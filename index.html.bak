                    </div>

                    <div style="text-align: center; margin: 10px 0;">
                        ${dataUrlInst ? `<img src="${dataUrlInst}" style="max-width: 100%; max-height: 480px; margin: 0 auto; border: 1px solid #cbd5e1; border-radius: 4px;" />` : '<p>Planta Elétrica</p>'}
                    </div>

