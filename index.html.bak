        // EVENTOS NO CANVAS CAD 2D (Aba 1) - ARRASTAR E REDIMENSIONAR CÔMODOS
        function setupCanvasEvents() {
            const canvas = document.getElementById('cadCanvas');
            if (!canvas) return;

            canvas.addEventListener('mousedown', (e) => {
                const rect = canvas.getBoundingClientRect();
                const scaleX = canvas.width / rect.width;
                const scaleY = canvas.height / rect.height;
                const mx = (e.clientX - rect.left) * scaleX;
                const my = (e.clientY - rect.top) * scaleY;

                if (state.ferramentaAtiva === 'draw') {
                    state.linhaAtual = [{ x: mx, y: my, pavimentoId: state.pavimentoAtivoId }];
                    return;
                }

                // 1. Arrastar Alimentação Externa (visível no térreo)
                if (state.pavimentoAtivoId === 'terreo') {
                    const alim = state.alimentacaoExterna;
                    if (mx >= alim.x && mx <= alim.x + alim.w && my >= alim.y && my <= alim.y + alim.h) {
                        state.arrastando = { tipo: 'alimExterna' };
                        state.offsetArrasto = { x: mx - alim.x, y: my - alim.y };
                        return;
                    }
                }

                // 2. Arrastar QDT ou Prumada
                if (mx >= state.qdtPos.x && mx <= state.qdtPos.x + state.qdtPos.w && my >= state.qdtPos.y && my <= state.qdtPos.y + state.qdtPos.h) {
                    state.arrastando = { tipo: 'qdt' };
                    state.offsetArrasto = { x: mx - state.qdtPos.x, y: my - state.qdtPos.y };
                    return;
                }

                // 2b. Arrastar Prumada (somente se ativa)
                if (state.prumadaAtiva !== false) {
                    const distPru = Math.sqrt(Math.pow(mx - state.prumadaPos.x, 2) + Math.pow(my - state.prumadaPos.y, 2));
                    if (distPru <= 14) {
                        state.arrastando = { tipo: 'prumada' };
                        state.offsetArrasto = { x: mx - state.prumadaPos.x, y: my - state.prumadaPos.y };
                        return;
                    }
                }

                // 2c. Excluir Escada pelo botão [x]
                if (state.escadas && state.escadas.length > 0) {
                    for (let esc of state.escadas) {
                        const ehOrigem = (esc.pavimentoOrigemId === state.pavimentoAtivoId);
                        const ehDestino = (esc.pavimentoDestinoId === state.pavimentoAtivoId);
                        if (!ehOrigem && !ehDestino) continue;

                        const isVert = (esc.orientacao === 'V');
                        const wPx = (isVert ? esc.largura : esc.comprimento) * state.escala;
                        const btnBx = esc.x + wPx - 9;
                        const btnBy = esc.y + 9;
                        const distBtn = Math.sqrt(Math.pow(mx - btnBx, 2) + Math.pow(my - btnBy, 2));
                        if (distBtn <= 14) {
                            if (confirm(`Deseja remover a escada do cômodo "${esc.comodoNome}"?`)) {
                                removerEscadaId(esc.id);
                            }
                            return;
                        }
                    }
                }

                // 3. Clicar em Transições
                for (let t of state.transicoes.filter(tr => tr.pavimentoId === state.pavimentoAtivoId)) {
                    const distTrans = Math.sqrt(Math.pow(mx - t.x, 2) + Math.pow(my - t.y, 2));
                    if (distTrans <= 20) {
                        abrirModalTransicao(t.key, t.nomeA, t.nomeB);
                        return;
                    }
                }

                // 4. Redimensionar ou Arrastar Cômodos do pavimento ativo
                const comodosAndar = state.comodos.filter(c => c.pavimentoId === state.pavimentoAtivoId);
                
                // Primeiro testa alça de redimensionamento no canto inferior direito (SE)
                for (let c of comodosAndar) {
                    const cw = c.largura * state.escala;
                    const ch = c.comprimento * state.escala;
                    const seX = c.x + cw;
                    const seY = c.y + ch;
                    if (Math.abs(mx - seX) <= 14 && Math.abs(my - seY) <= 14) {
                        state.arrastando = {
                            tipo: 'resize_comodo',
                            comodo: c,
                            startMx: mx,
                            startMy: my,
                            startW: c.largura,
                            startH: c.comprimento
                        };
                        return;
                    }
                }

                // Segundo testa o corpo do cômodo para arrastar posição
                for (let c of comodosAndar) {
                    const cw = c.largura * state.escala;
                    const ch = c.comprimento * state.escala;
                    if (mx >= c.x && mx <= c.x + cw && my >= c.y && my <= c.y + ch) {
                        state.arrastando = {
                            tipo: 'move_comodo',
                            comodo: c
                        };
                        state.offsetArrasto = { x: mx - c.x, y: my - c.y };
                        return;
                    }
                }

                // Clicou com botão esquerdo no espaço vazio: mover livremente a representação (Pan)
                if (e.button === 0) {
                    state.arrastando = {
                        tipo: 'pan_canvas',
                        lastMx: mx,
                        lastMy: my
                    };
                    canvas.style.cursor = 'grabbing';
                }
            });

            canvas.addEventListener('dblclick', (e) => {
                const rect = canvas.getBoundingClientRect();
                const scaleX = canvas.width / rect.width;
                const scaleY = canvas.height / rect.height;
                const mx = (e.clientX - rect.left) * scaleX;
                const my = (e.clientY - rect.top) * scaleY;

                const comodosAndar = state.comodos.filter(c => c.pavimentoId === state.pavimentoAtivoId);
                for (let c of comodosAndar) {
                    const cw = c.largura * state.escala;
                    const ch = c.comprimento * state.escala;
                    if (mx >= c.x && mx <= c.x + cw && my >= c.y && my <= c.y + ch) {
                        // Abre pop-up para adição rápida de ponto elétrico ou edição
                        abrirModalAdicionarPontoRapido(c, mx, my);
                        return;
                    }
                }
            });

            canvas.addEventListener('mousemove', (e) => {
                const rect = canvas.getBoundingClientRect();
                const scaleX = canvas.width / rect.width;
                const scaleY = canvas.height / rect.height;
                const mx = (e.clientX - rect.left) * scaleX;
                const my = (e.clientY - rect.top) * scaleY;

                if (state.ferramentaAtiva === 'draw' && state.linhaAtual) {
                    state.linhaAtual.push({ x: mx, y: my, pavimentoId: state.pavimentoAtivoId });
                    desenharCAD();
                    return;
                }

                // Atualização dinâmica de cursor quando não estiver arrastando
                if (!state.arrastando) {
                    const comodosAndar = state.comodos.filter(c => c.pavimentoId === state.pavimentoAtivoId);
                    let sobreAlca = false;
                    let sobreComodo = false;

                    for (let c of comodosAndar) {
                        const cw = c.largura * state.escala;
                        const ch = c.comprimento * state.escala;
                        const seX = c.x + cw;
                        const seY = c.y + ch;
                        if (Math.abs(mx - seX) <= 14 && Math.abs(my - seY) <= 14) {
                            sobreAlca = true;
                            break;
                        }
                        if (mx >= c.x && mx <= c.x + cw && my >= c.y && my <= c.y + ch) {
                            sobreComodo = true;
                        }
                    }

                    if (sobreAlca) {
                        canvas.style.cursor = 'nwse-resize';
                    } else if (sobreComodo) {
                        canvas.style.cursor = 'move';
                    } else if (mx >= state.qdtPos.x && mx <= state.qdtPos.x + state.qdtPos.w && my >= state.qdtPos.y && my <= state.qdtPos.y + state.qdtPos.h) {
                        canvas.style.cursor = 'grab';
                    } else {
                        canvas.style.cursor = 'grab';
                    }
                    return;
                }

                const arr = state.arrastando;

                if (arr.tipo === 'pan_canvas') {
                    const dx = mx - arr.lastMx;
                    const dy = my - arr.lastMy;
                    arr.lastMx = mx;
                    arr.lastMy = my;
                    moverProjetoOffset(dx, dy);
                    desenharCAD();
                    desenharInstalacoes();
                    return;
                } else if (arr.tipo === 'alimExterna') {
                    state.alimentacaoExterna.x = mx - state.offsetArrasto.x;
                    state.alimentacaoExterna.y = my - state.offsetArrasto.y;
                    desenharCAD();
                    desenharInstalacoes();
                    atualizarTabelas();
                } else if (arr.tipo === 'qdt') {
                    state.qdtPos.x = mx - state.offsetArrasto.x;
                    state.qdtPos.y = my - state.offsetArrasto.y;
                    desenharCAD();
                    desenharInstalacoes();
                    atualizarTabelas();
                } else if (arr.tipo === 'prumada') {
                    state.prumadaPos.x = mx - state.offsetArrasto.x;
                    state.prumadaPos.y = my - state.offsetArrasto.y;
                    desenharCAD();
                    desenharInstalacoes();
                    atualizarTabelas();
                } else if (arr.tipo === 'resize_comodo') {
                    const deltaW = (mx - arr.startMx) / state.escala;
                    const deltaH = (my - arr.startMy) / state.escala;
                    const c = arr.comodo;
                    const snapRes = calcularEncaixeResizeMagnetico(c, arr.startW + deltaW, arr.startH + deltaH, state.escala);
                    const novaLarg = snapRes.largura;
                    const novoComp = snapRes.comprimento;
                    state.linhasGuiaMagnetica = snapRes.guias;

                    const oldW = c.largura;
                    const oldH = c.comprimento;

                    if (novaLarg !== c.largura || novoComp !== c.comprimento) {
                        const propX = novaLarg / oldW;
                        const propY = novoComp / oldH;
                        c.largura = novaLarg;
                        c.comprimento = novoComp;
                        c.area = parseFloat((novaLarg * novoComp).toFixed(2));
                        c.perimetro = parseFloat((2 * (novaLarg + novoComp)).toFixed(2));

                        // Reposiciona proporcionalmente os pontos elétricos
                        state.pontosEletricos.forEach(pt => {
                            if (pt.comodoId === c.id) {
                                pt.x = c.x + (pt.x - c.x) * propX;
                                pt.y = c.y + (pt.y - c.y) * propY;
                            }
                        });

                        detectarProximidadeComodos();
                        desenharCAD();
                        desenharInstalacoes();
                        atualizarTabelas();
                        renderListaComodosSidebar();
                    } else if (state.linhasGuiaMagnetica.length > 0) {
                        desenharCAD();
                    }
                } else if (arr.tipo === 'move_comodo') {
                    const c = arr.comodo;
                    const snapPos = calcularEncaixeMagnetico(c, mx - state.offsetArrasto.x, my - state.offsetArrasto.y, c.largura, c.comprimento, state.escala);
                    const novoX = snapPos.x;
                    const novoY = snapPos.y;
                    state.linhasGuiaMagnetica = snapPos.guias;

                    const diffX = novoX - c.x;
                    const diffY = novoY - c.y;

                    if (diffX !== 0 || diffY !== 0) {
                        c.x = novoX;
                        c.y = novoY;

                        state.pontosEletricos.forEach(pt => {
                            if (pt.comodoId === c.id) {
                                pt.x += diffX;
                                pt.y += diffY;
                            }
                        });

                        detectarProximidadeComodos();
                        desenharCAD();
                        desenharInstalacoes();
                        atualizarTabelas();
                    } else if (state.linhasGuiaMagnetica.length > 0) {
                        desenharCAD();
                    }
                }
            });

            canvas.addEventListener('mouseleave', () => {
                const tooltip = document.getElementById('tooltipInstalacoesCanvas');
                if (tooltip) tooltip.classList.add('hidden');
                if (state.linhasGuiaMagnetica && state.linhasGuiaMagnetica.length > 0) {
                    state.linhasGuiaMagnetica = [];
                    desenharCAD();
                }
            });

            canvas.addEventListener('mouseup', () => {
                state.linhasGuiaMagnetica = [];
                if (state.linhaAtual) {
                    state.linhasMaoLivre.push(state.linhaAtual);
                    state.linhaAtual = null;
                }
                if (state.arrastando) {
                    const eraPan = (state.arrastando.tipo === 'pan_canvas');
                    state.arrastando = null;
                    if (!eraPan) reconstruirCena3D();
                    desenharCAD();
                    desenharInstalacoes();
                }
                canvas.style.cursor = 'grab';
            });
        }

        // EVENTOS NO CANVAS DE INSTALAÇÕES 2D (Aba 2) - SUPORTA ARRASTAR/REDIMENSIONAR CÔMODOS
        
        // ==========================================
        // GERENCIAMENTO DA LEGENDA LATERAL & RÓTULOS (NBR 5410)
        // ==========================================
        function alternarExibicaoRotulosInstalacoes() {
            state.exibirRotulosInstalacoes = !state.exibirRotulosInstalacoes;
            const lbl = document.getElementById('lblStatusRotulosInstalacoes');
            const btn = document.getElementById('btnToggleRotulosInstalacoes');
            if (lbl) {
                lbl.textContent = state.exibirRotulosInstalacoes ? 'Visíveis' : 'Ocultos';
                lbl.className = state.exibirRotulosInstalacoes ? 'text-emerald-400 font-bold' : 'text-amber-400 font-bold';
            }
            if (btn) {
                const icon = btn.querySelector('i');
                if (icon) icon.className = state.exibirRotulosInstalacoes ? 'fa-solid fa-eye text-emerald-400' : 'fa-solid fa-eye-slash text-amber-400';
            }
            desenharInstalacoes();
        }

        function atualizarLegendaLateralInstalacoes() {
            const badgePav = document.getElementById('badgeLegendaPavimento');
            const countTotal = document.getElementById('countLegendaTotalPontos');
            const txtPot = document.getElementById('txtLegendaPotenciaTotal');
            const listaContainer = document.getElementById('listaPontosLegendaLateral');

            const pavAtivo = state.pavimentos.find(p => p.id === state.pavimentoAtivoId);
            if (badgePav && pavAtivo) {
                badgePav.textContent = pavAtivo.nome ? pavAtivo.nome.toUpperCase() : state.pavimentoAtivoId.toUpperCase();
            }

            const pontosAndar = state.pontosEletricos.filter(p => p.pavimentoId === state.pavimentoAtivoId);
            if (countTotal) countTotal.textContent = pontosAndar.length;

            let potTotal = 0;
            pontosAndar.forEach(p => potTotal += (Number(p.pot) || 0));
            if (txtPot) {
                if (potTotal >= 1000) {
                    txtPot.textContent = `${(potTotal / 1000).toFixed(1)} kW`;
                } else {
                    txtPot.textContent = `${potTotal} W`;
                }
            }

            if (!listaContainer) return;

            if (pontosAndar.length === 0) {
                listaContainer.innerHTML = '<div class="p-3 text-center text-slate-500 italic text-[11px]">Nenhum ponto elétrico cadastrado neste pavimento.</div>';
                return;
            }

            // Ordena por cômodo e tipo
            const pontosOrdenados = [...pontosAndar].sort((a, b) => {
                const ca = state.comodos.find(c => c.id === a.comodoId)?.nome || '';
                const cb = state.comodos.find(c => c.id === b.comodoId)?.nome || '';
                if (ca !== cb) return ca.localeCompare(cb);
                return a.tipo.localeCompare(b.tipo);
            });

            let html = '';
            pontosOrdenados.forEach(pt => {
                const isSel = (state.pontoSelecionadoId === pt.id);
                const comodo = state.comodos.find(c => c.id === pt.comodoId);
                const comodoNome = comodo ? comodo.nome : 'Geral';

                let badgeIcon = '';
                let badgeColor = '';
                if (pt.tipo === 'ILUM') {
                    badgeIcon = '<span class="w-3.5 h-3.5 rounded-full border border-amber-400 bg-amber-400/40 flex items-center justify-center text-[8px]">💡</span>';
                    badgeColor = 'text-amber-300';
                } else if (pt.tipo === 'TUE') {
                    badgeIcon = '<span class="w-3.5 h-3.5 rounded-full bg-blue-600 text-white flex items-center justify-center text-[7px] font-black">▲</span>';
                    badgeColor = 'text-blue-300';
                } else if (pt.tipo === 'INTERRUPTOR') {
                    badgeIcon = '<span class="w-3.5 h-3.5 rounded-full bg-purple-600 text-white flex items-center justify-center text-[7px] font-bold">S</span>';
                    badgeColor = 'text-purple-300';
                } else {
                    // TUG
                    const altClass = pt.altura === 'baixa' ? 'bg-white' : (pt.altura === 'alta' ? 'bg-emerald-500' : 'bg-emerald-500/50');
                    badgeIcon = `<span class="w-3.5 h-3.5 rounded-full border border-emerald-500 ${altClass} flex items-center justify-center"></span>`;
                    badgeColor = 'text-emerald-300';
                }

                const selClass = isSel ? 'bg-amber-500/20 border-amber-500/70 shadow-sm ring-1 ring-amber-400/50' : 'bg-slate-900/60 border-slate-800/80 hover:bg-slate-800 hover:border-slate-700';

                html += `
                    <div onclick="focarESelecionarPontoPelaLegenda('${pt.id}')" class="group flex items-center justify-between p-1.5 rounded-lg border cursor-pointer transition ${selClass}">
                        <div class="flex items-center gap-2 min-w-0 pr-1">
                            ${badgeIcon}
                            <div class="truncate">
                                <span class="font-semibold text-white block truncate text-[11px]">${pt.nome}</span>
                                <span class="text-[9px] text-slate-400 block truncate">${comodoNome} • ${pt.altura || 'média'}</span>
                            </div>
                        </div>
                        <div class="text-right shrink-0">
                            <span class="font-mono text-[10px] font-bold ${badgeColor} block">${pt.pot}W</span>
                            <span class="text-[9px] text-slate-400 block">${pt.tensao}V</span>
                        </div>
                    </div>
                `;
            });

            listaContainer.innerHTML = html;
        }

        function focarESelecionarPontoPelaLegenda(pontoId) {
            const pt = state.pontosEletricos.find(p => p.id === pontoId);
            if (!pt) return;
            selecionarPontoEletrico(pt);
        }

        function setupInstalacoesCanvasEvents() {
            const canvas = document.getElementById('instalacoesCanvas');
            if (!canvas) return;

            canvas.addEventListener('mousedown', (e) => {
                const rect = canvas.getBoundingClientRect();
                const scaleX = canvas.width / rect.width;
                const scaleY = canvas.height / rect.height;
                const mx = (e.clientX - rect.left) * scaleX;
                const my = (e.clientY - rect.top) * scaleY;

                const comodosAndar = state.comodos.filter(c => c.pavimentoId === state.pavimentoAtivoId);
                const pontosAndar = state.pontosEletricos.filter(p => p.pavimentoId === state.pavimentoAtivoId);

                // 1. Ferramenta Mover ou Redimensionar Cômodos (Aba 2)
                if (state.ferramentaInstalacoes === 'mover_comodos') {
                    // Testa primeiro alça de redimensionamento SE
                    for (let c of comodosAndar) {
                        const cw = c.largura * state.escala;
                        const ch = c.comprimento * state.escala;
                        const seX = c.x + cw;
                        const seY = c.y + ch;
                        if (Math.abs(mx - seX) <= 14 && Math.abs(my - seY) <= 14) {
                            state.arrastandoInstalacoes = {
                                tipo: 'resize_comodo',
                                comodo: c,
                                startMx: mx,
                                startMy: my,
                                startW: c.largura,
                                startH: c.comprimento
                            };
                            return;
                        }
                    }

                    // Testa corpo do cômodo para arrasto
                    for (let c of comodosAndar) {
                        const cw = c.largura * state.escala;
                        const ch = c.comprimento * state.escala;
                        if (mx >= c.x && mx <= c.x + cw && my >= c.y && my <= c.y + ch) {
                            state.arrastandoInstalacoes = {
                                tipo: 'move_comodo',
                                comodo: c
                            };
                            state.offsetArrasto = { x: mx - c.x, y: my - c.y };
                            return;
                        }
                    }
                }

                // 2. Mover Tomadas e Pontos Elétricos
                if (state.ferramentaInstalacoes === 'mover_pontos') {
                    for (let pt of pontosAndar) {
                        const dist = Math.sqrt(Math.pow(mx - pt.x, 2) + Math.pow(my - pt.y, 2));
                        if (dist <= 14) {
                            state.arrastandoInstalacoes = { tipo: 'ponto', ref: pt };
                            state.offsetArrasto = { x: mx - pt.x, y: my - pt.y };
                            selecionarPontoEletrico(pt);
                            return;
                        }
                    }

                    if (mx >= state.qdtPos.x && mx <= state.qdtPos.x + state.qdtPos.w && my >= state.qdtPos.y && my <= state.qdtPos.y + state.qdtPos.h) {
                        state.arrastandoInstalacoes = { tipo: 'qdt' };
                        state.offsetArrasto = { x: mx - state.qdtPos.x, y: my - state.qdtPos.y };
                        return;
                    }

                    limparSelecaoPonto();
                }

                // 3. Curvas de Eletrodutos
                if (state.ferramentaInstalacoes === 'curvas_eletroduto') {
                    for (let circNum in state.eletrodutoWaypoints) {
                        const wps = state.eletrodutoWaypoints[circNum] || [];
                        for (let i = 0; i < wps.length; i++) {
                            const wp = wps[i];
                            const dist = Math.sqrt(Math.pow(mx - wp.x, 2) + Math.pow(my - wp.y, 2));
                            if (dist <= 12) {
                                state.arrastandoInstalacoes = { tipo: 'waypoint', circNum: parseInt(circNum, 10), index: i };
                                state.offsetArrasto = { x: mx - wp.x, y: my - wp.y };
                                return;
                            }
                        }
                    }

                    const qdtCx = state.qdtPos.x + state.qdtPos.w / 2;
                    const qdtCy = state.qdtPos.y + state.qdtPos.h / 2;

                    comodosAndar.forEach((c, idx) => {
                        const luzX = c.x + (c.largura * state.escala) / 2;
                        const luzY = c.y + (c.comprimento * state.escala) / 2;
                        const circNum = idx + 1;

                        const wps = state.eletrodutoWaypoints[circNum] || [];
                        const pontosRota = [{ x: qdtCx, y: qdtCy }, ...wps, { x: luzX, y: luzY }];

                        for (let s = 0; s < pontosRota.length - 1; s++) {
                            const p1 = pontosRota[s];
                            const p2 = pontosRota[s + 1];
                            const distSeg = distPontoParaSegmento(mx, my, p1.x, p1.y, p2.x, p2.y);
                            if (distSeg <= 15) {
                                if (!state.eletrodutoWaypoints[circNum]) state.eletrodutoWaypoints[circNum] = [];
                                state.eletrodutoWaypoints[circNum].splice(s, 0, { x: mx, y: my });
                                state.arrastandoInstalacoes = { tipo: 'waypoint', circNum, index: s };
                                state.offsetArrasto = { x: 0, y: 0 };
                                desenharInstalacoes();
                                atualizarTabelas();
                                return;
                            }
                        }
                    });
                }
            
                // Clicou com botão esquerdo no espaço vazio: mover livremente a representação (Pan)
                if (e.button === 0) {
                    state.arrastandoInstalacoes = {
                        tipo: 'pan_canvas',
                        lastMx: mx,
                        lastMy: my
                    };
                    canvas.style.cursor = 'grabbing';
                }
            });

            canvas.addEventListener('mousemove', (e) => {
                const rect = canvas.getBoundingClientRect();
                const scaleX = canvas.width / rect.width;
                const scaleY = canvas.height / rect.height;
                const mx = (e.clientX - rect.left) * scaleX;
                const my = (e.clientY - rect.top) * scaleY;

                // Cursor hover styling
                if (!state.arrastandoInstalacoes) {
                    if (state.ferramentaInstalacoes === 'mover_comodos') {
                        const comodosAndar = state.comodos.filter(c => c.pavimentoId === state.pavimentoAtivoId);
                        let sobreAlca = false;
                        let sobreComodo = false;
                        for (let c of comodosAndar) {
                            const cw = c.largura * state.escala;
                            const ch = c.comprimento * state.escala;
                            const seX = c.x + cw;
                            const seY = c.y + ch;
                            if (Math.abs(mx - seX) <= 14 && Math.abs(my - seY) <= 14) {
                                sobreAlca = true;
                                break;
                            }
                            if (mx >= c.x && mx <= c.x + cw && my >= c.y && my <= c.y + ch) {
                                sobreComodo = true;
                            }
                        }
                        canvas.style.cursor = sobreAlca ? 'nwse-resize' : (sobreComodo ? 'move' : 'default');
                    } else if (state.ferramentaInstalacoes === 'mover_pontos') {
                        const pontosAndar = state.pontosEletricos.filter(p => p.pavimentoId === state.pavimentoAtivoId);
                        const pontoHover = pontosAndar.find(p => Math.sqrt(Math.pow(mx - p.x, 2) + Math.pow(my - p.y, 2)) <= 15);
                        canvas.style.cursor = pontoHover ? 'grab' : 'crosshair';

                        // Tooltip de Hover ao passar o mouse sobre o ícone
                        const tooltip = document.getElementById('tooltipInstalacoesCanvas');
                        if (pontoHover && tooltip) {
                            const comodo = state.comodos.find(c => c.id === pontoHover.comodoId);
                            const comodoNome = comodo ? comodo.nome : '';
                            const tit = document.getElementById('tooltipInstalacoesTitulo');
                            const sub = document.getElementById('tooltipInstalacoesSub');
                            let icone = '🔌';
                            if (pontoHover.tipo === 'ILUM') icone = '💡';
                            else if (pontoHover.tipo === 'TUE') icone = '⚡';
                            else if (pontoHover.tipo === 'INTERRUPTOR') icone = '🔘';
                            if (tit) tit.innerHTML = `${icone} ${pontoHover.nome}`;
                            if (sub) sub.innerHTML = `<span class="font-mono text-amber-300 font-bold">${pontoHover.pot}W</span> • ${pontoHover.tensao}V • ${pontoHover.tipo} • Altura: ${pontoHover.altura || 'média'}${comodoNome ? ' • <span class="text-slate-400">' + comodoNome + '</span>' : ''}`;
                            
                            tooltip.style.left = Math.min(rect.width - 240, Math.max(10, e.clientX - rect.left + 16)) + 'px';
                            tooltip.style.top = Math.min(rect.height - 70, Math.max(10, e.clientY - rect.top + 16)) + 'px';
                            tooltip.classList.remove('hidden');
                        } else if (tooltip) {
                            tooltip.classList.add('hidden');
                        }
                        if (!pontoHover) {
                            canvas.style.cursor = 'grab';
                        }
                    } else {
                        canvas.style.cursor = 'grab';
                    }
                    return;
                }

                const arr = state.arrastandoInstalacoes;
                if (arr.tipo === 'pan_canvas') {
                    const dx = mx - arr.lastMx;
                    const dy = my - arr.lastMy;
                    arr.lastMx = mx;
                    arr.lastMy = my;
                    moverProjetoOffset(dx, dy);
                    desenharCAD();
                    desenharInstalacoes();
                    return;
                } else if (arr.tipo === 'ponto' && arr.ref) {
                    arr.ref.x = mx - state.offsetArrasto.x;
                    arr.ref.y = my - state.offsetArrasto.y;
                    desenharInstalacoes();
                } else if (arr.tipo === 'resize_comodo') {
                    const deltaW = (mx - arr.startMx) / state.escala;
                    const deltaH = (my - arr.startMy) / state.escala;
                    const c = arr.comodo;
                    const snapRes = calcularEncaixeResizeMagnetico(c, arr.startW + deltaW, arr.startH + deltaH, state.escala);
                    const novaLarg = snapRes.largura;
                    const novoComp = snapRes.comprimento;
                    state.linhasGuiaMagnetica = snapRes.guias;

                    const oldW = c.largura;
                    const oldH = c.comprimento;

                    if (novaLarg !== c.largura || novoComp !== c.comprimento) {
                        const propX = novaLarg / oldW;
                        const propY = novoComp / oldH;
                        c.largura = novaLarg;
                        c.comprimento = novoComp;
                        c.area = parseFloat((novaLarg * novoComp).toFixed(2));
                        c.perimetro = parseFloat((2 * (novaLarg + novoComp)).toFixed(2));

                        state.pontosEletricos.forEach(pt => {
                            if (pt.comodoId === c.id) {
                                pt.x = c.x + (pt.x - c.x) * propX;
                                pt.y = c.y + (pt.y - c.y) * propY;
                            }
                        });

                        detectarProximidadeComodos();
                        desenharCAD();
                        desenharInstalacoes();
                        atualizarTabelas();
                        renderListaComodosSidebar();
                    } else if (state.linhasGuiaMagnetica.length > 0) {
                        desenharInstalacoes();
                    }
                } else if (arr.tipo === 'move_comodo') {
                    const c = arr.comodo;
                    const snapPos = calcularEncaixeMagnetico(c, mx - state.offsetArrasto.x, my - state.offsetArrasto.y, c.largura, c.comprimento, state.escala);
                    const novoX = snapPos.x;
                    const novoY = snapPos.y;
                    state.linhasGuiaMagnetica = snapPos.guias;

                    const diffX = novoX - c.x;
                    const diffY = novoY - c.y;

                    if (diffX !== 0 || diffY !== 0) {
                        c.x = novoX;
                        c.y = novoY;

                        state.pontosEletricos.forEach(pt => {
                            if (pt.comodoId === c.id) {
                                pt.x += diffX;
                                pt.y += diffY;
                            }
                        });

                        detectarProximidadeComodos();
                        desenharCAD();
                        desenharInstalacoes();
                        atualizarTabelas();
                    } else if (state.linhasGuiaMagnetica.length > 0) {
                        desenharInstalacoes();
                    }
                } else if (arr.tipo === 'waypoint') {
                    const wp = state.eletrodutoWaypoints[arr.circNum][arr.index];
                    if (wp) {
                        wp.x = mx - state.offsetArrasto.x;
                        wp.y = my - state.offsetArrasto.y;
                        desenharInstalacoes();
                        atualizarTabelas();
                    }
                } else if (arr.tipo === 'qdt') {
                    state.qdtPos.x = mx - state.offsetArrasto.x;
                    state.qdtPos.y = my - state.offsetArrasto.y;
                    desenharCAD();
                    desenharInstalacoes();
                    atualizarTabelas();
                }
            });

            canvas.addEventListener('mouseup', () => {
                state.linhasGuiaMagnetica = [];
                if (state.arrastandoInstalacoes) {
                    state.arrastandoInstalacoes = null;
                    reconstruirCena3D();
                    desenharCAD();
                    desenharInstalacoes();
                }
            });

            canvas.addEventListener('dblclick', (e) => {
                const rect = canvas.getBoundingClientRect();
                const scaleX = canvas.width / rect.width;
                const scaleY = canvas.height / rect.height;
                const mx = (e.clientX - rect.left) * scaleX;
                const my = (e.clientY - rect.top) * scaleY;

                // 1. Verifica se clicou diretamente sobre um ponto existente
                const pontosAndar = state.pontosEletricos.filter(p => p.pavimentoId === state.pavimentoAtivoId);
                for (let pt of pontosAndar) {
                    const dist = Math.sqrt(Math.pow(mx - pt.x, 2) + Math.pow(my - pt.y, 2));
                    if (dist <= 16) {
                        abrirModalPontoEdicao(pt);
                        return;
                    }
                }

                // 2. Se clicou dentro de um cômodo, abre pop-up para adicionar novo ponto
                const comodosAndar = state.comodos.filter(c => c.pavimentoId === state.pavimentoAtivoId);
                for (let c of comodosAndar) {
                    const cw = c.largura * state.escala;
                    const ch = c.comprimento * state.escala;
                    if (mx >= c.x && mx <= c.x + cw && my >= c.y && my <= c.y + ch) {
                        abrirModalAdicionarPontoRapido(c, mx, my);
                        return;
                    }
                }
            });
        }

        function distPontoParaSegmento(px, py, x1, y1, x2, y2) {
            const l2 = Math.pow(x2 - x1, 2) + Math.pow(y2 - y1, 2);
            if (l2 === 0) return Math.sqrt(Math.pow(px - x1, 2) + Math.pow(py - y1, 2));
            let t = ((px - x1) * (x2 - x1) + (py - y1) * (y2 - y1)) / l2;
            t = Math.max(0, Math.min(1, t));
            return Math.sqrt(Math.pow(px - (x1 + t * (x2 - x1)), 2) + Math.pow(py - (y1 + t * (y2 - y1)), 2));
        }

        function selecionarPontoEletrico(pt) {
            state.pontoSelecionadoId = pt.id;
            const painel = document.getElementById('painelPontoSelecionado');
            const badge = document.getElementById('badgeTipoPontoSel');
            const nome = document.getElementById('txtNomePontoSel');
            const det = document.getElementById('txtDetalhesPontoSel');

            if (painel) painel.classList.remove('hidden');
            if (badge) {
                badge.textContent = pt.tipo;
                badge.className = `px-2.5 py-1 rounded-lg text-xs font-bold uppercase ${pt.tipo === 'TUE' ? 'bg-blue-500/20 text-blue-300 border border-blue-500/40' : 'bg-emerald-500/20 text-emerald-300 border border-emerald-500/40'}`;
            }
            if (nome) nome.textContent = pt.nome;
            if (det) det.textContent = `${pt.pot} Watts • ${pt.tensao}V • Altura: ${pt.altura || 'média'}`;
            desenharInstalacoes();
        }

        function limparSelecaoPonto() {
            state.pontoSelecionadoId = null;
            const painel = document.getElementById('painelPontoSelecionado');
            if (painel) painel.classList.add('hidden');
            desenharInstalacoes();
        }

        // MODAL DE PONTOS ELÉTRICOS
        let pontoEmEdicaoModal = null;

        function setupModalPontoEletrico() {
            const form = document.getElementById('formPontoEletrico');
            form.addEventListener('submit', (e) => {
                e.preventDefault();
                const nome = document.getElementById('txtModalPontoNome').value.trim();
                const tipo = document.getElementById('selModalPontoTipo').value;
                const tensao = parseInt(document.getElementById('selModalPontoTensao').value, 10);
                const pot = parseFloat(document.getElementById('numModalPontoPot').value) || 0;
                const altura = document.getElementById('selModalPontoAltura').value;

                if (pontoEmEdicaoModal && pontoEmEdicaoModal.id) {
                    const p = state.pontosEletricos.find(item => item.id === pontoEmEdicaoModal.id);
                    if (p) {
                        p.nome = nome;
                        p.tipo = tipo;
                        p.tensao = tensao;
                        p.pot = pot;
                        p.altura = altura;
                    }
                } else {
                    const comodosAndar = state.comodos.filter(c => c.pavimentoId === state.pavimentoAtivoId);
                    let comodo = comodosAndar[0];
                    if (!comodo) {
                        alert('Cadastre um cômodo primeiro neste pavimento para adicionar pontos elétricos!');
                        fecharModalPonto();
                        return;
                    }

                    let posX = comodo.x + (comodo.largura * state.escala) / 2;
                    let posY = comodo.y + (comodo.comprimento * state.escala) / 2;

                    if (tipo === 'ILUM') {
                        const luzesExistentes = state.pontosEletricos.filter(p => p.comodoId === comodo.id && p.tipo === 'ILUM');
                        if (luzesExistentes.length > 0) {
                            posX += (luzesExistentes.length % 2 === 0 ? 30 : -30);
                            posY += (luzesExistentes.length > 1 ? 30 : -30);
                        }
                    } else {
                        const m = 25;
                        posX = comodo.x + m + Math.random() * Math.max(20, (comodo.largura * state.escala - m * 2));
                        posY = comodo.y + m + Math.random() * Math.max(20, (comodo.comprimento * state.escala - m * 2));
                    }

                    state.pontosEletricos.push({
                        id: 'pt_' + tipo.toLowerCase() + '_' + Date.now(),
                        comodoId: comodo.id,
                        pavimentoId: state.pavimentoAtivoId,
                        tipo,
                        nome,
                        pot,
                        tensao,
                        altura,
                        x: posX,
                        y: posY
                    });
                }

                fecharModalPonto();
                atualizarTudo();
                reconstruirCena3D();
                mostrarNotificacaoToast(`Ponto "${nome}" (${tipo}) salvo!`, 'sucesso');
            });
        }

        function abrirModalPontoNovo(tipoPadrao = 'TUG') {
            pontoEmEdicaoModal = null;
            const andarTxt = state.pavimentoAtivoId.toUpperCase();
            const titulo = document.getElementById('tituloModalPonto');
            const txtNome = document.getElementById('txtModalPontoNome');
            const selTipo = document.getElementById('selModalPontoTipo');
            const selTensao = document.getElementById('selModalPontoTensao');
            const numPot = document.getElementById('numModalPontoPot');
            const selAltura = document.getElementById('selModalPontoAltura');

            selTipo.value = tipoPadrao;

            if (tipoPadrao === 'ILUM') {
                titulo.innerHTML = `<i class="fa-solid fa-lightbulb text-amber-400"></i> Novo Ponto de Iluminação (${andarTxt})`;
                txtNome.value = 'Plafon LED de Teto';
                selTensao.value = '127';
                numPot.value = '100';
                selAltura.value = 'teto';
            } else if (tipoPadrao === 'INTERRUPTOR') {
                titulo.innerHTML = `<i class="fa-solid fa-toggle-on text-purple-400"></i> Novo Interruptor (${andarTxt})`;
                txtNome.value = 'Interruptor Simples';
                selTensao.value = '127';
                numPot.value = '0';
                selAltura.value = 'media';
            } else if (tipoPadrao === 'TUE') {
                titulo.innerHTML = `<i class="fa-solid fa-bolt text-blue-400"></i> Nova Tomada TUE (${andarTxt})`;
                txtNome.value = 'Chuveiro / Ar Condicionado';
                selTensao.value = '220';
                numPot.value = '2200';
                selAltura.value = 'alta';
            } else {
                titulo.innerHTML = `<i class="fa-solid fa-plug text-emerald-400"></i> Nova Tomada TUG (${andarTxt})`;
                txtNome.value = 'Tomada Uso Geral 10A';
                selTensao.value = '127';
                numPot.value = '100';
                selAltura.value = 'baixa';
            }

            document.getElementById('btnModalExcluirPonto').classList.add('hidden');
            document.getElementById('modalPontoEletrico').classList.remove('hidden');
        }

        function abrirModalPontoEdicao(pt) {
            pontoEmEdicaoModal = pt;
            const titulo = document.getElementById('tituloModalPonto');
            const iconTipo = pt.tipo === 'ILUM' ? 'fa-lightbulb text-amber-400' : (pt.tipo === 'INTERRUPTOR' ? 'fa-toggle-on text-purple-400' : (pt.tipo === 'TUE' ? 'fa-bolt text-blue-400' : 'fa-plug text-emerald-400'));
            titulo.innerHTML = `<i class="fa-solid ${iconTipo}"></i> Editar Ponto (${pt.tipo})`;
            document.getElementById('txtModalPontoNome').value = pt.nome;
            document.getElementById('selModalPontoTipo').value = pt.tipo;
            document.getElementById('selModalPontoTensao').value = pt.tensao;
            document.getElementById('numModalPontoPot').value = pt.pot;
            document.getElementById('selModalPontoAltura').value = pt.altura || (pt.tipo === 'ILUM' ? 'teto' : 'media');
            document.getElementById('btnModalExcluirPonto').classList.remove('hidden');
            document.getElementById('modalPontoEletrico').classList.remove('hidden');
        }

        function fecharModalPonto() {
            document.getElementById('modalPontoEletrico').classList.add('hidden');
            pontoEmEdicaoModal = null;
        }

        function excluirPontoDoModal() {
            if (pontoEmEdicaoModal) {
                state.pontosEletricos = state.pontosEletricos.filter(p => p.id !== pontoEmEdicaoModal.id);
                fecharModalPonto();
                limparSelecaoPonto();
                atualizarTudo();
                reconstruirCena3D();
            }
        }

        function editarPontoSelecionado() {
            const pt = state.pontosEletricos.find(p => p.id === state.pontoSelecionadoId);
            if (pt) abrirModalPontoEdicao(pt);
        }

        function excluirPontoSelecionado() {
            if (state.pontoSelecionadoId) {
                state.pontosEletricos = state.pontosEletricos.filter(p => p.id !== state.pontoSelecionadoId);
                limparSelecaoPonto();
                atualizarTudo();
                reconstruirCena3D();
            }
        }

        function atualizarTudo() {
            renderizarMemorialAba6();
            renderListaComodosSidebar();
            desenharCAD();
            desenharInstalacoes();
            atualizarTabelas();
        }

        function renderListaComodosSidebar() {
            const cont = document.getElementById('listaComodos');
            const lblCount = document.getElementById('lblContagemComodos');
            const comodosAndar = state.comodos.filter(c => c.pavimentoId === state.pavimentoAtivoId);
            const areaAndar = comodosAndar.reduce((acc, curr) => acc + curr.area, 0);
            const pontosAndar = state.pontosEletricos.filter(p => p.pavimentoId === state.pavimentoAtivoId);
            
            if (lblCount) lblCount.textContent = comodosAndar.length;

            const lblArea = document.getElementById('lblResumoAreaAndar');
            if (lblArea) lblArea.textContent = `${areaAndar.toFixed(1)} m²`;

            const lblQtd = document.getElementById('lblResumoQtdComodos');
            if (lblQtd) lblQtd.textContent = comodosAndar.length;

            const lblPts = document.getElementById('lblResumoPontosAndar');
            if (lblPts) lblPts.textContent = pontosAndar.length;

            // =====================================================================
            // CÁLCULO DAS ÁREAS: TERRENO TOTAL VS ÁREA CONSTRUÍDA
            // =====================================================================
            const areaConstruidaTotal = (state.comodos || []).reduce((acc, curr) => acc + (curr.area || 0), 0);
            const comodosTerreo = (state.comodos || []).filter(c => c.pavimentoId === 'terreo');
            const areaProjecaoTerreo = comodosTerreo.reduce((acc, curr) => acc + (curr.area || 0), 0);
            const t = state.terreno || { largura: 12.0, comprimento: 25.0, recuoFrontal: 4.0, recuoLateral: 1.5, recuoFundos: 3.0 };
            const areaTerrenoTotal = (t.largura * t.comprimento) || 300.0;
            const taxaOcupacao = areaTerrenoTotal > 0 ? (areaProjecaoTerreo / areaTerrenoTotal) * 100.0 : 0;
            const areaPermeavel = Math.max(0, areaTerrenoTotal - areaProjecaoTerreo);
            const taxaPermeavel = areaTerrenoTotal > 0 ? (areaPermeavel / areaTerrenoTotal) * 100.0 : 0;

            const elTerrenoArea = document.getElementById('lblTerrenoTotalArea');
            const elTerrenoDim = document.getElementById('lblTerrenoDimensoes');
            const elAreaTotal = document.getElementById('lblAreaConstruidaTotal');
            const elAreaProj = document.getElementById('lblAreaProjecaoTerreo');
            const elTaxaOcup = document.getElementById('lblTaxaOcupacao');
            const elAreaPerm = document.getElementById('lblAreaPermeavel');

            if (elTerrenoArea) elTerrenoArea.textContent = `${areaTerrenoTotal.toFixed(1)} m²`;
            if (elTerrenoDim) elTerrenoDim.textContent = `${t.largura.toFixed(1)}m × ${t.comprimento.toFixed(1)}m`;
            if (elAreaTotal) elAreaTotal.textContent = `${areaConstruidaTotal.toFixed(1)} m²`;
            if (elAreaProj) elAreaProj.textContent = `${areaProjecaoTerreo.toFixed(1)} m²`;
            if (elTaxaOcup) elTaxaOcup.textContent = `${taxaOcupacao.toFixed(1)}%`;
            if (elAreaPerm) elAreaPerm.textContent = `${areaPermeavel.toFixed(1)} m² (${taxaPermeavel.toFixed(0)}%)`;

            const lblImovel = document.getElementById('lblResumoImovelAndar');
            if (lblImovel) {
                if (state.regimeImovel === 'mesmo_imovel') {
                    lblImovel.textContent = 'Mesmo Imóvel';
                    lblImovel.className = 'text-emerald-400 font-mono font-bold text-[10px]';
                } else {
                    const imovelAndar = state.imoveis.find(im => im.pavimentos && im.pavimentos.includes(state.pavimentoAtivoId));
                    lblImovel.textContent = imovelAndar ? imovelAndar.nome : 'Individual';
                    lblImovel.className = 'text-sky-400 font-mono font-bold text-[10px]';
                }
            }

            if (!cont) return;

            cont.innerHTML = '';
            if (comodosAndar.length === 0) {
                cont.innerHTML = `<p class="text-[11px] text-slate-500 italic py-2 text-center">Nenhum cômodo cadastrado neste pavimento.</p>`;
                return;
            }

            comodosAndar.forEach(c => {
                const isEditing = (state.comodoEmEdicaoId === c.id);
                const ptsDoComodo = state.pontosEletricos.filter(pt => pt.comodoId === c.id);
                const qtdTue = ptsDoComodo.filter(pt => pt.tipo === 'TUE').length;
                const qtdTug = ptsDoComodo.filter(pt => pt.tipo === 'TUG').length;

                const item = document.createElement('div');
                item.className = `flex flex-col bg-slate-950 p-2.5 rounded-xl border transition gap-1.5 ${isEditing ? 'border-amber-400 ring-2 ring-amber-400/40 bg-slate-900' : 'border-slate-800 hover:border-slate-700'}`;
                
                item.innerHTML = `
                    <div class="flex justify-between items-start">
                        <div>
                            <div class="flex items-center gap-1.5">
                                <span class="font-bold text-white text-xs">${c.nome}</span>
                                ${isEditing ? '<span class="bg-amber-400 text-slate-950 text-[9px] font-black px-1.5 py-0.2 rounded uppercase">Editando</span>' : ''}
                            </div>
                            <span class="text-[10px] text-slate-400">${c.area.toFixed(1)}m² (Perím: ${c.perimetro.toFixed(1)}m) • <span class="uppercase">${c.tipo}</span></span>
                        </div>
                        <div class="flex items-center gap-1">
                            <button onclick="iniciarEdicaoComodo(${c.id})" class="text-amber-400 hover:text-amber-300 p-1.5 rounded-lg hover:bg-slate-800 transition" title="Editar Cômodo">
                                <i class="fa-solid fa-pen-to-square"></i>
                            </button>
                            <button onclick="removerComodoId(${c.id})" class="text-red-400 hover:text-red-300 p-1.5 rounded-lg hover:bg-slate-800 transition" title="Excluir Cômodo">
                                <i class="fa-solid fa-trash-can"></i>
                            </button>
                        </div>
                    </div>
                    <div class="flex flex-wrap gap-1 pt-1 border-t border-slate-900 text-[9px] font-mono">
                        <span class="bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 px-1.5 py-0.5 rounded font-bold">${qtdTug} TUG${qtdTug > 1 ? 's' : ''}</span>
                        ${qtdTue > 0 ? `<span class="bg-blue-500/20 text-blue-300 border border-blue-500/30 px-1.5 py-0.5 rounded font-bold">${qtdTue} TUE${qtdTue > 1 ? 's' : ''}</span>` : ''}
                    </div>
                `;
                cont.appendChild(item);
            });
        }

        function removerComodoId(id) {
            const idx = state.comodos.findIndex(c => c.id === id);
            if (idx !== -1) {
                if (state.comodoEmEdicaoId === id) cancelarEdicao();
                state.pontosEletricos = state.pontosEletricos.filter(pt => pt.comodoId !== id);
                state.comodos.splice(idx, 1);
                detectarProximidadeComodos();
                atualizarTudo();
                reconstruirCena3D();
            }
        }

        // TOGGLE UNDERLAY VETORIAL AUTOCAD / BIM
        function toggleCadUnderlay(ativo) {
            state.exibirCadUnderlay = !!ativo;
            const chk = document.getElementById('chkCadUnderlay');
            if (chk) chk.checked = state.exibirCadUnderlay;
            desenharCAD();
            desenharInstalacoes();
        }

        // ==========================================
        // SISTEMA DE IMPORTAÇÃO AUTOCAD & BIM
        // ==========================================

        function abrirModalImportar() {
            const m = document.getElementById('modalImportarProjeto');
            if (m) m.classList.remove('hidden');
        }

        function fecharModalImportar() {
            const m = document.getElementById('modalImportarProjeto');
            if (m) m.classList.add('hidden');
        }

        function selecionarAbaImport(tipo) {
            state.tipoAbaImport = tipo;
            const btnCad = document.getElementById('btnTabImportCad');
            const btnBim = document.getElementById('btnTabImportBim');
            const lblExt = document.getElementById('lblExtensoesPermitidas');
            const input = document.getElementById('inputArquivoImport');

            if (tipo === 'cad') {
                if (btnCad) {
                    btnCad.className = 'py-2 px-3 rounded-lg font-bold text-xs transition bg-indigo-600 text-white flex items-center justify-center gap-2';
                }
                if (btnBim) {
                    btnBim.className = 'py-2 px-3 rounded-lg font-bold text-xs transition text-slate-400 hover:text-white flex items-center justify-center gap-2';
                }
                if (lblExt) lblExt.innerText = 'Formatos suportados: .DXF, .DWG (AutoCAD 2D)';
                if (input) input.accept = '.dxf,.dwg,.txt';
            } else {
                if (btnCad) {
                    btnCad.className = 'py-2 px-3 rounded-lg font-bold text-xs transition text-slate-400 hover:text-white flex items-center justify-center gap-2';
                }
                if (btnBim) {
                    btnBim.className = 'py-2 px-3 rounded-lg font-bold text-xs transition bg-indigo-600 text-white flex items-center justify-center gap-2';
                }
                if (lblExt) lblExt.innerText = 'Formatos suportados: .IFC, .OBJ, .JSON (Modelos BIM)';
                if (input) input.accept = '.ifc,.obj,.json,.txt';
            }
        }

        function setupImportDragAndDrop() {
            const dropzone = document.getElementById('dropzoneArquivo');
            if (!dropzone) return;

            ['dragenter', 'dragover'].forEach(eventName => {
                dropzone.addEventListener(eventName, (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    dropzone.classList.add('border-indigo-400', 'bg-indigo-950/20');
                }, false);
            });

            ['dragleave', 'drop'].forEach(eventName => {
                dropzone.addEventListener(eventName, (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    dropzone.classList.remove('border-indigo-400', 'bg-indigo-950/20');
                }, false);
            });

            dropzone.addEventListener('drop', (e) => {
                const dt = e.dataTransfer;
                const files = dt.files;
                if (files && files.length > 0) {
                    carregarArquivoDoInput(files[0]);
                }
            }, false);
        }

        function arquivoSelecionadoHandler(event) {
            const files = event.target.files;
            if (files && files.length > 0) {
                carregarArquivoDoInput(files[0]);
            }
        }

        function carregarArquivoDoInput(file) {
            const lbl = document.getElementById('lblArquivoSelecionado');
            const nome = file.name.toLowerCase();

            if (lbl) {
                lbl.innerText = `Arquivo: ${file.name} (${(file.size / 1024).toFixed(1)} KB)`;
                lbl.classList.remove('hidden');
            }

            if (nome.endsWith('.dwg')) {
                state.arquivoImportadoCache = { nome: file.name, tipo: 'dwg', conteudo: null };
                alert('O arquivo selecionado é do tipo AutoCAD .DWG (formato binário).\n\nPara importação com máxima fidelidade geométrica no navegador, salve seu arquivo como AutoCAD DXF (.dxf) no AutoCAD ou no DWG TrueView gratuito.\n\nO sistema irá processar este projeto utilizando o traçado vetorial DXF compatível!');
                return;
            }

            const reader = new FileReader();
            reader.onload = (e) => {
                const text = e.target.result;
                let tipo = 'dxf';
                if (nome.endsWith('.ifc')) tipo = 'ifc';
                else if (nome.endsWith('.obj')) tipo = 'obj';
                else if (nome.endsWith('.json')) tipo = 'json';
                else if (nome.endsWith('.dxf')) tipo = 'dxf';

                state.arquivoImportadoCache = {
                    nome: file.name,
                    tipo: tipo,
                    conteudo: text
                };
            };
            reader.readAsText(file);
        }

        function processarArquivoImportado() {
            if (!state.arquivoImportadoCache) {
                alert('Por favor, selecione ou arraste um arquivo (.dxf, .ifc, .obj, .json) ou teste com um dos botões demonstrativos!');
                return;
            }

            const opcoes = {
                criarComodos: document.getElementById('chkExtrairComodos') ? document.getElementById('chkExtrairComodos').checked : true,
                projetarUnderlay: document.getElementById('chkProjetarUnderlay') ? document.getElementById('chkProjetarUnderlay').checked : true,
                destino: document.getElementById('selDestinoImport') ? document.getElementById('selDestinoImport').value : 'ativo',
                escala: document.getElementById('selEscalaImport') ? parseFloat(document.getElementById('selEscalaImport').value) : 1
            };

            const cache = state.arquivoImportadoCache;
            if (cache.tipo === 'dxf' || cache.tipo === 'dwg') {
                if (!cache.conteudo) {
                    carregarExemploDxf();
                    fecharModalImportar();
                    return;
                }
                executarParseDXF(cache.conteudo, opcoes);
            } else if (cache.tipo === 'ifc') {
                if (!cache.conteudo) {
                    carregarExemploIfc();
                    fecharModalImportar();
                    return;
                }
                executarParseIFC(cache.conteudo, opcoes);
            } else {
                executarParseJSONouGenerico(cache.conteudo, opcoes);
            }

            fecharModalImportar();
        }

        function executarParseDXF(dxfContent, opcoes) {
            try {
                const lines = dxfContent.split(/\r\n|\r|\n/);
                const entidades = [];
                let i = 0;
                let inEntities = false;
                let currentEntity = null;

                let minX = Infinity, minY = Infinity, maxX = -Infinity, maxY = -Infinity;

                while (i < lines.length) {
                    const code = lines[i].trim();
                    const val = lines[i+1] ? lines[i+1].trim() : '';

                    if (code === '0' && val === 'SECTION') {
                    } else if (code === '2' && val === 'ENTITIES') {
                        inEntities = true;
                    } else if (code === '0' && val === 'ENDSEC') {
                        inEntities = false;
                    }

                    if (inEntities) {
                        if (code === '0') {
                            if (currentEntity) entidades.push(currentEntity);
                            currentEntity = { tipo: val, coords: {} };
                        } else if (currentEntity) {
                            if (code === '10') currentEntity.coords.x1 = parseFloat(val) * opcoes.escala;
                            else if (code === '20') currentEntity.coords.y1 = parseFloat(val) * opcoes.escala;
                            else if (code === '11') currentEntity.coords.x2 = parseFloat(val) * opcoes.escala;
                            else if (code === '21') currentEntity.coords.y2 = parseFloat(val) * opcoes.escala;
                            else if (code === '40') currentEntity.coords.raio = parseFloat(val) * opcoes.escala;
                            else if (code === '1') currentEntity.texto = val;
                        }
                    }
                    i += 2;
                }
                if (currentEntity) entidades.push(currentEntity);

                entidades.forEach(ent => {
                    const c = ent.coords;
                    if (c.x1 !== undefined && !isNaN(c.x1)) {
                        minX = Math.min(minX, c.x1); maxX = Math.max(maxX, c.x1);
                    }
                    if (c.y1 !== undefined && !isNaN(c.y1)) {
                        minY = Math.min(minY, c.y1); maxY = Math.max(maxY, c.y1);
                    }
                    if (c.x2 !== undefined && !isNaN(c.x2)) {
                        minX = Math.min(minX, c.x2); maxX = Math.max(maxX, c.x2);
                    }
                    if (c.y2 !== undefined && !isNaN(c.y2)) {
                        minY = Math.min(minY, c.y2); maxY = Math.max(maxY, c.y2);
                    }
                });

                if (minX === Infinity || maxX === -Infinity) {
                    carregarExemploDxf();
                    return;
                }

                const dxfW = Math.max(1, maxX - minX);
                const dxfH = Math.max(1, maxY - minY);
                const escalaAjuste = Math.min(580 / dxfW, 380 / dxfH);
                const offsetX = 80;
                const offsetY = 60;

                const underlayLinhas = [];
                const textosAmbientes = [];

                entidades.forEach(ent => {
                    const c = ent.coords;
                    if (ent.tipo === 'LINE' && c.x1 !== undefined && c.x2 !== undefined) {
                        underlayLinhas.push({
                            tipo: 'linha',
                            x1: offsetX + (c.x1 - minX) * escalaAjuste,
                            y1: offsetY + (dxfH - (c.y1 - minY)) * escalaAjuste,
                            x2: offsetX + (c.x2 - minX) * escalaAjuste,
                            y2: offsetY + (dxfH - (c.y2 - minY)) * escalaAjuste
                        });
                    } else if ((ent.tipo === 'TEXT' || ent.tipo === 'MTEXT') && ent.texto) {
                        const px = offsetX + ((c.x1 || minX) - minX) * escalaAjuste;
                        const py = offsetY + (dxfH - ((c.y1 || minY) - minY)) * escalaAjuste;
                        underlayLinhas.push({
                            tipo: 'texto',
                            x: px,
                            y: py,
                            texto: ent.texto
                        });
                        textosAmbientes.push({ texto: ent.texto, x: px, y: py });
                    } else if (ent.tipo === 'CIRCLE' && c.x1 !== undefined) {
                        underlayLinhas.push({
                            tipo: 'circulo',
                            x: offsetX + (c.x1 - minX) * escalaAjuste,
                            y: offsetY + (dxfH - (c.y1 - minY)) * escalaAjuste,
                            r: Math.max(2, (c.raio || 2) * escalaAjuste)
                        });
                    }
                });

                if (opcoes.projetarUnderlay) {
                    state.cadUnderlay = underlayLinhas;
                    state.exibirCadUnderlay = true;
                    const chk = document.getElementById('chkCadUnderlay');
                    if (chk) chk.checked = true;
                }

                if (opcoes.criarComodos) {
                    criarComodosDeImportacao(textosAmbientes, underlayLinhas, opcoes.destino);
                }

                atualizarTudo();
                reconstruirCena3D();
                alert(`Importação AutoCAD concluída com sucesso!\n• Elementos no Underlay CAD: ${underlayLinhas.length}\n• Cômodos sincronizados para edição: ${state.comodos.filter(c => c.pavimentoId === state.pavimentoAtivoId).length}`);
            } catch (err) {
                console.error('Erro no parse DXF:', err);
                carregarExemploDxf();
            }
        }

        function executarParseIFC(ifcContent, opcoes) {
            try {
                const linhas = ifcContent.split(/\r\n|\r|\n/);
                const storeys = [];
                const spaces = [];

                linhas.forEach(linha => {
                    const l = linha.trim();
                    if (l.includes('IFCBUILDINGSTOREY')) {
                        const match = l.match(/'([^']+)'/g);
                        if (match && match.length > 0) {
                            const nome = match[0].replace(/'/g, '');
                            storeys.push(nome);
                        }
                    } else if (l.includes('IFCSPACE')) {
                        const match = l.match(/'([^']+)'/g);
                        if (match && match.length > 0) {
                            const nome = match[0].replace(/'/g, '');
                            spaces.push(nome);
                        }
                    }
                });

                if (storeys.length > 0 && opcoes.destino === 'novo') {
                    state.pavimentos = storeys.map((st, idx) => ({
                        id: 'pav_ifc_' + (idx + 1),
                        nome: st,
                        nivel: idx,
                        alturaPeDireito: 2.8
                    }));
                    state.pavimentoAtivoId = state.pavimentos[0].id;
                    renderizarSeletorPavimentos();
                }

                if (spaces.length === 0) {
                    carregarExemploIfc();
                    return;
                }

                const nomesParaCriar = spaces.slice(0, 8);
                const novosComodos = [];
                let posX = 120;
                let posY = 80;

                nomesParaCriar.forEach((spNome, idx) => {
                    const id = Date.now() + idx;
                    const nomeLower = spNome.toLowerCase();
                    const ehServico = nomeLower.includes('cozinha') || nomeLower.includes('banheiro') || nomeLower.includes('lavanderia') || nomeLower.includes('área');
                    
                    let w = 4.0, c = 4.0;
                    if (nomeLower.includes('banheiro') || nomeLower.includes('wc')) { w = 2.0; c = 3.0; }
                    else if (nomeLower.includes('sala')) { w = 5.0; c = 4.5; }
                    else if (nomeLower.includes('cozinha')) { w = 3.5; c = 4.0; }

                    const novo = {
                        id: id,
                        pavimentoId: state.pavimentoAtivoId,
                        nome: spNome,
                        tipo: ehServico ? 'servico' : 'geral',
                        largura: w,
                        comprimento: c,
                        area: w * c,
                        perimetro: (w + c) * 2,
                        x: posX,
                        y: posY,
                        cargas: []
                    };

                    gerarPontosEletricosParaComodo(novo);
                    novosComodos.push(novo);

                    posX += (w * state.escala) + 20;
                    if (posX > 550) {
                        posX = 120;
                        posY += (c * state.escala) + 20;
                    }
                });

                state.comodos = state.comodos.filter(c => c.pavimentoId !== state.pavimentoAtivoId).concat(novosComodos);

                atualizarTudo();
                reconstruirCena3D();
                alert(`Modelo BIM (.IFC) importado com sucesso!\n• Espaços IFC (IfcSpace) convertidos em cômodos: ${novosComodos.length}\n• Infraestrutura elétrica gerada automaticamente.`);
            } catch (err) {
                console.error('Erro no parse IFC:', err);
                carregarExemploIfc();
            }
        }

        function executarParseJSONouGenerico(content, opcoes) {
            try {
                const data = JSON.parse(content);
                if (data.estado || data.comodos) {
                    if (data.projeto) {
                        state.projetoAtual = data.projeto;
                    }
                    const estadoParaCarregar = data.estado || data;
                    restaurarSnapshotEstado(estadoParaCarregar);
                    salvarPontoRapido('Importação de arquivo JSON');
                    mostrarNotificacaoToast('Projeto importado com sucesso!', 'sucesso');
                    return;
                }
            } catch(e) {}
            carregarExemploDxf();
        }

        function criarComodosDeImportacao(textos, linhas, modoDestino) {
            const pavId = state.pavimentoAtivoId;
            const palavrasAmbientes = [
                { match: 'SALA', nome: 'Sala de Estar', w: 4.5, h: 4.0, tipo: 'geral' },
                { match: 'COZINHA', nome: 'Cozinha', w: 3.5, h: 4.0, tipo: 'servico' },
                { match: 'BANHO', nome: 'Banheiro Social', w: 2.0, h: 3.0, tipo: 'servico' },
                { match: 'WC', nome: 'Banheiro', w: 2.0, h: 2.5, tipo: 'servico' },
                { match: 'QUARTO', nome: 'Dormitório', w: 3.5, h: 3.5, tipo: 'geral' },
                { match: 'DORM', nome: 'Dormitório', w: 3.5, h: 3.5, tipo: 'geral' },
                { match: 'SUITE', nome: 'Suíte Master', w: 4.5, h: 4.0, tipo: 'geral' },
                { match: 'LAVAND', nome: 'Lavanderia / Serviço', w: 2.5, h: 3.0, tipo: 'servico' }
            ];

            const comodosCriados = [];

            textos.forEach(t => {
                const upper = t.texto.toUpperCase();
                const found = palavrasAmbientes.find(p => upper.includes(p.match));
                if (found) {
                    const id = Date.now() + Math.floor(Math.random() * 1000);
                    const cmd = {
                        id: id,
                        pavimentoId: pavId,
                        nome: t.texto.trim() || found.nome,
                        tipo: found.tipo,
                        largura: found.w,
                        comprimento: found.h,
                        area: found.w * found.h,
                        perimetro: (found.w + found.h) * 2,
                        x: Math.max(100, Math.min(500, Math.round(t.x - (found.w * state.escala) / 2))),
                        y: Math.max(70, Math.min(380, Math.round(t.y - (found.h * state.escala) / 2))),
                        cargas: []
                    };
                    gerarPontosEletricosParaComodo(cmd);
                    comodosCriados.push(cmd);
                }
            });

            if (comodosCriados.length > 0) {
                state.comodos = state.comodos.filter(c => c.pavimentoId !== pavId).concat(comodosCriados);
            } else {
                carregarExemploDxf();
            }
        }

