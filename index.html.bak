                                    <th style="padding: 6px; border: 1px solid #334155;">Ib (A)</th>
                                    <th style="padding: 6px; border: 1px solid #334155;">Disjuntor</th>
                                    <th style="padding: 6px; border: 1px solid #334155;">Bitola</th>
