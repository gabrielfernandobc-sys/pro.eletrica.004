        <!-- ABA 6: GUIA NBR 5410 -->
        <div id="tab-duvidas" class="tab-content space-y-6">
            <!-- CABEÇALHO DO GUIA NBR 5410 -->
            <div class="bg-gradient-to-r from-slate-900 via-slate-850 to-slate-900 p-6 rounded-2xl shadow-2xl border border-slate-800 text-xs space-y-6">
                <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 border-b border-slate-800 pb-5">
                    <div>
                        <h2 class="text-xl font-black text-amber-400 flex items-center gap-3">
                            <i class="fa-solid fa-book-bookmark text-2xl"></i>
                            Memorial Técnico & Guia Completo NBR 5410
                        </h2>
                        <p class="text-slate-400 text-xs mt-1">
                            Critérios normativos de dimensionamento de condutores, ampacidades, quedas de tensão, infraestrutura e proteções
                        </p>
                    </div>
                    <div class="flex items-center gap-2">
                        <button onclick="abrirModalImpressaoPDF()" class="bg-blue-600 hover:bg-blue-500 text-white font-bold px-3 py-1.5 rounded-xl transition flex items-center gap-2 text-xs">
                            <i class="fa-solid fa-print"></i> Imprimir Folha NBR 5410
                        </button>
                    </div>
                </div>


                <!-- SEÇÃO ESPECIAL: QUADRO CONSOLIDADO DE REVISÃO DAS NORMAS BRASILEIRAS APLICÁVEIS -->
                <div class="bg-slate-950 p-5 rounded-2xl border-2 border-emerald-500/40 space-y-4">
                    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-2 border-b border-slate-800 pb-3">
                        <div class="flex items-center gap-2.5">
                            <span class="w-8 h-8 rounded-xl bg-emerald-500/20 text-emerald-400 border border-emerald-500/40 flex items-center justify-center font-bold text-sm">
                                <i class="fa-solid fa-stamp"></i>
                            </span>
                            <div>
                                <h3 class="font-black text-sm text-white">Revisão Técnica das Normas Brasileiras Vigentes</h3>
                                <p class="text-[11px] text-slate-400">Conformidade obrigatória com o ordenamento normativo nacional da ABNT e ANEEL</p>
                            </div>
                        </div>
                        <span class="bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 text-[10px] px-2.5 py-1 rounded-lg font-mono font-bold">
                            100% CONFORME NORMAS BRASILEIRAS
                        </span>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3.5 text-xs">
                        <!-- NBR 5410 -->
                        <div class="bg-slate-900/90 p-3.5 rounded-xl border border-slate-800 space-y-1.5">
                            <div class="flex items-center justify-between">
                                <span class="font-black text-amber-400 text-xs">ABNT NBR 5410:2004</span>
                                <span class="text-[9px] bg-amber-500/20 text-amber-300 px-1.5 py-0.5 rounded font-bold">Baixa Tensão</span>
                            </div>
                            <p class="text-[11px] text-slate-300 leading-relaxed">
                                Regra mestra para instalações elétricas prediais. Define seções mínimas de condutores (1,5 mm² iluminação, 2,5 mm² tomadas), método B1 de instalação, capacidade de condução de corrente, fatores de agrupamento (FCA) e temperatura (FCT), queda de tensão máxima de 4%, e obrigatoriedade de IDR de 30mA em áreas molhadas.
                            </p>
                        </div>

                        <!-- NORMAS DE CONCESSIONÁRIAS / PRODIST -->
                        <div class="bg-slate-900/90 p-3.5 rounded-xl border border-sky-500/40 space-y-1.5">
                            <div class="flex items-center justify-between">
                                <span class="font-black text-sky-400 text-xs">PRODIST ANEEL & Concessionárias</span>
                                <span class="text-[9px] bg-sky-500/20 text-sky-300 px-1.5 py-0.5 rounded font-bold">Demanda BT</span>
                            </div>
                            <p class="text-[11px] text-slate-300 leading-relaxed">
                                Conforme o item 9.5.2 da NBR 5410, a determinação da demanda global residencial e o padrão de entrada são regidos pelas normas técnicas das concessionárias locais (CPFL GED-13, CEMIG ND-5.1, ENEL NTC 8410, COPEL NTC 901100, LIGHT Recon-BT). As potências são decompostas em parcelas escalonadas (a, b, c, d).
                            </p>
                        </div>

                        <!-- NBR 5444 -->
                        <div class="bg-slate-900/90 p-3.5 rounded-xl border border-slate-800 space-y-1.5">
                            <div class="flex items-center justify-between">
                                <span class="font-black text-emerald-400 text-xs">ABNT NBR 5444</span>
                                <span class="text-[9px] bg-emerald-500/20 text-emerald-300 px-1.5 py-0.5 rounded font-bold">Simbologia CAD</span>
                            </div>
                            <p class="text-[11px] text-slate-300 leading-relaxed">
                                Padrão visual consagrado de simbologia gráfica para projetos elétricos no Brasil: pontos de luz no teto, tomadas baixas (0.30m), médias (1.20m), altas (2.00m), interruptores simples/paralelos, caixas de passagem e fiação normalizada (fase, neutro, retorno e terra).
                            </p>
                        </div>

                        <!-- NBR 14136 -->
                        <div class="bg-slate-900/90 p-3.5 rounded-xl border border-slate-800 space-y-1.5">
                            <div class="flex items-center justify-between">
                                <span class="font-black text-indigo-400 text-xs">ABNT NBR 14136</span>
                                <span class="text-[9px] bg-indigo-500/20 text-indigo-300 px-1.5 py-0.5 rounded font-bold">Plugues & Tomadas</span>
                            </div>
                            <p class="text-[11px] text-slate-300 leading-relaxed">
                                Padrão brasileiro de plugues e tomadas em formato hexagonal com 3 pinos (incluindo o contato central de proteção terra). Padronizado em 10A (pinos Ø 4,0 mm para TUGs) e 20A (pinos Ø 4,8 mm para TUEs e equipamentos de maior potência).
                            </p>
                        </div>

                        <!-- NBR IEC 60898 -->
                        <div class="bg-slate-900/90 p-3.5 rounded-xl border border-slate-800 space-y-1.5">
                            <div class="flex items-center justify-between">
                                <span class="font-black text-rose-400 text-xs">NBR IEC 60898 & 60947</span>
                                <span class="text-[9px] bg-rose-500/20 text-rose-300 px-1.5 py-0.5 rounded font-bold">Disjuntores DIN</span>
                            </div>
                            <p class="text-[11px] text-slate-300 leading-relaxed">
                                Dispositivos de proteção contra sobrecorrentes e curtos-circuitos montados em trilho DIN 35mm (EN 50022). Emprego de minidisjuntores Curva B (cargas puramente resistivas) e Curva C (cargas gerais com correntes de partida como motores e chuveiros).
                            </p>
                        </div>

                        <!-- NBR 5419 -->
                        <div class="bg-slate-900/90 p-3.5 rounded-xl border border-slate-800 space-y-1.5">
                            <div class="flex items-center justify-between">
                                <span class="font-black text-purple-400 text-xs">ABNT NBR 5419:2015</span>
                                <span class="text-[9px] bg-purple-500/20 text-purple-300 px-1.5 py-0.5 rounded font-bold">SPDA & Surtos</span>
                            </div>
                            <p class="text-[11px] text-slate-300 leading-relaxed">
                                Proteção contra descargas atmosféricas e surtos transitórios induzidos pela rede de distribuição. Especificação obrigatória de DPS Classe II no Quadro de Distribuição (QDT) com tensão nominal de 275V e corrente de descarga mínima de 20kA a 40kA por fase.
                            </p>
                        </div>
                    </div>
                </div>

                <!-- SEÇÃO 1: MEMORIAL DINÂMICO DOS CIRCUITOS DO PROJETO ATUAL -->
                <div class="bg-slate-950 p-5 rounded-xl border border-amber-500/30 space-y-4">
                    <div class="flex items-center justify-between">
                        <h3 class="font-black text-sm text-amber-300 flex items-center gap-2">
                            <i class="fa-solid fa-calculator text-amber-400"></i>
                            1. Justificativa das Bitolas Adotadas nos Circuitos deste Projeto
                        </h3>
                        <span class="text-[11px] font-mono text-slate-400 bg-slate-900 px-2.5 py-1 rounded-lg border border-slate-800">
                            Cálculo em Tempo Real
                        </span>
                    </div>
                    <p class="text-slate-300 leading-relaxed text-xs">
                        A tabela abaixo relaciona todos os circuitos dimensionados para a edificação, calculando a corrente de projeto (<strong class="text-sky-300 font-mono">I<sub>b</sub></strong>), disjuntor termomagnético (<strong class="text-amber-300 font-mono">I<sub>n</sub></strong>), a bitola nominal utilizada (<strong class="text-emerald-300 font-mono">S</strong>) e a fundamentação regulamentar estrita da <strong>NBR 5410</strong>:
                    </p>

                    <div class="overflow-x-auto rounded-xl border border-slate-800">
                        <table class="w-full text-left text-xs border-collapse">
                            <thead>
                                <tr class="bg-slate-900 text-slate-300 uppercase text-[10px] tracking-wider border-b border-slate-800">
                                    <th class="p-2.5">Circuito</th>
                                    <th class="p-2.5">Descrição & Ambiente</th>
                                    <th class="p-2.5">Tipo</th>
                                    <th class="p-2.5">Potência</th>
                                    <th class="p-2.5">Tensão</th>
                                    <th class="p-2.5 font-mono">I<sub>b</sub> (A)</th>
                                    <th class="p-2.5 font-mono">Disjuntor</th>
                                    <th class="p-2.5 font-mono text-amber-300">Bitola (mm²)</th>
                                    <th class="p-2.5">Justificativa Técnica NBR 5410</th>
                                </tr>
                            </thead>
                            <tbody id="tabelaMemorialCircuitosAba6" class="divide-y divide-slate-850">
                                <!-- Preenchido dinamicamente via renderizarMemorialAba6() -->
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- SEÇÃO 2: POR QUE CADA BITOLA FOI UTILIZADA NO PROJETO? (DETALHAMENTO TÉCNICO) -->
                <div class="space-y-4">
                    <h3 class="font-black text-sm text-sky-400 flex items-center gap-2">
                        <i class="fa-solid fa-code-compare"></i>
                        2. Por que estas Bitolas são Utilizadas? Fundamentação por Seção
                    </h3>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <!-- 1.5 mm² -->
                        <div class="bg-slate-950 p-4 rounded-xl border border-slate-800 space-y-2">
                            <div class="flex items-center justify-between border-b border-slate-850 pb-2">
                                <span class="font-black text-amber-400 flex items-center gap-2">
                                    <span class="w-6 h-6 rounded bg-amber-500/20 text-amber-300 border border-amber-500/40 flex items-center justify-center font-mono text-xs">1.5</span>
                                    Bitola 1,5 mm² — Circuitos de Iluminação
                                </span>
                                <span class="text-[10px] text-slate-400 font-mono">Disjuntor 10A / 16A</span>
                            </div>
                            <p class="text-slate-300 text-xs leading-relaxed">
                                • <strong>Seção Mínima Obrigatória (Item 6.2.6.1.1, Tabela 47)</strong>: A NBR 5410 determina que a menor seção de condutor de cobre permitida em instalações fixas de iluminação é <strong>1,5 mm²</strong>, mesmo quando a carga total em lâmpadas LED demande correntes baixas (&lt; 2A). Isso garante integridade mecânica na tração dos fios dentro dos eletrodutos.<br>
                                • <strong>Capacidade de Condução (Tabela 36, Método B1)</strong>: Suporta até <strong>17,5A</strong> (2 condutores carregados, isolação PVC 70°C). Com fator de agrupamento, opera com folga térmica absoluta sob disjuntor de 10A.
                            </p>
                        </div>

                        <!-- 2.5 mm² -->
                        <div class="bg-slate-950 p-4 rounded-xl border border-slate-800 space-y-2">
                            <div class="flex items-center justify-between border-b border-slate-850 pb-2">
                                <span class="font-black text-emerald-400 flex items-center gap-2">
                                    <span class="w-6 h-6 rounded bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 flex items-center justify-center font-mono text-xs">2.5</span>
                                    Bitola 2,5 mm² — Tomadas de Uso Geral (TUG)
                                </span>
                                <span class="text-[10px] text-slate-400 font-mono">Disjuntor 16A / 20A</span>
                            </div>
                            <p class="text-slate-300 text-xs leading-relaxed">
                                • <strong>Seção Mínima para Circuitos de Força (Item 6.2.6.1.1, Tabela 47)</strong>: A norma proíbe condutores menores que <strong>2,5 mm²</strong> para qualquer circuito de tomadas (TUG ou TUE).<br>
                                • <strong>Capacidade de Condução (Tabela 36, Método B1)</strong>: Suporta até <strong>24A</strong>. Coordenado com disjuntor padrão de 16A ou 20A, assegura que mesmo tomadas padrão NBR 14136 de 10A ou 20A sob regime de consumo contínuo (ferro, aspirador, secador) não superaqueçam o circuito.
                            </p>
                        </div>

                        <!-- 4.0 mm² -->
                        <div class="bg-slate-950 p-4 rounded-xl border border-slate-800 space-y-2">
                            <div class="flex items-center justify-between border-b border-slate-850 pb-2">
                                <span class="font-black text-blue-400 flex items-center gap-2">
                                    <span class="w-6 h-6 rounded bg-blue-500/20 text-blue-300 border border-blue-500/40 flex items-center justify-center font-mono text-xs">4.0</span>
                                    Bitola 4,0 mm² — Cargas Médias & Cozinha/Serviço
                                </span>
                                <span class="text-[10px] text-slate-400 font-mono">Disjuntor 25A</span>
                            </div>
                            <p class="text-slate-300 text-xs leading-relaxed">
                                • <strong>Ampacidade Térmica (Tabela 36, Método B1)</strong>: Suporta até <strong>32A</strong> em regime normal. Aplicando o Fator de Correção de Agrupamento (<strong class="text-sky-300">FCA = 0,70</strong> para 3 circuitos na prumada), a corrente corrigida admissível é de <strong>22,4A a 25,6A</strong>.<br>
                                • <strong>Aplicações Típicas</strong>: Circuitos dedicados para micro-ondas, forno elétrico, lava-louças, ar-condicionado de 18.000 a 24.000 BTU e bancadas de cozinha com tomadas de 600VA simultâneas.
                            </p>
                        </div>

                        <!-- 6.0 mm² -->
                        <div class="bg-slate-950 p-4 rounded-xl border border-slate-800 space-y-2">
                            <div class="flex items-center justify-between border-b border-slate-850 pb-2">
                                <span class="font-black text-indigo-400 flex items-center gap-2">
                                    <span class="w-6 h-6 rounded bg-indigo-500/20 text-indigo-300 border border-indigo-500/40 flex items-center justify-center font-mono text-xs">6.0</span>
                                    Bitola 6,0 mm² — Chuveiros Elétricos (5500W a 6800W)
                                </span>
                                <span class="text-[10px] text-slate-400 font-mono">Disjuntor 32A</span>
                            </div>
                            <p class="text-slate-300 text-xs leading-relaxed">
                                • <strong>Dimensionamento por Carga (Item 6.2.5.1)</strong>: Um chuveiro residencial padrão de 5500W em 220V demanda <strong class="text-amber-300 font-mono">I<sub>b</sub> = 25A</strong>. Se o modelo for de 6800W, a corrente atinge <strong class="text-amber-300 font-mono">30,9A</strong>.<br>
                                • <strong>Capacidade de Condução (Tabela 36, Método B1)</strong>: Suporta <strong>41A</strong>. Com disjuntor de 32A, a condição regulamentar <strong class="text-sky-300 font-mono">I<sub>b</sub> (25A) ≤ I<sub>n</sub> (32A) ≤ I<sub>z</sub> (41A)</strong> é atendida com 100% de segurança térmica e queda de tensão controlada.
                            </p>
                        </div>

                        <!-- 10.0 mm² -->
                        <div class="bg-slate-950 p-4 rounded-xl border border-slate-800 space-y-2">
                            <div class="flex items-center justify-between border-b border-slate-850 pb-2">
                                <span class="font-black text-purple-400 flex items-center gap-2">
                                    <span class="w-6 h-6 rounded bg-purple-500/20 text-purple-300 border border-purple-500/40 flex items-center justify-center font-mono text-xs">10</span>
                                    Bitola 10,0 mm² — Chuveiros 7500W+ & Sub-Quadros
                                </span>
                                <span class="text-[10px] text-slate-400 font-mono">Disjuntor 40A / 50A</span>
                            </div>
                            <p class="text-slate-300 text-xs leading-relaxed">
                                • <strong>Aparelhos de Alta Potência</strong>: Chuveiros modernos turbo de 7500W a 7800W em 220V exigem <strong class="text-amber-300 font-mono">I<sub>b</sub> = 34,1A a 35,5A</strong>. Em trechos longos, o cabo de 6 mm² excederia o limite térmico após agrupamento.<br>
                                • <strong>Capacidade de Condução</strong>: Suporta até <strong>57A</strong> (Método B1), sendo também a bitola adotada para a prumada de interligação entre o Quadro do Térreo (QDT-G) e o Quadro Superior (QDT-P).
                            </p>
                        </div>

                        <!-- 16.0 a 25.0 mm² -->
                        <div class="bg-slate-950 p-4 rounded-xl border border-slate-800 space-y-2">
                            <div class="flex items-center justify-between border-b border-slate-850 pb-2">
                                <span class="font-black text-rose-400 flex items-center gap-2">
                                    <span class="w-6 h-6 rounded bg-rose-500/20 text-rose-300 border border-rose-500/40 flex items-center justify-center font-mono text-xs">16+</span>
                                    Bitola 16 a 25 mm² — Ramal de Entrada da Concessionária
                                </span>
                                <span class="text-[10px] text-slate-400 font-mono">Disjuntor Geral 63A / 80A</span>
                            </div>
                            <p class="text-slate-300 text-xs leading-relaxed">
                                • <strong>Demanda Global Residencial (Item 9.5.2)</strong>: Dimensionado pela soma das potências com aplicação dos fatores de demanda da concessionária local (Copel, Enel, Cemig, CPFL).<br>
                                • <strong>Capacidade de Condução</strong>: 16 mm² suporta até <strong>76A</strong> e 25 mm² suporta até <strong>101A</strong>, garantindo suprimento total sem oscilações de luminosidade no acionamento simultâneo de cargas.
                            </p>
                        </div>
                    </div>
                </div>

                <!-- SEÇÃO 3: OS 5 CRITÉRIOS DE DIMENSIONAMENTO OBRIGATÓRIOS DA NBR 5410 -->
                <div class="bg-slate-950 p-5 rounded-xl border border-slate-800 space-y-4">
                    <h3 class="font-black text-sm text-amber-400 flex items-center gap-2">
                        <i class="fa-solid fa-scale-balanced"></i>
                        3. Os 5 Critérios de Dimensionamento que o Software Aplica Automaticamente
                    </h3>

                    <div class="grid grid-cols-1 md:grid-cols-3 gap-3 text-xs">
                        <div class="bg-slate-900 p-3.5 rounded-xl border border-slate-800">
                            <span class="font-bold text-amber-300 block mb-1">Critério 1: Seção Mínima</span>
                            <p class="text-slate-400 text-[11px] leading-relaxed">
                                Tabela 47: 1,5 mm² para iluminação e 2,5 mm² para força. É o piso obrigatório por resistência mecânica.
                            </p>
                        </div>
                        <div class="bg-slate-900 p-3.5 rounded-xl border border-slate-800">
                            <span class="font-bold text-sky-300 block mb-1">Critério 2: Capacidade Térmica (Ampacidade)</span>
                            <p class="text-slate-400 text-[11px] leading-relaxed">
                                Método B1 em eletrodutos embutidos em alvenaria. Condutores de cobre com isolação PVC 70°C sob regime contínuo.
                            </p>
                        </div>
                        <div class="bg-slate-900 p-3.5 rounded-xl border border-slate-800">
                            <span class="font-bold text-emerald-300 block mb-1">Critério 3: Fatores de Correção</span>
                            <p class="text-slate-400 text-[11px] leading-relaxed">
                                Fator de Agrupamento (FCA - Tab. 42: 0,80 para 2 circ; 0,70 para 3 circ) e Temperatura ambiente (FCT - Tab. 40).
                            </p>
                        </div>
                        <div class="bg-slate-900 p-3.5 rounded-xl border border-slate-800">
                            <span class="font-bold text-purple-300 block mb-1">Critério 4: Queda de Tensão Máxima</span>
                            <p class="text-slate-400 text-[11px] leading-relaxed">
                                Item 6.2.7: Limite de 4% a partir do quadro terminal ou 5% desde o ponto de entrega da concessionária.
                            </p>
                        </div>
                        <div class="bg-slate-900 p-3.5 rounded-xl border border-slate-800">
                            <span class="font-bold text-rose-300 block mb-1">Critério 5: Coordenação Disjuntor x Cabo</span>
                            <p class="text-slate-400 text-[11px] leading-relaxed">
                                Regra de ouro: <strong class="text-white font-mono">I<sub>b</sub> ≤ I<sub>n</sub> ≤ I<sub>z</sub></strong> e <strong class="text-white font-mono">I<sub>2</sub> ≤ 1,45 · I<sub>z</sub></strong>. O disjuntor atua antes do cabo queimar.
                            </p>
                        </div>
                        <div class="bg-slate-900 p-3.5 rounded-xl border border-slate-800">
                            <span class="font-bold text-teal-300 block mb-1">Taxa de Ocupação de Tubos</span>
                            <p class="text-slate-400 text-[11px] leading-relaxed">
                                Item 6.2.11: Máximo 40% da área útil do eletroduto ocupada por 3 ou mais cabos, permitindo dissipação de calor.
                            </p>
                        </div>
                    </div>
                </div>

                <!-- SEÇÃO 4: CÓDIGO OBRIGATÓRIO DE CORES DOS CONDUTORES (ITEM 6.1.5.3) -->
                <div class="bg-slate-950 p-5 rounded-xl border border-slate-800 space-y-3">
                    <h3 class="font-black text-sm text-sky-400 flex items-center gap-2">
                        <i class="fa-solid fa-palette"></i>
                        4. Padrão Obrigatório de Cores dos Condutores (NBR 5410 Item 6.1.5.3)
                    </h3>
                    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 text-xs">
                        <div class="bg-slate-900 p-3 rounded-xl border border-sky-500/30 flex items-center gap-3">
                            <span class="w-5 h-5 rounded-full bg-blue-500 border-2 border-white shrink-0"></span>
                            <div>
                                <strong class="text-white block">Neutro (N)</strong>
                                <span class="text-blue-400 text-[11px]">Azul-Claro Obrigatório</span>
                            </div>
                        </div>
                        <div class="bg-slate-900 p-3 rounded-xl border border-emerald-500/30 flex items-center gap-3">
                            <span class="w-5 h-5 rounded-full bg-emerald-500 border-2 border-amber-300 shrink-0"></span>
                            <div>
                                <strong class="text-white block">Proteção (PE / Terra)</strong>
                                <span class="text-emerald-400 text-[11px]">Verde ou Verde-Amarelo</span>
                            </div>
                        </div>
                        <div class="bg-slate-900 p-3 rounded-xl border border-red-500/30 flex items-center gap-3">
                            <span class="w-5 h-5 rounded-full bg-red-600 border-2 border-white shrink-0"></span>
                            <div>
                                <strong class="text-white block">Fase (R / S / T)</strong>
                                <span class="text-red-400 text-[11px]">Vermelho, Preto, Marrom</span>
                            </div>
                        </div>
                        <div class="bg-slate-900 p-3 rounded-xl border border-amber-500/30 flex items-center gap-3">
                            <span class="w-5 h-5 rounded-full bg-amber-400 border-2 border-white shrink-0"></span>
                            <div>
                                <strong class="text-white block">Retorno de Iluminação</strong>
                                <span class="text-amber-300 text-[11px]">Amarelo (Distinto de N/PE)</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- SEÇÃO 5: DISPOSITIVO DR (DIFERENCIAL RESIDUAL) & DPS -->
                <div class="bg-slate-950 p-5 rounded-xl border border-slate-800 space-y-2">
                    <h3 class="font-black text-sm text-emerald-400 flex items-center gap-2">
                        <i class="fa-solid fa-shield-halved"></i>
                        5. Proteção Contra Choques (DR 30mA) e Surtos Atmosféricos (DPS)
                    </h3>
                    <p class="text-slate-300 text-xs leading-relaxed">
                        • <strong>Dispositivo DR Obrigatório (Item 5.1.3.2)</strong>: Alta sensibilidade (<strong class="text-emerald-300">I<sub>Δn</sub> ≤ 30mA</strong>) obrigatório em circuitos que atendam: banheiros, cozinhas, lavanderias, garagens, varandas e quaisquer tomadas em áreas externas ou que alimentem equipamentos externos.<br>
                        • <strong>DPS Classe II (Item 5.4)</strong>: Instalado no Quadro de Distribuição Geral entre Fase-Terra e Neutro-Terra para proteger eletrodomésticos e eletrônicos contra descargas atmosféricas (raios).
                    </p>
                </div>
            </div>
        </div>
        </div>

    </div>

    <!-- MODAL DE CRIAÇÃO DE NOVO PAVIMENTO -->
    <div id="modalNovoPavimento" class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 flex items-center justify-center hidden">
        <div class="bg-slate-900 border border-slate-700 rounded-2xl p-6 max-w-sm w-full mx-4 shadow-2xl space-y-4">
            <div class="flex justify-between items-center border-b border-slate-800 pb-3">
                <h3 class="text-sm font-bold text-sky-400 flex items-center gap-2">
                    <i class="fa-solid fa-layer-group"></i> Adicionar Novo Pavimento
                </h3>
                <button onclick="fecharModalNovoPavimento()" class="text-slate-400 hover:text-white p-1"><i class="fa-solid fa-xmark"></i></button>
            </div>
            <div class="space-y-3 text-xs">
                <div>
                    <label class="block font-semibold text-slate-300 mb-1">Nome do Pavimento</label>
                    <input id="txtNomeNovoPavimento" type="text" placeholder="Ex: 2º Pavimento, Ático, Cobertura" class="w-full bg-slate-950 border border-slate-800 text-white rounded-xl p-2.5 outline-none focus:ring-1 focus:ring-sky-400">
                </div>
                <div>
                    <label class="block font-semibold text-slate-300 mb-1">Pé-Direito Livre (m)</label>
                    <input id="numPeDireitoNovoPav" type="number" step="0.1" value="2.8" class="w-full bg-slate-950 border border-slate-800 text-white rounded-xl p-2.5 outline-none font-mono">
                </div>
                <!-- OPÇÕES INDEPENDENTES DE LAJES PARA O NOVO ANDAR -->
                <div class="p-3 bg-slate-950 rounded-xl border border-slate-800 space-y-2">
                    <span class="font-bold text-amber-400 block text-[11px] uppercase">Estrutura de Lajes do Andar:</span>
                    <label class="flex items-center gap-2 text-slate-300 cursor-pointer">
                        <input type="checkbox" id="chkNovoPavLajePiso" checked class="rounded text-amber-500 bg-slate-900 border-slate-700">
                        <span>Laje de Piso / Chão (Contrapiso)</span>
                    </label>
                    <label class="flex items-center gap-2 text-slate-300 cursor-pointer">
                        <input type="checkbox" id="chkNovoPavLajeTeto" checked class="rounded text-sky-500 bg-slate-900 border-slate-700">
                        <span>Laje de Teto (Forro / Cobertura)</span>
                    </label>
                    <div class="pt-1 flex items-center justify-between">
                        <span class="text-slate-400">Passagem Eletrodutos:</span>
                        <select id="selNovoPavPassagem" class="bg-slate-900 border border-slate-700 text-white rounded-lg px-2 py-1 outline-none text-xs">
                            <option value="teto">🏠 Pelo Teto (Laje)</option>
                            <option value="chao">🧱 Pelo Chão (Piso)</option>
                        </select>
                    </div>
                </div>
                <div class="pt-1">
                    <label class="flex items-center gap-2 text-slate-300 cursor-pointer">
                        <input type="checkbox" id="chkCopiarParedesTerreo" class="rounded text-sky-500 bg-slate-950 border-slate-700">
                        <span>Copiar disposição de paredes do Térreo como base</span>
                    </label>
                </div>
            </div>
            <div class="pt-3 border-t border-slate-800 flex justify-end gap-2 text-xs">
                <button onclick="fecharModalNovoPavimento()" class="bg-slate-800 hover:bg-slate-700 text-slate-300 font-semibold px-4 py-2 rounded-xl transition">
                    Cancelar
                </button>
                <button onclick="confirmarNovoPavimento()" class="bg-sky-500 hover:bg-sky-400 text-slate-950 font-bold px-4 py-2 rounded-xl transition">
                    Criar Andar
                </button>
            </div>
        </div>
    </div>

    <!-- MODAL DE CONFIGURAÇÃO DE LAJES E PARÂMETROS DO PAVIMENTO ATIVO -->
    <div id="modalConfigPavimento" class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 flex items-center justify-center hidden p-4">
        <div class="bg-slate-900 border border-slate-700 rounded-2xl max-w-md w-full shadow-2xl overflow-hidden flex flex-col">
            <div class="p-4 border-b border-slate-800 flex justify-between items-center bg-slate-950/60">
                <div class="flex items-center gap-2.5">
                    <span class="w-8 h-8 rounded-lg bg-amber-500/20 text-amber-400 border border-amber-500/40 flex items-center justify-center text-sm">
                        <i class="fa-solid fa-sliders"></i>
                    </span>
                    <div>
                        <h3 class="text-sm font-bold text-white flex items-center gap-2">
                            <span>Configuração de Lajes & Pavimento</span>
                        </h3>
                        <p id="subtituloModalPavimento" class="text-[11px] text-slate-400">Configurações independentes para: Pavimento Térreo</p>
                    </div>
                </div>
                <button onclick="fecharModalConfigPavimento()" class="text-slate-400 hover:text-white p-1.5 rounded-lg hover:bg-slate-800 transition">
                    <i class="fa-solid fa-xmark text-base"></i>
                </button>
            </div>

            <div class="p-5 space-y-4 text-xs overflow-y-auto max-h-[80vh]">
                <!-- DADOS BÁSICOS -->
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block font-semibold text-slate-300 uppercase mb-1">Nome do Andar</label>
                        <input id="cfgPavNome" type="text" class="w-full bg-slate-950 border border-slate-800 text-white rounded-xl p-2.5 focus:ring-1 focus:ring-amber-400 outline-none font-bold">
                    </div>
                    <div>
                        <label class="block font-semibold text-slate-300 uppercase mb-1">Pé-Direito (m)</label>
                        <input id="cfgPavPeDireito" type="number" step="0.1" min="2.0" max="6.0" class="w-full bg-slate-950 border border-slate-800 text-white rounded-xl p-2.5 focus:ring-1 focus:ring-amber-400 outline-none font-mono">
                    </div>
                </div>

                <!-- SEÇÃO LAJE DE PISO (CHÃO) -->
                <div class="bg-slate-950 p-3.5 rounded-xl border border-slate-800 space-y-2.5">
                    <div class="flex items-center justify-between">
                        <span class="font-bold text-amber-400 flex items-center gap-2">
                            <i class="fa-solid fa-square text-sm"></i> Laje de Piso / Chão
                        </span>
                        <label class="relative inline-flex items-center cursor-pointer">
                            <input type="checkbox" id="cfgPavTemPiso" class="rounded text-amber-500 bg-slate-900 border-slate-700 w-4 h-4">
                            <span class="ml-2 text-[11px] text-slate-300 font-bold">Ativa neste andar</span>
                        </label>
                    </div>
                    <div id="cfgPainelPiso" class="grid grid-cols-2 gap-2 pt-1 border-t border-slate-900">
                        <div>
                            <label class="text-[10px] text-slate-400 block mb-1">Tipo de Piso / Base:</label>
                            <select id="cfgPavTipoPiso" class="w-full bg-slate-900 border border-slate-800 text-white rounded-lg p-2 text-xs outline-none">
                                <option value="concreto">Concreto Estrutural</option>
                                <option value="contrapiso">Contrapiso Nivelado</option>
                                <option value="radier">Radier / Solo Compactado</option>
                            </select>
                        </div>
                        <div>
                            <label class="text-[10px] text-slate-400 block mb-1">Espessura (cm):</label>
                            <input id="cfgPavEspessuraPiso" type="number" step="1" min="5" max="50" value="20" class="w-full bg-slate-900 border border-slate-800 text-white rounded-lg p-2 text-xs font-mono outline-none">
                        </div>
                    </div>
                </div>

                <!-- SEÇÃO LAJE DE TETO (FORRO / COBERTURA) -->
                <div class="bg-slate-950 p-3.5 rounded-xl border border-slate-800 space-y-2.5">
                    <div class="flex items-center justify-between">
                        <span class="font-bold text-sky-400 flex items-center gap-2">
                            <i class="fa-solid fa-cloud text-sm"></i> Laje de Teto / Forro
                        </span>
                        <label class="relative inline-flex items-center cursor-pointer">
                            <input type="checkbox" id="cfgPavTemTeto" class="rounded text-sky-500 bg-slate-900 border-slate-700 w-4 h-4">
                            <span class="ml-2 text-[11px] text-slate-300 font-bold">Ativa neste andar</span>
                        </label>
                    </div>
                    <div id="cfgPainelTeto" class="grid grid-cols-2 gap-2 pt-1 border-t border-slate-900">
                        <div>
                            <label class="text-[10px] text-slate-400 block mb-1">Tipo de Teto / Cobertura:</label>
                            <select id="cfgPavTipoTeto" class="w-full bg-slate-900 border border-slate-800 text-white rounded-lg p-2 text-xs outline-none">
                                <option value="concreto">Laje Maciça de Concreto</option>
                                <option value="forro_gesso">Forro Rebaixado de Gesso / Drywall</option>
                                <option value="madeira">Forro de Madeira / Lambril</option>
                            </select>
                        </div>
                        <div>
                            <label class="text-[10px] text-slate-400 block mb-1">Espessura (cm):</label>
                            <input id="cfgPavEspessuraTeto" type="number" step="1" min="5" max="40" value="15" class="w-full bg-slate-900 border border-slate-800 text-white rounded-lg p-2 text-xs font-mono outline-none">
                        </div>
                    </div>
                </div>

                <!-- SEÇÃO ROTEAMENTO DE TUBULAÇÃO DO ANDAR -->
                <div class="bg-slate-950 p-3.5 rounded-xl border border-slate-800 space-y-2">
                    <span class="font-bold text-slate-300 flex items-center gap-1.5 text-[11px] uppercase">
                        <i class="fa-solid fa-route text-amber-400"></i> Passagem de Eletrodutos deste Pavimento:
                    </span>
                    <div class="grid grid-cols-2 gap-2">
                        <label id="lblOptPassagemTeto" class="flex items-center gap-2 p-2.5 rounded-xl border border-slate-800 bg-slate-900 cursor-pointer hover:border-sky-500/50 transition">
                            <input type="radio" name="radCfgPassagem" value="teto" id="radCfgPassagemTeto" class="text-sky-500">
                            <div>
                                <span class="font-bold text-white block">🏠 Pelo Teto</span>
                                <span class="text-[10px] text-slate-400">Na laje superior / forro</span>
                            </div>
                        </label>
                        <label id="lblOptPassagemChao" class="flex items-center gap-2 p-2.5 rounded-xl border border-slate-800 bg-slate-900 cursor-pointer hover:border-emerald-500/50 transition">
                            <input type="radio" name="radCfgPassagem" value="chao" id="radCfgPassagemChao" class="text-emerald-500">
                            <div>
                                <span class="font-bold text-white block">🧱 Pelo Chão</span>
                                <span class="text-[10px] text-slate-400">No contrapiso / radier</span>
                            </div>
                        </label>
                    </div>
                </div>

                <!-- SEÇÃO PRUMADA VERTICAL (SHAFT) -->
                <div class="bg-slate-950 p-3.5 rounded-xl border border-slate-800 space-y-2">
                    <div class="flex items-center justify-between">
                        <span class="font-bold text-amber-400 flex items-center gap-2">
                            <i class="fa-solid fa-arrow-up-from-ground-water text-sm"></i> Prumada Vertical (Shaft)
                        </span>
                        <label class="relative inline-flex items-center cursor-pointer">
                            <input type="checkbox" id="cfgPrumadaAtiva" class="rounded text-amber-500 bg-slate-900 border-slate-700 w-4 h-4">
                            <span class="ml-2 text-[11px] text-slate-300 font-bold">Ativa no projeto</span>
                        </label>
                    </div>
                    <p class="text-[10px] text-slate-500">Desabilite se os pavimentos possuem quadros e alimentações independentes, sem shaft vertical interligando os andares.</p>
                </div>

                <!-- EXCLUIR PAVIMENTO (SE HOUVER MAIS DE 1) -->
                <div class="pt-2 flex justify-between items-center text-[11px]">
                    <button type="button" onclick="excluirPavimentoAtivo()" class="text-rose-400 hover:text-rose-300 hover:underline flex items-center gap-1">
                        <i class="fa-solid fa-trash-can"></i> Excluir este Pavimento
                    </button>
                    <label class="flex items-center gap-1.5 text-slate-400 cursor-pointer">
                        <input type="checkbox" id="chkAplicarTodosPavimentos" class="rounded text-amber-500 bg-slate-950 border-slate-700">
                        <span>Aplicar a todos os andares</span>
                    </label>
                </div>
            </div>

            <div class="p-4 border-t border-slate-800 flex justify-end gap-2 bg-slate-950/60 text-xs">
                <button onclick="fecharModalConfigPavimento()" class="bg-slate-800 hover:bg-slate-700 text-slate-300 font-semibold px-4 py-2 rounded-xl transition">
                    Cancelar
                </button>
                <button onclick="salvarConfigPavimento()" class="bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold px-4 py-2 rounded-xl transition flex items-center gap-2 shadow-lg shadow-amber-500/20">
                    <i class="fa-solid fa-check"></i> Salvar Alterações
                </button>
            </div>
        </div>
    </div>

    <!-- MODAL DE ACESSO WEB / DISPOSITIVOS EXTERNOS -->
    <div id="modalAcessoWeb" class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 flex items-center justify-center hidden p-4">
        <div class="bg-slate-900 border border-slate-700 rounded-2xl max-w-2xl w-full shadow-2xl overflow-hidden flex flex-col max-h-[92vh]">
            <div class="p-4 border-b border-slate-800 flex justify-between items-center bg-slate-950/60">
                <div class="flex items-center gap-2.5">
                    <span class="w-8 h-8 rounded-lg bg-gradient-to-tr from-blue-600 to-cyan-500 text-white flex items-center justify-center text-sm shadow">
                        <i class="fa-solid fa-globe"></i>
                    </span>
                    <div>
                        <h3 class="text-sm font-bold text-white flex items-center gap-2">
                            <span>Acessar Software de Qualquer Navegador Fora Desta Máquina</span>
                            <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-cyan-500/20 text-cyan-300 border border-cyan-500/40 uppercase">100% Web</span>
                        </h3>
                        <p class="text-[11px] text-slate-400">Abra no celular, tablet, notebook ou envie para clientes em qualquer lugar do mundo</p>
                    </div>
                </div>
                <button onclick="fecharModalAcessoWeb()" class="text-slate-400 hover:text-white p-1.5 rounded-lg hover:bg-slate-800 transition">
                    <i class="fa-solid fa-xmark text-base"></i>
                </button>
            </div>

            <div class="p-5 space-y-4 text-xs overflow-y-auto">
                <!-- MÉTODO 1: NA MESMA REDE (WI-FI / LAN) -->
                <div class="bg-slate-950 p-4 rounded-xl border border-slate-800 space-y-3">
                    <div class="flex items-center justify-between">
                        <span class="font-bold text-cyan-400 text-sm flex items-center gap-2">
                            <i class="fa-solid fa-wifi"></i> Método 1: No mesmo Wi-Fi (Celular, Tablet ou outro PC)
                        </span>
                        <span class="bg-emerald-500/20 text-emerald-300 text-[10px] font-bold px-2 py-0.5 rounded border border-emerald-500/30">
                            Pronto para Usar
                        </span>
                    </div>
                    <p class="text-slate-300 leading-relaxed">
                        Execute o servidor local na pasta do projeto dando 2 cliques no arquivo <strong class="text-amber-400 font-mono">iniciar_servidor.bat</strong>. Em seguida, acesse no navegador do seu smartphone ou de outro computador:
                    </p>
                    <div class="flex flex-col sm:flex-row items-center gap-3 bg-slate-900 p-3 rounded-xl border border-slate-800">
                        <div class="flex-1 w-full">
                            <label class="text-[10px] text-slate-400 uppercase font-bold block mb-1">Endereço de Acesso na Rede Local:</label>
                            <div class="flex items-center gap-2">
                                <input id="txtUrlRedeLocal" type="text" readonly value="http://192.168.15.2:8080" class="w-full bg-slate-950 border border-cyan-500/50 text-cyan-300 font-mono font-bold text-sm rounded-lg p-2 outline-none select-all">
                                <button onclick="copiarUrlRedeLocal()" class="bg-cyan-600 hover:bg-cyan-500 text-white font-bold px-3 py-2 rounded-lg transition whitespace-nowrap flex items-center gap-1.5">
                                    <i class="fa-solid fa-copy"></i> Copiar
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="text-[11px] text-slate-400 flex items-center gap-2">
                        <i class="fa-solid fa-circle-info text-cyan-400"></i>
                        <span>O terminal do servidor exibirá também o endereço pronto e instruções para navegar instantaneamente!</span>
                    </div>
                </div>

                <!-- MÉTODO 2: PELA INTERNET (QUALQUER LUGAR DO MUNDO - 100% GRATUITO) -->
                <div class="bg-slate-950 p-4 rounded-xl border border-slate-800 space-y-3">
                    <div class="flex items-center justify-between">
                        <span class="font-bold text-amber-400 text-sm flex items-center gap-2">
                            <i class="fa-solid fa-cloud-arrow-up"></i> Método 2: Pela Internet (Acesse de Qualquer Lugar do Mundo)
                        </span>
                        <span class="bg-amber-500/20 text-amber-300 text-[10px] font-bold px-2 py-0.5 rounded border border-amber-500/30">
                            Grátis & Permanente 24h
                        </span>
                    </div>
                    <p class="text-slate-300 leading-relaxed">
                        Como este software é um aplicativo Web Client-Side de alta performance (não necessita de banco de dados instalado no servidor), você pode colocá-lo online em 30 segundos em plataformas gratuitas:
                    </p>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <div class="bg-slate-900 p-3 rounded-xl border border-slate-800 space-y-1.5">
                            <span class="font-bold text-white flex items-center gap-2">
                                <i class="fa-solid fa-bolt text-teal-400"></i> Netlify Drop (Mais Fácil - 10 segundos)
                            </span>
                            <p class="text-[11px] text-slate-400">
                                Abra <a href="https://app.netlify.com/drop" target="_blank" class="text-teal-400 underline font-bold">app.netlify.com/drop</a> e simplesmente arraste a pasta deste projeto para lá. Você ganha na hora um link público HTTPS como <em>https://seu-projeto.netlify.app</em> para abrir em qualquer lugar!
                            </p>
                        </div>
                        <div class="bg-slate-900 p-3 rounded-xl border border-slate-800 space-y-1.5">
                            <span class="font-bold text-white flex items-center gap-2">
                                <i class="fa-brands fa-github text-purple-400"></i> GitHub Pages / Vercel
                            </span>
                            <p class="text-[11px] text-slate-400">
                                Crie um repositório no GitHub ou importe na <a href="https://vercel.com" target="_blank" class="text-purple-400 underline font-bold">Vercel</a>. O arquivo <strong class="text-slate-200">index.html</strong> já está preparado na raiz para implantação automática!
                            </p>
                        </div>
                    </div>
                </div>

                <!-- INFORMAÇÃO TÉCNICA -->
                <div class="p-3 bg-slate-900/60 rounded-xl border border-slate-800 text-[11px] text-slate-400 space-y-1">
                    <p><strong class="text-slate-300">Arquivos Gerados na Pasta do Projeto:</strong></p>
                    <p>• <strong class="text-amber-400 font-mono">iniciar_servidor.bat</strong>: Dê 2 cliques para iniciar o servidor web no Windows.</p>
                    <p>• <strong class="text-sky-400 font-mono">servidor_local.py</strong>: Servidor HTTP Python com auto-detecção de IP.</p>
                    <p>• <strong class="text-emerald-400 font-mono">index.html</strong>: Versão web padrão para carregamento universal.</p>
                </div>
            </div>

            <div class="p-4 border-t border-slate-800 flex justify-end bg-slate-950/60 text-xs">
                <button onclick="fecharModalAcessoWeb()" class="bg-slate-800 hover:bg-slate-700 text-slate-300 font-semibold px-4 py-2 rounded-xl transition">
                    Fechar
                </button>
            </div>
        </div>
    </div>

    <!-- MODAL DE EDIÇÃO / INSERÇÃO DE CÔMODO (SOB DEMANDA) -->
    <div id="modalComodo" class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 flex items-center justify-center hidden p-4">
        <div class="bg-slate-900 border border-slate-700 rounded-2xl max-w-xl w-full shadow-2xl overflow-hidden flex flex-col max-h-[92vh]">
            <div class="p-4 border-b border-slate-800 flex justify-between items-center bg-slate-950/60">
                <div class="flex items-center gap-2.5">
                    <span class="w-8 h-8 rounded-lg bg-amber-500/20 text-amber-400 border border-amber-500/40 flex items-center justify-center text-sm">
                        <i class="fa-solid fa-cube"></i>
                    </span>
                    <div>
                        <h3 id="tituloModalComodo" class="text-sm font-bold text-white flex items-center gap-2">
                            <span>Inserir Cômodo</span>
                            <span id="badgeModalEdicao" class="hidden px-2 py-0.5 rounded text-[10px] font-bold bg-amber-500/20 text-amber-300 border border-amber-500/40 uppercase">Modo Edição</span>
                        </h3>
                        <p class="text-[11px] text-slate-400">Configure dimensões, ambiente e cargas elétricas NBR 5410</p>
                    </div>
                </div>
                <button onclick="fecharModalComodo()" class="text-slate-400 hover:text-white p-1.5 rounded-lg hover:bg-slate-800 transition">
                    <i class="fa-solid fa-xmark text-base"></i>
                </button>
            </div>

            <div class="p-5 overflow-y-auto space-y-4 text-xs">
                <form id="formComodo" class="space-y-4">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                        <div>
                            <label class="block font-semibold text-slate-300 uppercase mb-1">Nome do Ambiente</label>
                            <input id="txtNome" type="text" placeholder="Ex: Sala de Estar, Suíte 1" required class="w-full bg-slate-950 border border-slate-800 text-white rounded-xl p-2.5 focus:ring-2 focus:ring-amber-400 outline-none">
                        </div>
                        <div>
                            <label class="block font-semibold text-slate-300 uppercase mb-1">Tipo de Ambiente</label>
                            <select id="selTipo" class="w-full bg-slate-950 border border-slate-800 text-white rounded-xl p-2.5 focus:ring-2 focus:ring-amber-400 outline-none">
                                <option value="geral">Geral (Quarto, Sala, Circulação)</option>
                                <option value="servico">Serviço (Cozinha, Banheiro, A. Serviço)</option>
                            </select>
                        </div>
                    </div>

                    <!-- PAVIMENTO ASSOCIADO E DIMENSÕES -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                        <div>
                            <label class="block font-semibold text-slate-300 uppercase mb-1">Pavimento Destino</label>
                            <select id="selComodoPavimento" class="w-full bg-slate-950 border border-slate-800 text-white rounded-xl p-2.5 focus:ring-2 focus:ring-amber-400 outline-none">
                                <!-- Preenchido dinamicamente -->
                            </select>
                        </div>

                        <!-- CAMPOS DINÂMICOS CONFORME O MODO -->
                        <div id="painelDimensionamentoCad" class="grid grid-cols-2 gap-2">
                            <div>
                                <label class="block font-semibold text-slate-300 uppercase mb-1 text-xs">Largura (m)</label>
                                <input id="numLargura" type="number" step="0.05" min="0.2" value="4.0" class="w-full bg-slate-950 border border-slate-800 text-white rounded-xl p-2.5 focus:ring-2 focus:ring-amber-400 outline-none font-mono font-bold text-sm">
                            </div>
                            <div>
                                <label class="block font-semibold text-slate-300 uppercase mb-1 text-xs">Comprimento (m)</label>
                                <input id="numComprimento" type="number" step="0.05" min="0.2" value="4.0" class="w-full bg-slate-950 border border-slate-800 text-white rounded-xl p-2.5 focus:ring-2 focus:ring-amber-400 outline-none font-mono font-bold text-sm">
                            </div>
                            <!-- ATALHOS PARA CÔMODOS MENORES QUE 0.90M E ESPAÇOS COMPACTOS -->
                            <div class="col-span-2 pt-1">
                                <span class="text-[10px] text-slate-400 font-semibold block mb-1">📐 Medidas Compactas (< 0,90m e nichos):</span>
                                <div class="flex flex-wrap gap-1.5 text-[10px]">
                                    <button type="button" onclick="aplicarDimensoesComodo(0.80, 1.20, 'Lavabo')" class="px-2 py-0.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700 transition">🚿 Lavabo 0.80×1.20m</button>
                                    <button type="button" onclick="aplicarDimensoesComodo(0.70, 0.90, 'Despensa')" class="px-2 py-0.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700 transition">📦 Despensa 0.70×0.90m</button>
                                    <button type="button" onclick="aplicarDimensoesComodo(0.40, 0.50, 'Shaft Elétrico')" class="px-2 py-0.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700 transition">⚡ Shaft 0.40×0.50m</button>
                                    <button type="button" onclick="aplicarDimensoesComodo(0.80, 2.50, 'Corredor')" class="px-2 py-0.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700 transition">🚪 Corredor 0.80×2.50m</button>
                                    <button type="button" onclick="aplicarDimensoesComodo(0.60, 0.80, 'Depósito')" class="px-2 py-0.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700 transition">🗄️ Depósito 0.60×0.80m</button>
                                </div>
                            </div>
                        </div>

                        <div id="painelDimensionamentoManual" class="grid grid-cols-2 gap-2 hidden">
                            <div>
                                <label class="block font-semibold text-amber-400 uppercase mb-1 text-xs">Área Direta (m²)</label>
                                <input id="numAreaManual" type="number" step="0.05" min="0.1" placeholder="Ex: 16.0" class="w-full bg-slate-950 border border-amber-500/50 text-white rounded-xl p-2.5 focus:ring-2 focus:ring-amber-400 outline-none">
                            </div>
                            <div>
                                <label class="block font-semibold text-amber-400 uppercase mb-1 text-xs">Perímetro (m)</label>
                                <input id="numPerimManual" type="number" step="0.05" min="0.5" placeholder="Ex: 16.0" class="w-full bg-slate-950 border border-amber-500/50 text-white rounded-xl p-2.5 focus:ring-2 focus:ring-amber-400 outline-none">
                            </div>
                        </div>
                    </div>

                    <!-- ESPESSURA DA PAREDE CONFORME NORMAS TÉCNICAS (NBR 15575 / NBR 15270 / NBR 16868) -->
                    <div class="bg-slate-950 p-3 rounded-xl border border-slate-800 space-y-2">
                        <div class="flex items-center justify-between">
                            <label class="block font-bold text-sky-400 uppercase text-[11px] flex items-center gap-1.5">
                                <i class="fa-solid fa-border-all"></i> Espessura da Parede deste Cômodo (Norma NBR)
                            </label>
                            <span class="text-[10px] text-emerald-400 font-mono font-bold" id="lblEspessuraComodoPreview">15 cm (Padrão)</span>
                        </div>
                        <select id="selEspessuraParedeComodo" onchange="atualizarPreviewEspessuraComodo(this.value)" class="w-full bg-slate-900 border border-slate-700 text-white rounded-xl p-2.5 text-xs focus:ring-2 focus:ring-sky-400 outline-none">
                            <option value="padrao">🌐 Usar Padrão do Projeto (NBR 15575 - 15 cm)</option>
                            <option value="0.15">🧱 0,15 m (15 cm) - Padrão NBR 15575 / NBR 15270 (Alvenaria convencional rebocada)</option>
                            <option value="0.14">🧱 0,14 m (14 cm) - Bloco com acabamento em gesso liso interno</option>
                            <option value="0.10">🪶 0,10 m (10 cm) - Parede Leve / Drywall Gesso Acartonado (NBR 15758)</option>
                            <option value="0.12">🧱 0,12 m (12 cm) - Alvenaria interna simples / tijolo estreito</option>
                            <option value="0.20">🛡️ 0,20 m (20 cm) - Parede externa / Fachada / Termoacústica (NBR 15575)</option>
                            <option value="0.25">🏢 0,25 m (25 cm) - Parede dupla geminada / bloco acústico estrutural (NBR 16868)</option>
                        </select>
                        <p class="text-[10px] text-slate-400 italic">Define a espessura física das paredes deste ambiente no CAD 2D e na extrusão 3D BIM.</p>
                    </div>

                    <!-- PASSAGEM DE CABOS DE TOMADAS NO CÔMODO (NOVO CONTROLE NBR 5410) -->
                    <div class="bg-slate-950 p-3 rounded-xl border border-slate-800 space-y-1.5">
                        <div class="flex items-center justify-between">
                            <label class="block font-bold text-amber-400 uppercase text-[11px] flex items-center gap-1.5">
                                <i class="fa-solid fa-arrows-left-right"></i> Passagem de Cabos das Tomadas (TUG)
                            </label>
                            <span class="text-[10px] text-slate-400 font-mono">Mais de 1 tomada</span>
                        </div>
                        <select id="selPassagemTomadasComodo" class="w-full bg-slate-900 border border-slate-700 text-white rounded-xl p-2.5 text-xs focus:ring-2 focus:ring-amber-400 outline-none">
                            <option value="horizontal">↔️ Horizontal nas Paredes (Tomada a Tomada / Encadeada - Padrão NBR 5410)</option>
                            <option value="radial">⬆️ Radial pelo Teto (Cada tomada sobe individualmente até a caixa do teto)</option>
                        </select>
                        <p class="text-[10px] text-slate-400 italic">No modo horizontal, o eletroduto corre na alvenaria ligando uma tomada à outra, economizando tubulação e fios.</p>
                    </div>

                    <!-- SEÇÃO DE CARGAS INDIVIDUAIS (TUG e TUE) -->
                    <div class="pt-3 border-t border-slate-800 space-y-2.5">
                        <div class="flex items-center justify-between">
                            <label class="font-bold text-sky-400 uppercase text-[11px] flex items-center gap-1.5">
                                <i class="fa-solid fa-bolt"></i> Cargas Iniciais do Cômodo
                            </label>
                            <span class="text-[10px] text-slate-400 font-mono">TUG & TUE NBR 5410</span>
                        </div>

                        <!-- SUGESTÕES RÁPIDAS -->
                        <div>
                            <label class="block text-[10px] font-semibold text-amber-400/90 mb-1 flex items-center gap-1">
                                <i class="fa-solid fa-lightbulb"></i> Sugestões Mercado BR:
                            </label>
                            <select id="selSugestaoBR" class="w-full bg-slate-950 border border-amber-500/40 text-amber-300 rounded-xl p-2 text-xs focus:ring-2 focus:ring-amber-400 outline-none">
                                <option value="">-- Escolha um equipamento sugerido --</option>
                            </select>
                        </div>

                        <!-- CAMPOS DA CARGA -->
                        <div class="bg-slate-950/80 p-2.5 rounded-xl border border-slate-800 space-y-2">
                            <div>
                                <input id="txtCargaNome" type="text" placeholder="Nome do Equipamento (Ex: Ar Condicionado, Chuveiro)" class="w-full bg-slate-900 border border-slate-800 text-white rounded-lg p-2 text-xs focus:ring-1 focus:ring-sky-400 outline-none">
                            </div>
                            <div class="grid grid-cols-3 gap-1.5">
                                <select id="selCargaTipo" class="bg-slate-900 border border-slate-800 text-slate-200 rounded-lg p-2 text-xs focus:ring-1 focus:ring-sky-400 outline-none">
                                    <option value="TUE">TUE (Específico)</option>
                                    <option value="TUG">TUG (Uso Geral)</option>
                                </select>
                                <input id="numCargaPot" type="number" step="10" placeholder="Watts (W)" class="bg-slate-900 border border-slate-800 text-white rounded-lg p-2 text-xs focus:ring-1 focus:ring-sky-400 outline-none font-mono">
                                <select id="selCargaTensao" class="bg-slate-900 border border-slate-800 text-slate-200 rounded-lg p-2 text-xs focus:ring-1 focus:ring-sky-400 outline-none">
                                    <option value="220">220 V</option>
                                    <option value="127">127 V</option>
                                </select>
                            </div>
                            <button type="button" id="btnAdicionarCarga" class="w-full bg-slate-800 hover:bg-slate-700 text-sky-400 hover:text-sky-300 font-bold py-1.5 px-3 rounded-lg border border-slate-700 transition flex items-center justify-center gap-1.5 text-xs">
                                <i class="fa-solid fa-plus text-xs"></i> Adicionar Carga ao Cômodo
                            </button>
                        </div>

                        <!-- LISTA DE CARGAS -->
                        <div class="space-y-1">
                            <span class="text-[10px] text-slate-400 font-semibold block">Cargas do Cômodo:</span>
                            <div id="listaCargasComodo" class="space-y-1.5 max-h-28 overflow-y-auto pr-1"></div>
                        </div>
                    </div>

                    <!-- BOTÕES -->
                    <div class="pt-3 border-t border-slate-800 flex justify-end gap-2">
                        <button type="button" onclick="fecharModalComodo()" class="bg-slate-800 hover:bg-slate-700 text-slate-300 font-bold py-2 px-4 rounded-xl transition text-xs">
                            Cancelar
                        </button>
                        <button type="submit" id="btnSubmitComodo" class="bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold py-2 px-5 rounded-xl transition flex justify-center items-center gap-2 shadow-lg shadow-amber-500/20 text-xs">
                            <i class="fa-solid fa-check"></i> Salvar Cômodo
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- MODAL DE IMPORTAÇÃO BIM & AUTOCAD -->
    <div id="modalImportarProjeto" class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 flex items-center justify-center hidden p-4">
        <div class="bg-slate-900 border border-slate-700 rounded-2xl max-w-2xl w-full shadow-2xl overflow-hidden flex flex-col max-h-[92vh]">
            <div class="p-4 border-b border-slate-800 flex justify-between items-center bg-slate-950/60">
                <div class="flex items-center gap-2.5">
                    <span class="w-8 h-8 rounded-lg bg-indigo-500/20 text-indigo-400 border border-indigo-500/40 flex items-center justify-center text-sm">
                        <i class="fa-solid fa-file-import"></i>
                    </span>
                    <div>
                        <h3 class="text-sm font-bold text-white flex items-center gap-2">
                            <span>Importar Projetos BIM & AutoCAD</span>
                            <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-indigo-500/20 text-indigo-300 border border-indigo-500/40 uppercase">DXF • IFC • DWG • 3D</span>
                        </h3>
                        <p class="text-[11px] text-slate-400">Carregue plantas baixas ou maquetes BIM para geração automática de cômodos e infraestrutura</p>
                    </div>
                </div>
                <button onclick="fecharModalImportar()" class="text-slate-400 hover:text-white p-1.5 rounded-lg hover:bg-slate-800 transition">
                    <i class="fa-solid fa-xmark text-base"></i>
                </button>
            </div>

            <div class="p-5 overflow-y-auto space-y-4 text-xs">
                <!-- SELEÇÃO DE TIPO DE IMPORTAÇÃO -->
                <div class="grid grid-cols-2 gap-2 bg-slate-950 p-1 rounded-xl border border-slate-800">
                    <button id="btnTabImportCad" onclick="selecionarAbaImport('cad')" class="py-2 px-3 rounded-lg font-bold text-xs transition bg-indigo-600 text-white flex items-center justify-center gap-2">
                        <i class="fa-solid fa-drafting-compass"></i> AutoCAD (.DXF / .DWG)
                    </button>
                    <button id="btnTabImportBim" onclick="selecionarAbaImport('bim')" class="py-2 px-3 rounded-lg font-bold text-xs transition text-slate-400 hover:text-white flex items-center justify-center gap-2">
                        <i class="fa-solid fa-cube"></i> BIM (.IFC / .OBJ / .JSON)
                    </button>
                </div>

                <!-- DROPZONE DE ARQUIVO -->
                <div id="dropzoneArquivo" onclick="document.getElementById('inputArquivoImport').click()" class="border-2 border-dashed border-indigo-500/40 hover:border-indigo-400 bg-slate-950/60 hover:bg-slate-950 p-6 rounded-2xl text-center cursor-pointer transition flex flex-col items-center justify-center gap-2 group">
                    <input type="file" id="inputArquivoImport" class="hidden" accept=".dxf,.dwg,.ifc,.obj,.json,.txt" onchange="arquivoSelecionadoHandler(event)">
                    <div class="w-12 h-12 rounded-2xl bg-indigo-500/20 text-indigo-400 flex items-center justify-center text-2xl group-hover:scale-110 transition">
                        <i class="fa-solid fa-cloud-arrow-up"></i>
                    </div>
                    <div>
                        <span class="font-bold text-white text-xs block">Clique para selecionar ou arraste seu arquivo</span>
                        <span class="text-[11px] text-slate-400" id="lblExtensoesPermitidas">Formatos suportados: .DXF, .DWG, .IFC, .OBJ, .JSON</span>
                    </div>
                    <span id="lblArquivoSelecionado" class="text-xs font-mono text-emerald-400 font-bold hidden"></span>
                </div>

                <!-- OPÇÕES DE PROCESSAMENTO -->
                <div class="bg-slate-950 p-3.5 rounded-xl border border-slate-800 space-y-2.5">
                    <span class="font-bold text-slate-300 uppercase text-[10px] tracking-wider block">Opções de Extração Inteligente:</span>
                    <label class="flex items-center gap-2 text-slate-300 cursor-pointer">
                        <input type="checkbox" id="chkExtrairComodos" checked class="rounded text-indigo-500 bg-slate-900 border-slate-700">
                        <span>Reconhecer textos de ambientes e contornos fechados como Cômodos Editáveis</span>
                    </label>
                    <label class="flex items-center gap-2 text-slate-300 cursor-pointer">
                        <input type="checkbox" id="chkProjetarUnderlay" checked class="rounded text-indigo-500 bg-slate-900 border-slate-700">
                        <span>Projetar traçado arquitetônico original como Camada Vetorial de Fundo (Underlay CAD)</span>
                    </label>
                    <div class="grid grid-cols-2 gap-2 pt-1 border-t border-slate-800/80">
                        <div>
                            <label class="block text-slate-400 mb-1">Destino da Importação:</label>
                            <select id="selDestinoImport" class="w-full bg-slate-900 border border-slate-700 text-white rounded-lg p-2 text-xs outline-none">
                                <option value="ativo">No Pavimento Ativo</option>
                                <option value="novo">Criar Pavimentos Conforme Arquivo</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-slate-400 mb-1">Escala da Planta:</label>
                            <select id="selEscalaImport" class="w-full bg-slate-900 border border-slate-700 text-white rounded-lg p-2 text-xs outline-none">
                                <option value="1">1:1 (Metros)</option>
                                <option value="0.01">1:100 (Centímetros)</option>
                                <option value="0.001">1:1000 (Milímetros)</option>
                            </select>
                        </div>
                    </div>
                </div>

                <!-- EXEMPLOS PRONTOS COM 1 CLIQUE -->
                <div class="bg-indigo-950/30 border border-indigo-500/30 p-3 rounded-xl space-y-2">
                    <div class="flex items-center justify-between">
                        <span class="text-[11px] font-bold text-indigo-300 flex items-center gap-1.5">
                            <i class="fa-solid fa-wand-magic-sparkles"></i> Testar Imediatamente (Modelos Demonstrativos):
                        </span>
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                        <button type="button" onclick="carregarExemploDxf()" class="bg-slate-900 hover:bg-slate-800 border border-indigo-500/40 p-2.5 rounded-xl text-left transition flex items-center gap-2.5 group">
                            <i class="fa-solid fa-drafting-compass text-indigo-400 text-lg group-hover:scale-110 transition"></i>
                            <div>
                                <span class="font-bold text-white text-xs block">Exemplo AutoCAD (.DXF)</span>
                                <span class="text-[10px] text-slate-400">Planta baixa residencial completa</span>
                            </div>
                        </button>
                        <button type="button" onclick="carregarExemploIfc()" class="bg-slate-900 hover:bg-slate-800 border border-emerald-500/40 p-2.5 rounded-xl text-left transition flex items-center gap-2.5 group">
                            <i class="fa-solid fa-cube text-emerald-400 text-lg group-hover:scale-110 transition"></i>
                            <div>
                                <span class="font-bold text-white text-xs block">Exemplo BIM (.IFC)</span>
                                <span class="text-[10px] text-slate-400">Edificação 2 pavimentos (IfcSpace)</span>
                            </div>
                        </button>
                    </div>
                </div>

                <!-- DICA DWG -->
                <div class="p-2.5 bg-slate-950 rounded-xl border border-slate-800 text-[11px] text-slate-400 flex items-start gap-2">
                    <i class="fa-solid fa-circle-info text-sky-400 text-sm mt-0.5"></i>
                    <span><strong>Arquivos .DWG:</strong> Para máxima fidelidade gráfica no navegador, salve seu arquivo como <strong>AutoCAD DXF (.dxf)</strong> no AutoCAD ou DWG TrueView gratuito. O parser processa DXF nativamente com precisão milimétrica.</span>
                </div>

                <!-- BOTÕES -->
                <div class="pt-2 border-t border-slate-800 flex justify-end gap-2">
                    <button type="button" onclick="fecharModalImportar()" class="bg-slate-800 hover:bg-slate-700 text-slate-300 font-bold py-2 px-4 rounded-xl transition text-xs">
                        Fechar
                    </button>
                    <button type="button" id="btnProcessarImport" onclick="processarArquivoImportado()" class="bg-indigo-600 hover:bg-indigo-500 text-white font-bold py-2 px-5 rounded-xl transition flex items-center gap-2 shadow-lg shadow-indigo-600/20 text-xs">
                        <i class="fa-solid fa-check"></i> Processar & Importar
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- MODAL DE CONFIGURAÇÃO DE REGIME DE IMÓVEIS & MEDIÇÕES (NBR 5410) -->
    <div id="modalConfigImoveis" class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 flex items-center justify-center hidden p-4">
        <div class="bg-slate-900 border border-slate-700 rounded-2xl max-w-2xl w-full shadow-2xl overflow-hidden flex flex-col max-h-[92vh]">
            <div class="p-4 border-b border-slate-800 flex justify-between items-center bg-slate-950/60">
                <div class="flex items-center gap-2.5">
                    <span class="w-8 h-8 rounded-lg bg-amber-500/20 text-amber-400 border border-amber-500/40 flex items-center justify-center text-sm">
                        <i class="fa-solid fa-building-user"></i>
                    </span>
                    <div>
                        <h3 class="text-sm font-bold text-white flex items-center gap-2">
                            <span>Regime de Pavimentos & Unidades Consumidoras</span>
                        </h3>
                        <p class="text-[11px] text-slate-400">Mesmo Imóvel (Unifamiliar) vs Imóveis Separados (Multifamiliar com Medições Individuais)</p>
                    </div>
                </div>
                <button onclick="fecharModalConfigImoveis()" class="text-slate-400 hover:text-white p-1.5 rounded-lg hover:bg-slate-800 transition">
                    <i class="fa-solid fa-xmark text-base"></i>
                </button>
            </div>

            <div class="p-5 overflow-y-auto space-y-4 text-xs">
                <!-- SELETOR PRINCIPAL DE REGIME -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                    <div onclick="selecionarRegimeModal('mesmo_imovel')" id="cardRegimeMesmo" class="border-2 border-amber-500 bg-slate-950 p-3.5 rounded-xl cursor-pointer transition space-y-1">
                        <div class="flex items-center justify-between">
                            <span class="font-bold text-white text-xs flex items-center gap-1.5">
                                <i class="fa-solid fa-house text-amber-400"></i> Mesmo Imóvel (Unifamiliar)
                            </span>
                            <span id="chkBadgeMesmo" class="w-4 h-4 rounded-full bg-amber-500 flex items-center justify-center text-[10px] text-slate-950 font-bold"><i class="fa-solid fa-check"></i></span>
                        </div>
                        <p class="text-[11px] text-slate-400">Sobrado ou residência única. Ramal de entrada unificado, QDT principal no térreo e QDT parcial nos andares superiores via prumada.</p>
                    </div>

                    <div onclick="selecionarRegimeModal('imoveis_separados')" id="cardRegimeSeparados" class="border-2 border-slate-800 bg-slate-950 p-3.5 rounded-xl cursor-pointer transition space-y-1">
                        <div class="flex items-center justify-between">
                            <span class="font-bold text-white text-xs flex items-center gap-1.5">
                                <i class="fa-solid fa-building-circle-check text-sky-400"></i> Imóveis Separados (Multifamiliar)
                            </span>
                            <span id="chkBadgeSeparados" class="w-4 h-4 rounded-full bg-slate-800 flex items-center justify-center text-[10px] text-slate-400"><i class="fa-solid fa-check"></i></span>
                        </div>
                        <p class="text-[11px] text-slate-400">Casas geminadas, kitnets ou apartamentos. Cada unidade possui medição individual e QDT independente, agrupados em Centro de Medição.</p>
                    </div>
                </div>

                <!-- CONFIGURAÇÃO DETALHADA DAS UNIDADES CONSUMIDORAS (QUANDO REGIME SEPARADO) -->
                <div id="painelDetalheImoveisSeparados" class="space-y-3">
                    <div class="flex items-center justify-between">
                        <span class="font-bold text-white uppercase text-[11px] flex items-center gap-1.5">
                            <i class="fa-solid fa-list-check text-sky-400"></i> Unidades Consumidoras / Imóveis Cadastrados:
                        </span>
                        <button onclick="adicionarNovaUnidadeImovel()" class="bg-slate-800 hover:bg-slate-700 text-sky-400 font-bold px-3 py-1.5 rounded-lg border border-slate-700 text-xs transition flex items-center gap-1">
                            <i class="fa-solid fa-plus"></i> Nova Unidade
                        </button>
                    </div>

                    <div id="listaUnidadesImoveis" class="space-y-2 max-h-60 overflow-y-auto pr-1">
                        <!-- Injetado dinamicamente -->
                    </div>

                    <div class="bg-slate-950 p-3 rounded-xl border border-slate-800 space-y-2 text-[11px]">
                        <span class="font-bold text-amber-400 uppercase text-[10px] block">Vínculo dos Pavimentos às Unidades:</span>
                        <div id="listaVinculoPavimentosImoveis" class="space-y-1.5">
                            <!-- Injetado dinamicamente -->
                        </div>
                    </div>
                </div>

                <!-- BOTÕES -->
                <div class="pt-2 border-t border-slate-800 flex justify-end gap-2">
                    <button type="button" onclick="fecharModalConfigImoveis()" class="bg-slate-800 hover:bg-slate-700 text-slate-300 font-bold py-2 px-4 rounded-xl transition text-xs">
                        Fechar
                    </button>
                    <button type="button" onclick="salvarConfigImoveis()" class="bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold py-2 px-5 rounded-xl transition flex items-center gap-2 shadow-lg shadow-amber-500/20 text-xs">
                        <i class="fa-solid fa-check"></i> Salvar Configuração
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- MODAL DE TRANSIÇÃO (PORTA / CORREDOR / VÃO LIVRE) -->
    <div id="modalTransicao" class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 flex items-center justify-center hidden">
        <div class="bg-slate-900 border border-slate-700 rounded-2xl p-6 max-w-md w-full mx-4 shadow-2xl space-y-4">
            <div class="flex justify-between items-center border-b border-slate-800 pb-3">
                <h3 class="text-sm font-bold text-amber-400 flex items-center gap-2">
                    <i class="fa-solid fa-arrows-split-up-and-left"></i> Conexão entre Cômodos Detectada
                </h3>
                <button onclick="fecharModalTransicao()" class="text-slate-400 hover:text-white p-1"><i class="fa-solid fa-xmark"></i></button>
            </div>
            <div>
                <p class="text-xs text-slate-300" id="txtDescricaoTransicao">Cômodos próximos detectados. Defina a transição:</p>
            </div>
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 pt-1">
                <button onclick="definirTipoTransicaoAtiva('porta')" class="bg-slate-950 hover:bg-slate-800 border border-amber-500/40 hover:border-amber-400 p-3 rounded-xl text-center flex flex-col items-center gap-1.5 transition group">
                    <i class="fa-solid fa-door-open text-amber-400 text-xl group-hover:scale-110 transition"></i>
                    <span class="font-bold text-xs text-white">Porta</span>
                    <span class="text-[9px] text-slate-400">Giro 90°</span>
                </button>
                <button onclick="definirTipoTransicaoAtiva('corredor')" class="bg-slate-950 hover:bg-slate-800 border border-sky-500/40 hover:border-sky-400 p-3 rounded-xl text-center flex flex-col items-center gap-1.5 transition group">
                    <i class="fa-solid fa-route text-sky-400 text-xl group-hover:scale-110 transition"></i>
                    <span class="font-bold text-xs text-white">Corredor</span>
                    <span class="text-[9px] text-slate-400">Circulação</span>
                </button>
                <button onclick="definirTipoTransicaoAtiva('vao_livre')" class="bg-slate-950 hover:bg-slate-800 border border-emerald-500/40 hover:border-emerald-400 p-3 rounded-xl text-center flex flex-col items-center gap-1.5 transition group">
                    <i class="fa-solid fa-border-none text-emerald-400 text-xl group-hover:scale-110 transition"></i>
                    <span class="font-bold text-xs text-white">Vão Livre</span>
                    <span class="text-[9px] text-slate-400">Passagem aberta</span>
                </button>
                <button onclick="definirTipoTransicaoAtiva('parede')" class="bg-slate-950 hover:bg-slate-800 border border-slate-600/70 hover:border-amber-400 p-3 rounded-xl text-center flex flex-col items-center gap-1.5 transition group">
                    <i class="fa-solid fa-cubes-stacked text-amber-400 text-xl group-hover:scale-110 transition"></i>
                    <span class="font-bold text-xs text-white">Parede</span>
                    <span class="text-[9px] text-slate-400">Alvenaria Fechada</span>
                </button>
            </div>
            <div class="pt-2 border-t border-slate-800 flex justify-end">
                <button onclick="fecharModalTransicao()" class="bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-semibold px-4 py-2 rounded-xl transition">
                    Fechar
                </button>
            </div>
        </div>
    </div>

    <!-- MODAL DE INSERÇÃO RÁPIDA NO DUPLO CLIQUE (NOVA INTERAÇÃO NBR 5410) -->
    <div id="modalAdicionarPontoRapido" class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 flex items-center justify-center hidden p-4">
        <div class="bg-slate-900 border border-slate-700 rounded-2xl max-w-lg w-full shadow-2xl overflow-hidden flex flex-col">
            <div class="p-4 border-b border-slate-800 flex justify-between items-center bg-slate-950/60">
                <div class="flex items-center gap-2.5">
                    <span class="w-8 h-8 rounded-lg bg-amber-500/20 text-amber-400 border border-amber-500/40 flex items-center justify-center text-sm">
                        <i class="fa-solid fa-bolt-lightning"></i>
                    </span>
                    <div>
                        <h3 class="text-sm font-bold text-white flex items-center gap-2">
                            <span>Adicionar Ponto Elétrico</span>
                            <span id="badgeComodoAlvoRapido" class="px-2 py-0.5 rounded text-[10px] font-bold bg-sky-500/20 text-sky-300 border border-sky-500/40">Sala</span>
                        </h3>
                        <p class="text-[11px] text-slate-400">Selecione o elemento para inserir no local exato do duplo clique</p>
                    </div>
                </div>
                <button onclick="fecharModalAdicionarPontoRapido()" class="text-slate-400 hover:text-white p-1.5 rounded-lg hover:bg-slate-800 transition">
                    <i class="fa-solid fa-xmark text-base"></i>
                </button>
            </div>

            <div class="p-5 space-y-4 text-xs">
                <!-- GRID COM OS 4 TIPOS PRINCIPAIS -->
                <div class="grid grid-cols-2 gap-3">
                    <!-- 1. TUG -->
                    <div class="bg-slate-950 p-3 rounded-xl border border-emerald-500/40 hover:border-emerald-400 transition space-y-2">
                        <div class="flex items-center justify-between">
                            <span class="font-black text-emerald-400 flex items-center gap-1.5 text-xs">
                                <i class="fa-solid fa-plug"></i> TUG (Uso Geral)
                            </span>
                            <span class="text-[9px] bg-emerald-500/20 text-emerald-300 px-1.5 py-0.5 rounded font-mono">127V/220V</span>
                        </div>
                        <p class="text-[10px] text-slate-400 leading-tight">Tomadas para eletrodomésticos, TV, abajur, carregadores</p>
                        <div class="grid grid-cols-2 gap-1.5 pt-1">
                            <button onclick="inserirPontoRapido('TUG', 100, 127, 'baixa', 'TUG 100W Baixa (0.30m)')" class="bg-emerald-700 hover:bg-emerald-600 text-white font-bold py-1.5 px-2 rounded-lg text-[10px] transition text-center">
                                + 100W Baixa
                            </button>
                            <button onclick="inserirPontoRapido('TUG', 600, 127, 'media', 'TUG 600W Média (1.20m)')" class="bg-emerald-800 hover:bg-emerald-700 text-white font-bold py-1.5 px-2 rounded-lg text-[10px] transition text-center">
                                + 600W Média
                            </button>
                        </div>
                    </div>

                    <!-- 2. TUE -->
                    <div class="bg-slate-950 p-3 rounded-xl border border-blue-500/40 hover:border-blue-400 transition space-y-2">
                        <div class="flex items-center justify-between">
                            <span class="font-black text-blue-400 flex items-center gap-1.5 text-xs">
                                <i class="fa-solid fa-bolt"></i> TUE (Específica)
                            </span>
                            <span class="text-[9px] bg-blue-500/20 text-blue-300 px-1.5 py-0.5 rounded font-mono">220V</span>
                        </div>
                        <p class="text-[10px] text-slate-400 leading-tight">Cargas dedicadas exclusivas: Ar-condicionado, chuveiro, forno</p>
                        <div class="grid grid-cols-2 gap-1.5 pt-1">
                            <button onclick="inserirPontoRapido('TUE', 1500, 220, 'alta', 'Ar Condicionado 1500W')" class="bg-blue-700 hover:bg-blue-600 text-white font-bold py-1.5 px-2 rounded-lg text-[10px] transition text-center">
                                + Ar (1500W)
                            </button>
                            <button onclick="inserirPontoRapido('TUE', 5500, 220, 'alta', 'Chuveiro 5500W')" class="bg-blue-800 hover:bg-blue-700 text-white font-bold py-1.5 px-2 rounded-lg text-[10px] transition text-center">
                                + Chuveiro
                            </button>
                        </div>
                    </div>

                    <!-- 3. LÂMPADA -->
                    <div class="bg-slate-950 p-3 rounded-xl border border-amber-500/40 hover:border-amber-400 transition space-y-2">
                        <div class="flex items-center justify-between">
                            <span class="font-black text-amber-400 flex items-center gap-1.5 text-xs">
                                <i class="fa-solid fa-lightbulb"></i> Lâmpada (Teto)
                            </span>
                            <span class="text-[9px] bg-amber-500/20 text-amber-300 px-1.5 py-0.5 rounded font-mono">127V</span>
                        </div>
                        <p class="text-[10px] text-slate-400 leading-tight">Ponto de iluminação central ou adicional no forro</p>
                        <div class="grid grid-cols-2 gap-1.5 pt-1">
                            <button onclick="inserirPontoRapido('ILUM', 100, 127, 'teto', 'Lâmpada 100VA')" class="bg-amber-600 hover:bg-amber-500 text-slate-950 font-bold py-1.5 px-2 rounded-lg text-[10px] transition text-center">
                                + Luz 100VA
                            </button>
                            <button onclick="inserirPontoRapido('ILUM', 60, 127, 'teto', 'Lâmpada 60VA')" class="bg-amber-700 hover:bg-amber-600 text-white font-bold py-1.5 px-2 rounded-lg text-[10px] transition text-center">
                                + Luz 60VA
                            </button>
                        </div>
                    </div>

                    <!-- 4. RETORNO & INTERRUPTOR -->
                    <div class="bg-slate-950 p-3 rounded-xl border border-purple-500/40 hover:border-purple-400 transition space-y-2">
                        <div class="flex items-center justify-between">
                            <span class="font-black text-purple-400 flex items-center gap-1.5 text-xs">
                                <i class="fa-solid fa-toggle-on"></i> Interruptor & Retorno
                            </span>
                            <span class="text-[9px] bg-purple-500/20 text-purple-300 px-1.5 py-0.5 rounded font-mono">Fase+Ret</span>
                        </div>
                        <p class="text-[10px] text-slate-400 leading-tight">Interruptor de parede conectado por retorno à lâmpada</p>
                        <div class="grid grid-cols-2 gap-1.5 pt-1">
                            <button onclick="inserirPontoRapido('INTERRUPTOR', 0, 127, 'media', 'Interruptor Simples c/ Retorno')" class="bg-purple-700 hover:bg-purple-600 text-white font-bold py-1.5 px-2 rounded-lg text-[10px] transition text-center">
                                + Interr. Simples
                            </button>
                            <button onclick="inserirPontoRapido('INTERRUPTOR', 0, 127, 'media', 'Interruptor Paralelo Three-Way')" class="bg-purple-800 hover:bg-purple-700 text-white font-bold py-1.5 px-2 rounded-lg text-[10px] transition text-center">
                                + Three-Way
                            </button>
                        </div>
                    </div>
                </div>

                <!-- 5. ESCADA ARQUITETÔNICA (INTERLIGAÇÃO COM O PAVIMENTO SUPERIOR) -->
                <div class="bg-slate-950 p-3.5 rounded-xl border border-violet-500/50 hover:border-violet-400 transition space-y-2.5 bg-gradient-to-r from-violet-950/40 via-slate-950 to-slate-950">
                    <div class="flex items-center justify-between">
                        <span class="font-black text-violet-300 flex items-center gap-2 text-xs">
                            <i class="fa-solid fa-stairs text-violet-400 text-sm"></i> Escada de Acesso ao 1º Pavimento
                        </span>
                        <span class="text-[9px] bg-violet-500/20 text-violet-300 border border-violet-500/40 px-2 py-0.5 rounded-full font-bold">Une Térreo ➔ 1º Pav.</span>
                    </div>
                    <p class="text-[10px] text-slate-400 leading-tight">
                        Adiciona escada técnica no ponto exato do cômodo, interligando ao 1º Pavimento com vão na laje e corrimão 3D.
                    </p>
                    <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 pt-1">
                        <button type="button" onclick="inserirEscadaRapida('H_DIR')" class="bg-violet-900/80 hover:bg-violet-700 text-white font-bold py-2 px-2 rounded-lg text-[10px] transition text-center flex flex-col items-center gap-1 border border-violet-500/30">
                            <i class="fa-solid fa-arrow-right text-xs text-violet-300"></i>
                            <span>Sobe Direita</span>
                        </button>
                        <button type="button" onclick="inserirEscadaRapida('H_ESQ')" class="bg-violet-900/80 hover:bg-violet-700 text-white font-bold py-2 px-2 rounded-lg text-[10px] transition text-center flex flex-col items-center gap-1 border border-violet-500/30">
                            <i class="fa-solid fa-arrow-left text-xs text-violet-300"></i>
                            <span>Sobe Esquerda</span>
                        </button>
                        <button type="button" onclick="inserirEscadaRapida('V_CIMA')" class="bg-violet-900/80 hover:bg-violet-700 text-white font-bold py-2 px-2 rounded-lg text-[10px] transition text-center flex flex-col items-center gap-1 border border-violet-500/30">
                            <i class="fa-solid fa-arrow-up text-xs text-violet-300"></i>
                            <span>Sobe p/ Cima</span>
                        </button>
                        <button type="button" onclick="inserirEscadaRapida('V_BAIXO')" class="bg-violet-900/80 hover:bg-violet-700 text-white font-bold py-2 px-2 rounded-lg text-[10px] transition text-center flex flex-col items-center gap-1 border border-violet-500/30">
                            <i class="fa-solid fa-arrow-down text-xs text-violet-300"></i>
                            <span>Sobe p/ Baixo</span>
                        </button>
                    </div>
                </div>

                <!-- AÇÃO ALTERNATIVA: EDITAR DIMENSÕES DO CÔMODO -->
                <div class="pt-2 border-t border-slate-800 flex justify-between items-center">
                    <button type="button" onclick="editarComodoAlvoRapido()" class="text-amber-400 hover:text-amber-300 font-semibold text-[11px] flex items-center gap-1.5">
                        <i class="fa-solid fa-pen-to-square"></i> Editar dimensões deste cômodo
                    </button>
                    <button type="button" onclick="fecharModalAdicionarPontoRapido()" class="bg-slate-800 hover:bg-slate-700 text-slate-300 font-bold py-1.5 px-3 rounded-xl transition text-xs">
                        Fechar
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- MODAL DE EXPORTAÇÃO PDF: TODAS AS FOLHAS DO PROJETO ABNT (NOVO) -->
    <div id="modalImpressaoPDF" class="fixed inset-0 bg-slate-950/85 backdrop-blur-md z-50 flex items-center justify-center hidden p-4">
        <div class="bg-slate-900 border border-slate-700 rounded-2xl max-w-2xl w-full shadow-2xl overflow-hidden flex flex-col max-h-[90vh]">
            <div class="p-4 border-b border-slate-800 flex justify-between items-center bg-slate-950/80">
                <div class="flex items-center gap-2.5">
                    <span class="w-9 h-9 rounded-xl bg-blue-500/20 text-blue-400 border border-blue-500/40 flex items-center justify-center text-base">
                        <i class="fa-solid fa-print"></i>
                    </span>
                    <div>
                        <h3 class="text-sm font-bold text-white flex items-center gap-2">
                            <span>Central de Impressão & Exportação PDF</span>
                            <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 uppercase">6 Pranchas ABNT</span>
                        </h3>
                        <p class="text-[11px] text-slate-400">Gere todas as pranchas técnicas regulamentadas com carimbo técnico e memorial</p>
                    </div>
                </div>
                <button onclick="fecharModalImpressaoPDF()" class="text-slate-400 hover:text-white p-1.5 rounded-lg hover:bg-slate-800 transition">
                    <i class="fa-solid fa-xmark text-base"></i>
                </button>
            </div>

            <div class="p-5 overflow-y-auto space-y-4 text-xs">
                <!-- LISTA DAS 6 FOLHAS DO PROJETO -->
                <div class="space-y-2">
                    <span class="font-bold text-sky-400 uppercase text-[11px] block">Pranchas que compõem o Projeto Completo:</span>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-2 text-slate-300 text-[11px]">
                        <div class="p-2.5 bg-slate-950 rounded-xl border border-slate-800 flex items-center gap-2.5">
                            <span class="w-6 h-6 rounded-lg bg-sky-500/20 text-sky-300 flex items-center justify-center font-bold font-mono text-xs">01</span>
                            <div>
                                <strong class="text-white block">Folha 01: Planta Baixa CAD 2D</strong>
                                <span class="text-[10px] text-slate-400">Arquitetura, cotas, áreas e perímetros</span>
                            </div>
                        </div>
                        <div class="p-2.5 bg-slate-950 rounded-xl border border-slate-800 flex items-center gap-2.5">
                            <span class="w-6 h-6 rounded-lg bg-emerald-500/20 text-emerald-300 flex items-center justify-center font-bold font-mono text-xs">02</span>
                            <div>
                                <strong class="text-white block">Folha 02: Projeto Elétrico 2D</strong>
                                <span class="text-[10px] text-slate-400">TUG, TUE, luz, retornos e tubulações</span>
                            </div>
                        </div>
                        <div class="p-2.5 bg-slate-950 rounded-xl border border-slate-800 flex items-center gap-2.5">
                            <span class="w-6 h-6 rounded-lg bg-blue-500/20 text-blue-300 flex items-center justify-center font-bold font-mono text-xs">03</span>
                            <div>
                                <strong class="text-white block">Folha 03: Maquete 3D BIM</strong>
                                <span class="text-[10px] text-slate-400">Isométrico dos pavimentos e prumadas</span>
                            </div>
                        </div>
                        <div class="p-2.5 bg-slate-950 rounded-xl border border-slate-800 flex items-center gap-2.5">
                            <span class="w-6 h-6 rounded-lg bg-amber-500/20 text-amber-300 flex items-center justify-center font-bold font-mono text-xs">04</span>
                            <div>
                                <strong class="text-white block">Folha 04: Quadro de Distribuição</strong>
                                <span class="text-[10px] text-slate-400">QDT DIN, disjuntores e balanceamento</span>
                            </div>
                        </div>
                        <div class="p-2.5 bg-slate-950 rounded-xl border border-slate-800 flex items-center gap-2.5">
                            <span class="w-6 h-6 rounded-lg bg-purple-500/20 text-purple-300 flex items-center justify-center font-bold font-mono text-xs">05</span>
                            <div>
                                <strong class="text-white block">Folha 05: Lista de Materiais</strong>
                                <span class="text-[10px] text-slate-400">Quantitativo de cabos, tubos e caixas</span>
                            </div>
                        </div>
                        <div class="p-2.5 bg-slate-950 rounded-xl border border-slate-800 flex items-center gap-2.5">
                            <span class="w-6 h-6 rounded-lg bg-rose-500/20 text-rose-300 flex items-center justify-center font-bold font-mono text-xs">06</span>
                            <div>
                                <strong class="text-white block">Folha 06: Memorial NBR 5410</strong>
                                <span class="text-[10px] text-slate-400">Critérios de bitolas e justificativa legal</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- INFORMAÇÕES DO CARIMBO TÉCNICO -->
                <div class="bg-slate-950 p-3.5 rounded-xl border border-slate-800 space-y-2">
                    <span class="font-bold text-amber-400 block text-[11px]">Dados do Carimbo Técnico (Prancha ABNT):</span>
                    <div class="grid grid-cols-2 gap-2">
                        <input id="txtPdfNomeObra" type="text" placeholder="Nome da Obra / Residência" value="Residência Unifamiliar NBR 5410" class="bg-slate-900 border border-slate-800 text-white rounded-lg p-2 text-xs outline-none">
                        <input id="txtPdfProjetista" type="text" placeholder="Responsável Técnico / CREA" value="Eng. Eletricista Responsável" class="bg-slate-900 border border-slate-800 text-white rounded-lg p-2 text-xs outline-none">
                    </div>
                </div>

                <!-- BOTÕES DE IMPRESSÃO -->
                <div class="pt-2 flex flex-col sm:flex-row justify-end gap-2">
                    <button type="button" onclick="imprimirApenasFolhaAtual()" class="bg-slate-800 hover:bg-slate-700 text-slate-200 font-bold py-2.5 px-4 rounded-xl transition text-xs border border-slate-700">
                        Imprimir Folha Atual
                    </button>
                    <button type="button" onclick="imprimirTodasFolhasProjeto()" class="bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 text-white font-black py-2.5 px-5 rounded-xl transition flex items-center justify-center gap-2 text-xs shadow-lg shadow-blue-600/30">
                        <i class="fa-solid fa-file-pdf text-amber-300 text-sm"></i> Imprimir Todas as 6 Folhas (Projeto Completo)
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- CONTAINER OCULTO NA TELA E VISÍVEL APENAS NA IMPRESSÃO (@media print) PARA AS 6 FOLHAS -->
    <div id="containerPranchasImpressaoCompleta" class="hidden print:block w-full"></div>

    <!-- MODAL DE PONTO ELÉTRICO -->
    <div id="modalPontoEletrico" class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 flex items-center justify-center hidden">
        <div class="bg-slate-900 border border-slate-700 rounded-2xl p-6 max-w-md w-full mx-4 shadow-2xl space-y-4">
            <div class="flex justify-between items-center border-b border-slate-800 pb-3">
                <h3 id="tituloModalPonto" class="text-sm font-bold text-amber-400 flex items-center gap-2">
                    <i class="fa-solid fa-plug"></i> Ponto de Tomada
                </h3>
                <button onclick="fecharModalPonto()" class="text-slate-400 hover:text-white p-1"><i class="fa-solid fa-xmark"></i></button>
            </div>
            <form id="formPontoEletrico" class="space-y-3 text-xs">
                <div>
                    <label class="block font-semibold text-slate-300 mb-1">Nome / Identificação</label>
                    <input id="txtModalPontoNome" type="text" required class="w-full bg-slate-950 border border-slate-800 text-white rounded-xl p-2.5 outline-none focus:ring-1 focus:ring-amber-400">
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block font-semibold text-slate-300 mb-1">Tipo de Tomada</label>
                        <select id="selModalPontoTipo" onchange="aoMudarTipoPontoModal(this.value)" class="w-full bg-slate-950 border border-slate-800 text-white rounded-xl p-2.5 outline-none focus:ring-1 focus:ring-amber-400">
                            <option value="TUG">TUG (Tomada de Uso Geral 10A/20A)</option>
                            <option value="TUE">TUE (Tomada de Uso Específico - 20A)</option>
                            <option value="ILUM">💡 Ponto de Iluminação (Plafon / Spot / Lustre)</option>
                            <option value="INTERRUPTOR">🔘 Interruptor (Comando de Lâmpadas)</option>
                        </select>
                    </div>
                    <div>
                        <label class="block font-semibold text-slate-300 mb-1">Tensão</label>
                        <select id="selModalPontoTensao" class="w-full bg-slate-950 border border-slate-800 text-white rounded-xl p-2.5 outline-none focus:ring-1 focus:ring-amber-400">
                            <option value="127">127 V</option>
                            <option value="220">220 V</option>
                        </select>
                    </div>
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block font-semibold text-slate-300 mb-1">Potência (Watts)</label>
                        <input id="numModalPontoPot" type="number" step="10" min="50" required class="w-full bg-slate-950 border border-slate-800 text-white rounded-xl p-2.5 outline-none focus:ring-1 focus:ring-amber-400 font-mono">
                    </div>
                    <div>
                        <label class="block font-semibold text-slate-300 mb-1">Altura de Instalação</label>
                        <select id="selModalPontoAltura" class="w-full bg-slate-950 border border-slate-800 text-white rounded-xl p-2.5 outline-none focus:ring-1 focus:ring-amber-400">
                            <option value="teto">Teto / Forro Superior (2.80m - Iluminação)</option>
                            <option value="alta">Alta na Parede (2.00m - TUE / Arandela)</option>
                            <option value="media">Média na Parede (1.20m - Bancada / Interruptor)</option>
                            <option value="baixa">Baixa na Parede (0.30m - Tomada Geral Piso)</option>
                        </select>
                    </div>
                </div>
                <div class="pt-3 border-t border-slate-800 flex justify-between gap-2">
                    <button type="button" onclick="excluirPontoDoModal()" id="btnModalExcluirPonto" class="bg-red-950/80 hover:bg-red-900 text-red-300 font-bold px-4 py-2 rounded-xl transition">
                        Excluir
                    </button>
                    <div class="flex gap-2">
                        <button type="button" onclick="fecharModalPonto()" class="bg-slate-800 hover:bg-slate-700 text-slate-300 font-semibold px-4 py-2 rounded-xl transition">
                            Cancelar
                        </button>
                        <button type="submit" class="bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold px-4 py-2 rounded-xl transition">
                            Salvar Ponto
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- SCRIPT JAVASCRIPT PRINCIPAL -->
    <script>
        const SUGESTOES_CARGAS_BR = [
            { grupo: 'Banheiro / Suíte (TUE)', nome: 'Chuveiro Elétrico Turbo', tipo: 'TUE', pot: 7500, tensao: 220, altura: 'alta' },
            { grupo: 'Banheiro / Suíte (TUE)', nome: 'Chuveiro Elétrico 127V', tipo: 'TUE', pot: 5500, tensao: 127, altura: 'alta' },
            { grupo: 'Banheiro / Suíte (TUE)', nome: 'Torneira Elétrica Banheiro', tipo: 'TUE', pot: 4500, tensao: 220, altura: 'media' },
            { grupo: 'Banheiro / Suíte (TUE)', nome: 'Hidromassagem', tipo: 'TUE', pot: 1500, tensao: 220, altura: 'baixa' },

            { grupo: 'Cozinha & Serviço (TUE)', nome: 'Cooktop por Indução 4 Bocas', tipo: 'TUE', pot: 7200, tensao: 220, altura: 'baixa' },
            { grupo: 'Cozinha & Serviço (TUE)', nome: 'Forno Elétrico de Embutir', tipo: 'TUE', pot: 2800, tensao: 220, altura: 'media' },
            { grupo: 'Cozinha & Serviço (TUE)', nome: 'Torneira Elétrica Cozinha', tipo: 'TUE', pot: 5500, tensao: 220, altura: 'media' },
            { grupo: 'Cozinha & Serviço (TUE)', nome: 'Máquina Lava e Seca', tipo: 'TUE', pot: 2200, tensao: 220, altura: 'media' },

            { grupo: 'Climatização (TUE)', nome: 'Ar Condicionado Inverter 9.000 BTU', tipo: 'TUE', pot: 900, tensao: 220, altura: 'alta' },
            { grupo: 'Climatização (TUE)', nome: 'Ar Condicionado Inverter 12.000 BTU', tipo: 'TUE', pot: 1150, tensao: 220, altura: 'alta' },
            { grupo: 'Climatização (TUE)', nome: 'Ar Condicionado Inverter 18.000 BTU', tipo: 'TUE', pot: 1700, tensao: 220, altura: 'alta' },

            { grupo: 'Cozinha & Serviço (TUG)', nome: 'Air Fryer (Fritadeira)', tipo: 'TUG', pot: 1500, tensao: 127, altura: 'media' },
            { grupo: 'Cozinha & Serviço (TUG)', nome: 'Geladeira Frost Free', tipo: 'TUG', pot: 300, tensao: 127, altura: 'media' },
            { grupo: 'Cozinha & Serviço (TUG)', nome: 'Micro-ondas', tipo: 'TUG', pot: 1200, tensao: 127, altura: 'media' },

            { grupo: 'Sala / Quarto (TUG)', nome: 'Smart TV 55"/65" LED', tipo: 'TUG', pot: 120, tensao: 127, altura: 'media' },
            { grupo: 'Sala / Quarto (TUG)', nome: 'Computador Gamer / Home Office', tipo: 'TUG', pot: 500, tensao: 127, altura: 'baixa' },
            { grupo: 'Sala / Quarto (TUG)', nome: 'Tomada Uso Geral 10A', tipo: 'TUG', pot: 100, tensao: 127, altura: 'baixa' },
            { grupo: 'Sala / Quarto (TUG)', nome: 'Tomada Especial 20A', tipo: 'TUG', pot: 600, tensao: 127, altura: 'media' }
        ];

        // Estado Global com Suporte Completo a Multi-Pavimentos
        const state = {
            // Configuração do Terreno Total (Lote) vs Área Construída
            terreno: {
                ativo: true,
                largura: 12.0,      // metros de testada/frente
                comprimento: 25.0,  // metros de profundidade
                recuoFrontal: 4.0,  // metros
                recuoLateral: 1.5,  // metros
                recuoFundos: 3.0,   // metros
                x: 40,              // posição X inicial no canvas (px)
                y: 40               // posição Y inicial no canvas (px)
            },
            // Gerenciamento de Projetos e Checkpoints
            projetoAtual: {
                id: 'proj_' + Date.now(),
                nome: 'Residência Unifamiliar NBR 5410',
                template: 'casa_terrea',
                dataCriacao: new Date().toISOString(),
                ultimaModificacao: new Date().toISOString()
            },
            templateNovoProjetoSelecionado: 'em_branco',
            checkpoints: [],
            filtroElemento3d: 'todos', // 'todos' | 'ilum' | 'tomadas' | 'tubos'
            comodoArrasto3D: null,
            boundaryBoxMesh: null,

            modoCalculo: 'cad',
            ferramentaAtiva: 'select',
            ferramentaInstalacoes: 'mover_pontos',
            exibirRotulosInstalacoes: false, // Inicia limpo apenas com ícones conforme solicitado
            pavimentos: [
                { id: 'terreo', nome: 'Pavimento Térreo', nivel: 0, alturaPeDireito: 2.8, temLajePiso: true, tipoLajePiso: 'concreto', espessuraLajePiso: 0.20, temLajeTeto: true, tipoLajeTeto: 'concreto', espessuraLajeTeto: 0.15, tipoPassagemCabos: 'teto' },
                { id: 'superior', nome: '1º Pavimento (Superior)', nivel: 1, alturaPeDireito: 2.8, temLajePiso: true, tipoLajePiso: 'concreto', espessuraLajePiso: 0.20, temLajeTeto: true, tipoLajeTeto: 'concreto', espessuraLajeTeto: 0.15, tipoPassagemCabos: 'teto' }
            ],
            pavimentoAtivoId: 'terreo',
            exibirGabaritoFantasma: true,
            exibirLajesPiso3D: true,
            exibirLajesTeto3D: true,
            comodos: [],
            pontosEletricos: [],
            eletrodutoWaypoints: {},
            linhasMaoLivre: [],
            linhaAtual: null,
            qdtPos: { x: 40, y: 40, w: 45, h: 26 },
            prumadaPos: { x: 85, y: 45, w: 20, h: 20 },
            prumadaAtiva: true,
            alimentacaoExterna: { x: 40, y: 440, w: 75, h: 36, distanciaManual: null, sistema: 'bifasico' },
            escala: 40,
            arrastando: null,
            arrastandoInstalacoes: null,
            offsetArrasto: { x: 0, y: 0 },
            // Modo Encaixe Magnético (Ímã de Cômodos) e Legenda de Transições
            snapMagnetico: true,
            linhasGuiaMagnetica: [],
            exibirLegendaTransicoes: true,
            exibirRotulosTransicoesTexto: false,
            comodoEmEdicaoId: null,
            pontoSelecionadoId: null,
            cargasFormulario: [],
            comprimentosManuaisCircuitos: {},
            transicoes: [],
            escadas: [],
            transicaoAtiva: null,
            circuitosCalculados: [],
            // Espessura Normativa das Paredes (NBR 15575 / NBR 15270 / NBR 16868)
            espessuraParede: 0.15, // metros (15cm - Padrão NBR 15575 Alvenaria convencional com emboço e reboco)
            // Estado do Motor 3D
            scene3d: null,
            camera3d: null,
            renderer3d: null,
            controls3d: null,
            meshGroup3d: null,
            gridHelper3D: null,
            filtroPavimento3d: 'todos', // 'todos' | 'terreo' | 'superior'
            raioX3d: false,
            explodido3d: false,
            abaAtiva: 'planta',
            cena3dDesatualizada: true,
            render3dAtivo: false,
            modoEconomia3D: true,
            animFrameId3D: null,
            framesRestantes3D: 0,

            // Regime de Imóvel (Mesmo Imóvel vs Imóveis Separados)
            regimeImovel: 'mesmo_imovel', // 'mesmo_imovel' | 'imoveis_separados'
            unidadeQdtAtivaId: 'todos', // 'todos' | id do imóvel
            imoveis: [
                {
                    id: 'imovel_terreo',
                    nome: 'Imóvel 1 (Térreo)',
                    tipo: 'residencial',
                    pavimentos: ['terreo'],
                    sistema: 'bifasico',
                    distancia: 15
                },
                {
                    id: 'imovel_superior',
                    nome: 'Imóvel 2 (Superior)',
                    tipo: 'residencial',
                    pavimentos: ['superior'],
                    sistema: 'bifasico',
                    distancia: 18
                }
            ],

            // Camada de Linhas AutoCAD de Fundo (Underlay DXF) e Importações
            cadUnderlay: [], // { x1, y1, x2, y2, layer, color }
            exibirCadUnderlay: true,
            arquivoImportadoCache: null,
            tipoAbaImport: 'cad',

            // Roteamento Padrão de Infraestrutura Elétrica
            tipoPassagemCabos: 'teto', // 'teto' | 'chao'

            // Modo Interativo de Edição e Arraste 3D
            modoEdicao3D: false,
            objetoArrastado3d: null
        };

        // OBTER PAVIMENTO ATIVO
        function obterPavimentoAtivo() {
            let pav = state.pavimentos.find(p => p.id === state.pavimentoAtivoId);
            if (!pav && state.pavimentos.length > 0) {
                pav = state.pavimentos[0];
                state.pavimentoAtivoId = pav.id;
            }
            return pav;
        }

        // ALTERAR INFRAESTRUTURA DE PASSAGEM DE CABOS (INDEPENDENTE POR PAVIMENTO)
        function alterarPassagemCabos(tipo, pavId = null) {
            const pId = pavId || state.pavimentoAtivoId;
            const pav = state.pavimentos.find(p => p.id === pId);
            if (pav) {
                pav.tipoPassagemCabos = tipo;
            }
            state.tipoPassagemCabos = tipo;

            renderizarSeletorPavimentos();
            atualizarTabelas();
            desenharInstalacoes();
            reconstruirCena3D();
        }

        // TOGGLE RÁPIDO DE LAJE DE PISO DO PAVIMENTO ATIVO
        function toggleLajePisoPavimentoAtivo() {
            const pav = obterPavimentoAtivo();
            if (!pav) return;
            pav.temLajePiso = (pav.temLajePiso === false) ? true : false;
            renderizarSeletorPavimentos();
            reconstruirCena3D();
        }

        // TOGGLE RÁPIDO DE LAJE DE TETO DO PAVIMENTO ATIVO
        function toggleLajeTetoPavimentoAtivo() {
            const pav = obterPavimentoAtivo();
            if (!pav) return;
            pav.temLajeTeto = (pav.temLajeTeto === false) ? true : false;
            renderizarSeletorPavimentos();
            reconstruirCena3D();
        }

        // TOGGLES GLOBAIS DE VISUALIZAÇÃO DE LAJES EM 3D
        function toggle3dLajesPiso() {
            state.exibirLajesPiso3D = (state.exibirLajesPiso3D === false) ? true : false;
            const btn = document.getElementById('btn3dVerLajesPiso');
            if (btn) {
                btn.className = state.exibirLajesPiso3D ? 
                    'px-2.5 py-1.5 rounded-lg font-bold bg-amber-500/30 text-amber-300 border border-amber-500/60 flex items-center gap-1 shadow' :
                    'px-2.5 py-1.5 rounded-lg font-bold bg-slate-900 text-slate-500 border border-slate-800 flex items-center gap-1 line-through';
            }
            reconstruirCena3D();
        }

        function toggle3dLajesTeto() {
            state.exibirLajesTeto3D = (state.exibirLajesTeto3D === false) ? true : false;
            const btn = document.getElementById('btn3dVerLajesTeto');
            if (btn) {
                btn.className = state.exibirLajesTeto3D ? 
                    'px-2.5 py-1.5 rounded-lg font-bold bg-sky-500/30 text-sky-300 border border-sky-500/60 flex items-center gap-1 shadow' :
                    'px-2.5 py-1.5 rounded-lg font-bold bg-slate-900 text-slate-500 border border-slate-800 flex items-center gap-1 line-through';
            }
            reconstruirCena3D();
        }

        // MODAL DE CONFIGURAÇÃO DE PAVIMENTO E LAJES
        function abrirModalConfigPavimento() {
            const pav = obterPavimentoAtivo();
            if (!pav) return;

            const sub = document.getElementById('subtituloModalPavimento');
            if (sub) sub.textContent = `Configurações independentes para: ${pav.nome}`;

            const txtNome = document.getElementById('cfgPavNome');
            const numPe = document.getElementById('cfgPavPeDireito');
            const chkPiso = document.getElementById('cfgPavTemPiso');
            const selTipoPiso = document.getElementById('cfgPavTipoPiso');
            const numEspPiso = document.getElementById('cfgPavEspessuraPiso');
            const chkTeto = document.getElementById('cfgPavTemTeto');
            const selTipoTeto = document.getElementById('cfgPavTipoTeto');
            const numEspTeto = document.getElementById('cfgPavEspessuraTeto');
            const radTeto = document.getElementById('radCfgPassagemTeto');
            const radChao = document.getElementById('radCfgPassagemChao');

            if (txtNome) txtNome.value = pav.nome;
            if (numPe) numPe.value = pav.alturaPeDireito || 2.8;
            if (chkPiso) chkPiso.checked = (pav.temLajePiso !== false);
            if (selTipoPiso) selTipoPiso.value = pav.tipoLajePiso || 'concreto';
            if (numEspPiso) numEspPiso.value = Math.round((pav.espessuraLajePiso || 0.20) * 100);
            if (chkTeto) chkTeto.checked = (pav.temLajeTeto !== false);
            if (selTipoTeto) selTipoTeto.value = pav.tipoLajeTeto || 'concreto';
            if (numEspTeto) numEspTeto.value = Math.round((pav.espessuraLajeTeto || 0.15) * 100);

            const tipoPass = pav.tipoPassagemCabos || state.tipoPassagemCabos || 'teto';
            if (tipoPass === 'chao') {
                if (radChao) radChao.checked = true;
            } else {
                if (radTeto) radTeto.checked = true;
            }

            const chkPrumada = document.getElementById('cfgPrumadaAtiva');
            if (chkPrumada) chkPrumada.checked = (state.prumadaAtiva !== false);

            const modal = document.getElementById('modalConfigPavimento');
            if (modal) modal.classList.remove('hidden');
        }

        function fecharModalConfigPavimento() {
            const modal = document.getElementById('modalConfigPavimento');
            if (modal) modal.classList.add('hidden');
        }

        function salvarConfigPavimento() {
            const pav = obterPavimentoAtivo();
            if (!pav) return;

            const nome = document.getElementById('cfgPavNome').value.trim() || pav.nome;
            const pe = parseFloat(document.getElementById('cfgPavPeDireito').value) || 2.8;
            const temPiso = document.getElementById('cfgPavTemPiso').checked;
            const tipoPiso = document.getElementById('cfgPavTipoPiso').value;
            const espPiso = (parseFloat(document.getElementById('cfgPavEspessuraPiso').value) || 20) / 100.0;
            const temTeto = document.getElementById('cfgPavTemTeto').checked;
            const tipoTeto = document.getElementById('cfgPavTipoTeto').value;
            const espTeto = (parseFloat(document.getElementById('cfgPavEspessuraTeto').value) || 15) / 100.0;
            const radChao = document.getElementById('radCfgPassagemChao');
            const tipoPassagem = (radChao && radChao.checked) ? 'chao' : 'teto';
            const aplicarTodos = document.getElementById('chkAplicarTodosPavimentos').checked;
            const chkPrumada = document.getElementById('cfgPrumadaAtiva');
            if (chkPrumada) state.prumadaAtiva = chkPrumada.checked;

            if (aplicarTodos) {
                state.pavimentos.forEach(p => {
                    p.alturaPeDireito = pe;
                    p.temLajePiso = temPiso;
                    p.tipoLajePiso = tipoPiso;
                    p.espessuraLajePiso = espPiso;
                    p.temLajeTeto = temTeto;
                    p.tipoLajeTeto = tipoTeto;
                    p.espessuraLajeTeto = espTeto;
                    p.tipoPassagemCabos = tipoPassagem;
                });
            } else {
                pav.nome = nome;
                pav.alturaPeDireito = pe;
                pav.temLajePiso = temPiso;
                pav.tipoLajePiso = tipoPiso;
                pav.espessuraLajePiso = espPiso;
                pav.temLajeTeto = temTeto;
                pav.tipoLajeTeto = tipoTeto;
                pav.espessuraLajeTeto = espTeto;
                pav.tipoPassagemCabos = tipoPassagem;
            }

            fecharModalConfigPavimento();
            renderizarSeletorPavimentos();
            atualizarTudo();
            reconstruirCena3D();
        }

        function excluirPavimentoAtivo() {
            if (state.pavimentos.length <= 1) {
                alert('É necessário ter ao menos um pavimento cadastrado na edificação!');
                return;
            }
            const pav = obterPavimentoAtivo();
            if (!pav) return;

            if (!confirm(`Tem certeza que deseja excluir o "${pav.nome}" e todos os seus cômodos?`)) {
                return;
            }

            state.comodos = state.comodos.filter(c => c.pavimentoId !== pav.id);
            state.pavimentos = state.pavimentos.filter(p => p.id !== pav.id);
            state.pavimentoAtivoId = state.pavimentos[0].id;

            fecharModalConfigPavimento();
            renderizarSeletorPavimentos();
            atualizarTudo();
            reconstruirCena3D();
        }

        // MODAL DE ACESSO WEB REMOTO
        function abrirModalAcessoWeb() {
            const modal = document.getElementById('modalAcessoWeb');
            if (modal) modal.classList.remove('hidden');

            const txt = document.getElementById('txtUrlRedeLocal');
            if (txt) {
                const host = window.location.hostname;
                if (host && host !== '' && host !== 'localhost' && host !== '127.0.0.1') {
                    txt.value = `http://${host}:${window.location.port || '8080'}`;
                } else {
                    txt.value = 'http://192.168.15.2:8080';
                }
            }
        }

        function fecharModalAcessoWeb() {
            const modal = document.getElementById('modalAcessoWeb');
            if (modal) modal.classList.add('hidden');
        }

        function copiarUrlRedeLocal() {
            const txt = document.getElementById('txtUrlRedeLocal');
            if (txt) {
                navigator.clipboard.writeText(txt.value).then(() => {
                    alert('URL copiada para a área de transferência:\n' + txt.value + '\n\nAbra no navegador de qualquer dispositivo no mesmo Wi-Fi!');
                }).catch(() => {
                    txt.select();
                    document.execCommand('copy');
                    alert('URL copiada:\n' + txt.value);
                });
            }
        }

        
        // =========================================================================
        // SISTEMA DE PROJETOS, PONTOS DE SALVAMENTO (CHECKPOINTS) & ARQUIVOS
        // =========================================================================

        function mostrarNotificacaoToast(mensagem, tipo = 'sucesso') {
            const toast = document.getElementById('toastNotificacao');
            const txt = document.getElementById('toastMensagem');
            const icone = document.getElementById('toastIcone');
            if (!toast || !txt) return;

            txt.textContent = mensagem;
            if (tipo === 'sucesso') {
                toast.className = 'fixed bottom-6 right-6 z-50 bg-slate-900 border border-emerald-500 text-white px-4 py-3 rounded-2xl shadow-2xl flex items-center gap-3 text-xs transition-all duration-300 opacity-100 translate-y-0';
                icone.innerHTML = '<i class="fa-solid fa-circle-check text-emerald-400 text-base"></i>';
            } else if (tipo === 'aviso') {
                toast.className = 'fixed bottom-6 right-6 z-50 bg-slate-900 border border-amber-500 text-white px-4 py-3 rounded-2xl shadow-2xl flex items-center gap-3 text-xs transition-all duration-300 opacity-100 translate-y-0';
                icone.innerHTML = '<i class="fa-solid fa-triangle-exclamation text-amber-400 text-base"></i>';
            } else {
                toast.className = 'fixed bottom-6 right-6 z-50 bg-slate-900 border border-red-500 text-white px-4 py-3 rounded-2xl shadow-2xl flex items-center gap-3 text-xs transition-all duration-300 opacity-100 translate-y-0';
                icone.innerHTML = '<i class="fa-solid fa-circle-xmark text-red-400 text-base"></i>';
            }

            setTimeout(() => {
                toast.className = 'fixed bottom-6 right-6 z-50 bg-slate-900 border border-emerald-500/60 text-white px-4 py-3 rounded-2xl shadow-2xl flex items-center gap-3 text-xs pointer-events-none transition-all duration-300 opacity-0 translate-y-4';
            }, 3500);
        }

        function exportarSnapshotEstado() {
            return {
                projetoAtual: JSON.parse(JSON.stringify(state.projetoAtual)),
                pavimentos: JSON.parse(JSON.stringify(state.pavimentos)),
                pavimentoAtivoId: state.pavimentoAtivoId,
                comodos: JSON.parse(JSON.stringify(state.comodos)),
                pontosEletricos: JSON.parse(JSON.stringify(state.pontosEletricos)),
                eletrodutoWaypoints: JSON.parse(JSON.stringify(state.eletrodutoWaypoints || {})),
                transicoes: JSON.parse(JSON.stringify(state.transicoes || [])),
                escadas: JSON.parse(JSON.stringify(state.escadas || [])),
                imoveis: JSON.parse(JSON.stringify(state.imoveis || [])),
                regimeImovel: state.regimeImovel || 'mesmo_imovel',
                unidadeQdtAtivaId: state.unidadeQdtAtivaId || 'todos',
                qdtPos: { ...state.qdtPos },
                prumadaPos: { ...state.prumadaPos },
                prumadaAtiva: state.prumadaAtiva !== false,
                alimentacaoExterna: { ...state.alimentacaoExterna },

                // Configurações do Terreno Total (Lote)
                terreno: state.terreno ? JSON.parse(JSON.stringify(state.terreno)) : null,

                // Escala de Desenho CAD
                escala: state.escala || 40,

                // Desenhos Vetoriais e Underlay
                linhasMaoLivre: JSON.parse(JSON.stringify(state.linhasMaoLivre || [])),
                cadUnderlay: JSON.parse(JSON.stringify(state.cadUnderlay || [])),
                exibirCadUnderlay: state.exibirCadUnderlay !== false,

                // Infraestrutura Elétrica e Concessionária
                tipoPassagemCabos: state.tipoPassagemCabos || 'teto',
                concessionariaId: state.concessionariaId || 'cpfl',
                comprimentosManuaisCircuitos: JSON.parse(JSON.stringify(state.comprimentosManuaisCircuitos || {})),
                cargasFormulario: JSON.parse(JSON.stringify(state.cargasFormulario || [])),

                // Espessura Normativa das Paredes (NBR 15575)
                espessuraParede: state.espessuraParede || 0.15,

                // Modos de CAD, Snapping e Legenda
                snapMagnetico: state.snapMagnetico !== false,
                exibirLegendaTransicoes: state.exibirLegendaTransicoes !== false,
                exibirRotulosTransicoesTexto: !!state.exibirRotulosTransicoesTexto,
                exibirRotulosInstalacoes: !!state.exibirRotulosInstalacoes,
                exibirGabaritoFantasma: state.exibirGabaritoFantasma !== false,

                // Modos e Visualizações 3D
                exibirLajesPiso3D: state.exibirLajesPiso3D !== false,
                exibirLajesTeto3D: state.exibirLajesTeto3D !== false,
                filtroPavimento3d: state.filtroPavimento3d || 'todos',
                filtroElemento3d: state.filtroElemento3d || 'todos',
                raioX3d: !!state.raioX3d,
                explodido3d: !!state.explodido3d,

                // Onde o usuário parou (aba e ferramentas ativas)
                abaAtiva: state.abaAtiva || 'planta',
                ferramentaAtiva: state.ferramentaAtiva || 'select',
                ferramentaInstalacoes: state.ferramentaInstalacoes || 'mover_pontos'
            };
        }

        function restaurarSnapshotEstado(snapshot) {
            if (!snapshot) return;
            if (snapshot.projetoAtual) state.projetoAtual = JSON.parse(JSON.stringify(snapshot.projetoAtual));
            if (snapshot.pavimentos) state.pavimentos = JSON.parse(JSON.stringify(snapshot.pavimentos));
            if (snapshot.pavimentoAtivoId) state.pavimentoAtivoId = snapshot.pavimentoAtivoId;
            if (snapshot.comodos) state.comodos = JSON.parse(JSON.stringify(snapshot.comodos));
            if (snapshot.pontosEletricos) state.pontosEletricos = JSON.parse(JSON.stringify(snapshot.pontosEletricos));
            if (snapshot.eletrodutoWaypoints) state.eletrodutoWaypoints = JSON.parse(JSON.stringify(snapshot.eletrodutoWaypoints));
            if (snapshot.transicoes) state.transicoes = JSON.parse(JSON.stringify(snapshot.transicoes));
            state.escadas = snapshot.escadas ? JSON.parse(JSON.stringify(snapshot.escadas)) : [];
            if (snapshot.imoveis) state.imoveis = JSON.parse(JSON.stringify(snapshot.imoveis));
            if (snapshot.regimeImovel) state.regimeImovel = snapshot.regimeImovel;
            if (snapshot.unidadeQdtAtivaId) state.unidadeQdtAtivaId = snapshot.unidadeQdtAtivaId;
            if (snapshot.qdtPos) state.qdtPos = { ...snapshot.qdtPos };
            if (snapshot.prumadaPos) state.prumadaPos = { ...snapshot.prumadaPos };
            if (snapshot.prumadaAtiva !== undefined) state.prumadaAtiva = snapshot.prumadaAtiva;
            if (snapshot.alimentacaoExterna) state.alimentacaoExterna = { ...snapshot.alimentacaoExterna };

            // Terreno Total (Lote)
            if (snapshot.terreno) {
                state.terreno = JSON.parse(JSON.stringify(snapshot.terreno));
            } else {
                if (typeof ajustarTerrenoAosComodos === 'function') ajustarTerrenoAosComodos();
            }

            // Escala de Desenho CAD
            if (snapshot.escala) {
                state.escala = snapshot.escala;
                const selEscala = document.getElementById('selEscalaProporcao');
                if (selEscala) selEscala.value = String(snapshot.escala);
                const lblEscala = document.getElementById('lblEscalaAtual');
                if (lblEscala) lblEscala.innerText = `${snapshot.escala}px/m`;
            }

            // Linhas Livres e CAD Underlay
            if (snapshot.linhasMaoLivre) state.linhasMaoLivre = JSON.parse(JSON.stringify(snapshot.linhasMaoLivre));
            if (snapshot.cadUnderlay) state.cadUnderlay = JSON.parse(JSON.stringify(snapshot.cadUnderlay));
            if (snapshot.exibirCadUnderlay !== undefined) {
                state.exibirCadUnderlay = snapshot.exibirCadUnderlay;
                const chkUnderlay = document.getElementById('chkExibirUnderlay');
                if (chkUnderlay) chkUnderlay.checked = snapshot.exibirCadUnderlay;
            }

            // Infraestrutura Elétrica e Concessionária
            if (snapshot.tipoPassagemCabos) state.tipoPassagemCabos = snapshot.tipoPassagemCabos;
            if (snapshot.concessionariaId) state.concessionariaId = snapshot.concessionariaId;
            if (snapshot.comprimentosManuaisCircuitos) state.comprimentosManuaisCircuitos = JSON.parse(JSON.stringify(snapshot.comprimentosManuaisCircuitos));
            if (snapshot.cargasFormulario) state.cargasFormulario = JSON.parse(JSON.stringify(snapshot.cargasFormulario));

            // Espessura Normativa das Paredes
            if (snapshot.espessuraParede !== undefined) {
                state.espessuraParede = snapshot.espessuraParede;
                const txtCm = `${Math.round(state.espessuraParede * 100)} cm`;
                const lblEsp = document.getElementById('lblEspessuraParedeAtual');
                if (lblEsp) lblEsp.innerText = txtCm;
                const lblToolbar = document.getElementById('lblEspessuraParedeCadToolbar');
                if (lblToolbar) lblToolbar.innerText = txtCm;
                const lblToolbarInst = document.getElementById('lblEspessuraParedeInstToolbar');
                if (lblToolbarInst) lblToolbarInst.innerText = txtCm;
                const selEsp = document.getElementById('selPresetEspessuraParede');
                if (selEsp) selEsp.value = String(state.espessuraParede);
            }

            // Snapping Magnético
            if (snapshot.snapMagnetico !== undefined) {
                state.snapMagnetico = snapshot.snapMagnetico;
                const btnSnap = document.getElementById('btnToggleSnapMagnetico');
                if (btnSnap) {
                    if (state.snapMagnetico) {
                        btnSnap.classList.add('bg-cyan-500/20', 'text-cyan-300', 'border-cyan-500/40');
                        btnSnap.classList.remove('bg-slate-900', 'text-slate-400', 'border-slate-800');
                        btnSnap.title = 'Snap Magnético: LIGADO';
                    } else {
                        btnSnap.classList.remove('bg-cyan-500/20', 'text-cyan-300', 'border-cyan-500/40');
                        btnSnap.classList.add('bg-slate-900', 'text-slate-400', 'border-slate-800');
                        btnSnap.title = 'Snap Magnético: DESLIGADO';
                    }
                }
            }

            // Legenda e Rótulos de Transições
            if (snapshot.exibirLegendaTransicoes !== undefined) {
                state.exibirLegendaTransicoes = snapshot.exibirLegendaTransicoes;
                const chkLeg = document.getElementById('chkLegendaTransicoes');
                if (chkLeg) chkLeg.checked = snapshot.exibirLegendaTransicoes;
                const legEl = document.getElementById('legendaTransicoesLinha');
                if (legEl) legEl.style.display = snapshot.exibirLegendaTransicoes ? 'flex' : 'none';
            }
            if (snapshot.exibirRotulosTransicoesTexto !== undefined) {
                state.exibirRotulosTransicoesTexto = snapshot.exibirRotulosTransicoesTexto;
                const chkRot = document.getElementById('chkRotulosTransicoes');
                if (chkRot) chkRot.checked = snapshot.exibirRotulosTransicoesTexto;
            }
            if (snapshot.exibirRotulosInstalacoes !== undefined) state.exibirRotulosInstalacoes = snapshot.exibirRotulosInstalacoes;
            if (snapshot.exibirGabaritoFantasma !== undefined) state.exibirGabaritoFantasma = snapshot.exibirGabaritoFantasma;

            // Modos 3D
            if (snapshot.exibirLajesPiso3D !== undefined) state.exibirLajesPiso3D = snapshot.exibirLajesPiso3D;
            if (snapshot.exibirLajesTeto3D !== undefined) state.exibirLajesTeto3D = snapshot.exibirLajesTeto3D;
            if (snapshot.filtroPavimento3d) {
                state.filtroPavimento3d = snapshot.filtroPavimento3d;
                const btnTodos = document.getElementById('btn3dVerTodos');
                const btnTerreo = document.getElementById('btn3dVerTerreo');
                const btnSup = document.getElementById('btn3dVerSuperior');
                if (btnTodos) btnTodos.className = state.filtroPavimento3d === 'todos' ? 'px-3 py-1.5 rounded-lg font-bold bg-emerald-500 text-slate-950 shadow' : 'px-3 py-1.5 rounded-lg font-bold text-slate-400 hover:text-white';
                if (btnTerreo) btnTerreo.className = state.filtroPavimento3d === 'terreo' ? 'px-3 py-1.5 rounded-lg font-bold bg-emerald-500 text-slate-950 shadow' : 'px-3 py-1.5 rounded-lg font-bold text-slate-400 hover:text-white';
                if (btnSup) btnSup.className = state.filtroPavimento3d === 'superior' ? 'px-3 py-1.5 rounded-lg font-bold bg-emerald-500 text-slate-950 shadow' : 'px-3 py-1.5 rounded-lg font-bold text-slate-400 hover:text-white';
            }
            if (snapshot.filtroElemento3d) state.filtroElemento3d = snapshot.filtroElemento3d;
            if (snapshot.raioX3d !== undefined) {
                state.raioX3d = snapshot.raioX3d;
                const btnX = document.getElementById('btn3dRaioX');
                if (btnX) btnX.className = state.raioX3d ? 'px-3 py-1.5 rounded-xl font-bold bg-sky-500 text-slate-950 flex items-center gap-1.5 shadow' : 'px-3 py-1.5 rounded-xl font-bold bg-slate-800 hover:bg-slate-700 text-sky-400 border border-slate-700 flex items-center gap-1.5';
            }
            if (snapshot.explodido3d !== undefined) {
                state.explodido3d = snapshot.explodido3d;
                const btnExp = document.getElementById('btn3dExplodir');
                if (btnExp) btnExp.className = state.explodido3d ? 'px-3 py-1.5 rounded-xl font-bold bg-purple-500 text-white flex items-center gap-1.5 shadow' : 'px-3 py-1.5 rounded-xl font-bold bg-slate-800 hover:bg-slate-700 text-purple-400 border border-slate-700 flex items-center gap-1.5';
            }

            if (snapshot.ferramentaAtiva) state.ferramentaAtiva = snapshot.ferramentaAtiva;
            if (snapshot.ferramentaInstalacoes) state.ferramentaInstalacoes = snapshot.ferramentaInstalacoes;

            // Sincroniza alinhamento do terreno
            if (typeof ajustarTerrenoAosComodos === 'function') {
                ajustarTerrenoAosComodos();
            }

            renderizarSeletorPavimentos();
            renderListaComodosSidebar();
            renderizarBarraTransicoes();
            renderizarBotoesUnidadesQDT();
            atualizarTudo();
            reconstruirCena3D(true);
            if (typeof resetarCamera3D === 'function') {
                resetarCamera3D();
            }

            // Grava silenciosamente como estado ativo
            if (typeof salvarProjetoSilencioso === 'function') {
                salvarProjetoSilencioso();
            }

            // Volta literalmente onde o usuário parou (aba ativa)
            if (snapshot.abaAtiva && typeof trocarAba === 'function') {
                setTimeout(() => {
                    trocarAba(snapshot.abaAtiva);
                }, 60);
            }
        }

        function salvarPontoRapido(nomePonto = null) {
            const agora = new Date();
            const dataHoraStr = agora.toLocaleDateString('pt-BR') + ' ' + agora.toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
            const nome = nomePonto || `Ponto ${dataHoraStr}`;

            let totalWatts = 0;
            state.pontosEletricos.forEach(p => totalWatts += (p.pot || 0));

            const novoCheckpoint = {
                id: 'ckpt_' + Date.now(),
                projetoId: state.projetoAtual.id,
                nome: nome,
                dataHora: dataHoraStr,
                timestamp: Date.now(),
                resumo: {
                    pavimentos: state.pavimentos.length,
                    comodos: state.comodos.length,
                    pontos: state.pontosEletricos.length,
                    potenciaKva: (totalWatts / 1000).toFixed(2)
                },
                estado: exportarSnapshotEstado()
            };

            // Carrega checkpoints existentes de LocalStorage
            let lista = [];
            try {
                const salvo = localStorage.getItem('proeletrica_checkpoints_' + state.projetoAtual.id);
                if (salvo) lista = JSON.parse(salvo);
            } catch(e) {}

            lista.unshift(novoCheckpoint);
            if (lista.length > 30) lista = lista.slice(0, 30); // Guarda os últimos 30 checkpoints

            try {
                localStorage.setItem('proeletrica_checkpoints_' + state.projetoAtual.id, JSON.stringify(lista));
                // Atualiza lista geral de checkpoints
                localStorage.setItem('proeletrica_checkpoints_recente', JSON.stringify(lista));
            } catch(e) {
                console.warn('LocalStorage cheio ao salvar checkpoint', e);
            }

            atualizarBadgePontosSalvos();
            renderizarListaCheckpoints();
            mostrarNotificacaoToast(`Ponto de restauração "${nome}" salvo!`, 'sucesso');
        }

        function salvarPontoRapidoComNome() {
            const agora = new Date();
            const padrao = 'Versão ' + agora.toLocaleDateString('pt-BR') + ' ' + agora.toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' });
            const nome = prompt('Digite um nome ou descrição para este Ponto de Salvamento:', padrao);
            if (nome && nome.trim()) {
                salvarPontoRapido(nome.trim());
            }
        }

        function restaurarCheckpoint(ckptId) {
            let lista = [];
            try {
                const salvo = localStorage.getItem('proeletrica_checkpoints_' + state.projetoAtual.id) || localStorage.getItem('proeletrica_checkpoints_recente');
                if (salvo) lista = JSON.parse(salvo);
            } catch(e) {}

            const ckpt = lista.find(c => c.id === ckptId);
            if (!ckpt) {
                alert('Ponto de salvamento não encontrado!');
                return;
            }

            if (confirm(`Deseja restaurar o projeto para "${ckpt.nome}" (${ckpt.dataHora})?\nAs alterações não salvas serão substituídas.`)) {
                restaurarSnapshotEstado(ckpt.estado);
                mostrarNotificacaoToast(`Projeto restaurado para: "${ckpt.nome}"`, 'sucesso');
                fecharModalGerenciarProjetos();
            }
        }

        function excluirCheckpoint(ckptId) {
            if (!confirm('Tem certeza que deseja excluir este Ponto de Salvamento?')) return;
            let lista = [];
            try {
                const chave = 'proeletrica_checkpoints_' + state.projetoAtual.id;
                const salvo = localStorage.getItem(chave) || localStorage.getItem('proeletrica_checkpoints_recente');
                if (salvo) lista = JSON.parse(salvo);
                lista = lista.filter(c => c.id !== ckptId);
                localStorage.setItem(chave, JSON.stringify(lista));
                localStorage.setItem('proeletrica_checkpoints_recente', JSON.stringify(lista));
            } catch(e) {}
            atualizarBadgePontosSalvos();
            renderizarListaCheckpoints();
            mostrarNotificacaoToast('Ponto de salvamento excluído.', 'aviso');
        }

        function atualizarBadgePontosSalvos() {
            const badge = document.getElementById('badgeContagemSalvos');
            if (!badge) return;
            let count = 0;
            try {
                const salvo = localStorage.getItem('proeletrica_checkpoints_' + state.projetoAtual.id) || localStorage.getItem('proeletrica_checkpoints_recente');
                if (salvo) count = JSON.parse(salvo).length;
            } catch(e) {}
            badge.textContent = count;
        }

        function renderizarListaCheckpoints() {
            const container = document.getElementById('listaCheckpointsContainer');
            if (!container) return;

            let lista = [];
            try {
                const salvo = localStorage.getItem('proeletrica_checkpoints_' + state.projetoAtual.id) || localStorage.getItem('proeletrica_checkpoints_recente');
                if (salvo) lista = JSON.parse(salvo);
            } catch(e) {}

            if (lista.length === 0) {
                container.innerHTML = `
                    <div class="p-8 text-center text-slate-500 bg-slate-950/40 rounded-xl border border-dashed border-slate-800 space-y-2">
                        <i class="fa-regular fa-bookmark text-3xl text-slate-600 block"></i>
                        <p class="font-bold text-slate-400">Nenhum ponto de salvamento criado ainda.</p>
                        <p class="text-[11px]">Clique em "Criar Novo Ponto Agora" acima ou no botão "Salvar Ponto" no topo para criar sua primeira versão gravada.</p>
                    </div>`;
                return;
            }

            container.innerHTML = lista.map((ckpt, idx) => `
                <div class="bg-slate-950 p-3.5 rounded-xl border border-slate-800 hover:border-slate-700 transition flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3">
                    <div class="space-y-1">
                        <div class="flex items-center gap-2">
                            <span class="w-6 h-6 rounded-lg bg-amber-500/20 text-amber-400 border border-amber-500/40 flex items-center justify-center text-xs font-mono font-bold">
                                ${idx + 1}
                            </span>
                            <span class="font-bold text-white text-sm">${ckpt.nome}</span>
                            <span class="text-[10px] text-slate-400 bg-slate-900 px-2 py-0.5 rounded-md border border-slate-800">
                                <i class="fa-regular fa-clock"></i> ${ckpt.dataHora}
                            </span>
                        </div>
                        <div class="flex items-center gap-3 text-slate-400 text-[11px]">
                            <span><i class="fa-solid fa-layer-group text-sky-400"></i> ${ckpt.resumo.pavimentos} Pavimento(s)</span>
                            <span><i class="fa-solid fa-door-open text-amber-400"></i> ${ckpt.resumo.comodos} Cômodo(s)</span>
                            <span><i class="fa-solid fa-plug text-emerald-400"></i> ${ckpt.resumo.pontos} Ponto(s)</span>
                            <span><i class="fa-solid fa-bolt text-yellow-400"></i> ${ckpt.resumo.potenciaKva} kVA</span>
                        </div>
                    </div>
                    <div class="flex items-center gap-2 w-full sm:w-auto justify-end">
                        <button onclick="restaurarCheckpoint('${ckpt.id}')" class="bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold px-3.5 py-1.5 rounded-lg transition flex items-center gap-1.5 shadow" title="Restaurar projeto para este estado">
                            <i class="fa-solid fa-rotate-left"></i> Restaurar
                        </button>
                        <button onclick="excluirCheckpoint('${ckpt.id}')" class="bg-slate-900 hover:bg-red-950/80 hover:text-red-400 text-slate-400 p-2 rounded-lg border border-slate-800 transition" title="Excluir este ponto">
                            <i class="fa-solid fa-trash-can"></i>
                        </button>
                    </div>
                </div>
            `).join('');
        }

        // --- GESTÃO DE PROJETOS SALVOS (LOCALSTORAGE) ---

        function salvarProjetoAtualNoLocalStorage() {
            let lista = [];
            try {
                const salvo = localStorage.getItem('proeletrica_projetos');
                if (salvo) lista = JSON.parse(salvo);
            } catch(e) {}

            state.projetoAtual.ultimaModificacao = new Date().toISOString();

            let totalWatts = 0;
            state.pontosEletricos.forEach(p => totalWatts += (p.pot || 0));

            const registro = {
                id: state.projetoAtual.id,
                nome: state.projetoAtual.nome || 'Projeto Sem Nome',
                template: state.projetoAtual.template || 'personalizado',
                dataCriacao: state.projetoAtual.dataCriacao || new Date().toISOString(),
                ultimaModificacao: state.projetoAtual.ultimaModificacao,
                resumo: {
                    pavimentos: state.pavimentos.length,
                    comodos: state.comodos.length,
                    pontos: state.pontosEletricos.length,
                    potenciaKva: (totalWatts / 1000).toFixed(2)
                },
                estado: exportarSnapshotEstado()
            };

            const idx = lista.findIndex(p => p.id === registro.id);
            if (idx >= 0) {
                lista[idx] = registro;
            } else {
                lista.unshift(registro);
            }

            try {
                localStorage.setItem('proeletrica_projetos', JSON.stringify(lista));
            } catch(e) {
                console.warn('Erro ao salvar em localStorage', e);
            }

            renderizarListaProjetosSalvos();
            salvarProjetoSilencioso();
            mostrarNotificacaoToast(`Projeto "${registro.nome}" gravado no navegador!`, 'sucesso');
        }

        function salvarProjetoSilencioso() {
            try {
                const snapshot = exportarSnapshotEstado();
                localStorage.setItem('proeletrica_projeto_ativo', JSON.stringify({
                    id: state.projetoAtual?.id || 'proj_ativo',
                    nome: state.projetoAtual?.nome || 'Projeto Residencial',
                    timestamp: Date.now(),
                    estado: snapshot
                }));
            } catch(e) {
                // Silencioso caso cota de storage local esteja cheia
            }
        }

        function carregarProjetoSalvo(projId) {
            let lista = [];
            try {
                const salvo = localStorage.getItem('proeletrica_projetos');
                if (salvo) lista = JSON.parse(salvo);
            } catch(e) {}

            const proj = lista.find(p => p.id === projId);
            if (!proj) {
                alert('Projeto não encontrado!');
                return;
            }

            if (confirm(`Deseja abrir o projeto "${proj.nome}"?\nO trabalho atual será substituído.`)) {
                restaurarSnapshotEstado(proj.estado);
                mostrarNotificacaoToast(`Projeto "${proj.nome}" carregado com sucesso!`, 'sucesso');
                fecharModalGerenciarProjetos();
            }
        }

        function excluirProjetoSalvo(projId) {
            if (!confirm('Deseja realmente apagar este projeto salvo da memória do navegador?')) return;
            let lista = [];
            try {
                const salvo = localStorage.getItem('proeletrica_projetos');
                if (salvo) lista = JSON.parse(salvo);
                lista = lista.filter(p => p.id !== projId);
                localStorage.setItem('proeletrica_projetos', JSON.stringify(lista));
            } catch(e) {}
            renderizarListaProjetosSalvos();
            mostrarNotificacaoToast('Projeto excluído da memória.', 'aviso');
        }

        function renderizarListaProjetosSalvos() {
            const container = document.getElementById('listaProjetosLocalStorageContainer');
            if (!container) return;

            let lista = [];
            try {
                const salvo = localStorage.getItem('proeletrica_projetos');
                if (salvo) lista = JSON.parse(salvo);
            } catch(e) {}

            if (lista.length === 0) {
                container.innerHTML = `
                    <div class="p-8 text-center text-slate-500 bg-slate-950/40 rounded-xl border border-dashed border-slate-800 space-y-2">
                        <i class="fa-regular fa-folder text-3xl text-slate-600 block"></i>
                        <p class="font-bold text-slate-400">Nenhum projeto salvo no navegador ainda.</p>
                        <p class="text-[11px]">Clique em "Salvar Projeto Atual" acima para guardar uma cópia persistente nesta máquina.</p>
                    </div>`;
                return;
            }

            container.innerHTML = lista.map(proj => {
                const dataFormatada = new Date(proj.ultimaModificacao).toLocaleString('pt-BR');
                const ehOAtual = (proj.id === state.projetoAtual.id);
                return `
                <div class="bg-slate-950 p-4 rounded-xl border ${ehOAtual ? 'border-emerald-500/60 ring-1 ring-emerald-500/30' : 'border-slate-800'} hover:border-slate-700 transition flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3">
                    <div class="space-y-1">
                        <div class="flex items-center gap-2">
                            <span class="font-bold text-white text-sm">${proj.nome}</span>
                            ${ehOAtual ? '<span class="text-[10px] bg-emerald-500/20 text-emerald-300 px-2 py-0.5 rounded-full font-bold border border-emerald-500/40">Em Edição</span>' : ''}
                        </div>
                        <div class="flex items-center gap-3 text-slate-400 text-[11px]">
                            <span><i class="fa-regular fa-clock"></i> ${dataFormatada}</span>
                            <span><i class="fa-solid fa-layer-group text-sky-400"></i> ${proj.resumo.pavimentos} Pav.</span>
                            <span><i class="fa-solid fa-door-open text-amber-400"></i> ${proj.resumo.comodos} Cômodos</span>
                            <span><i class="fa-solid fa-plug text-emerald-400"></i> ${proj.resumo.pontos} Pontos</span>
                            <span><i class="fa-solid fa-bolt text-yellow-400"></i> ${proj.resumo.potenciaKva} kVA</span>
                        </div>
                    </div>
                    <div class="flex items-center gap-2 w-full sm:w-auto justify-end">
                        <button onclick="carregarProjetoSalvo('${proj.id}')" class="bg-emerald-600 hover:bg-emerald-500 text-white font-bold px-3.5 py-1.5 rounded-lg transition flex items-center gap-1.5 shadow">
                            <i class="fa-solid fa-folder-open"></i> Abrir
                        </button>
                        <button onclick="excluirProjetoSalvo('${proj.id}')" class="bg-slate-900 hover:bg-red-950/80 hover:text-red-400 text-slate-400 p-2 rounded-lg border border-slate-800 transition" title="Excluir projeto">
                            <i class="fa-solid fa-trash-can"></i>
                        </button>
                    </div>
                </div>`;
            }).join('');
        }

        // --- EXPORTAR E IMPORTAR ARQUIVOS .PROELETRICA ---

        function exportarArquivoProjeto() {
            const dadosCompletos = {
                software: 'PRO-ELÉTRICA CAD NBR 5410',
                versao: '2.5',
                dataExportacao: new Date().toISOString(),
                projeto: state.projetoAtual,
                estado: exportarSnapshotEstado()
            };

            const jsonStr = JSON.stringify(dadosCompletos, null, 2);
            const blob = new Blob([jsonStr], { type: 'application/json' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            const nomeArquivo = (state.projetoAtual.nome || 'projeto_eletrico').replace(/[^a-zA-Z0-9_-]/g, '_') + '.proeletrica';
            a.href = url;
            a.download = nomeArquivo;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
            mostrarNotificacaoToast(`Arquivo "${nomeArquivo}" baixado com sucesso!`, 'sucesso');
        }

        function importarArquivoProjeto(event) {
            const file = event.target.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = (e) => {
                try {
                    const dados = JSON.parse(e.target.result);
                    if (dados.projeto) {
                        state.projetoAtual = dados.projeto;
                    }
                    const estadoParaCarregar = dados.estado || dados;
                    restaurarSnapshotEstado(estadoParaCarregar);
                    salvarPontoRapido('Importado de arquivo: ' + file.name);
                    mostrarNotificacaoToast(`Projeto carregado do arquivo "${file.name}"!`, 'sucesso');
                    fecharModalGerenciarProjetos();
                } catch(err) {
                    alert('Erro ao ler arquivo de projeto: ' + err.message);
                }
            };
            reader.readAsText(file);
            event.target.value = '';
        }

        // --- NOVO PROJETO COM MODELOS PRÉ-DEFINIDOS ---

        function abrirModalNovoProjeto() {
            const modal = document.getElementById('modalNovoProjeto');
            if (modal) modal.classList.remove('hidden');
