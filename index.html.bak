<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PRO-ELÉTRICA CAD NBR 5410</title>
    <!-- PWA Manifest & App Configuration -->
    <link rel="manifest" href="manifest.json">
    <meta name="theme-color" content="#0f172a">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="ProElétrica">
    <link rel="apple-touch-icon" href="apple-touch-icon.png">
    <link rel="icon" type="image/svg+xml" href="icon.svg">
    <link rel="icon" type="image/png" sizes="192x192" href="icon-192.png">

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- SheetJS (XLSX) para Exportação Profissional para Excel -->
    <script src="https://cdn.sheetjs.com/xlsx-0.20.2/package/dist/xlsx.full.min.js"></script>
    <!-- Three.js (r128) & OrbitControls para Visualização 3D e BIM Realista (Offline Local com Fallback CDN) -->
    <script src="libs/three.min.js"></script>
    <script>
        if (typeof THREE === 'undefined') {
            document.write('<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"><\/script>');
        }
    </script>
    <script src="libs/OrbitControls.js"></script>
    <script>
        if (typeof THREE !== 'undefined' && typeof THREE.OrbitControls === 'undefined') {
            document.write('<script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js"><\/script>');
        }
    </script>
    <style>
        canvas { touch-action: none; }
        .tab-content { display: none; }
        .tab-content.active { display: block; }
        @media print {
            .no-print { display: none !important; }
            .print-only { display: block !important; }
            body { background: #ffffff !important; color: #000000 !important; }
            .tab-content { display: none !important; }
            #containerPranchasImpressaoCompleta { display: block !important; }
            .folha-prancha-abnt {
                page-break-after: always !important;
                break-after: page !important;
                width: 100% !important;
                min-height: 200mm !important;
                box-sizing: border-box !important;
                border: 2px solid #0f172a !important;
                padding: 8mm !important;
                margin-bottom: 20mm !important;
                background: #ffffff !important;
                color: #0f172a !important;
            }
        }
        .folha-prancha-abnt {
            background: #ffffff;
            color: #0f172a;
            border: 2px solid #334155;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.4);
            border-radius: 8px;
            padding: 24px;
            margin-bottom: 28px;
        }
        .carimbo-tecnico {
            border: 1.5px solid #0f172a;
            background: #f8fafc;
        }
        .din-rail-bg {
            background: linear-gradient(180deg, #1e293b 0%, #334155 35%, #475569 50%, #334155 65%, #1e293b 100%);
            box-shadow: inset 0 2px 4px rgba(0,0,0,0.6);
        }

        /* OTIMIZAÇÕES MOBILE & TABLET (TOUCH & RESPONSIVIDADE) */
        @media (max-width: 1023px) {
            body {
                overflow-x: hidden;
                -webkit-tap-highlight-color: transparent;
            }
            .mobile-bottom-nav {
                display: flex !important;
            }
            .desktop-only-header {
                display: none !important;
            }
            .desktop-only-subbar {
                display: none !important;
            }
            .desktop-only-tabs {
                display: none !important;
            }
            .mobile-top-header {
                display: flex !important;
            }
            .canvas-container-responsive {
                height: 400px !important;
            }
            canvas {
                touch-action: none;
            }
        }
        @media (min-width: 1024px) {
            .mobile-bottom-nav {
                display: none !important;
            }
            .mobile-top-header {
                display: none !important;
            }
            .mobile-fab {
                display: none !important;
            }
        }

        /* Botão Flutuante (FAB) Mobile */
        .mobile-fab-btn {
            box-shadow: 0 8px 24px -2px rgba(245, 158, 11, 0.45);
        }
        /* Drawer Sheet */
        .mobile-drawer-sheet {
            transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        }

        /* MODO EXPANDIDO EM TELA CHEIA (VIEWPORT FULLSCREEN) */
        .viewport-fullscreen-mode {
            position: fixed !important;
            inset: 0 !important;
            top: 0 !important;
            left: 0 !important;
            width: 100vw !important;
            height: 100vh !important;
            z-index: 99999 !important;
            margin: 0 !important;
            border-radius: 0 !important;
            border: none !important;
            background-color: #020617 !important;
            box-shadow: none !important;
            overflow: hidden !important;
        }
        .viewport-fullscreen-mode canvas {
            width: 100vw !important;
            height: 100vh !important;
        }
        .viewport-fullscreen-mode #viewport3d {
            width: 100vw !important;
            height: 100vh !important;
        }
        .viewport-fullscreen-mode .fullscreen-exit-btn {
            display: inline-flex !important;
        }
    </style>
</head>
<body class="bg-slate-950 text-slate-100 font-sans antialiased min-h-screen">
    <div class="max-w-7xl mx-auto px-2.5 sm:px-4 pt-2 pb-24 lg:py-6">
        
        <!-- MOBILE TOP HEADER (VISÍVEL APENAS EM CELULARES E TABLETS) -->
        <div class="mobile-top-header hidden bg-slate-900/95 backdrop-blur-md border border-slate-800 rounded-2xl p-3 mb-3 shadow-xl flex justify-between items-center no-print sticky top-2 z-30">
            <div class="flex items-center gap-2">
                <span class="w-8 h-8 rounded-xl bg-amber-500/20 text-amber-400 border border-amber-500/40 flex items-center justify-center text-sm shadow">
                    <i class="fa-solid fa-bolt-lightning"></i>
                </span>
                <div>
                    <h1 class="text-sm font-black tracking-tight text-amber-400 flex items-center gap-1.5 leading-none">
                        PRO-ELÉTRICA
                    </h1>
                    <span class="text-[9px] text-slate-400 font-mono">NBR 5410 • CAD/BIM</span>
                </div>
            </div>

            <!-- SELETOR RÁPIDO DE PAVIMENTO MOBILE & AÇÕES -->
                <button id="btnInstalarAppMobile" onclick="dispararInstalacaoPWA()" class="bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-600 hover:to-amber-700 text-slate-950 font-black px-2 py-1 rounded-lg text-[10px] flex items-center gap-1 shadow transition" title="Instalar Aplicativo no Celular">
                    <i class="fa-solid fa-download"></i> Instalar
                </button>

            <div class="flex items-center gap-1.5">
                <button onclick="alternarPavimentoMobile()" id="btnMobilePavimentoBadge" class="bg-sky-500/20 text-sky-300 border border-sky-500/40 px-2.5 py-1 rounded-lg text-[11px] font-bold flex items-center gap-1 shadow-sm">
                    <i class="fa-solid fa-layer-group text-[10px]"></i> <span id="lblNomePavimentoMobile">Térreo</span> ▾
                </button>
                                <button id="btnInstalarAppDesktop" onclick="dispararInstalacaoPWA()" class="bg-amber-500/20 hover:bg-amber-500/30 text-amber-300 border border-amber-500/40 px-3 py-1.5 rounded-lg text-xs font-bold transition flex items-center gap-1.5 shadow-sm" title="Instalar como aplicativo no computador">
                    <i class="fa-solid fa-download text-amber-400"></i> <span>Instalar App</span>
                </button>
                <button onclick="abrirModalImpressaoPDF()" class="bg-blue-600 hover:bg-blue-500 text-white p-1.5 rounded-lg text-xs font-bold transition flex items-center justify-center shadow" title="Imprimir PDF">
                    <i class="fa-solid fa-print"></i>
                </button>
                <button onclick="salvarPontoRapido()" class="bg-amber-600 hover:bg-amber-500 text-white p-1.5 rounded-lg text-xs font-bold transition flex items-center justify-center shadow" title="Salvar Ponto">
                    <i class="fa-solid fa-floppy-disk"></i>
                </button>
                <button onclick="abrirDrawerMobile()" class="bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 p-1.5 rounded-lg text-xs font-bold transition flex items-center justify-center shadow" title="Menu Completo">
                    <i class="fa-solid fa-bars"></i>
                </button>
            </div>
        </div>

        <!-- DRAWER / MENU COMPLETO MOBILE (OFFCANVAS) -->
        <div id="drawerMenuMobile" class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 flex justify-end hidden p-0">
            <div class="bg-slate-900 border-l border-slate-800 w-full max-w-xs h-full p-4 overflow-y-auto space-y-4 text-xs shadow-2xl flex flex-col justify-between">
                <div class="space-y-4">
                    <div class="flex justify-between items-center border-b border-slate-800 pb-3">
                        <div class="flex items-center gap-2">
                            <i class="fa-solid fa-drafting-compass text-amber-400 text-lg"></i>
                            <h3 class="font-bold text-white text-sm">Ferramentas & Ajustes</h3>
                        </div>
                        <button onclick="fecharDrawerMobile()" class="text-slate-400 hover:text-white p-1 rounded-lg hover:bg-slate-800">
                            <i class="fa-solid fa-xmark text-base"></i>
                        </button>
                    </div>

                    <!-- PWA BANNER NO DRAWER -->
                    <div id="pwaBannerDrawer" class="bg-gradient-to-r from-amber-500/15 via-sky-500/15 to-purple-500/15 border border-amber-500/30 p-3 rounded-xl space-y-2">
                        <div class="flex items-center gap-2">
                            <span class="w-7 h-7 rounded-lg bg-amber-500 text-slate-950 flex items-center justify-center text-xs font-black shadow">
                                <i class="fa-solid fa-mobile-screen-button"></i>
                            </span>
                            <div>
                                <h4 class="font-bold text-white text-xs">Instalar Aplicativo</h4>
                                <p class="text-[10px] text-slate-300">Acesse direto da tela inicial em tela cheia</p>
                            </div>
                        </div>
                        <button onclick="dispararInstalacaoPWA(); fecharDrawerMobile();" class="w-full bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold py-1.5 px-3 rounded-lg text-xs flex items-center justify-center gap-1.5 transition shadow">
                            <i class="fa-solid fa-download"></i> Adicionar à Tela Inicial
                        </button>
                    </div>

                    <!-- GESTÃO DE PROJETOS -->
                    <div class="space-y-1.5">
                        <span class="text-[10px] uppercase font-bold text-amber-400 tracking-wider">Projetos & Versões</span>
                        <div class="grid grid-cols-2 gap-1.5">
                            <button onclick="abrirModalNovoProjeto(); fecharDrawerMobile();" class="bg-emerald-700 hover:bg-emerald-600 text-white font-bold p-2 rounded-xl transition flex flex-col items-center gap-1 text-[10px] text-center">
                                <i class="fa-solid fa-folder-plus text-xs"></i> Novo Projeto
                            </button>
                            <button onclick="abrirModalGerenciarProjetos(); fecharDrawerMobile();" class="bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 font-bold p-2 rounded-xl transition flex flex-col items-center gap-1 text-[10px] text-center">
                                <i class="fa-solid fa-clock-rotate-left text-amber-400 text-xs"></i> Versões Salvas
                            </button>
                        </div>
                    </div>

                    <!-- PAVIMENTOS E LAJES -->
                    <div class="space-y-1.5">
                        <span class="text-[10px] uppercase font-bold text-sky-400 tracking-wider">Pavimentos & Infraestrutura</span>
                        <div class="bg-slate-950 p-2.5 rounded-xl border border-slate-800 space-y-2">
                            <div class="flex justify-between items-center">
                                <span class="text-slate-300 font-semibold">Andar:</span>
                                <div id="containerBotoesPavimentosMobile" class="flex gap-1"></div>
                            </div>
                            <div class="flex justify-between items-center pt-1 border-t border-slate-850">
                                <span class="text-slate-400 text-[10px]">Passagem:</span>
                                <div class="flex gap-1">
                                    <button onclick="alterarPassagemCabos('teto')" class="bg-sky-600 text-white text-[10px] px-2 py-1 rounded font-bold">Teto</button>
                                    <button onclick="alterarPassagemCabos('chao')" class="bg-slate-800 text-slate-300 text-[10px] px-2 py-1 rounded font-bold">Chão</button>
                                </div>
                            </div>
                            <button onclick="abrirModalNovoPavimento(); fecharDrawerMobile();" class="w-full bg-slate-800 hover:bg-slate-700 text-sky-300 font-bold p-1.5 rounded-lg border border-slate-700 transition text-[10px] flex items-center justify-center gap-1">
                                <i class="fa-solid fa-plus text-[9px]"></i> Criar Novo Andar
                            </button>
                        </div>
                    </div>

                    <!-- EXPORTAÇÕES E IMPRESSÃO -->
                    <div class="space-y-1.5">
                        <span class="text-[10px] uppercase font-bold text-emerald-400 tracking-wider">Exportações & Relatórios</span>
                        <div class="space-y-1">
                            <button onclick="abrirModalImpressaoPDF(); fecharDrawerMobile();" class="w-full bg-gradient-to-r from-blue-600 to-indigo-600 text-white font-bold p-2 rounded-xl transition flex items-center justify-center gap-2 text-xs shadow">
                                <i class="fa-solid fa-file-pdf text-amber-300"></i> Imprimir 6 Pranchas PDF
                            </button>
                            <button onclick="exportarParaExcel(); fecharDrawerMobile();" class="w-full bg-emerald-700 hover:bg-emerald-600 text-white font-bold p-2 rounded-xl transition flex items-center justify-center gap-2 text-xs">
                                <i class="fa-solid fa-file-excel text-sm"></i> Exportar Lista Excel (.xlsx)
                            </button>
                            <button onclick="abrirModalImportar(); fecharDrawerMobile();" class="w-full bg-indigo-700 hover:bg-indigo-600 text-white font-bold p-2 rounded-xl transition flex items-center justify-center gap-2 text-xs">
                                <i class="fa-solid fa-file-import"></i> Importar Planta CAD / DWG
                            </button>
                        </div>
                    </div>
                </div>

                <div class="pt-3 border-t border-slate-800 text-[10px] text-slate-500 text-center">
                    PRO-ELÉTRICA CAD NBR 5410 • Versão Mobile
                </div>
            </div>
        </div>

                <!-- CABEÇALHO -->
        <header class="desktop-only-header bg-slate-900 border border-slate-800 text-white rounded-2xl p-6 shadow-2xl mb-6 flex flex-col md:flex-row justify-between items-center no-print">
            <div class="mb-4 md:mb-0">
                <h1 class="text-2xl font-black tracking-tight flex items-center gap-3 text-amber-400">
                    <i class="fa-solid fa-drafting-compass text-3xl"></i>
                    PRO-ELÉTRICA CAD NBR 5410
                </h1>
                <p class="text-slate-400 text-xs mt-1">Multi-Pavimentos (Térreo/Superior), Maquete 3D BIM, Instalações TUG/TUE, QDT DIN & Exportação Excel</p>
            </div>
            <div class="flex flex-wrap items-center gap-2">
                <!-- GERENCIAMENTO DE PROJETOS & PONTOS DE SALVAMENTO -->
                <button onclick="abrirModalNovoProjeto()" class="bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 text-white font-bold px-3.5 py-2 rounded-xl transition flex items-center gap-2 text-xs shadow-lg shadow-emerald-600/25 ring-1 ring-emerald-400/40" title="Iniciar um novo projeto em branco ou a partir de modelos prontos">
                    <i class="fa-solid fa-folder-plus text-sm"></i> Novo Projeto
                </button>
                <button onclick="salvarPontoRapido()" class="bg-gradient-to-r from-amber-600 to-orange-600 hover:from-amber-500 hover:to-orange-500 text-white font-bold px-3.5 py-2 rounded-xl transition flex items-center gap-2 text-xs shadow-lg shadow-amber-600/25" title="Salvar ponto de restauração instantâneo (Snapshot com data/hora)">
                    <i class="fa-solid fa-floppy-disk text-sm"></i> Salvar Ponto
                </button>
                <button onclick="salvarProjetoNaPastaServidor()" class="bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 text-white font-bold px-3.5 py-2 rounded-xl transition flex items-center gap-2 text-xs shadow-lg shadow-blue-600/25 ring-1 ring-blue-400/40" title="Salvar diretamente na pasta 'projetos/' no computador">
                    <i class="fa-solid fa-folder-arrow-down text-sm text-sky-300"></i> Salvar na Pasta
                </button>
                <button onclick="abrirModalGerenciarProjetos()" class="bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 font-bold px-3.5 py-2 rounded-xl transition flex items-center gap-2 text-xs shadow" title="Histórico de versões, pontos de salvamento e projetos salvos">
                    <i class="fa-solid fa-clock-rotate-left text-amber-400 text-sm"></i> Salvos & Versões <span id="badgeContagemSalvos" class="bg-amber-500 text-slate-950 px-1.5 py-0.5 rounded-full text-[10px] font-mono font-bold ml-1">0</span>
                </button>
                <div class="h-6 w-px bg-slate-800 mx-1 hidden sm:block"></div>
                <button onclick="abrirModalAcessoWeb()" class="bg-gradient-to-r from-blue-600 to-cyan-600 hover:from-blue-500 hover:to-cyan-500 text-white font-bold px-3.5 py-2 rounded-xl transition flex items-center gap-2 text-xs shadow-lg shadow-cyan-600/20 ring-1 ring-cyan-400/40" title="Abrir software no celular ou em qualquer outro navegador web fora desta máquina">
                    <i class="fa-solid fa-globe text-sm"></i> Web / Celular
                </button>
                <button onclick="abrirModalImportar()" class="bg-indigo-600 hover:bg-indigo-500 text-white font-bold px-3.5 py-2 rounded-xl transition flex items-center gap-2 text-xs shadow-lg shadow-indigo-600/20">
                    <i class="fa-solid fa-file-import text-sm"></i> Importar CAD
                </button>
                <button onclick="exportarParaExcel()" class="bg-emerald-700 hover:bg-emerald-600 text-white font-bold px-3.5 py-2 rounded-xl transition flex items-center gap-2 text-xs shadow-lg shadow-emerald-700/20">
                    <i class="fa-solid fa-file-excel text-sm"></i> Excel (.xlsx)
                </button>
                <button onclick="abrirModalImpressaoPDF()" class="bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 text-white font-bold px-3.5 py-2 rounded-xl transition flex items-center gap-2 text-xs border border-blue-400/40 shadow-lg shadow-blue-600/25" title="Exportar Pranchas e Relatórios do Projeto Completo em PDF (6 Folhas ABNT)">
                    <i class="fa-solid fa-file-pdf text-amber-300 text-sm"></i> PDF / Imprimir (Todas as Folhas)
                </button>
            </div>
        </header>

        <!-- SELETOR DE MODO DE CÁLCULO, REGIME DO IMÓVEL E BARRA GLOBAL DE PAVIMENTOS -->
        <div class="desktop-only-subbar bg-slate-900 p-4 rounded-2xl border border-slate-800 mb-6 flex flex-col xl:flex-row justify-between items-center gap-4 no-print">
            <!-- SELETOR DE PAVIMENTO ATIVO -->
            <div class="flex flex-wrap items-center gap-2 w-full xl:w-auto">
                <div class="flex items-center gap-2 mr-2">
                    <i class="fa-solid fa-layer-group text-sky-400 text-lg"></i>
                    <div>
                        <span class="text-xs font-bold text-white uppercase tracking-wider block">Pavimento em Edição:</span>
                        <span class="text-[10px] text-slate-400">Alterne entre Térreo, Superior e outros andares</span>
                    </div>
                </div>
                <div id="containerBotoesPavimentos" class="flex flex-wrap items-center gap-1.5 bg-slate-950 p-1 rounded-xl border border-slate-800">
                    <!-- Injetado dinamicamente via renderizarSeletorPavimentos() -->
                </div>
                <button onclick="abrirModalNovoPavimento()" class="bg-slate-800 hover:bg-slate-700 text-sky-400 hover:text-sky-300 font-bold px-3 py-1.5 rounded-lg border border-slate-700 text-xs transition flex items-center gap-1">
                    <i class="fa-solid fa-plus"></i> Novo Andar
                </button>
                <button onclick="abrirModalConfigPavimento()" class="bg-slate-800 hover:bg-slate-700 text-amber-400 hover:text-amber-300 font-bold px-3 py-1.5 rounded-lg border border-slate-700 text-xs transition flex items-center gap-1.5" title="Configurar Lajes (Teto/Chão Piso) e Infraestrutura deste Andar">
                    <i class="fa-solid fa-sliders"></i> Lajes & Opções
                </button>
                <label class="flex items-center gap-1.5 text-xs text-slate-400 cursor-pointer select-none ml-2">
                    <input type="checkbox" id="chkGabaritoFantasma" checked onchange="toggleGabaritoFantasma(this.checked)" class="rounded text-amber-500 bg-slate-950 border-slate-700">
                    <span class="text-[11px]">Gabarito Fantasma</span>
                </label>
            </div>

            <!-- REGIME DO IMÓVEL, MODO CAD & CONTROLE RÁPIDO DE LAJES DO ANDAR ATIVO -->
            <div class="flex flex-wrap items-center gap-3 w-full xl:w-auto justify-end">
                <!-- CONTROLE RÁPIDO DE LAJE DE PISO E LAJE DE TETO DO PAVIMENTO ATIVO -->
                <div class="flex items-center gap-1 bg-slate-950 p-1 rounded-xl border border-slate-800">
                    <span class="text-[10px] uppercase font-bold text-slate-400 px-1.5 flex items-center gap-1" title="Lajes estruturais do pavimento selecionado">
                        <i class="fa-solid fa-shapes text-amber-400"></i> Lajes Andar:
                    </span>
                    <button id="btnToggleLajePisoAtivo" onclick="toggleLajePisoPavimentoAtivo()" class="px-2 py-1 rounded-lg text-xs font-bold transition flex items-center gap-1 bg-slate-900 text-slate-300 border border-slate-800 hover:border-amber-500/50" title="Laje de Piso / Radier / Contrapiso deste pavimento">
                        🧱 Piso: <span id="lblStatusLajePisoAtivo" class="text-emerald-400">SIM</span>
                    </button>
                    <button id="btnToggleLajeTetoAtivo" onclick="toggleLajeTetoPavimentoAtivo()" class="px-2 py-1 rounded-lg text-xs font-bold transition flex items-center gap-1 bg-slate-900 text-slate-300 border border-slate-800 hover:border-sky-500/50" title="Laje de Teto / Forro superior deste pavimento">
                        🏠 Teto: <span id="lblStatusLajeTetoAtivo" class="text-emerald-400">SIM</span>
                    </button>
                </div>

                <!-- PASSAGEM DE CABOS DO PAVIMENTO ATIVO (TETO VS CHÃO COM INFRAESTRUTURA ÚNICA) -->
                <div class="flex items-center gap-1.5 bg-slate-950 p-1 rounded-xl border border-slate-800">
                    <span class="text-[10px] uppercase font-bold text-slate-400 px-2 flex items-center gap-1" title="Infraestrutura de conduítes deste pavimento">
                        <i class="fa-solid fa-route text-sky-400"></i> Infra:
                    </span>
                    <button id="btnPassagemTeto" onclick="alterarPassagemCabos('teto')" class="px-2.5 py-1.5 rounded-lg text-xs font-bold transition bg-sky-500 text-slate-950 shadow" title="Eletrodutos pela laje de teto / forro deste pavimento">
                        🏠 Teto (Laje)
                    </button>
                    <button id="btnPassagemChao" onclick="alterarPassagemCabos('chao')" class="px-2.5 py-1.5 rounded-lg text-xs font-bold transition text-slate-400 hover:text-white" title="Eletrodutos pelo contrapiso / chão deste pavimento">
                        🧱 Chão (Piso)
                    </button>
                    <span id="badgeInfraUnica" class="hidden px-2 py-0.5 rounded text-[9px] font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-500/40" title="Infraestrutura única compartilhada entre laje e contrapiso NBR 5410">
                        ⚡ Infra Única
                    </span>
                </div>

                <!-- SELETOR: MESMO IMÓVEL VS IMÓVEIS SEPARADOS -->
                <div class="flex items-center gap-1.5 bg-slate-950 p-1 rounded-xl border border-slate-800">
                    <span class="text-[10px] uppercase font-bold text-slate-400 px-2 flex items-center gap-1">
                        <i class="fa-solid fa-building-user text-amber-400"></i> Regime:
                    </span>
                    <button id="btnRegimeMesmoImovel" onclick="alterarRegimeImovel('mesmo_imovel')" class="px-2.5 py-1.5 rounded-lg text-xs font-bold transition bg-amber-500 text-slate-950 shadow" title="Alimentação unificada via prumada interna (sobrado / casa unifamiliar)">
                        🏢 Mesmo Imóvel
                    </button>
                    <button id="btnRegimeImoveisSeparados" onclick="alterarRegimeImovel('imoveis_separados')" class="px-2.5 py-1.5 rounded-lg text-xs font-bold transition text-slate-400 hover:text-white" title="Unidades autônomas / locação: medição e QDT individuais conforme NBR 5410">
                        🏘️ Imóveis Separados
                    </button>
                    <button onclick="abrirModalConfigImoveis()" class="bg-slate-900 hover:bg-slate-800 text-sky-400 hover:text-sky-300 px-2 py-1.5 rounded-lg text-xs border border-slate-800 transition" title="Configurar Vínculo de Pavimentos e Medições">
                        <i class="fa-solid fa-gear"></i>
                    </button>
                </div>

                <!-- MODO CAD VS MANUAL -->
                <div class="flex bg-slate-950 p-1 rounded-xl border border-slate-800">
                    <button id="btnModoCad" class="px-3 py-1.5 rounded-lg text-xs font-bold transition bg-amber-500 text-slate-950 shadow">
                        <i class="fa-solid fa-map"></i> CAD 2D
                    </button>
                    <button id="btnModoManual" class="px-3 py-1.5 rounded-lg text-xs font-bold transition text-slate-400 hover:text-white">
                        <i class="fa-solid fa-keyboard"></i> Manual
                    </button>
                </div>
            </div>
        </div>

        <!-- MENU DE NAVEGAÇÃO PRINCIPAL (6 ABAS) -->
        <nav class="desktop-only-tabs flex border-b border-slate-800 mb-6 space-x-2 no-print overflow-x-auto">
            <button data-tab="planta" class="tab-btn py-3 px-5 border-b-2 font-bold text-xs rounded-t-xl transition flex items-center gap-2 whitespace-nowrap border-amber-400 text-amber-400 bg-slate-900">
                <i class="fa-solid fa-pen-ruler"></i> 1. Planta & Cômodos (2D)
            </button>
            <button data-tab="instalacoes" class="tab-btn py-3 px-5 border-b-2 font-medium text-xs rounded-t-xl transition flex items-center gap-2 whitespace-nowrap border-transparent text-slate-400 hover:text-slate-200">
                <i class="fa-solid fa-bolt-lightning text-sky-400"></i> 2. Instalações TUG/TUE & Eletrodutos (2D)
                <span class="bg-sky-500/20 text-sky-300 text-[9px] px-1.5 py-0.5 rounded font-bold border border-sky-500/40">AMPLIADA</span>
            </button>
            <button data-tab="visualizacao3d" class="tab-btn py-3 px-5 border-b-2 font-medium text-xs rounded-t-xl transition flex items-center gap-2 whitespace-nowrap border-transparent text-slate-400 hover:text-slate-200">
                <i class="fa-solid fa-cube text-emerald-400"></i> 3. Maquete 3D & BIM
                <span class="bg-emerald-500/20 text-emerald-300 text-[9px] px-1.5 py-0.5 rounded font-bold border border-emerald-500/40">3D WEBGL</span>
            </button>
            <button data-tab="alimentador" class="tab-btn py-3 px-5 border-b-2 font-medium text-xs rounded-t-xl transition flex items-center gap-2 whitespace-nowrap border-transparent text-slate-400 hover:text-slate-200">
                <i class="fa-solid fa-microchip text-amber-400"></i> 4. QDT & Circuitos
            </button>
            <button data-tab="materiais" class="tab-btn py-3 px-5 border-b-2 font-medium text-xs rounded-t-xl transition flex items-center gap-2 whitespace-nowrap border-transparent text-slate-400 hover:text-slate-200">
                <i class="fa-solid fa-boxes-stacked text-emerald-400"></i> 5. Quantitativo de Materiais
            </button>
            <button data-tab="duvidas" class="tab-btn py-3 px-5 border-b-2 font-medium text-xs rounded-t-xl transition flex items-center gap-2 whitespace-nowrap border-transparent text-slate-400 hover:text-slate-200">
                <i class="fa-solid fa-circle-question text-blue-400"></i> 6. Guia NBR 5410
            </button>
        </nav>

        <!-- ABA 1: PLANTA BAIXA & CAD 2D -->
        <div id="tab-planta" class="tab-content active space-y-6">
            <div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
                
                <!-- PAINEL DE CONTROLE DE CÔMODOS / GESTÃO DO ANDAR -->
                <div class="bg-slate-900 p-5 rounded-2xl border border-slate-800 lg:col-span-1 space-y-4 text-xs">
                    <!-- BOTÕES DE AÇÃO PRINCIPAIS -->
                    <div class="space-y-2">
                        <button onclick="abrirModalNovoComodo()" class="w-full bg-amber-500 hover:bg-amber-400 text-slate-950 font-black py-2.5 px-4 rounded-xl transition flex justify-center items-center gap-2 shadow-lg shadow-amber-500/20 text-xs">
                            <i class="fa-solid fa-plus-circle text-sm"></i> Inserir Cômodo
                        </button>
                        <button onclick="abrirModalImportar()" class="w-full bg-indigo-600/80 hover:bg-indigo-600 text-indigo-100 font-bold py-2 px-3 rounded-xl transition flex justify-center items-center gap-2 border border-indigo-500/40 text-xs">
                            <i class="fa-solid fa-file-import"></i> Importar BIM / AutoCAD
                        </button>
                    </div>

                    <!-- RESUMO RÁPIDO DO ANDAR ATIVO -->
                    <div class="bg-slate-950/80 p-3 rounded-xl border border-slate-800 space-y-1.5 text-[11px]">
                        <div class="flex justify-between items-center text-slate-400">
                            <span>Área deste Andar:</span>
                            <span id="lblResumoAreaAndar" class="text-white font-mono font-bold">0.0 m²</span>
                        </div>
                        <div class="flex justify-between items-center text-slate-400">
                            <span>Ambientes no Andar:</span>
                            <span id="lblResumoQtdComodos" class="text-amber-400 font-mono font-bold">0</span>
                        </div>
                        <div class="flex justify-between items-center text-slate-400">
                            <span>Pontos TUG/TUE:</span>
                            <span id="lblResumoPontosAndar" class="text-sky-400 font-mono font-bold">0</span>
                        </div>
                        <div class="flex justify-between items-center text-slate-400 pt-1 border-t border-slate-800/80">
                            <span>Vínculo de Imóvel:</span>
                            <span id="lblResumoImovelAndar" class="text-emerald-400 font-mono font-bold text-[10px]">Mesmo Imóvel</span>
                        </div>
                    </div>

                    <!-- QUADRO COMPARATIVO: ÁREA CONSTRUÍDA X TERRENO TOTAL -->
                    <div class="bg-gradient-to-br from-slate-950 via-slate-900 to-slate-950 p-3.5 rounded-xl border-2 border-emerald-500/40 space-y-2 text-[11px] shadow-lg">
                        <div class="flex items-center justify-between border-b border-slate-800 pb-1.5">
                            <span class="font-black text-emerald-400 uppercase tracking-wider text-[10px] flex items-center gap-1.5">
                                <i class="fa-solid fa-layer-group"></i> Terreno x Área Construída
                            </span>
                            <button onclick="abrirModalConfigTerreno()" class="text-[10px] bg-slate-800 hover:bg-slate-700 text-amber-300 px-2 py-0.5 rounded border border-slate-700 font-bold transition flex items-center gap-1" title="Configurar dimensões e recuos do terreno">
                                <i class="fa-solid fa-gear text-[9px]"></i> Ajustar Lote
                            </button>
                        </div>
                        
                        <div class="flex justify-between items-center text-slate-400">
                            <span>🏡 Terreno Total (Lote):</span>
                            <span id="lblTerrenoTotalArea" class="text-emerald-400 font-mono font-bold">300.0 m²</span>
                        </div>
                        <div class="flex justify-between items-center text-slate-400">
                            <span>📐 Dimensões do Lote:</span>
                            <span id="lblTerrenoDimensoes" class="text-slate-300 font-mono text-[10px]">12.0m × 25.0m</span>
                        </div>
                        <div class="flex justify-between items-center text-slate-400 pt-1 border-t border-slate-800/60">
                            <span>🏗️ Área Construída (Total):</span>
                            <span id="lblAreaConstruidaTotal" class="text-white font-mono font-bold">0.0 m²</span>
                        </div>
                        <div class="flex justify-between items-center text-slate-400">
                            <span>🏢 Projeção no Solo (Térreo):</span>
                            <span id="lblAreaProjecaoTerreo" class="text-sky-300 font-mono font-bold">0.0 m²</span>
                        </div>
                        <div class="flex justify-between items-center text-slate-400 pt-1 border-t border-slate-800/60">
                            <span>📊 Taxa de Ocupação (T.O.):</span>
                            <span id="lblTaxaOcupacao" class="text-amber-400 font-mono font-black">0.0%</span>
                        </div>
                        <div class="flex justify-between items-center text-slate-400">
                            <span>🌿 Área Permeável / Livre:</span>
                            <span id="lblAreaPermeavel" class="text-emerald-300 font-mono font-bold">300.0 m²</span>
                        </div>
                    </div>

                    <!-- LISTA DE CÔMODOS CADASTRADOS NO ANDAR -->
                    <div class="space-y-2 pt-2 border-t border-slate-800">
                        <div class="flex justify-between items-center">
                            <h3 class="font-bold text-slate-300 flex items-center gap-1.5">
                                <i class="fa-solid fa-door-closed text-amber-400"></i> Cômodos do Andar:
                            </h3>
                            <span id="lblContagemComodos" class="text-[10px] bg-slate-800 text-slate-400 px-2 py-0.5 rounded-full font-mono">0</span>
                        </div>
                        <p class="text-[10px] text-slate-400">Clique em <strong class="text-amber-300">Editar</strong> ou dê duplo-clique no cômodo na planta para alterar dimensões e cargas.</p>
                        <div id="listaComodos" class="space-y-2 max-h-[380px] overflow-y-auto pr-1"></div>
                    </div>
                </div>

                <!-- ÁREA DO CANVAS CAD 2D -->
                <div class="bg-slate-900 p-5 rounded-2xl border border-slate-800 lg:col-span-3 space-y-3">
                    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-2 text-xs">
                        <div class="flex items-center gap-2">
                            <span id="badgeIndicadorPavimento" class="bg-sky-500/20 text-sky-400 border border-sky-500/40 px-2.5 py-1 rounded-lg font-bold text-xs">
                                🏢 PAVIMENTO TÉRREO
                            </span>
                            <span class="text-slate-400 text-[11px]">Posicione os cômodos e conecte com a prumada elétrica vertical.</span>
                        </div>
                        
                        <!-- FERRAMENTAS CAD -->
                        <div class="flex flex-wrap items-center gap-1.5 bg-slate-950 p-1.5 rounded-xl border border-slate-800">
                            <button id="btnToolSelect" class="px-3 py-1.5 rounded-lg font-bold text-[11px] bg-amber-500 text-slate-950 flex items-center gap-1" title="Clique e arraste pelo centro para mover ou arraste o canto inferior direito para redimensionar o cômodo">
                                <i class="fa-solid fa-up-down-left-right"></i> Mover & Redimensionar Cômodo
                            </button>
                            <button id="btnToolDraw" class="px-3 py-1.5 rounded-lg font-bold text-[11px] text-slate-400 hover:text-white flex items-center gap-1">
                                <i class="fa-solid fa-pencil"></i> Mão Livre
                            </button>
                            <button id="btnClearFreehand" class="px-2.5 py-1.5 rounded-lg text-red-400 hover:text-red-300 font-bold text-[11px]" title="Limpar riscos">
                                <i class="fa-solid fa-eraser"></i> Limpar
                            </button>
                            <button onclick="abrirModalImportar()" class="px-2.5 py-1.5 rounded-lg bg-indigo-950 hover:bg-indigo-900 border border-indigo-500/40 text-indigo-300 hover:text-white font-bold text-[11px] flex items-center gap-1" title="Importar arquivo DXF / DWG / IFC">
                                <i class="fa-solid fa-file-import"></i> Importar CAD
                            </button>
                            <label class="flex items-center gap-1.5 text-[11px] text-slate-400 cursor-pointer select-none ml-1">
                                <input type="checkbox" id="chkCadUnderlay" checked onchange="toggleCadUnderlay(this.checked)" class="rounded text-indigo-500 bg-slate-950 border-slate-700">
                                <span>Planta AutoCAD Fundo</span>
                            </label>
                            <div class="w-px h-5 bg-slate-800 mx-0.5"></div>
                            <!-- NOVA OPÇÃO DE EDIÇÃO DE LAYOUT DA CONSTRUÇÃO: ÍMÃ E ALINHAMENTO -->
                            <button id="btnToggleSnapMagnetico" onclick="alternarSnapMagnetico()" class="px-2.5 py-1.5 rounded-lg font-bold text-[11px] bg-emerald-500/20 text-emerald-400 border border-emerald-500/40 hover:bg-emerald-500/30 flex items-center gap-1.5 transition active:scale-95" title="Ativar/desativar atração magnética de paredes e cômodos ao arrastar">
                                <i class="fa-solid fa-magnet text-emerald-400"></i> Ímã: <span id="lblStatusSnapMagnetico">Ativo</span>
                            </button>
                            <button onclick="autoUnirEAlinharComodos()" class="px-2.5 py-1.5 rounded-lg font-bold text-[11px] bg-gradient-to-r from-amber-600 to-amber-500 hover:from-amber-500 hover:to-amber-400 text-slate-950 flex items-center gap-1.5 shadow-md shadow-amber-500/20 transition active:scale-95" title="Unir e alinhar todos os cômodos adjacentes como um ímã, eliminando frestas e desníveis">
                                <i class="fa-solid fa-wand-magic-sparkles"></i> Unir & Alinhar Cômodos
                            </button>
                            <button id="btnConfigParedesCad" onclick="abrirModalConfigParedes()" class="px-2.5 py-1.5 rounded-lg font-bold text-[11px] bg-sky-500/20 text-sky-300 border border-sky-500/40 hover:bg-sky-500/30 flex items-center gap-1.5 transition active:scale-95" title="Configurar espessura das paredes segundo normas técnicas NBR (15575, 15270, 16868)">
                                <i class="fa-solid fa-border-all text-sky-400"></i> Parede: <span id="lblEspessuraParedeCadToolbar">15 cm</span>
                            </button>
                        </div>
                    </div>

                    <div id="containerCad2D" class="relative w-full overflow-hidden rounded-xl border-2 border-slate-800 bg-slate-950 shadow-inner transition-all">
                        <!-- BOTÃO DE SAÍDA FLUTUANTE EM TELA CHEIA (ESC) -->
                        <button id="btnExitFullscreenCad" onclick="toggleFullscreenViewport('cad')" class="fullscreen-exit-btn hidden absolute top-4 left-4 z-50 bg-rose-600/90 hover:bg-rose-500 text-white font-bold text-xs px-3.5 py-2 rounded-xl shadow-2xl items-center gap-2 border border-rose-400 backdrop-blur transition active:scale-95">
                            <i class="fa-solid fa-compress"></i> Sair da Tela Cheia (ESC)
                        </button>

                        <!-- CONTROLES DE ZOOM / PAN / TELA CHEIA -->
                        <div class="absolute top-2 right-2 z-10 flex items-center gap-1.5 bg-slate-900/90 backdrop-blur-sm border border-slate-700/80 rounded-xl p-1 shadow-lg">
                            <button onclick="ajustarZoomCad(1.15)" class="w-7 h-7 rounded-lg bg-slate-800 hover:bg-slate-700 text-white font-bold text-xs flex items-center justify-center transition active:scale-90" title="Aumentar Zoom">
                                <i class="fa-solid fa-magnifying-glass-plus"></i>
                            </button>
                            <button onclick="ajustarZoomCad(0.87)" class="w-7 h-7 rounded-lg bg-slate-800 hover:bg-slate-700 text-white font-bold text-xs flex items-center justify-center transition active:scale-90" title="Diminuir Zoom">
                                <i class="fa-solid fa-magnifying-glass-minus"></i>
                            </button>
                            <button onclick="resetarZoomCad()" class="px-2 h-7 rounded-lg bg-slate-800 hover:bg-slate-700 text-amber-300 font-bold text-[10px] flex items-center justify-center transition active:scale-90" title="Centralizar e redefinir zoom padrão"><span class="lbl-zoom-cad-pct">100%</span></button>
                            <div class="w-px h-5 bg-slate-700 mx-0.5"></div>
                            <button id="btnFullscreenCad" onclick="toggleFullscreenViewport('cad')" class="px-2.5 h-7 rounded-lg bg-amber-500 hover:bg-amber-400 text-slate-950 font-black text-xs flex items-center gap-1.5 transition shadow active:scale-90" title="Expandir Planta Baixa 2D em Tela Cheia">
                                <i class="fa-solid fa-expand"></i> <span class="hidden sm:inline text-[11px]">Tela Cheia</span>
                            </button>
                        </div>
                        <canvas id="cadCanvas" width="900" height="520" class="w-full h-[520px]"></canvas>
                    </div>

                    <!-- BARRA DE STATUS DE TRANSIÇÕES COM LEGENDA TÉCNICA -->
                    <div id="painelTransicoes" class="bg-slate-950 p-3 rounded-xl border border-slate-800 flex flex-col md:flex-row justify-between items-start md:items-center gap-3 text-xs">
                        <div class="flex flex-col gap-1.5">
                            <div class="flex items-center gap-2">
                                <span class="p-1.5 rounded-lg bg-sky-500/20 text-sky-400 border border-sky-500/40">
                                    <i class="fa-solid fa-arrows-split-up-and-left"></i>
                                </span>
                                <div>
                                    <span class="font-bold text-white block">Esquadrias & Transições entre Ambientes</span>
                                    <span id="lblResumoTransicoes" class="text-[10px] text-slate-400">Aproxime cômodos no mesmo andar para conectar com Portas ou Vãos!</span>
                                </div>
                            </div>
                            <!-- LEGENDA TÉCNICA DAS TRANSIÇÕES (NBR 6492) -->
                            <div class="flex flex-wrap items-center gap-2 pt-1 border-t border-slate-800/80 text-[11px]">
                                <span class="text-slate-400 font-bold text-[10px] uppercase tracking-wider flex items-center gap-1">
                                    <i class="fa-solid fa-circle-info text-sky-400"></i> Legenda:
                                </span>
                                <span class="inline-flex items-center gap-1 bg-amber-500/15 border border-amber-500/30 text-amber-300 px-2 py-0.5 rounded-md font-medium text-[10px]">
                                    <span class="w-2 h-2 rounded-full bg-amber-400"></span> 🚪 Porta (Arco Âmbar)
                                </span>
                                <span class="inline-flex items-center gap-1 bg-sky-500/15 border border-sky-500/30 text-sky-300 px-2 py-0.5 rounded-md font-medium text-[10px]">
                                    <span class="w-2 h-2 rounded-full bg-sky-400"></span> 🚶 Corredor (Passagem Ciano)
                                </span>
                                <span class="inline-flex items-center gap-1 bg-emerald-500/15 border border-emerald-500/30 text-emerald-300 px-2 py-0.5 rounded-md font-medium text-[10px]">
                                    <span class="w-2 h-2 rounded-full bg-emerald-400"></span> 🔲 Vão Livre (Abertura Verde)
                                </span>
                                <span class="inline-flex items-center gap-1 bg-slate-700/40 border border-slate-600/40 text-slate-300 px-2 py-0.5 rounded-md font-medium text-[10px]">
                                    <span class="w-2 h-2 rounded-full bg-slate-400"></span> 🧱 Parede (Alvenaria Contínua)
                                </span>
                                <label class="inline-flex items-center gap-1.5 text-[10px] text-slate-400 cursor-pointer select-none ml-1 hover:text-slate-200">
                                    <input type="checkbox" id="chkRotulosTransicoes" onchange="alternarRotulosTransicoes(this.checked)" class="rounded text-amber-500 bg-slate-900 border-slate-700">
                                    <span>Mostrar rótulos na planta</span>
                                </label>
                            </div>
                        </div>
                        <div id="listaBotoesTransicoes" class="flex flex-wrap gap-1.5 max-h-[140px] overflow-y-auto pr-1"></div>
                    </div>
                </div>

            </div>
        </div>

        <!-- ABA 2: INSTALAÇÕES ELÉTRICAS: TUG / TUE & ELETRODUTOS (2D AMPLIADO) -->
        <div id="tab-instalacoes" class="tab-content space-y-4">
            <div class="bg-slate-900 border border-slate-800 p-5 rounded-2xl shadow-xl space-y-4">
                <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-3 border-b border-slate-800 pb-3">
                    <div>
                        <div class="flex items-center gap-2">
                            <h2 class="text-base font-black text-amber-400 flex items-center gap-2">
                                <i class="fa-solid fa-bolt-lightning text-sky-400 text-xl"></i>
                                INSTALAÇÕES ELÉTRICAS POR PAVIMENTO
                            </h2>
                            <span id="badgeInstalacoesPavimento" class="bg-sky-500/20 text-sky-300 border border-sky-500/40 px-2 py-0.5 rounded text-[10px] font-bold">TÉRREO</span>
                        </div>
                        <p class="text-slate-400 text-xs mt-0.5">
                            Arraste livremente as tomadas pelas paredes. Ajuste os eletrodutos criando curvas manuais e interligue os andares através da Prumada Vertical!
                        </p>
                    </div>
                    
                    <!-- FERRAMENTAS -->
                    <div class="flex flex-wrap items-center gap-2">
                        <button id="btnToolMoverComodosInst" class="px-3 py-1.5 rounded-xl font-bold text-xs bg-slate-800 hover:bg-slate-700 text-amber-400 border border-slate-700 flex items-center gap-1.5" title="Mover ou redimensionar cômodos na Aba 2">
                            <i class="fa-solid fa-arrows-up-down-left-right"></i> Mover/Redimensionar Cômodos
                        </button>
                        <button onclick="autoUnirEAlinharComodos()" class="px-3 py-1.5 rounded-xl font-bold text-xs bg-gradient-to-r from-amber-600 to-amber-500 hover:from-amber-500 hover:to-amber-400 text-slate-950 flex items-center gap-1.5 shadow" title="Unir e alinhar todos os cômodos adjacentes como um ímã">
                            <i class="fa-solid fa-wand-magic-sparkles"></i> Unir Cômodos (Ímã)
                        </button>
                        <button id="btnToolMoverPontos" class="px-3 py-1.5 rounded-xl font-bold text-xs bg-amber-500 text-slate-950 flex items-center gap-1.5 shadow">
                            <i class="fa-solid fa-up-down-left-right"></i> Arrastar Tomadas
                        </button>
                        <button id="btnToolCurvasEletroduto" class="px-3 py-1.5 rounded-xl font-bold text-xs bg-slate-800 hover:bg-slate-700 text-sky-400 border border-slate-700 flex items-center gap-1.5">
                            <i class="fa-solid fa-bezier-curve"></i> Curvar / Desviar Eletrodutos
                        </button>
                        <button id="btnAdicionarIlumRapida" onclick="abrirModalPontoNovo('ILUM')" class="px-3 py-1.5 rounded-xl font-bold text-xs bg-amber-600 hover:bg-amber-500 text-white flex items-center gap-1.5 shadow-md shadow-amber-600/25 ring-1 ring-amber-400/40" title="Adicionar ponto de iluminação (Lâmpada de teto, spot ou arandela)">
                            <i class="fa-solid fa-lightbulb"></i> + Iluminação
                        </button>
                        <button id="btnAdicionarTugRapida" class="px-3 py-1.5 rounded-xl font-bold text-xs bg-emerald-700 hover:bg-emerald-600 text-white flex items-center gap-1.5">
                            <i class="fa-solid fa-plus-circle"></i> + Nova TUG
                        </button>
                        <button id="btnAdicionarTueRapida" class="px-3 py-1.5 rounded-xl font-bold text-xs bg-blue-700 hover:bg-blue-600 text-white flex items-center gap-1.5">
                            <i class="fa-solid fa-bolt"></i> + Nova TUE
                        </button>
                        <button id="btnAdicionarInterruptorRapida" onclick="abrirModalPontoNovo('INTERRUPTOR')" class="px-3 py-1.5 rounded-xl font-bold text-xs bg-purple-700 hover:bg-purple-600 text-white flex items-center gap-1.5 shadow-md shadow-purple-700/20" title="Adicionar interruptor de parede">
                            <i class="fa-solid fa-toggle-on"></i> + Interruptor
                        </button>
                        <!-- BOTÃO DE ROTEAMENTO HORIZONTAL / RADIAL DE TOMADAS -->
                        <button id="btnTogglePassagemTomadasToolbar" onclick="alternarPassagemTomadasComodo()" class="px-3 py-1.5 rounded-xl font-bold text-xs bg-slate-900 hover:bg-slate-800 text-amber-300 border border-amber-500/40 flex items-center gap-1.5 shadow" title="Alternar passagem das tomadas deste cômodo entre Horizontal na Parede e Radial pelo Teto">
                            <i class="fa-solid fa-arrows-left-right text-emerald-400"></i> Tomadas: <span id="lblStatusPassagemTomadaToolbar">Horizontal (Parede)</span>
                        </button>
                        <button id="btnToggleRotulosInstalacoes" onclick="alternarExibicaoRotulosInstalacoes()" class="px-3 py-1.5 rounded-xl font-bold text-xs bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700 flex items-center gap-1.5" title="Alternar visualização de rótulos no desenho">
                            <i class="fa-solid fa-eye-slash text-amber-400"></i> Rótulos: <span id="lblStatusRotulosInstalacoes" class="text-amber-400">Ocultos</span>
                        </button>
                        <button onclick="resetarTodasCurvasEletrodutos()" class="px-2.5 py-1.5 rounded-xl text-slate-400 hover:text-amber-400 bg-slate-950 border border-slate-800 text-xs" title="Redefinir traçados">
                            <i class="fa-solid fa-rotate-left"></i> Redefinir
                        </button>
                        <button id="btnConfigParedesInst" onclick="abrirModalConfigParedes()" class="px-3 py-1.5 rounded-xl font-bold text-xs bg-sky-950/60 hover:bg-sky-900/80 text-sky-300 border border-sky-500/40 flex items-center gap-1.5 transition" title="Configurar espessura das paredes segundo normas técnicas NBR">
                            <i class="fa-solid fa-border-all text-sky-400"></i> Parede: <span id="lblEspessuraParedeInstToolbar">15 cm</span>
                        </button>
                    </div>
                </div>

                <div class="flex flex-col lg:flex-row gap-4 items-start w-full">
                <div id="containerInstalacoes2D" class="relative flex-1 min-w-0 w-full overflow-hidden rounded-2xl border-2 border-sky-950/70 bg-slate-950 shadow-2xl transition-all">
                        <!-- BOTÃO DE SAÍDA FLUTUANTE EM TELA CHEIA (ESC) -->
                        <button id="btnExitFullscreenInstalacoes" onclick="toggleFullscreenViewport('instalacoes')" class="fullscreen-exit-btn hidden absolute top-4 left-4 z-50 bg-rose-600/90 hover:bg-rose-500 text-white font-bold text-xs px-3.5 py-2 rounded-xl shadow-2xl items-center gap-2 border border-rose-400 backdrop-blur transition active:scale-95">
                            <i class="fa-solid fa-compress"></i> Sair da Tela Cheia (ESC)
                        </button>

                        <!-- CONTROLES DE ZOOM NA TELA DE INSTALAÇÕES E TELA CHEIA -->
                        <div class="absolute top-2 right-2 z-10 flex items-center gap-1.5 bg-slate-900/90 backdrop-blur-sm border border-slate-700/80 rounded-xl p-1 shadow-lg">
                            <button onclick="ajustarZoomCad(1.15)" class="w-7 h-7 rounded-lg bg-slate-800 hover:bg-slate-700 text-white font-bold text-xs flex items-center justify-center transition active:scale-90" title="Aumentar Zoom">
                                <i class="fa-solid fa-magnifying-glass-plus"></i>
                            </button>
                            <button onclick="ajustarZoomCad(0.87)" class="w-7 h-7 rounded-lg bg-slate-800 hover:bg-slate-700 text-white font-bold text-xs flex items-center justify-center transition active:scale-90" title="Diminuir Zoom">
                                <i class="fa-solid fa-magnifying-glass-minus"></i>
                            </button>
                            <button onclick="resetarZoomCad()" class="px-2 h-7 rounded-lg bg-slate-800 hover:bg-slate-700 text-amber-300 font-bold text-[10px] flex items-center justify-center transition active:scale-90" title="100%"><span class="lbl-zoom-cad-pct">100%</span></button>
                            <button onclick="centralizarProjetoNoCanvas('instalacoesCanvas'); desenharInstalacoes();" class="px-2 h-7 rounded-lg bg-slate-800 hover:bg-slate-700 text-sky-300 font-bold text-[10px] flex items-center gap-1 transition active:scale-90" title="Centralizar Desenho na Tela"><i class="fa-solid fa-arrows-to-dot"></i> <span class="hidden sm:inline">Centralizar</span></button>
                            <button onclick="centralizarProjetoNoCanvas('cadCanvas'); desenharCAD();" class="px-2 h-7 rounded-lg bg-slate-800 hover:bg-slate-700 text-sky-300 font-bold text-[10px] flex items-center gap-1 transition active:scale-90" title="Centralizar Desenho na Tela"><i class="fa-solid fa-arrows-to-dot"></i> <span class="hidden sm:inline">Centralizar</span></button>
                            <div class="w-px h-5 bg-slate-700 mx-0.5"></div>
                            <button id="btnFullscreenInstalacoes" onclick="toggleFullscreenViewport('instalacoes')" class="px-2.5 h-7 rounded-lg bg-sky-500 hover:bg-sky-400 text-slate-950 font-black text-xs flex items-center gap-1.5 transition shadow active:scale-90" title="Expandir Passagem de Cabos e Eletrodutos em Tela Cheia">
                                <i class="fa-solid fa-expand"></i> <span class="hidden sm:inline text-[11px]">Tela Cheia</span>
                            </button>
                        </div>
                    <canvas id="instalacoesCanvas" width="1120" height="620" class="w-full h-[620px] cursor-crosshair"></canvas>
                    
                    <div id="dicaModoInstalacoes" class="absolute bottom-3 left-3 bg-slate-900/90 backdrop-blur-sm border border-slate-700 text-slate-300 px-3 py-1.5 rounded-xl text-xs flex items-center gap-2 pointer-events-none shadow-lg">
                        <i class="fa-solid fa-info-circle text-sky-400"></i>
                        <span id="txtDicaInstalacoes">Clique e arraste as tomadas pelas paredes do andar selecionado!</span>
                    </div>
                
                    <!-- TOOLTIP FLUTUANTE DE HOVER NOS ÍCONES DO CANVAS -->
                    <div id="tooltipInstalacoesCanvas" class="hidden absolute pointer-events-none z-30 bg-slate-900/95 backdrop-blur-md border border-sky-500/50 text-white rounded-xl px-3 py-2 text-xs shadow-2xl transition-opacity">
                        <div id="tooltipInstalacoesTitulo" class="font-bold flex items-center gap-1.5 text-amber-300"></div>
                        <div id="tooltipInstalacoesSub" class="text-[11px] text-slate-300"></div>
                    </div>
                </div>

                <!-- LEGENDA TÉCNICA LATERAL (NBR 5410 / NBR 5444) -->
                <aside id="legendaLateralInstalacoes" class="w-full lg:w-72 xl:w-80 shrink-0 bg-slate-950/95 border border-slate-800 rounded-2xl p-4 shadow-xl space-y-3.5 text-xs text-slate-300">
                    <!-- Cabeçalho da Legenda -->
                    <div class="flex items-center justify-between border-b border-slate-800 pb-2.5">
                        <div class="flex items-center gap-2">
                            <div class="w-7 h-7 rounded-lg bg-amber-500/20 text-amber-400 flex items-center justify-center font-bold">
                                <i class="fa-solid fa-list-check"></i>
                            </div>
                            <div>
                                <h3 class="font-black text-white text-xs uppercase tracking-wide">LEGENDA DO PROJETO</h3>
                                <p class="text-[10px] text-slate-400 font-mono">Normas NBR 5410 & 5444</p>
                            </div>
                        </div>
                        <span id="badgeLegendaPavimento" class="bg-sky-500/20 text-sky-300 border border-sky-500/40 px-2 py-0.5 rounded text-[9px] font-bold uppercase">TÉRREO</span>
                    </div>

                    <!-- 1. Simbologia dos Ícones de Pontos -->
                    <div>
                        <h4 class="text-[10px] font-black uppercase tracking-wider text-amber-400 mb-2 flex items-center gap-1.5">
                            <i class="fa-solid fa-shapes text-[9px]"></i> Símbolos dos Pontos
                        </h4>
                        <div class="space-y-1.5 text-[11px]">
                            <!-- Iluminação -->
                            <div class="flex items-center justify-between p-1.5 rounded-lg bg-slate-900/70 border border-slate-800/80 hover:border-amber-500/40 transition">
                                <div class="flex items-center gap-2">
                                    <span class="w-4 h-4 rounded-full border-2 border-amber-400 bg-amber-400/30 flex items-center justify-center shrink-0">
                                        <span class="w-1.5 h-1.5 rounded-full bg-amber-300"></span>
                                    </span>
                                    <span class="text-slate-200 font-medium">Iluminação no Teto</span>
                                </div>
                                <span class="text-[9px] text-amber-300 font-mono font-bold">Lâmpada</span>
                            </div>

                            <!-- TUG Baixa -->
                            <div class="flex items-center justify-between p-1.5 rounded-lg bg-slate-900/70 border border-slate-800/80 hover:border-emerald-500/40 transition">
                                <div class="flex items-center gap-2">
                                    <span class="w-4 h-4 rounded-full border-2 border-emerald-500 bg-white flex items-center justify-center shrink-0"></span>
                                    <span class="text-slate-200 font-medium">Tomada Baixa (TUG)</span>
                                </div>
                                <span class="text-[9px] text-emerald-400 font-mono font-bold">h = 0,30m</span>
                            </div>

                            <!-- TUG Média -->
                            <div class="flex items-center justify-between p-1.5 rounded-lg bg-slate-900/70 border border-slate-800/80 hover:border-emerald-500/40 transition">
                                <div class="flex items-center gap-2">
                                    <span class="w-4 h-4 rounded-full border-2 border-emerald-500 overflow-hidden flex flex-col shrink-0">
                                        <span class="w-full h-1/2 bg-white"></span>
                                        <span class="w-full h-1/2 bg-emerald-500"></span>
                                    </span>
                                    <span class="text-slate-200 font-medium">Tomada Média (TUG)</span>
                                </div>
                                <span class="text-[9px] text-emerald-400 font-mono font-bold">h = 1,20m</span>
                            </div>

                            <!-- TUG Alta -->
                            <div class="flex items-center justify-between p-1.5 rounded-lg bg-slate-900/70 border border-slate-800/80 hover:border-emerald-500/40 transition">
                                <div class="flex items-center gap-2">
                                    <span class="w-4 h-4 rounded-full border-2 border-emerald-500 bg-emerald-500 flex items-center justify-center shrink-0"></span>
                                    <span class="text-slate-200 font-medium">Tomada Alta (TUG)</span>
                                </div>
                                <span class="text-[9px] text-emerald-400 font-mono font-bold">h = 2,00m</span>
                            </div>

                            <!-- TUE -->
                            <div class="flex items-center justify-between p-1.5 rounded-lg bg-slate-900/70 border border-slate-800/80 hover:border-blue-500/40 transition">
                                <div class="flex items-center gap-2">
                                    <span class="w-4 h-4 rounded-full border-2 border-blue-400 bg-blue-600 flex items-center justify-center text-white text-[8px] shrink-0 font-black">▲</span>
                                    <span class="text-slate-200 font-medium">Tomada Especial (TUE)</span>
                                </div>
                                <span class="text-[9px] text-blue-300 font-mono font-bold">220V Dedicado</span>
                            </div>

                            <!-- Interruptor -->
                            <div class="flex items-center justify-between p-1.5 rounded-lg bg-slate-900/70 border border-slate-800/80 hover:border-purple-500/40 transition">
                                <div class="flex items-center gap-2">
                                    <span class="w-4 h-4 rounded-full border border-purple-300 bg-purple-600 flex items-center justify-center text-white text-[8px] font-bold shrink-0">S</span>
                                    <span class="text-slate-200 font-medium">Interruptor Simples</span>
                                </div>
                                <span class="text-[9px] text-purple-300 font-mono font-bold">Comando</span>
                            </div>

                            <!-- QDT & Prumada -->
                            <div class="grid grid-cols-2 gap-1.5 pt-0.5">
                                <div class="flex items-center gap-1.5 p-1.5 rounded-lg bg-slate-900/70 border border-slate-800/80">
                                    <span class="w-3.5 h-3 rounded-sm bg-red-600 border border-white shrink-0"></span>
                                    <span class="text-[10px] text-slate-200 font-medium">QDT Geral</span>
                                </div>
                                <div class="flex items-center gap-1.5 p-1.5 rounded-lg bg-slate-900/70 border border-slate-800/80">
                                    <span class="w-3.5 h-3.5 rounded-full bg-amber-500 border border-white text-slate-950 text-[8px] flex items-center justify-center font-black shrink-0">▲</span>
                                    <span class="text-[10px] text-slate-200 font-medium">Prumada</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 2. Simbologia de Eletrodutos e Condutores -->
                    <div>
                        <h4 class="text-[10px] font-black uppercase tracking-wider text-sky-400 mb-2 flex items-center gap-1.5">
                            <i class="fa-solid fa-bezier-curve text-[9px]"></i> Eletrodutos & Fiação
                        </h4>
                        <div class="space-y-1 text-[11px]">
                            <div class="flex items-center justify-between py-1 px-1.5 rounded bg-slate-900/50">
                                <span class="flex items-center gap-2">
                                    <span class="w-6 h-0.5 border-t-2 border-dashed border-sky-400 inline-block"></span>
                                    <span>Infra Teto / Laje</span>
                                </span>
                                <span class="text-[9px] text-sky-400 font-mono">#38bdf8</span>
                            </div>
                            <div class="flex items-center justify-between py-1 px-1.5 rounded bg-slate-900/50">
                                <span class="flex items-center gap-2">
                                    <span class="w-6 h-0.5 border-t-2 border-dotted border-orange-500 inline-block"></span>
                                    <span>Infra Piso / Chão</span>
                                </span>
                                <span class="text-[9px] text-orange-400 font-mono">#f97316</span>
                            </div>
                            <div class="flex items-center justify-between py-1 px-1.5 rounded bg-slate-900/50">
                                <span class="flex items-center gap-2">
                                    <span class="w-6 h-0.5 bg-emerald-500 inline-block"></span>
                                    <span>Circuito TUG</span>
                                </span>
                                <span class="text-[9px] text-emerald-400 font-mono">#10b981</span>
                            </div>
                            <div class="flex items-center justify-between py-1 px-1.5 rounded bg-slate-900/50">
                                <span class="flex items-center gap-2">
                                    <span class="w-6 h-0.5 border-t-2 border-dashed border-blue-500 inline-block"></span>
                                    <span>Circuito TUE</span>
                                </span>
                                <span class="text-[9px] text-blue-400 font-mono">#3b82f6</span>
                            </div>
                            <div class="flex items-center justify-between py-1 px-1.5 rounded bg-slate-900/50">
                                <span class="flex items-center gap-2">
                                    <span class="w-6 h-0.5 bg-purple-500 inline-block"></span>
                                    <span>Condutor Retorno</span>
                                </span>
                                <span class="text-[9px] text-purple-400 font-mono">#a855f7</span>
                            </div>
                        </div>
                    </div>

                    <!-- 3. Pontos Instalados no Pavimento Ativo (Interativo) -->
                    <div class="border-t border-slate-800 pt-2.5">
                        <div class="flex items-center justify-between mb-2">
                            <h4 class="text-[10px] font-black uppercase tracking-wider text-emerald-400 flex items-center gap-1.5">
                                <i class="fa-solid fa-plug text-[9px]"></i> Pontos do Andar (<span id="countLegendaTotalPontos">0</span>)
                            </h4>
                            <span id="txtLegendaPotenciaTotal" class="text-[10px] font-mono font-bold text-amber-400 bg-amber-500/10 px-1.5 py-0.5 rounded border border-amber-500/30">0 W</span>
                        </div>
                        <div id="listaPontosLegendaLateral" class="max-h-56 overflow-y-auto space-y-1 pr-1 custom-scroll">
                            <!-- Preenchido dinamicamente via JS -->
                        </div>
                    </div>
                </aside>
            </div>


                <!-- PAINEL DO PONTO SELECIONADO -->
                <div id="painelPontoSelecionado" class="hidden bg-slate-950 p-4 rounded-xl border border-sky-500/40 flex flex-col md:flex-row justify-between items-center gap-3 text-xs">
                    <div class="flex items-center gap-3">
                        <span id="badgeTipoPontoSel" class="px-2.5 py-1 rounded-lg text-xs font-bold uppercase bg-emerald-500/20 text-emerald-300 border border-emerald-500/40">TUG</span>
                        <div>
                            <span id="txtNomePontoSel" class="font-bold text-white text-sm block">Tomada</span>
                            <span id="txtDetalhesPontoSel" class="text-slate-400 text-[11px]">100 W • 127V</span>
                        </div>
                    </div>
                    <div class="flex items-center gap-2">
                        <button onclick="editarPontoSelecionado()" class="bg-slate-800 hover:bg-slate-700 text-amber-400 font-bold px-3 py-1.5 rounded-lg border border-slate-700 transition flex items-center gap-1.5">
                            <i class="fa-solid fa-pen"></i> Editar
                        </button>
                        <button onclick="excluirPontoSelecionado()" class="bg-red-950/80 hover:bg-red-900 text-red-300 font-bold px-3 py-1.5 rounded-lg border border-red-800 transition flex items-center gap-1.5">
                            <i class="fa-solid fa-trash-can"></i> Excluir
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- ABA 3: MAQUETE 3D & BIM (NOVA ABA: RENDERIZADOR WEBGL THREE.JS) -->
        <div id="tab-visualizacao3d" class="tab-content space-y-4">
            <div class="bg-slate-900 border border-slate-800 p-5 rounded-2xl shadow-xl space-y-4">
                <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-3 border-b border-slate-800 pb-3">
                    <div>
                        <h2 class="text-base font-black text-emerald-400 flex flex-wrap items-center gap-2">
                            <i class="fa-solid fa-cube text-xl"></i>
                            MAQUETE 3D BIM & INFRAESTRUTURA ELÉTRICA MULTI-PAVIMENTOS
                            <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-emerald-950/80 text-emerald-300 border border-emerald-500/40 shadow-sm" title="Motor Three.js renderiza estritamente sob demanda: quando a câmera pára ou quando em outras abas, o consumo de GPU e bateria fica zerado">
                                <i class="fa-solid fa-bolt text-amber-400"></i> Render sob Demanda (0% GPU Idle)
                            </span>
                        </h2>
                        <p class="text-slate-400 text-xs mt-0.5">
                            Gire com o mouse para ver lajes sobrepostas, paredes em 3D, lâmpadas com luz emissiva, tomadas nas alturas reais e eletrodutos espaciais!
                        </p>
                    </div>

                    <!-- BARRA DE FERRAMENTAS 3D -->
                    <div class="flex flex-wrap items-center gap-2 text-xs">
                        <div class="flex bg-slate-950 p-1 rounded-xl border border-slate-800">
                            <button id="btn3dVerTodos" onclick="setFiltro3d('todos')" class="px-3 py-1.5 rounded-lg font-bold bg-emerald-500 text-slate-950 shadow">
                                Todos Andares
                            </button>
                            <button id="btn3dVerTerreo" onclick="setFiltro3d('terreo')" class="px-3 py-1.5 rounded-lg font-bold text-slate-400 hover:text-white">
                                Só Térreo
                            </button>
                            <button id="btn3dVerSuperior" onclick="setFiltro3d('superior')" class="px-3 py-1.5 rounded-lg font-bold text-slate-400 hover:text-white">
                                Só 1º Andar
                            </button>
                        </div>
                        <!-- FILTRO VISUAL DE ELEMENTOS 3D -->
                        <div class="flex bg-slate-950 p-1 rounded-xl border border-slate-800">
                            <button id="btn3dFiltroTodosElem" onclick="setFiltroElemento3d('todos')" class="px-2.5 py-1.5 rounded-lg font-bold bg-slate-800 text-emerald-400 shadow text-xs">
                                Todos
                            </button>
                            <button id="btn3dFiltroIlum" onclick="setFiltroElemento3d('ilum')" class="px-2.5 py-1.5 rounded-lg font-bold text-slate-400 hover:text-amber-300 text-xs flex items-center gap-1" title="Visualizar e destacar apenas iluminação">
                                <i class="fa-solid fa-lightbulb text-amber-400"></i> Luzes
                            </button>
                            <button id="btn3dFiltroTomadas" onclick="setFiltroElemento3d('tomadas')" class="px-2.5 py-1.5 rounded-lg font-bold text-slate-400 hover:text-emerald-300 text-xs flex items-center gap-1" title="Visualizar e destacar apenas tomadas e interruptores">
                                <i class="fa-solid fa-plug text-emerald-400"></i> Tomadas
                            </button>
                            <button id="btn3dFiltroTubos" onclick="setFiltroElemento3d('tubos')" class="px-2.5 py-1.5 rounded-lg font-bold text-slate-400 hover:text-sky-300 text-xs flex items-center gap-1" title="Visualizar e destacar apenas eletrodutos e fiação">
                                <i class="fa-solid fa-wave-square text-sky-400"></i> Tubos
                            </button>
                        </div>
                        <!-- VISUALIZAÇÃO GLOBAL 3D DE LAJES -->
                        <div class="flex bg-slate-950 p-1 rounded-xl border border-slate-800">
                            <button id="btn3dVerLajesPiso" onclick="toggle3dLajesPiso()" class="px-2.5 py-1.5 rounded-lg font-bold bg-amber-500/30 text-amber-300 border border-amber-500/60 flex items-center gap-1 shadow" title="Exibir/ocultar lajes de chão/piso em 3D">
                                🧱 Lajes Piso
                            </button>
                            <button id="btn3dVerLajesTeto" onclick="toggle3dLajesTeto()" class="px-2.5 py-1.5 rounded-lg font-bold bg-sky-500/30 text-sky-300 border border-sky-500/60 flex items-center gap-1 shadow" title="Exibir/ocultar lajes de teto/cobertura em 3D">
                                🏠 Lajes Teto
                            </button>
                        </div>
                        <button id="btn3dRaioX" onclick="toggle3dRaioX()" class="px-3 py-1.5 rounded-xl font-bold bg-slate-800 hover:bg-slate-700 text-sky-400 border border-slate-700 flex items-center gap-1.5">
                            <i class="fa-solid fa-eye"></i> Raio-X
                        </button>
                        <button id="btn3dExplodir" onclick="toggle3dExplodir()" class="px-3 py-1.5 rounded-xl font-bold bg-slate-800 hover:bg-slate-700 text-amber-400 border border-slate-700 flex items-center gap-1.5">
                            <i class="fa-solid fa-arrows-up-down"></i> Explodir Lajes
                        </button>
                        <button id="btn3dModoEdicao" onclick="toggleModoEdicao3D()" class="px-3 py-1.5 rounded-xl font-bold bg-slate-800 hover:bg-slate-700 text-emerald-400 border border-slate-700 flex items-center gap-1.5 shadow" title="Alternar entre navegar câmera e mover tomadas, luminárias e conduítes em 3D">
                            <i class="fa-solid fa-hand-pointer"></i> Arrastar / Mover Objetos 3D
                        </button>
                        <button onclick="resetarCamera3D()" class="px-3 py-1.5 rounded-xl font-bold text-slate-300 hover:text-white bg-slate-900 hover:bg-slate-800 border border-slate-700 flex items-center gap-1.5 shadow" title="Centralizar câmera e ajustar visão aos cômodos">
                            <i class="fa-solid fa-camera-rotate text-emerald-400"></i> Centralizar Visão
                        </button>
                        <button onclick="initThreeEngine(); reconstruirCena3D();" class="px-2.5 py-1.5 rounded-xl text-slate-400 hover:text-amber-300 bg-slate-950 border border-slate-800" title="Recarregar Motor 3D">
                            <i class="fa-solid fa-arrows-rotate"></i>
                        </button>
                        <button id="btn3dFullscreenToolbar" onclick="toggleFullscreenViewport('3d')" class="px-3 py-1.5 rounded-xl font-bold bg-emerald-500 hover:bg-emerald-400 text-slate-950 flex items-center gap-1.5 shadow transition active:scale-95" title="Expandir Maquete 3D em Tela Cheia">
                            <i class="fa-solid fa-expand"></i> <span>Tela Cheia 3D</span>
                        </button>
                    </div>
                </div>

                <!-- LEGENDA TÉCNICA 3D -->
                <div class="flex flex-wrap items-center gap-4 bg-slate-950 p-2 rounded-xl border border-slate-800 text-[11px]">
                    <span class="text-slate-400 font-bold uppercase text-[10px]">Diferenciação 3D & Alturas (NBR 5410):</span>
                    <span class="flex items-center gap-1 text-yellow-300 bg-yellow-950/40 px-2 py-0.5 rounded-lg border border-yellow-500/30">
                        <span class="w-3 h-3 rounded-full bg-yellow-400 shadow shadow-yellow-400/80 ring-2 ring-yellow-200"></span> 💡 Iluminação / Plafon (Teto 2.80m)
                    </span>
                    <span class="flex items-center gap-1 text-emerald-400 bg-emerald-950/40 px-2 py-0.5 rounded-lg border border-emerald-500/30">
                        <span class="w-2.5 h-3.5 rounded-sm bg-white border-2 border-emerald-500"></span> 🔌 Tomada TUG Baixa (0.30m)
                    </span>
                    <span class="flex items-center gap-1 text-amber-400 bg-amber-950/40 px-2 py-0.5 rounded-lg border border-amber-500/30">
                        <span class="w-2.5 h-3.5 rounded-sm bg-white border-2 border-amber-500"></span> 🔌 Tomada TUG Média (1.20m)
                    </span>
                    <span class="flex items-center gap-1 text-blue-400 bg-blue-950/40 px-2 py-0.5 rounded-lg border border-blue-500/30">
                        <span class="w-2.5 h-3.5 rounded-sm bg-blue-600 border border-white"></span> ⚡ Tomada TUE / Alta (2.00m)
                    </span>
                    <span class="flex items-center gap-1 text-purple-400 bg-purple-950/40 px-2 py-0.5 rounded-lg border border-purple-500/30">
                        <span class="w-2.5 h-3.5 rounded-sm bg-purple-600"></span> 🔘 Interruptor Parede (1.20m)
                    </span>
                    <span class="flex items-center gap-1 text-sky-400">
                        <span class="w-3.5 h-1 bg-sky-400 rounded"></span> Eletrodutos Teto/Chão
                    </span>
                    <span class="text-slate-500 text-[10px] ml-auto">
                        <i class="fa-solid fa-computer-mouse"></i> Botão esquerdo: Gira / Arrasta objeto • Direito: Move câmera • Scroll: Zoom
                    </span>
                </div>

                <!-- VIEWPORT 3D THREE.JS CONTAINER (1120x620) -->
                <div id="container3D" class="relative w-full overflow-hidden rounded-2xl border-2 border-emerald-950/70 bg-slate-950 shadow-2xl transition-all">
                    <!-- BOTÃO DE SAÍDA FLUTUANTE EM TELA CHEIA (ESC) -->
                    <button id="btnExitFullscreen3D" onclick="toggleFullscreenViewport('3d')" class="fullscreen-exit-btn hidden absolute top-4 left-4 z-50 bg-rose-600/90 hover:bg-rose-500 text-white font-bold text-xs px-3.5 py-2 rounded-xl shadow-2xl items-center gap-2 border border-rose-400 backdrop-blur transition active:scale-95">
                        <i class="fa-solid fa-compress"></i> Sair da Tela Cheia (ESC)
                    </button>

                    <!-- BOTÃO FLUTUANTE DE TELA CHEIA NO 3D -->
                    <div class="absolute top-3 right-3 z-20 flex items-center gap-2">
                        <button id="btnFullscreen3D" onclick="toggleFullscreenViewport('3d')" class="px-3 py-1.5 rounded-xl bg-emerald-500/90 hover:bg-emerald-400 text-slate-950 font-black text-xs flex items-center gap-1.5 shadow-xl backdrop-blur transition active:scale-90" title="Expandir Maquete 3D em Tela Cheia">
                            <i class="fa-solid fa-expand"></i> <span class="hidden sm:inline">Tela Cheia 3D</span>
                        </button>
                    </div>

                    <div id="viewport3d" class="w-full h-[620px]"></div>
                    
                    <!-- HUD OVERLAY DE FEEDBACK DA EDIÇÃO 3D -->
                    <div id="hudEdicao3D" class="hidden absolute top-4 left-4 bg-slate-900/90 backdrop-blur-md border border-emerald-500/60 p-3 rounded-xl shadow-2xl flex items-center gap-3 text-xs pointer-events-none transition-all">
                        <span class="w-8 h-8 rounded-lg bg-emerald-500/20 text-emerald-400 border border-emerald-500/40 flex items-center justify-center font-bold text-sm">
                            <i class="fa-solid fa-arrows-up-down-left-right"></i>
                        </span>
                        <div>
                            <span class="font-bold text-white block">MODO DE EDIÇÃO 3D ATIVO</span>
                            <span id="txtInfoObjeto3D" class="text-[11px] text-emerald-300">Passe o cursor sobre tomadas ou lâmpadas e arraste para reposicionar!</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ABA 4: QUADRO DE DISTRIBUIÇÃO & CIRCUITOS -->
        <div id="tab-alimentador" class="tab-content space-y-6">
            
            <!-- BARRA SELETORA DE VISUALIZAÇÃO QDT (CENTRO DE MEDIÇÃO OU IMÓVEL INDIVIDUAL) -->
            <div id="barraSeletorUnidadeQDT" class="bg-slate-900 border border-slate-800 p-4 rounded-2xl flex flex-col md:flex-row justify-between items-start md:items-center gap-3 shadow-xl">
                <div class="flex items-center gap-3">
                    <span class="p-2 rounded-xl bg-amber-500/20 text-amber-400 border border-amber-500/40 text-sm">
                        <i class="fa-solid fa-gauge-high"></i>
                    </span>
                    <div>
                        <h3 class="text-xs font-bold text-white uppercase tracking-wider flex items-center gap-2">
                            <span>Visualização de Medição & QDT:</span>
                            <span id="badgeRegimeAtivo" class="bg-amber-400/20 text-amber-300 border border-amber-400/30 text-[10px] px-2 py-0.5 rounded-full font-mono">MESMO IMÓVEL</span>
                        </h3>
                        <p id="lblSubtituloUnidadeQDT" class="text-[10px] text-slate-400">Edificação unifamiliar única: alimenta pavimentos via prumada vertical.</p>
                    </div>
                </div>
                <div id="containerBotoesUnidadesQDT" class="flex flex-wrap items-center gap-1.5 bg-slate-950 p-1.5 rounded-xl border border-slate-800">
                    <!-- Preenchido dinamicamente via renderizarBotoesUnidadesQDT() -->
                </div>
            </div>

            <!-- PAINEL OFICIAL DA CONCESSIONÁRIA / DISTRIBUIDORA LOCAL & CÁLCULO DE DEMANDA (NBR 5410 ITEM 9.5.2 & PRODIST) -->
            <div class="bg-gradient-to-r from-sky-950/90 via-slate-900 to-slate-900 border-2 border-sky-500/50 p-5 rounded-2xl shadow-2xl space-y-4">
                <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-3">
                    <div class="flex items-center gap-3.5">
                        <div class="w-12 h-12 rounded-2xl bg-sky-500/20 text-sky-400 border border-sky-500/40 flex items-center justify-center text-2xl shadow-lg shrink-0">
                            <i class="fa-solid fa-tower-broadcast"></i>
                        </div>
                        <div>
                            <div class="flex flex-wrap items-center gap-2">
                                <span class="text-[10px] font-bold uppercase tracking-wider text-sky-400 bg-sky-500/10 px-2 py-0.5 rounded border border-sky-500/30">
                                    Norma da Concessionária Local • NBR 5410 item 9.5.2
                                </span>
                                <span id="badgeStatusConcessionaria" class="bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 text-[10px] px-2 py-0.5 rounded font-bold">
                                    CONCESSIONÁRIA SELECIONADA
                                </span>
                            </div>
                            <h3 class="text-base font-black text-white mt-1 flex flex-wrap items-center gap-2">
                                <span id="lblNomeConcessionaria">CPFL Energia / RGE</span>
                                <span id="lblNormaConcessionaria" class="text-xs font-mono font-bold text-amber-300 bg-slate-950 px-2 py-0.5 rounded border border-slate-800">GED 13 / NTD 01</span>
                            </h3>
                            <p id="lblDescricaoConcessionaria" class="text-xs text-slate-300 mt-0.5">
                                Cálculo do Fator de Demanda, Ramal de Entrada e Categoria de Fornecimento em Baixa Tensão conforme regulamentação da distribuidora.
                            </p>
                        </div>
                    </div>
                    <div class="flex flex-wrap items-center gap-2 w-full md:w-auto">
                        <button onclick="abrirModalConcessionaria()" class="bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-400 hover:to-amber-500 text-slate-950 font-black py-2.5 px-4 rounded-xl text-xs flex items-center gap-2 shadow-lg shadow-amber-500/20 transition active:scale-95 flex-1 md:flex-initial justify-center">
                            <i class="fa-solid fa-building-circle-check text-sm"></i>
                            <span>Alterar Distribuidora Local</span>
                        </button>
                        <button onclick="abrirModalMemoriaDemanda()" class="bg-slate-800 hover:bg-slate-700 text-sky-300 border border-slate-700 font-bold py-2.5 px-3 rounded-xl text-xs flex items-center gap-1.5 transition flex-1 md:flex-initial justify-center" title="Ver memorial de cálculo detalhado por parcelas a, b, c, d">
                            <i class="fa-solid fa-calculator"></i> Memória de Demanda
                        </button>
                    </div>
                </div>

                <!-- CARDS DE SÍNTESE DA DEMANDA DA CONCESSIONÁRIA -->
                <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 text-xs pt-3 border-t border-slate-800">
                    <div class="bg-slate-950/80 p-3 rounded-xl border border-slate-800">
                        <span class="block text-slate-400 text-[10px] mb-0.5">Carga Instalada (Total)</span>
                        <span id="lblCargaInstaladakW" class="text-base font-black text-white font-mono">-- kW</span>
                        <span id="lblCargaInstaladakVA" class="block text-[9px] text-slate-400 font-mono">-- kVA</span>
                    </div>
                    <div class="bg-slate-950/80 p-3 rounded-xl border border-slate-800">
                        <span class="block text-slate-400 text-[10px] mb-0.5">Fator de Demanda Global</span>
                        <span id="lblFatorDemandaGlobal" class="text-base font-black text-amber-400 font-mono">-- %</span>
                        <span id="lblMetodoDemanda" class="block text-[9px] text-amber-300/80 truncate">Tabela Oficial Concessionária</span>
                    </div>
                    <div class="bg-slate-950/80 p-3 rounded-xl border border-slate-800">
                        <span class="block text-slate-400 text-[10px] mb-0.5">Demanda Máx. Provável</span>
                        <span id="lblDemandaCalculadakW" class="text-base font-black text-emerald-400 font-mono">-- kW</span>
                        <span id="lblDemandaCalculadakVA" class="block text-[9px] text-emerald-300 font-mono font-bold">-- kVA</span>
                    </div>
                    <div class="bg-slate-950/80 p-3 rounded-xl border border-slate-800">
                        <span class="block text-slate-400 text-[10px] mb-0.5">Categoria de Atendimento</span>
                        <span id="lblCategoriaAtendimento" class="text-xs font-black text-sky-300 font-mono block truncate">--</span>
                        <span id="lblTipoFornecimento" class="block text-[9px] text-slate-400">Padrão Concessionária</span>
                    </div>
                    <div class="bg-slate-950/80 p-3 rounded-xl border border-slate-800">
                        <span class="block text-slate-400 text-[10px] mb-0.5">Disjuntor Padrão Entrada</span>
                        <span id="lblDisjuntorConcessionaria" class="text-base font-black text-amber-400 font-mono">-- A</span>
                        <span id="lblCurvaDisjuntorConc" class="block text-[9px] text-amber-300 font-bold">Curva C • NBR IEC</span>
                    </div>
                    <div class="bg-slate-950/80 p-3 rounded-xl border border-slate-800">
                        <span class="block text-slate-400 text-[10px] mb-0.5">Ramal de Entrada Recomendado</span>
                        <span id="lblRamalConcessionaria" class="text-base font-black text-emerald-400 font-mono">-- mm²</span>
                        <span id="lblEletrodutoEntradaConc" class="block text-[9px] text-slate-400">Eletroduto Concessionária</span>
                    </div>
                </div>
            </div>

            <!-- SUB-PAINEL: ALIMENTAÇÃO EXTERNA & ALIMENTADOR GERAL -->
            <div class="bg-gradient-to-r from-amber-500/10 via-slate-900 to-slate-900 border-2 border-amber-500/40 p-6 rounded-2xl shadow-2xl">
                <div class="flex items-center justify-between mb-4">
                    <h2 id="tituloAlimentadorGeral" class="text-base font-black text-amber-400 flex items-center gap-2">
                        <i class="fa-solid fa-charging-station text-xl"></i> ALIMENTADOR GERAL DA EDIFICAÇÃO (NBR 5410)
                    </h2>
                    <span id="badgeModoUtilizado" class="bg-amber-400 text-slate-950 text-xs font-black px-3 py-1 rounded-full uppercase">MODO CAD AUTOMÁTICO</span>
                </div>

                <!-- ALIMENTAÇÃO EXTERNA -->
                <div class="bg-slate-950 p-4 rounded-xl border border-emerald-500/40 mb-4 space-y-3">
                    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-2 border-b border-slate-800 pb-2">
                        <div class="flex items-center gap-2">
                            <span class="p-1.5 rounded-lg bg-emerald-500/20 text-emerald-400 border border-emerald-500/40 text-xs">
                                <i class="fa-solid fa-tower-broadcast"></i>
                            </span>
                            <div>
                                <h3 class="text-xs font-bold text-white uppercase tracking-wider flex items-center gap-2">
                                    Ponto de Entrada da Concessionária
                                    <span class="bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 text-[9px] px-1.5 py-0.2 rounded font-mono">CONECTADO</span>
                                </h3>
                                <p class="text-[10px] text-slate-400">Ramal até o Quadro Geral de Distribuição (QDT Térreo) e Prumada aos Pavimentos</p>
                            </div>
                        </div>
                        <div class="flex items-center gap-2">
                            <label class="text-[11px] font-semibold text-slate-400">Sistema:</label>
                            <select id="selSistemaEntrada" class="bg-slate-900 border border-slate-700 text-amber-300 rounded-lg p-1.5 text-xs font-bold outline-none focus:ring-1 focus:ring-amber-400">
                                <option value="bifasico">Bifásico 127/220V (2 Fases + Neutro + Terra = 4 Condutores)</option>
                                <option value="trifasico">Trifásico 220/380V (3 Fases + Neutro + Terra = 5 Condutores)</option>
                                <option value="monofasico">Monofásico 127V ou 220V (Fase + Neutro + Terra = 3 Condutores)</option>
                            </select>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-4 gap-3 text-xs">
                        <div class="bg-slate-900 p-3 rounded-xl border border-slate-800">
                            <span class="block text-slate-400 text-[10px] mb-1">Distância Entrada → QDT</span>
                            <div class="flex items-center gap-1.5">
                                <input id="numDistAlimExterna" type="number" step="0.5" min="1" placeholder="Auto" class="w-20 bg-slate-950 border border-slate-700 text-amber-300 font-mono font-bold p-1 rounded text-xs text-center focus:ring-1 focus:ring-emerald-400 outline-none">
                                <span class="text-slate-400 font-mono">m</span>
                                <button id="btnRestaurarDistAlim" onclick="restaurarDistanciaAlimCad()" class="hidden text-amber-400 hover:text-amber-300 p-0.5" title="Restaurar valor do CAD"><i class="fa-solid fa-rotate-left text-[10px]"></i></button>
                                <span id="lblOrigemAlimDist" class="text-[9px] text-emerald-400 bg-emerald-500/20 px-1 py-0.5 rounded font-mono">CAD</span>
                            </div>
                        </div>

                        <div class="bg-slate-900 p-3 rounded-xl border border-slate-800">
                            <span class="block text-slate-400 text-[10px] mb-1">Qtd. de Condutores no Ramal</span>
                            <span id="lblQtdCondutoresRamal" class="text-base font-black text-emerald-400 font-mono">4 Condutores</span>
                            <span id="lblDetFiosRamal" class="block text-[9px] text-slate-400 mt-0.5">2x Fase, 1x Neutro, 1x Terra</span>
                        </div>

                        <div class="bg-slate-900 p-3 rounded-xl border border-slate-800">
                            <span class="block text-slate-400 text-[10px] mb-1">Bitola do Cabo Alimentador</span>
                            <span id="lblBitolaAlimExterna" class="text-base font-black text-amber-400 font-mono">10.0 mm²</span>
                            <span class="block text-[9px] text-slate-500 mt-0.5">Cobre Flexível 750V / 1kV</span>
                        </div>

                        <div class="bg-slate-900 p-3 rounded-xl border border-slate-800">
                            <span class="block text-slate-400 text-[10px] mb-1">Total de Cabos de Entrada</span>
                            <span id="lblMetragemTotalCaboAlim" class="text-base font-black text-sky-400 font-mono">60 m</span>
                            <span id="lblFormulaCaboAlim" class="block text-[9px] text-slate-400 mt-0.5">4 condutores × 15m</span>
                        </div>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-4 gap-4 text-xs">
                    <div class="bg-slate-950 p-4 rounded-xl border border-slate-800">
                        <span class="block text-slate-400 mb-1">Cabo Alimentador Geral</span>
                        <span id="lblCaboGeral" class="text-xl font-black text-emerald-400 font-mono">10.0 mm²</span>
                        <span class="block text-[10px] text-slate-500 mt-1">Cobre Flexível 750V (PVC 70°C)</span>
                    </div>

                    <div class="bg-slate-950 p-4 rounded-xl border border-slate-800">
                        <span class="block text-slate-400 mb-1">Cabo Proteção Geral (Terra)</span>
                        <span id="lblTerraGeral" class="text-xl font-black text-emerald-400 font-mono">10.0 mm²</span>
                        <span class="block text-[10px] text-slate-500 mt-1">NBR 5410 Tabela 54</span>
                    </div>

                    <div class="bg-slate-950 p-4 rounded-xl border border-slate-800">
                        <span class="block text-slate-400 mb-1">Disjuntor Geral</span>
                        <span id="lblDisjGeral" class="text-xl font-black text-amber-400 font-mono">50 A</span>
                        <span class="block text-[10px] font-bold text-amber-300 mt-1">Curva C (Bipolar/Trifásico)</span>
                    </div>

                    <div class="bg-slate-950 p-4 rounded-xl border border-slate-800">
                        <span class="block text-slate-400 mb-1">Proteção IDR & DPS Geral</span>
                        <span id="lblIdrGeral" class="text-xs font-bold text-blue-400 block mt-1">IDR 50A / 30mA</span>
                        <span class="text-[10px] text-slate-400 block">DPS Classe II 275V (20kA/40kA)</span>
                    </div>
                </div>
            </div>

            <!-- DISPOSIÇÃO FÍSICA DOS DISJUNTORES NO QUADRO (TRILHO DIN 35MM) -->
            <div class="bg-slate-900 p-6 rounded-2xl shadow-xl border border-slate-800 space-y-4">
                <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-2">
                    <div>
                        <h2 class="text-base font-black text-white flex items-center gap-2">
                            <i class="fa-solid fa-server text-amber-400"></i>
                            DISPOSIÇÃO FÍSICA DOS DISJUNTORES NO QUADRO (TRILHO DIN 35mm)
                        </h2>
                        <p class="text-slate-400 text-xs mt-0.5">
                            Diagrama de montagem física de todos os circuitos (Térreo + Pavimentos Superiores) balanceados por fase.
                        </p>
                    </div>
                    <span class="bg-slate-950 px-3 py-1 rounded-xl border border-slate-800 text-[11px] font-mono text-amber-300">
                        Padrão Trilho DIN 35mm • NBR IEC 60898
                    </span>
                </div>

                <!-- SUGESTÃO COMERCIAL DE CAIXA DE DISTRIBUIÇÃO (NBR 5410) -->
                <div id="cardSugestaoCaixaQdt" class="bg-gradient-to-r from-amber-500/10 via-slate-950 to-slate-900 border border-amber-500/30 p-4 rounded-xl flex flex-col md:flex-row items-start md:items-center justify-between gap-4 shadow-lg">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-xl bg-amber-500/20 border border-amber-500/40 text-amber-400 flex items-center justify-center text-lg font-bold">
                            <i class="fa-solid fa-box-archive"></i>
                        </div>
                        <div>
                            <div class="flex items-center gap-2">
                                <span class="text-xs font-black uppercase text-amber-400 tracking-wide">Dimensionamento Comercial do QDT</span>
                                <span class="px-2 py-0.5 rounded text-[9px] font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-500/40">NBR 5410 item 6.5.4.7</span>
                            </div>
                            <h3 id="txtSugestaoModeloCaixa" class="text-base font-black text-white mt-0.5">Caixa de Distribuição para 24 Módulos DIN</h3>
                            <p id="txtSugestaoDescricaoCaixa" class="text-xs text-slate-400">Capacidade ideal para acomodar disjuntores monopolares/bipolares + reserva normativa obrigatória.</p>
                        </div>
                    </div>
                    <div class="flex flex-wrap items-center gap-2 w-full md:w-auto">
                        <div class="bg-slate-950/80 px-3 py-1.5 rounded-lg border border-slate-800 text-center flex-1 md:flex-initial">
                            <span class="block text-[10px] text-slate-400">Ocupados</span>
                            <span id="badgeModulosOcupados" class="text-xs font-black text-amber-400 font-mono">--</span>
                        </div>
                        <div class="bg-slate-950/80 px-3 py-1.5 rounded-lg border border-slate-800 text-center flex-1 md:flex-initial">
                            <span class="block text-[10px] text-slate-400">Reserva NBR</span>
                            <span id="badgeModulosReserva" class="text-xs font-black text-sky-400 font-mono">--</span>
                        </div>
                        <div class="bg-slate-950/80 px-3 py-1.5 rounded-lg border border-slate-800 text-center flex-1 md:flex-initial">
                            <span class="block text-[10px] text-slate-400">Espaço Livre</span>
                            <span id="badgeModulosLivres" class="text-xs font-black text-emerald-400 font-mono">--</span>
                        </div>
                    </div>
                </div>

                <!-- QUADRO FÍSICO COM TRILHO DIN -->
                <div class="bg-slate-950 border-2 border-slate-700 rounded-2xl p-6 shadow-2xl relative overflow-hidden">
                    <div class="mb-3 flex items-center justify-between bg-slate-900/90 border border-slate-800 px-4 py-1.5 rounded-lg text-[10px] font-mono">
                        <span class="text-slate-400 flex items-center gap-2">
                            <i class="fa-solid fa-bars text-amber-400"></i>
                            Barramento Pente (Fases):
                        </span>
                        <div class="flex items-center gap-3">
                            <span class="flex items-center gap-1"><span class="w-2.5 h-2.5 rounded-full bg-red-500"></span> Fase R</span>
                            <span class="flex items-center gap-1"><span class="w-2.5 h-2.5 rounded-full bg-amber-500"></span> Fase S</span>
                            <span class="flex items-center gap-1"><span class="w-2.5 h-2.5 rounded-full bg-slate-500"></span> Fase T</span>
                        </div>
                    </div>

                    <div class="din-rail-bg p-4 rounded-xl border border-slate-700/80 my-3 shadow-inner">
