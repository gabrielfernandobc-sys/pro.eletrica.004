                ]
            }
        };

        // Estado do Fator de Demanda da Concessionária
        if (!state.concessionariaId) {
            state.concessionariaId = 'cpfl';
        }
        let tempConcessionariaSelecionada = state.concessionariaId || 'cpfl';
        let dadosUltimaDemandaCalculada = null;

        // =========================================================================
        // FUNÇÕES DO MODAL DA CONCESSIONÁRIA & CÁLCULO DE DEMANDA
        // =========================================================================
        function abrirModalConcessionaria() {
            tempConcessionariaSelecionada = state.concessionariaId || 'cpfl';
            renderizarListaConcessionarias();
            const modal = document.getElementById('modalConcessionariaLocal');
            if (modal) modal.classList.remove('hidden');
        }

        function fecharModalConcessionaria() {
            const modal = document.getElementById('modalConcessionariaLocal');
            if (modal) modal.classList.add('hidden');
        }

        function renderizarListaConcessionarias() {
            const grid = document.getElementById('gridConcessionarias');
            if (!grid) return;
            grid.innerHTML = '';

            const busca = (document.getElementById('txtBuscaConcessionaria')?.value || '').toLowerCase().trim();
            const ufFiltro = document.getElementById('selFiltroUfConcessionaria')?.value || 'todos';

            Object.values(CONCESSIONARIAS_BR).forEach(c => {
                const bateUf = ufFiltro === 'todos' || c.ufs.includes(ufFiltro) || (ufFiltro === 'outros' && c.ufs.includes('outros'));
                const bateBusca = !busca || c.nome.toLowerCase().includes(busca) || c.norma.toLowerCase().includes(busca) || c.ufs.some(u => u.toLowerCase().includes(busca)) || c.descricao.toLowerCase().includes(busca);

                if (!bateUf || !bateBusca) return;

                const isSelected = (c.id === tempConcessionariaSelecionada);
                const card = document.createElement('div');
                card.className = `p-3.5 rounded-xl border-2 cursor-pointer transition flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 ${isSelected ? 'bg-sky-950/60 border-sky-400 shadow-lg shadow-sky-500/20' : 'bg-slate-900 border-slate-800 hover:border-slate-700 hover:bg-slate-850'}`;
                card.onclick = () => {
                    tempConcessionariaSelecionada = c.id;
                    const lblTensao = document.getElementById('lblTensaoNominalConcessionaria');
                    if (lblTensao) lblTensao.innerText = c.tensao;
                    renderizarListaConcessionarias();
                };

                card.innerHTML = `
                    <div class="flex items-center gap-3">
                        <div class="w-8 h-8 rounded-lg ${isSelected ? 'bg-sky-500 text-slate-950 font-black' : 'bg-slate-800 text-slate-400'} flex items-center justify-center text-sm shrink-0">
                            ${isSelected ? '<i class="fa-solid fa-check"></i>' : '<i class="fa-solid fa-tower-broadcast"></i>'}
                        </div>
                        <div>
                            <div class="flex items-center gap-2">
                                <span class="font-black text-sm ${isSelected ? 'text-white' : 'text-slate-200'}">${c.nome}</span>
                                <span class="text-[10px] font-mono font-bold px-2 py-0.5 rounded bg-slate-950 border border-slate-700 text-amber-300">${c.norma}</span>
                            </div>
                            <p class="text-[11px] text-slate-400 mt-0.5">${c.descricao}</p>
                            <div class="flex items-center gap-2 mt-1 text-[10px] text-slate-400">
                                <span><strong class="text-sky-400">UF:</strong> ${c.ufs.join(', ')}</span>
                                <span>•</span>
                                <span><strong class="text-amber-400">Tensão Padrão:</strong> ${c.tensao}</span>
                            </div>
                        </div>
                    </div>
                    <div class="shrink-0 flex items-center gap-1.5 self-end sm:self-center">
                        <span class="text-xs font-bold ${isSelected ? 'text-sky-400' : 'text-slate-500'}">
                            ${isSelected ? 'SELECIONADA' : 'Selecionar'}
                        </span>
                        <i class="fa-solid fa-chevron-right text-xs ${isSelected ? 'text-sky-400' : 'text-slate-600'}"></i>
                    </div>
                `;
                grid.appendChild(card);
            });
        }

        function filtrarListaConcessionarias() {
            renderizarListaConcessionarias();
        }

        function confirmarConcessionariaSelecionada() {
            state.concessionariaId = tempConcessionariaSelecionada;
            fecharModalConcessionaria();
            atualizarTabelas();
            salvarProjetoSilencioso();
        }

        // =========================================================================
        // MOTOR DE CÁLCULO NORMATIVO DE DEMANDA DA CONCESSIONÁRIA
        // =========================================================================
        function calcularDemandaConcessionaria(totIlum, totTug, tues, sistemaAlim, concessionariaId) {
            const conc = CONCESSIONARIAS_BR[concessionariaId] || CONCESSIONARIAS_BR.cpfl;

            // 1. PARCELA a: Iluminação e TUGs (kW)
            const potIlumTugKW = (totIlum + totTug) / 1000.0;
            let demandaIlumTugKW = 0;
            let restanteKW = potIlumTugKW;

            const memoriaParcelaA = [];
            conc.tabelaIlumTug.forEach(faixa => {
                if (restanteKW <= 0) return;
                const faixaTamanho = faixa.ate - faixa.de;
                const kwNestaFaixa = Math.min(restanteKW, faixaTamanho);
                const demFaixa = kwNestaFaixa * faixa.fd;
                demandaIlumTugKW += demFaixa;
                memoriaParcelaA.push({
                    faixa: `${faixa.de.toFixed(1)} a ${faixa.ate === 999 ? 'acima' : faixa.ate.toFixed(1)} kW`,
                    potencia: kwNestaFaixa,
                    fd: faixa.fd,
                    demanda: demFaixa
                });
                restanteKW -= kwNestaFaixa;
            });

            // 2. PARCELA b: Cargas de Aquecimento / Resistivas (Chuveiros, Torneiras, Fornos, Boilers)
            let potAquecKW = 0;
            let qtdAparelhosAquec = 0;
            const aparelhosAquec = [];

            // 3. PARCELA c: Ar Condicionado
            let potArCondKW = 0;
            let qtdArCond = 0;
            const aparelhosAr = [];

            // 4. PARCELA d: Outras cargas / Motores
            let potOutrasKW = 0;

            tues.forEach(pt => {
                const nome = (pt.nome || '').toLowerCase();
                const kw = pt.pot / 1000.0;
                if (nome.includes('chuveiro') || nome.includes('torneira') || nome.includes('aquecedor') || nome.includes('boiler') || nome.includes('forno') || nome.includes('cooktop')) {
                    potAquecKW += kw;
                    qtdAparelhosAquec++;
                    aparelhosAquec.push({ nome: pt.nome, potKW: kw });
                } else if (nome.includes('ar ') || nome.includes('condicionado') || nome.includes('climatizador') || nome.includes('split')) {
                    potArCondKW += kw;
                    qtdArCond++;
                    aparelhosAr.push({ nome: pt.nome, potKW: kw });
                } else {
                    potOutrasKW += kw;
                }
            });

            // Fator de Demanda Aquecimento por Quantidade
            const idxAquec = Math.min(qtdAparelhosAquec, conc.fdAquecimento.length) - 1;
            const fdAquec = qtdAparelhosAquec > 0 ? (conc.fdAquecimento[idxAquec] || 0.40) : 0;
            const demandaAquecKW = potAquecKW * fdAquec;

            // Fator de Demanda Ar Condicionado por Quantidade
            const idxAr = Math.min(qtdArCond, conc.fdArCond.length) - 1;
            const fdAr = qtdArCond > 0 ? (conc.fdArCond[idxAr] || 0.60) : 0;
            const demandaArKW = potArCondKW * fdAr;

            // Demanda Outras Cargas (fator 0.70 padrão)
            const demandaOutrasKW = potOutrasKW * 0.70;

            // DEMANDA TOTAL DA EDIFICAÇÃO (kW e kVA)
            const demandaTotalKW = demandaIlumTugKW + demandaAquecKW + demandaArKW + demandaOutrasKW;
            const cargaInstaladaTotalKW = potIlumTugKW + potAquecKW + potArCondKW + potOutrasKW;
            const fatorDemandaGlobal = cargaInstaladaTotalKW > 0 ? (demandaTotalKW / cargaInstaladaTotalKW) : 0.6;

            const fp = 0.95; // Fator de Potência Normativo Residencial
            const demandaTotalkVA = demandaTotalKW / fp;

            // Determinação da Categoria de Atendimento da Concessionária
            let categoriaAtend = conc.categorias[0];
            for (let i = 0; i < conc.categorias.length; i++) {
                const cat = conc.categorias[i];
                if (sistemaAlim === 'monofasico' && cat.tipo === 'Monofásico' && demandaTotalkVA <= cat.kvaMax) {
                    categoriaAtend = cat;
                    break;
                } else if (sistemaAlim === 'bifasico' && (cat.tipo === 'Bifásico' || cat.tipo === 'Trifásico') && demandaTotalkVA <= cat.kvaMax) {
                    categoriaAtend = cat;
                    break;
                } else if (sistemaAlim === 'trifasico' && cat.tipo === 'Trifásico' && demandaTotalkVA <= cat.kvaMax) {
                    categoriaAtend = cat;
                    break;
                }
                categoriaAtend = cat; // fallback para maior categoria se exceder
            }

            return {
                concessionaria: conc,
                cargaInstaladaTotalKW,
                demandaTotalKW,
                demandaTotalkVA,
                fatorDemandaGlobal,
                parcelaA: { potKW: potIlumTugKW, demKW: demandaIlumTugKW, memoria: memoriaParcelaA },
                parcelaB: { potKW: potAquecKW, demKW: demandaAquecKW, qtd: qtdAparelhosAquec, fd: fdAquec, itens: aparelhosAquec },
                parcelaC: { potKW: potArCondKW, demKW: demandaArKW, qtd: qtdArCond, fd: fdAr, itens: aparelhosAr },
                parcelaD: { potKW: potOutrasKW, demKW: demandaOutrasKW },
                categoriaAtend
            };
        }

        // =========================================================================
        // MEMÓRIA DE CÁLCULO MODAL
        // =========================================================================
        function abrirModalMemoriaDemanda() {
            if (!dadosUltimaDemandaCalculada) {
                atualizarTabelas();
            }
            renderizarMemoriaDemanda();
            const modal = document.getElementById('modalMemoriaDemanda');
            if (modal) modal.classList.remove('hidden');
        }

        function fecharModalMemoriaDemanda() {
            const modal = document.getElementById('modalMemoriaDemanda');
            if (modal) modal.classList.add('hidden');
        }

        function renderizarMemoriaDemanda() {
            const c = dadosUltimaDemandaCalculada;
            const container = document.getElementById('conteudoMemoriaDemanda');
            if (!container || !c) return;

            container.innerHTML = `
                <!-- CABEÇALHO DA CONCESSIONÁRIA -->
                <div class="bg-slate-950 p-4 rounded-xl border border-sky-500/40 flex flex-col md:flex-row justify-between items-start md:items-center gap-3">
                    <div>
                        <span class="text-[10px] font-bold uppercase text-sky-400 bg-sky-500/20 px-2 py-0.5 rounded">Distribuidora Ativa</span>
                        <h4 class="text-base font-black text-white mt-1">${c.concessionaria.nome} — Norma ${c.concessionaria.norma}</h4>
                        <p class="text-xs text-slate-400">${c.concessionaria.descricao}</p>
                    </div>
                    <div class="text-right">
                        <span class="text-[10px] text-slate-400 block">Fator de Demanda Resultante:</span>
                        <span class="text-xl font-black text-amber-400 font-mono">${(c.fatorDemandaGlobal * 100).toFixed(1)}%</span>
                    </div>
                </div>

                <!-- QUADRO RESUMO GERAL -->
                <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
                    <div class="bg-slate-950 p-3 rounded-xl border border-slate-800">
                        <span class="text-slate-400 text-[10px] block">Carga Total Instalada (C)</span>
                        <strong class="text-base font-mono text-white">${c.cargaInstaladaTotalKW.toFixed(2)} kW</strong>
                        <span class="text-[9px] text-slate-500 block">Soma de todas as potências</span>
                    </div>
                    <div class="bg-slate-950 p-3 rounded-xl border border-slate-800">
                        <span class="text-slate-400 text-[10px] block">Demanda Provável (D)</span>
                        <strong class="text-base font-mono text-emerald-400">${c.demandaTotalKW.toFixed(2)} kW</strong>
                        <span class="text-[9px] text-slate-400 block">D = a + b + c + d</span>
                    </div>
                    <div class="bg-slate-950 p-3 rounded-xl border border-slate-800">
                        <span class="text-slate-400 text-[10px] block">Demanda Aparente (kVA)</span>
                        <strong class="text-base font-mono text-emerald-300">${c.demandaTotalkVA.toFixed(2)} kVA</strong>
                        <span class="text-[9px] text-slate-500 block">FP = 0,95 Residencial</span>
                    </div>
                    <div class="bg-slate-950 p-3 rounded-xl border border-slate-800">
                        <span class="text-slate-400 text-[10px] block">Padrão da Concessionária</span>
                        <strong class="text-sm font-mono text-sky-300 block truncate">${c.categoriaAtend.id} (${c.categoriaAtend.tipo})</strong>
                        <span class="text-[9px] text-amber-300 font-bold block">Disjuntor ${c.categoriaAtend.disj}</span>
                    </div>
                </div>

                <!-- PARCELA A: ILUMINAÇÃO E TUGS -->
                <div class="bg-slate-950 p-4 rounded-xl border border-slate-800 space-y-3">
                    <div class="flex justify-between items-center border-b border-slate-850 pb-2">
                        <h5 class="font-bold text-amber-400 flex items-center gap-2">
                            <i class="fa-solid fa-lightbulb"></i> Parcela (a) — Iluminação e Tomadas de Uso Geral (TUGs)
                        </h5>
                        <div class="text-right">
                            <span class="text-slate-400 text-[10px]">Total Instalado: <strong class="text-white font-mono">${c.parcelaA.potKW.toFixed(2)} kW</strong></span>
                            <span class="mx-2 text-slate-600">•</span>
                            <span class="text-emerald-400 text-[10px]">Demanda Resultante: <strong class="font-mono text-emerald-300">${c.parcelaA.demKW.toFixed(2)} kW</strong></span>
                        </div>
                    </div>
                    <p class="text-[11px] text-slate-400">Escalonamento progressivo decrescente conforme a Tabela da Norma ${c.concessionaria.norma}:</p>
                    <div class="overflow-x-auto rounded-lg border border-slate-800">
                        <table class="w-full text-left text-[11px]">
                            <thead class="bg-slate-900 text-slate-400">
                                <tr>
                                    <th class="p-2">Faixa de Carga</th>
                                    <th class="p-2">Potência na Faixa (kW)</th>
                                    <th class="p-2">Fator de Demanda (Fd)</th>
                                    <th class="p-2 text-right">Demanda da Faixa (kW)</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-850">
                                ${c.parcelaA.memoria.map(m => `
                                    <tr>
                                        <td class="p-2 font-mono text-slate-300">${m.faixa}</td>
                                        <td class="p-2 font-mono text-white">${m.potencia.toFixed(2)} kW</td>
                                        <td class="p-2 font-mono text-amber-300 font-bold">${(m.fd * 100).toFixed(0)}%</td>
                                        <td class="p-2 font-mono text-emerald-400 font-bold text-right">${m.demanda.toFixed(3)} kW</td>
                                    </tr>
                                `).join('')}
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- PARCELA B: CARGAS DE AQUECIMENTO (TUES TÉRMICAS) -->
                <div class="bg-slate-950 p-4 rounded-xl border border-slate-800 space-y-3">
                    <div class="flex justify-between items-center border-b border-slate-850 pb-2">
                        <h5 class="font-bold text-rose-400 flex items-center gap-2">
                            <i class="fa-solid fa-shower"></i> Parcela (b) — Aparelhos de Aquecimento / TUEs Resistivas
                        </h5>
                        <div class="text-right">
                            <span class="text-slate-400 text-[10px]">Aparelhos: <strong class="text-white font-mono">${c.parcelaB.qtd} un.</strong> (${c.parcelaB.potKW.toFixed(2)} kW)</span>
                            <span class="mx-2 text-slate-600">•</span>
                            <span class="text-emerald-400 text-[10px]">Demanda: <strong class="font-mono text-emerald-300">${c.parcelaB.demKW.toFixed(2)} kW</strong> (${(c.parcelaB.fd * 100).toFixed(0)}%)</span>
                        </div>
                    </div>
                    <p class="text-[11px] text-slate-400">
                        Chuveiros elétricos, torneiras elétricas, fornos e boilers. Fator de simultaneidade da concessionária para <strong>${c.parcelaB.qtd} aparelhos = ${(c.parcelaB.fd * 100).toFixed(0)}%</strong>.
                    </p>
                    ${c.parcelaB.itens.length > 0 ? `
                        <div class="flex flex-wrap gap-2">
                            ${c.parcelaB.itens.map(it => `
                                <span class="bg-slate-900 border border-slate-800 px-2.5 py-1 rounded-lg text-[11px] text-slate-300 flex items-center gap-1.5 font-mono">
                                    <i class="fa-solid fa-bolt text-rose-400 text-[10px]"></i> ${it.nome}: <strong>${it.potKW.toFixed(2)} kW</strong>
                                </span>
                            `).join('')}
                        </div>
                    ` : '<span class="text-slate-500 text-[11px] italic">Nenhuma carga térmica cadastrada no projeto.</span>'}
                </div>

                <!-- PARCELA C: AR CONDICIONADO -->
                <div class="bg-slate-950 p-4 rounded-xl border border-slate-800 space-y-3">
                    <div class="flex justify-between items-center border-b border-slate-850 pb-2">
                        <h5 class="font-bold text-sky-400 flex items-center gap-2">
                            <i class="fa-solid fa-snowflake"></i> Parcela (c) — Condicionadores de Ar
                        </h5>
                        <div class="text-right">
                            <span class="text-slate-400 text-[10px]">Aparelhos: <strong class="text-white font-mono">${c.parcelaC.qtd} un.</strong> (${c.parcelaC.potKW.toFixed(2)} kW)</span>
                            <span class="mx-2 text-slate-600">•</span>
                            <span class="text-emerald-400 text-[10px]">Demanda: <strong class="font-mono text-emerald-300">${c.parcelaC.demKW.toFixed(2)} kW</strong> (${(c.parcelaC.fd * 100).toFixed(0)}%)</span>
                        </div>
                    </div>
                    ${c.parcelaC.itens.length > 0 ? `
                        <div class="flex flex-wrap gap-2">
                            ${c.parcelaC.itens.map(it => `
                                <span class="bg-slate-900 border border-slate-800 px-2.5 py-1 rounded-lg text-[11px] text-slate-300 flex items-center gap-1.5 font-mono">
                                    <i class="fa-solid fa-wind text-sky-400 text-[10px]"></i> ${it.nome}: <strong>${it.potKW.toFixed(2)} kW</strong>
                                </span>
                            `).join('')}
                        </div>
                    ` : '<span class="text-slate-500 text-[11px] italic">Nenhum aparelho de ar-condicionado cadastrado.</span>'}
                </div>

                <!-- ENTRADA DE SERVIÇO HOMOLOGADA -->
                <div class="bg-gradient-to-r from-emerald-950/40 via-slate-950 to-slate-950 p-4 rounded-xl border border-emerald-500/50 space-y-2">
                    <h5 class="font-bold text-emerald-400 flex items-center gap-2">
                        <i class="fa-solid fa-circle-check"></i> Especificação Conclusiva do Padrão de Entrada da Concessionária
                    </h5>
                    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 text-xs pt-1">
                        <div>
                            <span class="text-slate-400 text-[10px] block">Categoria:</span>
                            <span class="font-bold text-white font-mono">${c.categoriaAtend.id} — ${c.categoriaAtend.tipo}</span>
                        </div>
                        <div>
                            <span class="text-slate-400 text-[10px] block">Disjuntor Caixa Medição:</span>
                            <span class="font-bold text-amber-300 font-mono">${c.categoriaAtend.disj} (Curva C)</span>
                        </div>
                        <div>
                            <span class="text-slate-400 text-[10px] block">Ramal Subterrâneo/Aéreo:</span>
                            <span class="font-bold text-emerald-400 font-mono">${c.categoriaAtend.cabo} Cobre</span>
                        </div>
                        <div>
                            <span class="text-slate-400 text-[10px] block">Eletroduto Padrão:</span>
                            <span class="font-bold text-sky-300 font-mono">${c.categoriaAtend.tubo}</span>
                        </div>
                    </div>
                </div>
            `;
        }

        // =========================================================================
        // GERENCIAMENTO DE TELA CHEIA (FULLSCREEN 2D CAD, CABOS E 3D)
        // =========================================================================
        let viewportFullscreenAtivo = null;

        function toggleFullscreenViewport(tipo) {
            if (viewportFullscreenAtivo === tipo) {
                sairFullscreen();
            } else {
                entrarFullscreen(tipo);
            }
        }

        function entrarFullscreen(tipo) {
            // Se já tem outro ativo, sai antes
            if (viewportFullscreenAtivo) {
                sairFullscreen();
            }

            let container = null;
            if (tipo === 'cad') container = document.getElementById('containerCad2D');
            else if (tipo === 'instalacoes') container = document.getElementById('containerInstalacoes2D');
            else if (tipo === '3d') container = document.getElementById('container3D');

            if (!container) return;

            viewportFullscreenAtivo = tipo;
            container.classList.add('viewport-fullscreen-mode');

            // Ajusta dimensões específicas por viewport
            if (tipo === 'cad') {
                const canvas = document.getElementById('cadCanvas');
                if (canvas) {
                    canvas.dataset.origW = canvas.width;
                    canvas.dataset.origH = canvas.height;
                    canvas.width = window.innerWidth;
                    canvas.height = window.innerHeight;
                    canvas.style.height = window.innerHeight + 'px';
                    centralizarProjetoNoCanvas('cadCanvas');
                    desenharCAD();
                }
            } else if (tipo === 'instalacoes') {
                const canvas = document.getElementById('instalacoesCanvas');
                if (canvas) {
                    canvas.dataset.origW = canvas.width;
                    canvas.dataset.origH = canvas.height;
                    canvas.width = window.innerWidth;
                    canvas.height = window.innerHeight;
                    canvas.style.height = window.innerHeight + 'px';
                    centralizarProjetoNoCanvas('instalacoesCanvas');
                    desenharInstalacoes();
                }
            } else if (tipo === '3d') {
                const vp = document.getElementById('viewport3d');
                if (vp) {
                    vp.style.height = window.innerHeight + 'px';
                    setTimeout(() => {
                        onWindowResize3d();
                        reconstruirCena3D();
                    }, 50);
                }
            }

            atualizarBotoesFullscreen(tipo, true);

            // Tenta ativar a Fullscreen API nativa do navegador se suportada
            if (document.fullscreenEnabled && !document.fullscreenElement) {
                try {
                    container.requestFullscreen().catch(() => {});
                } catch (e) {}
            }
        }

        function sairFullscreen() {
            if (!viewportFullscreenAtivo) return;

            const tipo = viewportFullscreenAtivo;
            let container = null;
            if (tipo === 'cad') container = document.getElementById('containerCad2D');
            else if (tipo === 'instalacoes') container = document.getElementById('containerInstalacoes2D');
            else if (tipo === '3d') container = document.getElementById('container3D');

            if (container) {
                container.classList.remove('viewport-fullscreen-mode');
            }

            if (tipo === 'cad') {
                const canvas = document.getElementById('cadCanvas');
                if (canvas) {
                    canvas.width = parseInt(canvas.dataset.origW) || 900;
                    canvas.height = parseInt(canvas.dataset.origH) || 520;
                    canvas.style.height = '520px';
                    centralizarProjetoNoCanvas('cadCanvas');
                    desenharCAD();
                }
            } else if (tipo === 'instalacoes') {
                const canvas = document.getElementById('instalacoesCanvas');
                if (canvas) {
                    canvas.width = parseInt(canvas.dataset.origW) || 1120;
                    canvas.height = parseInt(canvas.dataset.origH) || 620;
                    canvas.style.height = '620px';
                    centralizarProjetoNoCanvas('instalacoesCanvas');
                    desenharInstalacoes();
                }
            } else if (tipo === '3d') {
                const vp = document.getElementById('viewport3d');
                if (vp) {
                    vp.style.height = '620px';
                    setTimeout(() => {
                        onWindowResize3d();
                        reconstruirCena3D();
                    }, 50);
                }
            }

            atualizarBotoesFullscreen(tipo, false);
            viewportFullscreenAtivo = null;

            if (document.fullscreenElement) {
                try {
                    document.exitFullscreen().catch(() => {});
                } catch (e) {}
            }
        }

        function atualizarBotoesFullscreen(tipo, isFullscreen) {
            const configs = [
                { idBtn: 'btnFullscreenCad', idExit: 'btnExitFullscreenCad', label: 'Tela Cheia', labelExit: 'Sair da Tela Cheia (ESC)' },
                { idBtn: 'btnFullscreenInstalacoes', idExit: 'btnExitFullscreenInstalacoes', label: 'Tela Cheia', labelExit: 'Sair da Tela Cheia (ESC)' },
                { idBtn: 'btnFullscreen3D', idExit: 'btnExitFullscreen3D', label: 'Tela Cheia 3D', labelExit: 'Sair da Tela Cheia (ESC)' },
                { idBtn: 'btn3dFullscreenToolbar', label: 'Tela Cheia 3D' }
            ];

            if (tipo === 'cad') {
                const btn = document.getElementById('btnFullscreenCad');
                if (btn) btn.innerHTML = isFullscreen ? '<i class="fa-solid fa-compress"></i> <span class="hidden sm:inline text-[11px]">Recolher</span>' : '<i class="fa-solid fa-expand"></i> <span class="hidden sm:inline text-[11px]">Tela Cheia</span>';
                const exit = document.getElementById('btnExitFullscreenCad');
                if (exit) {
                    if (isFullscreen) exit.classList.remove('hidden');
                    else exit.classList.add('hidden');
                }
            } else if (tipo === 'instalacoes') {
                const btn = document.getElementById('btnFullscreenInstalacoes');
                if (btn) btn.innerHTML = isFullscreen ? '<i class="fa-solid fa-compress"></i> <span class="hidden sm:inline text-[11px]">Recolher</span>' : '<i class="fa-solid fa-expand"></i> <span class="hidden sm:inline text-[11px]">Tela Cheia</span>';
                const exit = document.getElementById('btnExitFullscreenInstalacoes');
                if (exit) {
                    if (isFullscreen) exit.classList.remove('hidden');
                    else exit.classList.add('hidden');
                }
            } else if (tipo === '3d') {
                const btn1 = document.getElementById('btnFullscreen3D');
                const btn2 = document.getElementById('btn3dFullscreenToolbar');
                const htmlStr = isFullscreen ? '<i class="fa-solid fa-compress"></i> <span>Recolher 3D</span>' : '<i class="fa-solid fa-expand"></i> <span>Tela Cheia 3D</span>';
                if (btn1) btn1.innerHTML = htmlStr;
                if (btn2) btn2.innerHTML = htmlStr;
                const exit = document.getElementById('btnExitFullscreen3D');
                if (exit) {
                    if (isFullscreen) exit.classList.remove('hidden');
                    else exit.classList.add('hidden');
                }
            }
        }

        // Suporte à tecla ESC e evento nativo de fullscreen
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && viewportFullscreenAtivo) {
                sairFullscreen();
            }
        });

        document.addEventListener('fullscreenchange', () => {
            if (!document.fullscreenElement && viewportFullscreenAtivo) {
                sairFullscreen();
            }
        });

        window.addEventListener('resize', () => {
            if (viewportFullscreenAtivo === 'cad') {
                const canvas = document.getElementById('cadCanvas');
                if (canvas) {
                    canvas.width = window.innerWidth;
                    canvas.height = window.innerHeight;
                    canvas.style.height = window.innerHeight + 'px';
                    desenharCAD();
                }
            } else if (viewportFullscreenAtivo === 'instalacoes') {
                const canvas = document.getElementById('instalacoesCanvas');
                if (canvas) {
                    canvas.width = window.innerWidth;
                    canvas.height = window.innerHeight;
                    canvas.style.height = window.innerHeight + 'px';
                    desenharInstalacoes();
                }
            } else if (viewportFullscreenAtivo === '3d') {
                const vp = document.getElementById('viewport3d');
                if (vp) {
                    vp.style.height = window.innerHeight + 'px';
                    onWindowResize3d();
                }
            }
        });

        // CÁLCULOS TÉCNICOS CONSOLIDADOS (CONFORME NBR 5410 & REGIME DE IMÓVEIS)
        function atualizarTabelas() {
            // 1. Determina quais cômodos entram no cálculo (respeita regime de imóveis)
            let comodosParaCalcular = state.comodos;
            let ehUnidadeEspecifica = false;
            let imovelAtivo = null;

            if (state.regimeImovel === 'imoveis_separados' && state.unidadeQdtAtivaId !== 'todos') {
                imovelAtivo = state.imoveis.find(i => i.id === state.unidadeQdtAtivaId);
                if (imovelAtivo && imovelAtivo.pavimentos && imovelAtivo.pavimentos.length > 0) {
                    comodosParaCalcular = state.comodos.filter(c => imovelAtivo.pavimentos.includes(c.pavimentoId));
                    ehUnidadeEspecifica = true;
                }
            }

            let totIlum = 0, totTug = 0, totTue = 0;
            const circuitos = [];

            let totTugGeral = 0;
            let totTugServico = 0;

            const qdtCx = state.qdtPos.x + state.qdtPos.w / 2;
            const qdtCy = state.qdtPos.y + state.qdtPos.h / 2;

            // Itera pelos cômodos filtrados
            comodosParaCalcular.forEach((c, idx) => {
                const ilum = 100 + (c.area >= 6 ? Math.floor((c.area - 6) / 4) * 60 : 0);
                totIlum += ilum;

                const ptsDoComodo = state.pontosEletricos.filter(pt => pt.comodoId === c.id);
                const tugs = ptsDoComodo.filter(pt => pt.tipo === 'TUG');
                const tues = ptsDoComodo.filter(pt => pt.tipo === 'TUE');

                const somaTug = tugs.reduce((acc, curr) => acc + curr.pot, 0);
                if (c.tipo === 'servico') {
                    totTugServico += somaTug;
                } else {
                    totTugGeral += somaTug;
                }
                totTug += somaTug;

                // Rota CAD + Subida Vertical de Prumada
                const luzX = c.x + (c.largura * state.escala) / 2;
                const luzY = c.y + (c.comprimento * state.escala) / 2;
                const circNumIndex = idx + 1;
                const wps = state.eletrodutoWaypoints[circNumIndex] || [];
                const pontos = [{ x: qdtCx, y: qdtCy }, ...wps, { x: luzX, y: luzY }];

                let distPxTotal = 0;
                for (let i = 0; i < pontos.length - 1; i++) {
                    distPxTotal += Math.sqrt(Math.pow(pontos[i+1].x - pontos[i].x, 2) + Math.pow(pontos[i+1].y - pontos[i].y, 2));
                }

                const acrescimoPrumada = (state.prumadaAtiva !== false && c.pavimentoId && c.pavimentoId !== 'terreo' && state.regimeImovel === 'mesmo_imovel') ? 3.2 : 0;
                const rotaMetrosReal = (distPxTotal / state.escala) + 2.8 + acrescimoPrumada;

                const pavObj = state.pavimentos.find(p => p.id === c.pavimentoId);
                const nomeAndar = pavObj ? pavObj.nome : 'Térreo';

                tues.forEach(tue => {
                    totTue += tue.pot;
                    const tensao = tue.tensao || 220;
                    const ib = tue.pot / tensao;

                    const nomeLower = tue.nome.toLowerCase();
                    const ehResistivo = nomeLower.includes('chuveiro') || nomeLower.includes('torneira') || nomeLower.includes('aquecedor') || nomeLower.includes('boiler');

                    let cabo = '2.5 mm²';
                    let disj = '20 A';

                    if (ib <= 12) { cabo = '2.5 mm²'; disj = '16 A'; }
                    else if (ib <= 17.5) { cabo = '2.5 mm²'; disj = '20 A'; }
                    else if (ib <= 24) { cabo = '4.0 mm²'; disj = '25 A'; }
                    else if (ib <= 32) { cabo = '6.0 mm²'; disj = '32 A'; }
                    else if (ib <= 41) { cabo = '10.0 mm²'; disj = '40 A'; }
                    else if (ib <= 57) { cabo = '16.0 mm²'; disj = '50 A'; }
                    else { cabo = '25.0 mm²'; disj = '63 A'; }

                    circuitos.push({
                        num: 0,
                        andar: ehUnidadeEspecifica ? `${imovelAtivo.nome} • ${nomeAndar}` : nomeAndar,
                        nome: `TUE - ${tue.nome} (${c.nome})`,
                        tipo: 'TUE',
                        tensao: tensao,
                        potVal: tue.pot,
                        pot: `${tue.pot} W (${tensao}V)`,
                        ibVal: ib,
                        ib: `${ib.toFixed(1)} A`,
                        cabo: cabo,
                        disj: disj,
                        curva: ehResistivo ? 'B' : 'C',
                        polos: tensao === 220 ? '2P' : '1P',
                        rotaCad: Math.ceil(rotaMetrosReal)
                    });
                });
            });

            // Circuitos Base
            const circsBase = [];
            const rotaBasePadrao = 14;

            if (totIlum > 0) {
                circsBase.push({
                    andar: ehUnidadeEspecifica ? `${imovelAtivo.nome} • Iluminação` : (state.regimeImovel === 'imoveis_separados' ? 'Geral Coletivo' : 'Geral (Todos os Andares)'),
                    nome: 'Iluminação Social e Serviços',
                    tipo: 'Iluminação',
                    tensao: 127,
                    potVal: totIlum,
                    pot: `${totIlum} VA (127V)`,
                    ibVal: totIlum / 127,
                    ib: `${(totIlum / 127).toFixed(1)} A`,
                    cabo: '1.5 mm²',
                    disj: '10 A',
                    curva: 'C',
                    polos: '1P',
                    rotaCad: rotaBasePadrao
                });
            }

            if (totTugGeral > 0) {
                circsBase.push({
                    andar: ehUnidadeEspecifica ? `${imovelAtivo.nome} • TUGs` : 'Térreo & Superior',
                    nome: 'TUG - Tomadas Gerais (Salas, Quartos, Circulação)',
                    tipo: 'TUG',
                    tensao: 127,
                    potVal: totTugGeral,
                    pot: `${Math.round(totTugGeral)} VA (127V)`,
                    ibVal: totTugGeral / 127,
                    ib: `${(totTugGeral / 127).toFixed(1)} A`,
                    cabo: '2.5 mm²',
                    disj: '20 A',
                    curva: 'C',
                    polos: '1P',
                    rotaCad: rotaBasePadrao + 3
                });
            }

            if (totTugServico > 0) {
                circsBase.push({
                    andar: ehUnidadeEspecifica ? `${imovelAtivo.nome} • TUG Serviço` : 'Térreo & Serviço',
                    nome: 'TUG - Tomadas Especiais de Serviço (Cozinha, Banheiros)',
                    tipo: 'TUG',
                    tensao: 127,
                    potVal: totTugServico,
                    pot: `${Math.round(totTugServico)} VA (127V)`,
                    ibVal: totTugServico / 127,
                    ib: `${(totTugServico / 127).toFixed(1)} A`,
                    cabo: '2.5 mm²',
                    disj: '20 A',
                    curva: 'C',
                    polos: '1P',
                    rotaCad: rotaBasePadrao + 5
                });
            }

            const circuitosFinais = [...circsBase, ...circuitos];
            let somaMetragensFinais = 0;

            const fases = ['R', 'S'];
            if (state.alimentacaoExterna.sistema === 'trifasico') fases.push('T');

            circuitosFinais.forEach((circ, index) => {
                circ.num = index + 1;
                if (circ.polos === '2P') {
                    circ.fase = 'R + S';
                } else {
                    circ.fase = fases[index % fases.length];
                }

                const compManual = state.comprimentosManuaisCircuitos[circ.num];
                if (compManual !== undefined) {
                    circ.rota = compManual;
                    circ.ehManual = true;
                } else {
                    circ.rota = circ.rotaCad;
                    circ.ehManual = false;
                }
                somaMetragensFinais += circ.rota;
            });

            state.circuitosCalculados = circuitosFinais;

            // Renderiza Tabela de Circuitos
            const tb = document.getElementById('tbCircuitos');
            if (tb) {
                tb.innerHTML = '';
                circuitosFinais.forEach(c => {
                    const tr = document.createElement('tr');
                    tr.className = 'hover:bg-slate-800/40';
                    tr.innerHTML = `
                        <td class="p-3 font-bold text-amber-400">${c.num}</td>
                        <td class="p-3 font-semibold text-slate-300 font-mono text-[11px]">${c.andar}</td>
                        <td class="p-3 font-semibold text-white">${c.nome}</td>
                        <td class="p-3"><span class="px-2 py-0.5 rounded border text-[10px] font-bold ${c.tipo === 'TUE' ? 'bg-blue-900/40 text-blue-300 border-blue-500/40' : (c.tipo === 'TUG' ? 'bg-emerald-900/40 text-emerald-300 border-emerald-500/40' : 'bg-slate-800 text-amber-300 border-amber-500/40')}">${c.tipo}</span></td>
                        <td class="p-3 font-mono text-slate-300">${c.pot}</td>
                        <td class="p-3 font-mono text-slate-300">${c.ib}</td>
                        <td class="p-3 font-bold font-mono text-emerald-400">${c.cabo}</td>
                        <td class="p-3 font-bold font-mono text-amber-300">${c.disj}</td>
                        <td class="p-3 font-bold text-amber-400">Curva ${c.curva}</td>
                        <td class="p-3"><span class="px-1.5 py-0.5 rounded text-[10px] font-mono font-bold bg-slate-950 border border-slate-700 text-slate-300">Fase ${c.fase}</span></td>
                        <td class="p-3">
                            <div class="flex items-center gap-1.5">
                                <input type="number" step="0.5" min="1" value="${c.rota}" 
                                    onchange="definirComprimentoManualCircuito(${c.num}, this.value)"
                                    class="w-16 bg-slate-950 border ${c.ehManual ? 'border-amber-500/80 text-amber-300 font-bold' : 'border-slate-800 text-blue-400'} font-mono px-1.5 py-1 rounded text-xs focus:ring-1 focus:ring-amber-400 outline-none text-center">
                                <span class="text-slate-400 font-mono text-xs">m</span>
                                ${c.ehManual ? `<button onclick="restaurarComprimentoCadCircuito(${c.num})" class="text-amber-400 hover:text-amber-300 p-0.5" title="Restaurar rota do CAD (${c.rotaCad}m)"><i class="fa-solid fa-rotate-left text-[10px]"></i></button>` : `<span class="text-[9px] bg-slate-800 text-slate-500 px-1 py-0.5 rounded font-mono">CAD</span>`}
                            </div>
                        </td>
                    `;
                    tb.appendChild(tr);
                });
            }

            // =====================================================================
            // DIMENSIONAMENTO DA DEMANDA CONFORME NORMA DA CONCESSIONÁRIA LOCAL (NBR 5410 ITEM 9.5.2)
            // =====================================================================
            const sistemaAlimAtual = (ehUnidadeEspecifica && imovelAtivo.sistema) ? imovelAtivo.sistema : (state.alimentacaoExterna.sistema || 'bifasico');
            const todosTuesDoProjeto = state.pontosEletricos.filter(p => p.tipo === 'TUE');

            const calculoDemanda = calcularDemandaConcessionaria(totIlum, totTug, todosTuesDoProjeto, sistemaAlimAtual, state.concessionariaId || 'cpfl');
            dadosUltimaDemandaCalculada = calculoDemanda;

            const potTotalW = calculoDemanda.cargaInstaladaTotalKW * 1000.0;
            const potDemandaKW = calculoDemanda.demandaTotalKW;
            const potDemandakVA = calculoDemanda.demandaTotalkVA;
            const tensaoAlim = (sistemaAlimAtual === 'monofasico') ? 127 : 220;
            const corrGeral = (potDemandaKW * 1000) / tensaoAlim;

            // Disjuntor e Cabo Geral calculados segundo Norma da Concessionária e NBR 5410
            let caboGeral = calculoDemanda.categoriaAtend.cabo || '10.0 mm²';
            let disjGeral = calculoDemanda.categoriaAtend.disj || '50 A';

            // Atualiza o painel da Concessionária
            const elNomeConc = document.getElementById('lblNomeConcessionaria');
            const elNormaConc = document.getElementById('lblNormaConcessionaria');
            const elCargaKW = document.getElementById('lblCargaInstaladakW');
            const elCargakVA = document.getElementById('lblCargaInstaladakVA');
            const elFdGlobal = document.getElementById('lblFatorDemandaGlobal');
            const elDemKW = document.getElementById('lblDemandaCalculadakW');
            const elDemkVA = document.getElementById('lblDemandaCalculadakVA');
            const elCatAtend = document.getElementById('lblCategoriaAtendimento');
            const elDisjConc = document.getElementById('lblDisjuntorConcessionaria');
            const elRamalConc = document.getElementById('lblRamalConcessionaria');
            const elEletroConc = document.getElementById('lblEletrodutoEntradaConc');

            if (elNomeConc) elNomeConc.innerText = calculoDemanda.concessionaria.nome;
            if (elNormaConc) elNormaConc.innerText = calculoDemanda.concessionaria.norma;
            if (elCargaKW) elCargaKW.innerText = calculoDemanda.cargaInstaladaTotalKW.toFixed(2) + ' kW';
            if (elCargakVA) elCargakVA.innerText = (calculoDemanda.cargaInstaladaTotalKW / 0.95).toFixed(2) + ' kVA';
            if (elFdGlobal) elFdGlobal.innerText = (calculoDemanda.fatorDemandaGlobal * 100).toFixed(1) + ' %';
            if (elDemKW) elDemKW.innerText = calculoDemanda.demandaTotalKW.toFixed(2) + ' kW';
            if (elDemkVA) elDemkVA.innerText = calculoDemanda.demandaTotalkVA.toFixed(2) + ' kVA';
            if (elCatAtend) elCatAtend.innerText = calculoDemanda.categoriaAtend.id + ' (' + calculoDemanda.categoriaAtend.tipo + ')';
            if (elDisjConc) elDisjConc.innerText = calculoDemanda.categoriaAtend.disj;
            if (elRamalConc) elRamalConc.innerText = calculoDemanda.categoriaAtend.cabo;
            if (elEletroConc) elEletroConc.innerText = 'Eletroduto ' + calculoDemanda.categoriaAtend.tubo;

            const alimCx = state.alimentacaoExterna.x + state.alimentacaoExterna.w / 2;
            const alimCy = state.alimentacaoExterna.y + state.alimentacaoExterna.h / 2;
            const distPxAlim = Math.sqrt(Math.pow(qdtCx - alimCx, 2) + Math.pow(qdtCy - alimCy, 2));
            const distCadAlim = Math.max(4, Math.ceil((distPxAlim / state.escala) + 3.0));
            const distAlimUsada = (ehUnidadeEspecifica && imovelAtivo.distancia) ? imovelAtivo.distancia : (state.alimentacaoExterna.distanciaManual || distCadAlim);

            let sistemaUsado = state.alimentacaoExterna.sistema;
            if (ehUnidadeEspecifica && imovelAtivo.sistema) {
                sistemaUsado = imovelAtivo.sistema;
            }

            let numCondutores = 4;
            let detCondutores = '2x Fases, 1x Neutro, 1x Terra';
            if (sistemaUsado === 'trifasico') {
                numCondutores = 5;
                detCondutores = '3x Fases, 1x Neutro, 1x Terra';
            } else if (sistemaUsado === 'monofasico') {
                numCondutores = 3;
                detCondutores = '1x Fase, 1x Neutro, 1x Terra';
            }

            const totalMetrosAlimentador = numCondutores * distAlimUsada;

            const elDistAlimInput = document.getElementById('numDistAlimExterna');
            if (elDistAlimInput && state.alimentacaoExterna.distanciaManual) {
                elDistAlimInput.value = state.alimentacaoExterna.distanciaManual;
            } else if (elDistAlimInput) {
                elDistAlimInput.placeholder = distCadAlim;
            }

            const prefixoDesc = ehUnidadeEspecifica ? `[${imovelAtivo.nome}] ` : (state.regimeImovel === 'imoveis_separados' ? '[Centro Medição Coletivo] ' : '');

            document.getElementById('lblQtdCondutoresRamal').innerText = `${numCondutores} Condutores (${sistemaUsado.toUpperCase()})`;
            document.getElementById('lblDetFiosRamal').innerText = `${prefixoDesc}${detCondutores}`;
            document.getElementById('lblBitolaAlimExterna').innerText = caboGeral;
            document.getElementById('lblMetragemTotalCaboAlim').innerText = `${totalMetrosAlimentador} m`;
            document.getElementById('lblFormulaCaboAlim').innerText = `${numCondutores} condutores × ${distAlimUsada}m`;

            document.getElementById('lblCaboGeral').innerText = caboGeral;
            document.getElementById('lblTerraGeral').innerText = caboGeral;
            document.getElementById('lblDisjGeral').innerText = disjGeral;
            document.getElementById('lblIdrGeral').innerText = `IDR ${disjGeral} / 30mA`;

            // Quantitativo Consolidado de Materiais
            const metros15 = Math.ceil(somaMetragensFinais * 0.45 * 3);
            const metros25 = Math.ceil(somaMetragensFinais * 0.7 * 3);
            const metros40 = Math.ceil(somaMetragensFinais * 0.3 * 3);

            const metrosPrumadaVertical = (state.prumadaAtiva !== false && state.regimeImovel === 'mesmo_imovel') ? (state.pavimentos.length - 1) * 3.0 : 0;
            const descRamal = ehUnidadeEspecifica 
                ? `Alimentador Individual (${imovelAtivo.nome} → Medidor/QDT)` 
                : (state.regimeImovel === 'imoveis_separados' ? 'Ramal Coletivo de Entrada (Poste Concessionária → Centro de Medição)' : 'Ramal Alimentação Externa → QDT');

            document.getElementById('listaCabos').innerHTML = `
                <li class="flex justify-between bg-slate-900 p-3 rounded-lg border border-slate-800">
                    <div>
                        <span class="block font-semibold">Cabo ${caboGeral} (${descRamal})</span>
                        <span class="text-[10px] text-slate-400">${numCondutores} condutores × ${distAlimUsada}m (${sistemaUsado})</span>
                    </div>
                    <strong class="text-emerald-400 text-sm self-center font-mono">${totalMetrosAlimentador} m</strong>
                </li>
                ${metrosPrumadaVertical > 0 ? `
                <li class="flex justify-between bg-slate-900 p-3 rounded-lg border border-slate-800">
                    <div>
                        <span class="block font-semibold">Cabo 6.0/10.0 mm² (Prumada Vertical entre Pavimentos)</span>
                        <span class="text-[10px] text-slate-400">Alimentação dos sub-quadros dos andares superiores (${metrosPrumadaVertical}m)</span>
                    </div>
                    <strong class="text-emerald-400 text-sm self-center font-mono">${metrosPrumadaVertical * numCondutores} m</strong>
                </li>` : ''}
                <li class="flex justify-between bg-slate-900 p-3 rounded-lg border border-slate-800">
                    <div>
                        <span class="block font-semibold">Cabo 1.5 mm² (Iluminação ${ehUnidadeEspecifica ? imovelAtivo.nome : 'Geral'})</span>
                        <span class="text-[10px] text-slate-400">Circuitos terminais de iluminação</span>
                    </div>
                    <strong class="text-emerald-400 text-sm self-center font-mono">${metros15} m</strong>
                </li>
                <li class="flex justify-between bg-slate-900 p-3 rounded-lg border border-slate-800">
                    <div>
                        <span class="block font-semibold">Cabo 2.5 mm² (TUGs e Aparelhos Gerais)</span>
                        <span class="text-[10px] text-slate-400">Tomadas de uso geral</span>
                    </div>
                    <strong class="text-emerald-400 text-sm self-center font-mono">${metros25} m</strong>
                </li>
                <li class="flex justify-between bg-slate-900 p-3 rounded-lg border border-slate-800">
                    <div>
                        <span class="block font-semibold">Cabo 4.0/6.0/10.0 mm² (Chuveiros, Ar Cond., Fornos TUE)</span>
                        <span class="text-[10px] text-slate-400">Cargas de alta potência selecionadas</span>
                    </div>
                    <strong class="text-emerald-400 text-sm self-center font-mono">${metros40} m</strong>
                </li>
            `;

            const qtdQuadrosDesc = ehUnidadeEspecifica 
                ? '1 Unidade (QDT ' + imovelAtivo.nome + ')' 
                : (state.regimeImovel === 'imoveis_separados' ? `${state.imoveis.length} QDTs Individuais + 1 Centro Medição Coletivo` : `${state.pavimentos.length} Unidades`);

            const qtdAndaresChao = state.pavimentos.filter(p => (p.tipoPassagemCabos === 'chao' || (!p.tipoPassagemCabos && state.tipoPassagemCabos === 'chao'))).length;
            const ehInfraUnica = (qtdAndaresChao > 1 || (qtdAndaresChao >= 1 && state.pavimentos.length > 1));
            const fatorEletroduto = ehInfraUnica ? 0.75 : 1.0; // Economia de 25% por laje compartilhada contrapiso/teto
            const metragemEletrodutosFinal = Math.ceil((somaMetragensFinais * 1.15) * fatorEletroduto);
            const descEletroduto = ehInfraUnica 
                ? 'Infraestrutura Única Compartilhada (Laje Contrapiso/Teto - Economia de 25% NBR 5410)' 
                : (qtdAndaresChao > 0 ? 'Distribuição pelo Chão / Contrapiso' : 'Distribuição interna pela laje de teto / forro');

            document.getElementById('listaQuadros').innerHTML = `
                <li class="flex justify-between bg-slate-900 p-3 rounded-lg border border-slate-800">
                    <div>
                        <span class="block font-semibold">Eletroduto Flexível 3/4" (25mm)</span>
                        <span class="text-[10px] ${ehInfraUnica ? 'text-emerald-400 font-bold' : 'text-slate-400'}">${descEletroduto}</span>
                    </div>
                    <strong class="text-amber-400 text-sm self-center font-mono">${metragemEletrodutosFinal} m</strong>
                </li>
                <li class="flex justify-between bg-slate-900 p-3 rounded-lg border border-slate-800">
                    <div>
                        <span class="block font-semibold">Quadro de Distribuição QDT DIN</span>
                        <span class="text-[10px] text-slate-400">Sugestão NBR 5410: ${document.getElementById('txtSugestaoModeloCaixa') ? document.getElementById('txtSugestaoModeloCaixa').innerText : '24 Módulos DIN'}</span>
                    </div>
                    <strong class="text-amber-400 text-sm font-mono self-center">${qtdQuadrosDesc}</strong>
                </li>
                <li class="flex justify-between bg-slate-900 p-3 rounded-lg border border-slate-800">
                    <span>Disjuntor Geral Termomagnético Curva C</span>
                    <strong class="text-amber-400 text-sm font-mono">1x ${disjGeral}</strong>
                </li>
                <li class="flex justify-between bg-slate-900 p-3 rounded-lg border border-slate-800">
                    <span>Dispositivos de Proteção contra Surtos (DPS 275V)</span>
                    <strong class="text-amber-400 text-sm font-mono">${(numCondutores === 5 ? 4 : 3) * (ehUnidadeEspecifica ? 1 : state.pavimentos.length)} unidades</strong>
                </li>
            `;

            const totTugQtd = state.pontosEletricos.filter(p => comodosParaCalcular.some(c => c.id === p.comodoId) && p.tipo === 'TUG').length;
            const totTueQtd = state.pontosEletricos.filter(p => comodosParaCalcular.some(c => c.id === p.comodoId) && p.tipo === 'TUE').length;
            const totCaixas4x2 = totTugQtd + totTueQtd;
            const totCaixasOcto = comodosParaCalcular.length;

            document.getElementById('listaPontosTomadas').innerHTML = `
                <li class="bg-slate-900 p-3 rounded-lg border border-slate-800 flex justify-between items-center">
                    <div>
                        <span class="font-semibold block">Tomadas TUG 10A / 20A</span>
                        <span class="text-[10px] text-slate-400">NBR 14136 (${ehUnidadeEspecifica ? imovelAtivo.nome : 'Unidades Totais'})</span>
                    </div>
                    <strong class="text-emerald-400 font-mono text-sm">${totTugQtd} un</strong>
                </li>
                <li class="bg-slate-900 p-3 rounded-lg border border-slate-800 flex justify-between items-center">
                    <div>
                        <span class="font-semibold block">Tomadas Especiais TUE</span>
                        <span class="text-[10px] text-slate-400">Chuveiros, Ar Cond., Hidros</span>
                    </div>
                    <strong class="text-blue-400 font-mono text-sm">${totTueQtd} un</strong>
                </li>
                <li class="bg-slate-900 p-3 rounded-lg border border-slate-800 flex justify-between items-center">
                    <div>
                        <span class="font-semibold block">Caixas 4x2 Embutir</span>
                        <span class="text-[10px] text-slate-400">Paredes dos cômodos</span>
                    </div>
                    <strong class="text-amber-400 font-mono text-sm">${totCaixas4x2} un</strong>
                </li>
                <li class="bg-slate-900 p-3 rounded-lg border border-slate-800 flex justify-between items-center">
                    <div>
                        <span class="font-semibold block">Caixas Octogonais 4x4 (Teto)</span>
                        <span class="text-[10px] text-slate-400">Lajes dos cômodos</span>
                    </div>
                    <strong class="text-amber-400 font-mono text-sm">${totCaixasOcto} un</strong>
                </li>
            `;

            renderizarQuadroDIN(circuitosFinais);
        }

        // RENDERIZAÇÃO DO QUADRO EM TRILHO DIN COM DISJUNTORES MODULARES (NBR 5410 & NBR IEC 60898)
        function renderizarQuadroDIN(circuitos) {
            const trilho = document.getElementById('trilhoDinContainer');
            if (!trilho) return;
            trilho.innerHTML = '';

            const disjGeralTxt = document.getElementById('lblDisjGeral').innerText || '50 A';
            const ehColetivo = (state.regimeImovel === 'imoveis_separados' && state.unidadeQdtAtivaId === 'todos');
            const sistemaEntrada = state.alimentacaoExterna.sistema || 'bifasico';

            let modulosUsados = 0;

            if (ehColetivo) {
                // EXIBIÇÃO: CENTRO DE MEDIÇÃO COLETIVO (NBR 5410)
                const elGeralCol = document.createElement('div');
                elGeralCol.className = 'bg-slate-900 border-2 border-emerald-500 rounded-lg p-2 flex flex-col items-center justify-between text-center shrink-0 w-24 h-40 shadow-xl relative';
                elGeralCol.innerHTML = `
                    <span class="text-[8px] font-black text-emerald-400 uppercase tracking-tighter">RAMAL COLETIVO</span>
                    <div class="w-10 h-10 bg-slate-950 border border-emerald-500/40 rounded flex flex-col items-center justify-center">
                        <div class="w-6 h-5 bg-emerald-500 rounded-sm shadow-md flex items-center justify-center text-[7px] font-black text-slate-950">3P</div>
                        <span class="text-[6px] font-bold text-white mt-0.5">CONCESS.</span>
                    </div>
                    <div>
                        <span class="block text-xs font-black text-white font-mono">${disjGeralTxt}</span>
                        <span class="block text-[7px] font-bold text-emerald-300">Geral CMC</span>
                    </div>
                    <span class="text-[7px] text-slate-400 font-mono">Trifásico (3 Módulos)</span>
                `;
                trilho.appendChild(elGeralCol);
                modulosUsados += 3;

                // Módulos de Medição Individual
                state.imoveis.forEach((imovel, i) => {
                    const elMed = document.createElement('div');
                    elMed.className = 'bg-slate-900 border-2 border-sky-500/80 rounded-lg p-1.5 flex flex-col items-center justify-between text-center shrink-0 w-20 h-40 shadow-lg';
                    elMed.innerHTML = `
                        <span class="text-[8px] font-black text-sky-400 uppercase tracking-tighter">MEDIDOR ${i+1}</span>
                        <div class="w-10 h-8 bg-slate-950 border border-sky-500/40 rounded flex flex-col items-center justify-center">
                            <i class="fa-solid fa-gauge-high text-sky-400 text-xs"></i>
                            <span class="text-[6px] font-bold text-slate-300 mt-0.5 font-mono">kWh</span>
                        </div>
                        <div>
                            <span class="block text-[10px] font-black text-white font-mono">40 A</span>
                            <span class="block text-[7px] font-bold text-sky-300 truncate w-16" title="${imovel.nome}">${imovel.nome}</span>
                        </div>
                        <span class="text-[6px] text-slate-400 font-mono">${imovel.sistema.slice(0,4)} (2 Mód.)</span>
                    `;
                    trilho.appendChild(elMed);
                    modulosUsados += 2;
                });

                const elDiv = document.createElement('div');
                elDiv.className = 'w-1.5 h-40 bg-slate-700 shrink-0 mx-1 rounded';
                trilho.appendChild(elDiv);

            } else {
                // EXIBIÇÃO: QDT PADRÃO (MESMO IMÓVEL OU UNIDADE INDIVIDUAL)
                // 1. DISJUNTOR GERAL MODULAR DIN
                const polosGeral = (sistemaEntrada === 'trifasico') ? 3 : (sistemaEntrada === 'bifasico' ? 2 : 1);
                modulosUsados += polosGeral;

                const elGeral = document.createElement('div');
                // Largura modular: 1P = 42px, 2P = 78px (2 módulos DIN), 3P = 114px (3 módulos DIN)
                const wGeralClass = (polosGeral === 3) ? 'w-28' : (polosGeral === 2 ? 'w-20' : 'w-12');
                elGeral.className = `bg-slate-900 border-2 border-amber-500 rounded-xl p-1.5 flex flex-col items-center justify-between text-center shrink-0 ${wGeralClass} h-40 shadow-xl relative`;
                
                // Representação de pólos acoplados com barra mecânica
                let manoplasGeral = '';
                if (polosGeral === 2) {
                    manoplasGeral = `
                        <div class="relative flex items-center justify-center gap-1.5 w-full">
                            <div class="w-4 h-6 bg-slate-950 border border-slate-700 rounded-sm flex items-center justify-center">
                                <div class="w-2.5 h-3 bg-slate-400 rounded-xs"></div>
                            </div>
                            <div class="w-4 h-6 bg-slate-950 border border-slate-700 rounded-sm flex items-center justify-center">
                                <div class="w-2.5 h-3 bg-slate-400 rounded-xs"></div>
                            </div>
                            <!-- Barra mecânica de acoplamento entre os 2 pólos -->
                            <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-10 h-3 bg-amber-500 rounded-xs shadow-md border border-amber-300 flex items-center justify-center pointer-events-none">
                                <span class="text-[5px] font-black text-slate-950 uppercase tracking-tighter">LINK 2P</span>
                            </div>
                        </div>
                    `;
                } else if (polosGeral === 3) {
                    manoplasGeral = `
                        <div class="relative flex items-center justify-center gap-1 w-full">
                            <div class="w-3.5 h-6 bg-slate-950 border border-slate-700 rounded-sm"></div>
                            <div class="w-3.5 h-6 bg-slate-950 border border-slate-700 rounded-sm"></div>
                            <div class="w-3.5 h-6 bg-slate-950 border border-slate-700 rounded-sm"></div>
                            <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-14 h-3 bg-amber-500 rounded-xs shadow-md border border-amber-300 flex items-center justify-center pointer-events-none">
                                <span class="text-[5px] font-black text-slate-950 uppercase tracking-tighter">LINK 3P</span>
                            </div>
                        </div>
                    `;
                } else {
                    manoplasGeral = `
                        <div class="w-5 h-6 bg-slate-950 border border-slate-700 rounded-sm flex items-center justify-center">
                            <div class="w-3 h-3 bg-amber-500 rounded-xs"></div>
                        </div>
                    `;
                }

                elGeral.innerHTML = `
                    <span class="text-[8px] font-black text-amber-400 uppercase tracking-tighter">GERAL ${polosGeral}P</span>
                    ${manoplasGeral}
                    <div>
                        <span class="block text-xs font-black text-white font-mono">${disjGeralTxt}</span>
                        <span class="block text-[7px] font-bold text-amber-300">Curva C</span>
                    </div>
                    <span class="text-[6px] text-slate-400 font-mono">${polosGeral} Mód. DIN (36mm)</span>
                `;
                trilho.appendChild(elGeral);

                // 2. DISPOSITIVOS DE PROTEÇÃO CONTRA SURTOS (DPS CLASSE II)
                const numDPS = sistemaEntrada === 'trifasico' ? 4 : (sistemaEntrada === 'bifasico' ? 3 : 2);
                for (let i = 0; i < numDPS; i++) {
                    modulosUsados += 1; // 1 módulo DIN (18mm) por DPS
                    const poloNome = (i === numDPS - 1) ? 'Neutro' : `Fase ${i + 1}`;
                    const elDPS = document.createElement('div');
                    elDPS.className = 'bg-slate-900 border border-slate-700 rounded-xl p-1.5 flex flex-col items-center justify-between text-center shrink-0 w-11 h-40 shadow';
                    elDPS.innerHTML = `
                        <span class="text-[7px] font-bold text-blue-400">DPS</span>
                        <div class="w-5 h-5 rounded bg-emerald-600 border border-emerald-400 flex items-center justify-center text-[7px] font-bold text-white shadow-inner">OK</div>
                        <div>
                            <span class="block text-[8px] font-bold text-white">275V</span>
                            <span class="block text-[6px] text-slate-400 font-mono">20kA/40kA</span>
                        </div>
                        <span class="text-[6px] text-slate-500 font-mono truncate w-10" title="${poloNome}">${poloNome}</span>
                    `;
                    trilho.appendChild(elDPS);
                }

                // 3. INTERRUPTOR DIFERENCIAL RESIDUAL (IDR 30mA)
                const polosIDR = (sistemaEntrada === 'trifasico') ? 4 : 2; // Tetrapolar ou Bipolar
                modulosUsados += polosIDR;

                const elIDR = document.createElement('div');
                const wIdrClass = (polosIDR === 4) ? 'w-28' : 'w-20'; // 4 ou 2 módulos DIN
                elIDR.className = `bg-slate-900 border-2 border-blue-500 rounded-xl p-1.5 flex flex-col items-center justify-between text-center shrink-0 ${wIdrClass} h-40 shadow-lg`;
                
                elIDR.innerHTML = `
                    <span class="text-[8px] font-black text-blue-400 uppercase tracking-tighter">IDR ${polosIDR}P</span>
                    <div class="flex items-center justify-center gap-1 w-full">
                        <div class="w-6 h-7 bg-slate-950 border border-blue-500/40 rounded flex flex-col items-center justify-center">
                            <button class="w-3.5 h-2.5 bg-red-600 rounded-xs text-[5px] font-bold text-white flex items-center justify-center shadow">T</button>
                            <span class="text-[5px] font-bold text-slate-400 mt-0.5">TEST</span>
                        </div>
                        <div class="w-5 h-6 bg-slate-950 border border-slate-700 rounded-sm flex items-center justify-center">
                            <div class="w-2.5 h-3 bg-blue-500 rounded-xs"></div>
                        </div>
                    </div>
                    <div>
                        <span class="block text-xs font-black text-white font-mono">${disjGeralTxt}</span>
                        <span class="block text-[7px] font-bold text-blue-300">IΔn 30mA</span>
                    </div>
                    <span class="text-[6px] text-slate-400 font-mono">${polosIDR} Mód. DIN</span>
                `;
                trilho.appendChild(elIDR);

                const elDiv = document.createElement('div');
                elDiv.className = 'w-1.5 h-40 bg-slate-800 shrink-0 mx-1 rounded';
                trilho.appendChild(elDiv);
            }

            // 4. MINI-DISJUNTORES DOS CIRCUITOS TERMINAIS (MONOPOLARES VS BIPOLARES)
            circuitos.forEach(c => {
                const isTue = (c.tipo === 'TUE');
                const isBipolar = (c.polos === '2P');
                const modulosCircuito = isBipolar ? 2 : 1;
                modulosUsados += modulosCircuito;

                const elCirc = document.createElement('div');
                // Disjuntor monopolar: 1 módulo DIN (38px/w-11)
                // Disjuntor bipolar: exatamente 2 módulos DIN (76px/w-20) com 2 pólos físicos e acoplamento
                if (isBipolar) {
                    elCirc.className = `bg-slate-900 border-2 ${isTue ? 'border-blue-500' : 'border-amber-500/70'} hover:border-amber-400 transition rounded-xl p-1 flex flex-col items-center justify-between text-center shrink-0 w-20 h-40 shadow-lg relative`;
                    elCirc.innerHTML = `
                        <div class="flex items-center justify-between w-full px-1">
                            <span class="px-1 py-0.2 rounded text-[8px] font-black ${isTue ? 'bg-blue-500/20 text-blue-300' : 'bg-amber-500/20 text-amber-300'}">C${c.num}</span>
                            <span class="text-[7px] font-black text-amber-400 font-mono">2P 220V</span>
                        </div>

                        <!-- Dois pólos físicos com manopla mecânica acoplada (crossbar NBR IEC 60898) -->
                        <div class="relative flex items-center justify-center gap-1.5 w-full my-0.5">
                            <div class="w-4 h-7 bg-slate-950 border border-slate-700 rounded-sm flex flex-col items-center justify-center">
                                <span class="text-[5px] text-slate-500 font-mono">L1</span>
                                <div class="w-2.5 h-3.5 bg-slate-400 rounded-xs mt-0.5"></div>
                            </div>
                            <div class="w-4 h-7 bg-slate-950 border border-slate-700 rounded-sm flex flex-col items-center justify-center">
                                <span class="text-[5px] text-slate-500 font-mono">L2</span>
                                <div class="w-2.5 h-3.5 bg-slate-400 rounded-xs mt-0.5"></div>
                            </div>
                            <!-- Barra física de travamento mecânico bipolar -->
                            <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-11 h-3.5 bg-gradient-to-r from-amber-600 via-amber-400 to-amber-600 rounded-xs shadow border border-amber-300 flex items-center justify-center pointer-events-none">
                                <span class="text-[5px] font-black text-slate-950 uppercase tracking-tighter">BIPOLAR</span>
                            </div>
                        </div>

                        <div>
                            <span class="block text-xs font-black text-white font-mono">${c.disj}</span>
                            <span class="block text-[7px] font-bold text-amber-400">Curva ${c.curva}</span>
                        </div>
                        <div class="w-full">
                            <span class="block text-[7px] font-mono text-slate-400 bg-slate-950 rounded px-0.5 truncate" title="${c.andar} - ${c.nome}">${c.fase}</span>
                            <span class="block text-[6px] text-slate-500 font-mono">2 Módulos (36mm)</span>
                        </div>
                    `;
                } else {
                    elCirc.className = `bg-slate-900 border ${isTue ? 'border-blue-500/60' : 'border-slate-700'} hover:border-amber-400 transition rounded-xl p-1 flex flex-col items-center justify-between text-center shrink-0 w-11 h-40 shadow-md`;
                    elCirc.innerHTML = `
                        <span class="px-1 py-0.2 rounded text-[8px] font-black ${isTue ? 'bg-blue-500/20 text-blue-300' : 'bg-amber-500/20 text-amber-300'}">C${c.num}</span>
                        <div class="w-5 h-7 bg-slate-950 border border-slate-800 rounded flex flex-col items-center justify-center">
                            <div class="w-3 h-3.5 bg-slate-400 rounded-xs"></div>
                            <span class="text-[5px] font-bold text-slate-400 mt-0.5">1P</span>
                        </div>
                        <div>
                            <span class="block text-[11px] font-black text-white font-mono">${c.disj}</span>
                            <span class="block text-[6px] font-bold text-amber-400">Curva ${c.curva}</span>
                        </div>
                        <div class="w-full">
                            <span class="block text-[7px] font-mono text-slate-400 bg-slate-950 rounded px-0.5 truncate" title="${c.andar} - ${c.nome}">${c.fase}</span>
                            <span class="block text-[6px] text-slate-500 font-mono">1 Mód.</span>
                        </div>
                    `;
                }
                trilho.appendChild(elCirc);
            });

            // =========================================================================
            // CÁLCULO NORMATIVO DE RESERVA (NBR 5410 ITEM 6.5.4.7) & SUGESTÃO COMERCIAL
            // =========================================================================
            const numCirc = circuitos.length;
            let modulosReservaNorma = 2; // padrão para até 6 circuitos
            if (numCirc <= 6) {
                modulosReservaNorma = 2;
            } else if (numCirc <= 12) {
                modulosReservaNorma = 3;
            } else if (numCirc <= 30) {
                modulosReservaNorma = 4;
            } else {
                modulosReservaNorma = Math.ceil(modulosUsados * 0.15);
            }

            const capacidadeMinima = modulosUsados + modulosReservaNorma;

            // Padrões comerciais de Caixas de Distribuição DIN disponíveis no mercado brasileiro (Tigre, Schneider, Steck, Lorenzetti):
            const TAMANHOS_COMERCIAIS = [6, 8, 12, 16, 18, 24, 27, 36, 48, 54, 72];
            let tamanhoSugerido = TAMANHOS_COMERCIAIS.find(t => t >= capacidadeMinima);
            let textoCaixaDesc = '';

            if (tamanhoSugerido) {
                textoCaixaDesc = `Quadro de Distribuição para ${tamanhoSugerido} Módulos DIN (Embutir / Sobrepor)`;
            } else {
                tamanhoSugerido = Math.ceil(capacidadeMinima / 36) * 36;
                textoCaixaDesc = `Painel Modular Industrial / Composto para ${tamanhoSugerido} Módulos DIN`;
            }

            const modulosLivres = Math.max(0, tamanhoSugerido - modulosUsados);

            // Atualiza os dados no Card de Sugestão Comercial
            const txtModelo = document.getElementById('txtSugestaoModeloCaixa');
            const txtDesc = document.getElementById('txtSugestaoDescricaoCaixa');
            const bOcup = document.getElementById('badgeModulosOcupados');
            const bRes = document.getElementById('badgeModulosReserva');
            const bLivres = document.getElementById('badgeModulosLivres');

            if (txtModelo) txtModelo.innerText = textoCaixaDesc;
            if (txtDesc) {
                txtDesc.innerHTML = `Recomendação técnica: Caixa comercial de <strong>${tamanhoSugerido} módulos DIN</strong> atende aos <strong>${modulosUsados} módulos ocupados</strong> (Geral, IDR, DPS, Monopolares e Bipolares) + <strong>${modulosReservaNorma} de reserva mínima NBR 5410</strong>.`;
            }
            if (bOcup) bOcup.innerText = `${modulosUsados} Módulos`;
            if (bRes) bRes.innerText = `+${modulosReservaNorma} NBR 5410`;
            if (bLivres) bLivres.innerText = `${modulosLivres} Livres`;

            // RENDERIZA OS MÓDULOS DE RESERVA FÍSICOS NO TRILHO DIN
            for (let r = 0; r < modulosLivres; r++) {
                const elRes = document.createElement('div');
                elRes.className = 'border border-dashed border-slate-700/80 rounded-xl p-1.5 flex flex-col items-center justify-center text-center shrink-0 w-10 h-40 bg-slate-950/40';
                elRes.innerHTML = `
                    <span class="text-[7px] text-slate-600 font-bold uppercase rotate-90 block tracking-wider">RESERVA</span>
                    <span class="text-[6px] text-slate-700 font-mono mt-3">18mm DIN</span>
                `;
                trilho.appendChild(elRes);
            }
        }

        // EXPORTAÇÃO EXCEL (.XLSX) COM SUPORTE A PAVIMENTOS
        function exportarParaExcel() {
            try {
                if (typeof XLSX === 'undefined') {
                    alert('Biblioteca SheetJS carregando... Por favor tente novamente em alguns segundos.');
                    return;
                }

                const wb = XLSX.utils.book_new();

                // 1. ABA 1: RESUMO DO PROJETO & ALIMENTADOR
                const dadosResumo = [
                    ['PRO-ELÉTRICA CAD NBR 5410 - MEMORIAL DESCRITIVO MULTI-PAVIMENTOS'],
                    ['Data de Emissão:', new Date().toLocaleDateString('pt-BR')],
                    ['Norma de Referência:', 'ABNT NBR 5410:2004 (Instalações Elétricas de Baixa Tensão)'],
                    ['Quantidade de Pavimentos:', `${state.pavimentos.length} (${state.pavimentos.map(p => p.nome).join(', ')})`],
                    [''],
                    ['PARÂMETROS GERAIS DA ENTRADA DE ENERGIA', ''],
                    ['Sistema de Alimentação:', state.alimentacaoExterna.sistema.toUpperCase()],
                    ['Condutores do Ramal:', document.getElementById('lblQtdCondutoresRamal').innerText],
                    ['Cabo Alimentador Geral:', document.getElementById('lblCaboGeral').innerText],
                    ['Cabo de Proteção (Terra):', document.getElementById('lblTerraGeral').innerText],
                    ['Disjuntor Geral:', document.getElementById('lblDisjGeral').innerText],
                    ['Dispositivo Residual (IDR):', document.getElementById('lblIdrGeral').innerText],
                    ['Distância Alimentação Externa → QDT:', document.getElementById('lblFormulaCaboAlim').innerText],
                    ['Total de Cabos de Entrada:', document.getElementById('lblMetragemTotalCaboAlim').innerText]
                ];
                const wsResumo = XLSX.utils.aoa_to_sheet(dadosResumo);
                XLSX.utils.book_append_sheet(wb, wsResumo, 'Resumo Geral');

                // 2. ABA 2: QUADRO DE CIRCUITOS TERMINAIS
                const cabecalhoCircuitos = [
                    'Nº Circuito', 'Pavimento / Andar', 'Descrição da Carga', 'Tipo', 'Potência Prevista',
                    'Corrente Ib (A)', 'Bitola Condutor (mm²)', 'Disjuntor In (A)',
                    'Curva Disjuntor', 'Fase Conectada', 'Comprimento Rota (m)'
                ];
                const linhasCircuitos = [cabecalhoCircuitos];

                state.circuitosCalculados.forEach(c => {
                    linhasCircuitos.push([
                        c.num,
                        c.andar,
                        c.nome,
                        c.tipo,
                        c.pot,
                        c.ib,
                        c.cabo,
                        c.disj,
                        `Curva ${c.curva}`,
                        `Fase ${c.fase}`,
                        c.rota
                    ]);
                });
                const wsCircuitos = XLSX.utils.aoa_to_sheet(linhasCircuitos);
                XLSX.utils.book_append_sheet(wb, wsCircuitos, 'Quadro de Circuitos');

                // 3. ABA 3: QUANTITATIVO DE MATERIAIS PARA COMPRA (BOM)
                const cabecalhoMateriais = ['Categoria', 'Item / Descrição', 'Especificação Técnica', 'Quantidade', 'Unidade'];
                const linhasMateriais = [cabecalhoMateriais];

                const lisCabos = document.querySelectorAll('#listaCabos li');
                lisCabos.forEach(li => {
                    const desc = li.querySelector('.font-semibold').innerText;
                    const det = li.querySelector('.text-slate-400').innerText;
                    const qtd = li.querySelector('strong').innerText;
                    linhasMateriais.push(['Cabos Flexíveis', desc, det, qtd, 'm']);
                });

                const lisQuadros = document.querySelectorAll('#listaQuadros li');
                lisQuadros.forEach(li => {
                    const desc = (li.querySelector('.font-semibold') || li.querySelector('span')).innerText;
                    const detEl = li.querySelector('.text-slate-400');
                    const det = detEl ? detEl.innerText : 'NBR 5410 / NBR IEC 60898';
                    const qtd = li.querySelector('strong').innerText;
                    linhasMateriais.push(['Quadro, Prumadas e Eletrodutos', desc, det, qtd, 'un/m']);
                });

                const lisPontos = document.querySelectorAll('#listaPontosTomadas li');
                lisPontos.forEach(li => {
                    const desc = li.querySelector('.font-semibold').innerText;
                    const det = li.querySelector('.text-slate-400').innerText;
                    const qtd = li.querySelector('strong').innerText;
                    linhasMateriais.push(['Pontos e Acessórios', desc, det, qtd, 'un']);
                });

                const wsMateriais = XLSX.utils.aoa_to_sheet(linhasMateriais);
                XLSX.utils.book_append_sheet(wb, wsMateriais, 'Quantitativo de Materiais');

                // 4. ABA 4: PONTOS DE CONSUMO POR CÔMODO E PAVIMENTO
                const cabecalhoPontos = ['Pavimento', 'Cômodo', 'Identificação', 'Tipo', 'Potência (W)', 'Tensão (V)', 'Altura'];
                const linhasPontos = [cabecalhoPontos];

                state.pontosEletricos.forEach(pt => {
                    const c = state.comodos.find(cmd => cmd.id === pt.comodoId);
                    const pav = state.pavimentos.find(p => p.id === pt.pavimentoId);
                    linhasPontos.push([
                        pav ? pav.nome : 'Térreo',
                        c ? c.nome : 'Geral',
                        pt.nome,
                        pt.tipo,
                        pt.pot,
                        pt.tensao,
                        pt.altura || 'media'
                    ]);
                });
                const wsPontos = XLSX.utils.aoa_to_sheet(linhasPontos);
                XLSX.utils.book_append_sheet(wb, wsPontos, 'Pontos Elétricos TUG-TUE');

                XLSX.writeFile(wb, 'Projeto_Eletrico_MultiPavimentos_NBR5410.xlsx');

            } catch (err) {
                console.error('Erro na exportação Excel:', err);
                alert('Ocorreu um erro ao exportar para Excel: ' + err.message);
            }
        }
    </script>

    <!-- ========================================== -->
    <!-- MODAL 1: NOVO PROJETO (EM BRANCO OU MODELOS) -->
    <!-- ========================================== -->
    <div id="modalNovoProjeto" class="fixed inset-0 bg-slate-950/85 backdrop-blur-sm z-50 flex items-center justify-center hidden p-4">
        <div class="bg-slate-900 border border-slate-700 rounded-2xl max-w-2xl w-full mx-auto shadow-2xl overflow-hidden animate-in fade-in zoom-in-95 duration-200">
            <div class="bg-gradient-to-r from-emerald-950 via-slate-900 to-slate-900 p-5 border-b border-slate-800 flex justify-between items-center">
                <div class="flex items-center gap-3">
                    <span class="w-10 h-10 rounded-xl bg-emerald-500/20 text-emerald-400 border border-emerald-500/40 flex items-center justify-center text-lg shadow-lg">
                        <i class="fa-solid fa-folder-plus"></i>
                    </span>
                    <div>
                        <h3 class="text-base font-black text-white flex items-center gap-2">
                            Iniciar Novo Projeto Elétrico
                        </h3>
                        <p class="text-slate-400 text-xs mt-0.5">Comece um projeto limpo do zero ou selecione um modelo NBR 5410 pronto</p>
                    </div>
                </div>
                <button onclick="fecharModalNovoProjeto()" class="text-slate-400 hover:text-white p-2 rounded-lg hover:bg-slate-800 transition">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>

            <div class="p-6 space-y-5 text-xs">
                <div>
                    <label class="block font-bold text-slate-300 mb-1.5">Nome do Projeto / Obra:</label>
                    <input id="txtNovoProjetoNome" type="text" value="Residência Unifamiliar NBR 5410" class="w-full bg-slate-950 border border-slate-700 text-white rounded-xl p-3 outline-none focus:ring-2 focus:ring-emerald-500 text-sm font-semibold">
                </div>

                <div>
                    <span class="block font-bold text-slate-300 mb-2">Escolha o Ponto de Partida:</span>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                        <!-- Opção 1: Projeto em Branco -->
                        <div onclick="selecionarTemplateNovoProjeto('em_branco')" id="cardTpl_em_branco" class="template-card border-2 border-emerald-500 bg-emerald-950/20 p-4 rounded-xl cursor-pointer hover:border-emerald-400 transition space-y-1.5 relative">
                            <div class="flex items-center justify-between">
                                <span class="font-bold text-white text-sm flex items-center gap-2">
                                    <i class="fa-regular fa-file text-emerald-400"></i> Em Branco
                                </span>
                                <span class="text-[10px] bg-emerald-500/20 text-emerald-300 px-2 py-0.5 rounded-full font-bold border border-emerald-500/40">Recomendado</span>
                            </div>
                            <p class="text-slate-400 text-[11px]">Planta limpa com 1 pavimento térreo e quadro QDT pronto para desenhar paredes e cômodos do zero.</p>
                        </div>

                        <!-- Opção 2: Casa Térrea -->
                        <div onclick="selecionarTemplateNovoProjeto('casa_terrea')" id="cardTpl_casa_terrea" class="template-card border border-slate-800 bg-slate-950/60 p-4 rounded-xl cursor-pointer hover:border-slate-700 transition space-y-1.5">
                            <div class="flex items-center justify-between">
                                <span class="font-bold text-white text-sm flex items-center gap-2">
                                    <i class="fa-solid fa-house text-amber-400"></i> Casa Térrea (4 Cômodos)
                                </span>
                                <span class="text-[10px] bg-slate-800 text-slate-400 px-2 py-0.5 rounded-full font-bold">Completa</span>
                            </div>
                            <p class="text-slate-400 text-[11px]">Sala, Cozinha, Quarto e Banheiro já dimensionados com iluminação NBR 5410 e tomadas TUG/TUE.</p>
                        </div>

                        <!-- Opção 3: Sobrado 2 Pavimentos -->
                        <div onclick="selecionarTemplateNovoProjeto('sobrado')" id="cardTpl_sobrado" class="template-card border border-slate-800 bg-slate-950/60 p-4 rounded-xl cursor-pointer hover:border-slate-700 transition space-y-1.5">
                            <div class="flex items-center justify-between">
                                <span class="font-bold text-white text-sm flex items-center gap-2">
                                    <i class="fa-solid fa-building text-sky-400"></i> Sobrado (2 Andares)
                                </span>
                                <span class="text-[10px] bg-sky-500/20 text-sky-300 px-2 py-0.5 rounded-full font-bold">Multi-Pavimento</span>
                            </div>
                            <p class="text-slate-400 text-[11px]">Térreo + 1º Andar conectados por Prumada Vertical 3D, lajes independentes e circuitos distribuídos.</p>
                        </div>

                        <!-- Opção 4: Apartamento Studio -->
                        <div onclick="selecionarTemplateNovoProjeto('apartamento')" id="cardTpl_apartamento" class="template-card border border-slate-800 bg-slate-950/60 p-4 rounded-xl cursor-pointer hover:border-slate-700 transition space-y-1.5">
                            <div class="flex items-center justify-between">
                                <span class="font-bold text-white text-sm flex items-center gap-2">
                                    <i class="fa-solid fa-city text-purple-400"></i> Apartamento Compacto
                                </span>
                                <span class="text-[10px] bg-purple-500/20 text-purple-300 px-2 py-0.5 rounded-full font-bold">Studio</span>
                            </div>
                            <p class="text-slate-400 text-[11px]">Living integrado com cozinha americana, suíte e varanda técnica com ar-condicionado 12.000 BTU.</p>
                        </div>
                    </div>
                </div>

                <div class="bg-amber-950/30 border border-amber-500/40 p-3 rounded-xl flex items-start gap-2.5 text-amber-300 text-[11px]">
                    <i class="fa-solid fa-triangle-exclamation text-amber-400 text-sm mt-0.5"></i>
                    <span><strong>Dica:</strong> Se você possui alterações não salvas no projeto atual, um Ponto de Salvamento automático será guardado para você poder restaurá-lo a qualquer momento.</span>
                </div>
            </div>

            <div class="bg-slate-950 p-4 border-t border-slate-800 flex justify-between items-center">
                <button type="button" onclick="fecharModalNovoProjeto()" class="bg-slate-800 hover:bg-slate-700 text-slate-300 font-semibold px-4 py-2.5 rounded-xl transition">
                    Cancelar
                </button>
                <button type="button" onclick="confirmarIniciarNovoProjeto()" class="bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 text-white font-bold px-6 py-2.5 rounded-xl transition flex items-center gap-2 text-xs shadow-lg shadow-emerald-600/30">
                    <i class="fa-solid fa-check"></i> Criar & Iniciar Projeto
                </button>
            </div>
        </div>
    </div>

    <!-- ============================================================== -->
    <!-- MODAL 2: GERENCIAR PROJETOS, PONTOS DE SALVAMENTO & ARQUIVOS -->
    <!-- ============================================================== -->
    <div id="modalGerenciarProjetos" class="fixed inset-0 bg-slate-950/85 backdrop-blur-sm z-50 flex items-center justify-center hidden p-4">
        <div class="bg-slate-900 border border-slate-700 rounded-2xl max-w-3xl w-full mx-auto shadow-2xl overflow-hidden flex flex-col max-h-[90vh]">
            <div class="bg-slate-950 p-5 border-b border-slate-800 flex justify-between items-center">
                <div class="flex items-center gap-3">
                    <span class="w-10 h-10 rounded-xl bg-amber-500/20 text-amber-400 border border-amber-500/40 flex items-center justify-center text-lg shadow-lg">
                        <i class="fa-solid fa-clock-rotate-left"></i>
                    </span>
                    <div>
                        <h3 class="text-base font-black text-white flex items-center gap-2">
                            Projetos Salvos & Pontos de Restauração
                        </h3>
                        <p class="text-slate-400 text-xs mt-0.5">Navegue pelo histórico de checkpoints, projetos salvos no navegador ou exporte arquivos .proeletrica</p>
                    </div>
                </div>
                <button onclick="fecharModalGerenciarProjetos()" class="text-slate-400 hover:text-white p-2 rounded-lg hover:bg-slate-800 transition">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>

            <!-- Abas do Gerenciador -->
            <div class="flex border-b border-slate-800 bg-slate-950/60 px-5 pt-2 text-xs font-bold gap-1 sm:gap-2 overflow-x-auto [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden">
                <button id="btnTabPastaProjetos" onclick="trocarAbaGerenciador('pasta')" class="px-4 py-2.5 border-b-2 border-sky-400 text-sky-400 flex items-center gap-2 whitespace-nowrap">
                    <i class="fa-solid fa-folder-tree text-sky-400"></i> Pasta do Computador (projetos/)
                </button>
                <button id="btnTabCheckpoints" onclick="trocarAbaGerenciador('checkpoints')" class="px-4 py-2.5 border-b-2 border-transparent text-slate-400 hover:text-slate-200 flex items-center gap-2 whitespace-nowrap">
                    <i class="fa-solid fa-bookmark"></i> Pontos de Salvamento (Checkpoints)
                </button>
                <button id="btnTabProjetos" onclick="trocarAbaGerenciador('projetos')" class="px-4 py-2.5 border-b-2 border-transparent text-slate-400 hover:text-slate-200 flex items-center gap-2 whitespace-nowrap">
                    <i class="fa-solid fa-folder-open"></i> Navegador (LocalStorage)
                </button>
                <button id="btnTabArquivos" onclick="trocarAbaGerenciador('arquivos')" class="px-4 py-2.5 border-b-2 border-transparent text-slate-400 hover:text-slate-200 flex items-center gap-2 whitespace-nowrap">
                    <i class="fa-solid fa-file-arrow-up"></i> Arquivos (.proeletrica / .json)
                </button>
            </div>

            <!-- CONTEÚDO 0: PASTA DE PROJETOS NO COMPUTADOR -->
            <div id="painelTabPastaProjetos" class="p-6 overflow-y-auto space-y-4 flex-1 text-xs">
                <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 bg-slate-950 p-4 rounded-xl border border-sky-900/60 shadow-lg">
                    <div class="space-y-1">
                        <div class="flex items-center gap-2">
                            <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 shadow shadow-emerald-400/80 ring-2 ring-emerald-950"></span>
                            <span class="font-bold text-white text-sm">Pasta Local: <code class="font-mono text-sky-300 text-xs bg-slate-900 px-2 py-0.5 rounded border border-slate-800">projeto_eletrico/projetos/</code></span>
                        </div>
                        <p class="text-slate-400 text-[11px]">Todos os projetos salvos nesta pasta ficam gravados permanentemente no seu disco e prontos para backup ou compartilhamento.</p>
                    </div>
                    <div class="flex flex-wrap items-center gap-2 w-full sm:w-auto">
                        <button onclick="salvarProjetoNaPastaServidor()" class="bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 text-white font-bold px-3.5 py-2 rounded-xl transition flex items-center gap-1.5 shadow-lg shadow-emerald-600/25 whitespace-nowrap">
                            <i class="fa-solid fa-floppy-disk"></i> Salvar Projeto Atual na Pasta
                        </button>
                        <button onclick="abrirPastaProjetosNoExplorer()" class="bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 font-bold px-3 py-2 rounded-xl transition flex items-center gap-1.5 whitespace-nowrap" title="Abrir pasta 'projetos' no Explorador de Arquivos do Windows">
                            <i class="fa-solid fa-folder-open text-amber-400"></i> Abrir Pasta no Windows
                        </button>
                    </div>
                </div>

                <div>
                    <div class="flex justify-between items-center mb-2">
                        <h4 class="font-bold text-slate-300 flex items-center gap-2">
                            <i class="fa-solid fa-hard-drive text-sky-400"></i> Arquivos Salvos em <code class="text-sky-300 font-mono">projetos/</code>:
                        </h4>
                        <button onclick="carregarListaProjetosPastaServidor()" class="text-slate-400 hover:text-white text-[11px] flex items-center gap-1">
                            <i class="fa-solid fa-rotate-right"></i> Atualizar Lista
                        </button>
                    </div>
                    <div id="listaProjetosPastaServidorContainer" class="space-y-2.5">
                        <!-- Injetado via carregarListaProjetosPastaServidor() -->
                    </div>
                </div>
            </div>

            <!-- CONTEÚDO 1: PONTOS DE SALVAMENTO -->
            <div id="painelTabCheckpoints" class="p-6 overflow-y-auto space-y-4 flex-1 text-xs hidden">
                <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2 bg-slate-950 p-3.5 rounded-xl border border-slate-800">
                    <div>
                        <span class="font-bold text-white block">Salvar Ponto Atual</span>
                        <span class="text-slate-400 text-[11px]">Grave o estado exato de agora para poder desfazer ou voltar a qualquer instante.</span>
                    </div>
                    <button onclick="salvarPontoRapidoComNome()" class="bg-amber-600 hover:bg-amber-500 text-white font-bold px-4 py-2 rounded-xl transition flex items-center gap-2 shadow-lg shadow-amber-600/20 whitespace-nowrap">
                        <i class="fa-solid fa-floppy-disk"></i> Criar Novo Ponto Agora
                    </button>
                </div>

                <div>
                    <h4 class="font-bold text-slate-300 mb-2 flex items-center gap-2">
                        <i class="fa-solid fa-timeline text-amber-400"></i> Histórico de Checkpoints do Projeto:
                    </h4>
                    <div id="listaCheckpointsContainer" class="space-y-2">
                        <!-- Injetado via renderizarListaCheckpoints() -->
                    </div>
                </div>
            </div>

            <!-- CONTEÚDO 2: MEUS PROJETOS SALVOS NO NAVEGADOR -->
            <div id="painelTabProjetos" class="p-6 overflow-y-auto space-y-4 flex-1 text-xs hidden">
                <div class="flex justify-between items-center">
                    <span class="text-slate-400">Projetos gravados na memória local deste navegador:</span>
                    <button onclick="salvarProjetoAtualNoLocalStorage()" class="bg-emerald-600 hover:bg-emerald-500 text-white font-bold px-3.5 py-1.5 rounded-xl transition flex items-center gap-1.5">
                        <i class="fa-solid fa-floppy-disk"></i> Salvar Projeto Atual
                    </button>
                </div>
                <div id="listaProjetosLocalStorageContainer" class="space-y-3">
                    <!-- Injetado via renderizarListaProjetosSalvos() -->
                </div>
            </div>

            <!-- CONTEÚDO 3: ARQUIVOS (.proeletrica / .json) -->
            <div id="painelTabArquivos" class="p-6 overflow-y-auto space-y-5 flex-1 text-xs hidden">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <!-- Baixar Arquivo -->
                    <div class="bg-slate-950 p-5 rounded-2xl border border-slate-800 space-y-3 flex flex-col justify-between">
                        <div class="space-y-2">
                            <span class="w-10 h-10 rounded-xl bg-emerald-500/20 text-emerald-400 flex items-center justify-center text-lg">
                                <i class="fa-solid fa-file-arrow-down"></i>
                            </span>
                            <h4 class="font-bold text-white text-sm">Baixar Arquivo (.proeletrica)</h4>
                            <p class="text-slate-400 text-[11px] leading-relaxed">
                                Salve seu projeto completo em um arquivo no seu computador para enviar a clientes, engenheiros ou continuar em outra máquina.
                            </p>
                        </div>
                        <button onclick="exportarArquivoProjeto()" class="w-full bg-emerald-600 hover:bg-emerald-500 text-white font-bold py-2.5 rounded-xl transition flex items-center justify-center gap-2 shadow-lg shadow-emerald-600/20">
                            <i class="fa-solid fa-download"></i> Baixar Arquivo do Projeto
                        </button>
                    </div>

                    <!-- Carregar Arquivo -->
                    <div class="bg-slate-950 p-5 rounded-2xl border border-slate-800 space-y-3 flex flex-col justify-between">
                        <div class="space-y-2">
                            <span class="w-10 h-10 rounded-xl bg-sky-500/20 text-sky-400 flex items-center justify-center text-lg">
                                <i class="fa-solid fa-file-arrow-up"></i>
                            </span>
                            <h4 class="font-bold text-white text-sm">Carregar Arquivo (.proeletrica / .json)</h4>
                            <p class="text-slate-400 text-[11px] leading-relaxed">
                                Abra um arquivo salvo anteriormente para continuar a edição com todas as paredes, cômodos, circuitos e cálculos intactos.
                            </p>
                        </div>
                        <label class="w-full bg-sky-600 hover:bg-sky-500 text-white font-bold py-2.5 rounded-xl transition flex items-center justify-center gap-2 shadow-lg shadow-sky-600/20 cursor-pointer">
                            <i class="fa-solid fa-folder-open"></i> Selecionar Arquivo
                            <input type="file" id="inputArquivoProeletrica" accept=".proeletrica,.json" onchange="importarArquivoProjeto(event)" class="hidden">
                        </label>
                    </div>
                </div>
            </div>

            <div class="bg-slate-950 p-4 border-t border-slate-800 flex justify-end">
                <button type="button" onclick="fecharModalGerenciarProjetos()" class="bg-slate-800 hover:bg-slate-700 text-slate-300 font-semibold px-5 py-2 rounded-xl transition">
                    Fechar
                </button>
            </div>
        </div>
    </div>

    <!-- TOAST NOTIFICATION CONTAINER -->
    <div id="toastNotificacao" class="fixed bottom-6 right-6 z-50 bg-slate-900 border border-emerald-500/60 text-white px-4 py-3 rounded-2xl shadow-2xl flex items-center gap-3 text-xs pointer-events-none transition-all duration-300 opacity-0 translate-y-4">
        <span id="toastIcone" class="text-emerald-400 text-base"><i class="fa-solid fa-circle-check"></i></span>
        <span id="toastMensagem" class="font-semibold">Projeto salvo com sucesso!</span>
    </div>

    <!-- MOBILE FLOATING ACTION BUTTON (FAB: + RÁPIDO PARA ADICIONAR ELEMENTOS) -->
    <div class="mobile-fab fixed bottom-20 right-4 z-40 flex flex-col items-end gap-2 no-print">
        <!-- Speed Dial Items (Ocultos por padrão, alternados ao clicar no FAB) -->
        <div id="mobileSpeedDialItems" class="hidden flex-col items-end gap-2 mb-1">
            <button onclick="abrirModalPontoNovo('TUG'); toggleSpeedDialMobile();" class="bg-emerald-600 hover:bg-emerald-500 text-white font-bold py-1.5 px-3 rounded-xl shadow-lg flex items-center gap-2 text-xs border border-emerald-400/40">
                <span>+ Tomada TUG</span> <i class="fa-solid fa-plug text-xs"></i>
            </button>
            <button onclick="abrirModalPontoNovo('TUE'); toggleSpeedDialMobile();" class="bg-blue-600 hover:bg-blue-500 text-white font-bold py-1.5 px-3 rounded-xl shadow-lg flex items-center gap-2 text-xs border border-blue-400/40">
                <span>+ Tomada TUE</span> <i class="fa-solid fa-bolt text-xs"></i>
            </button>
            <button onclick="abrirModalPontoNovo('ILUM'); toggleSpeedDialMobile();" class="bg-amber-600 hover:bg-amber-500 text-slate-950 font-bold py-1.5 px-3 rounded-xl shadow-lg flex items-center gap-2 text-xs border border-amber-300">
                <span>+ Lâmpada</span> <i class="fa-solid fa-lightbulb text-xs"></i>
            </button>
            <button onclick="abrirModalPontoNovo('INTERRUPTOR'); toggleSpeedDialMobile();" class="bg-purple-600 hover:bg-purple-500 text-white font-bold py-1.5 px-3 rounded-xl shadow-lg flex items-center gap-2 text-xs border border-purple-400/40">
                <span>+ Interruptor</span> <i class="fa-solid fa-toggle-on text-xs"></i>
            </button>
            <button onclick="abrirModalNovoComodo(); toggleSpeedDialMobile();" class="bg-slate-800 hover:bg-slate-700 text-amber-400 font-bold py-1.5 px-3 rounded-xl shadow-lg flex items-center gap-2 text-xs border border-amber-500/40">
                <span>+ Novo Cômodo</span> <i class="fa-solid fa-cube text-xs"></i>
            </button>
        </div>

        <!-- Botão Principal do FAB -->
        <button id="btnPrincipalFabMobile" onclick="toggleSpeedDialMobile()" class="mobile-fab-btn w-13 h-13 p-3.5 bg-gradient-to-tr from-amber-500 to-orange-500 hover:from-amber-400 hover:to-orange-400 text-slate-950 rounded-full shadow-2xl flex items-center justify-center text-lg font-black transition active:scale-95 ring-4 ring-slate-950/80">
            <i id="iconeFabPrincipal" class="fa-solid fa-plus text-xl transition transform"></i>
        </button>
    </div>

    <!-- MOBILE BOTTOM NAVIGATION BAR (BARRA NATIVA INFERIOR COM AS 6 ABAS) -->
    <nav class="mobile-bottom-nav fixed bottom-0 left-0 right-0 z-40 bg-slate-900/95 backdrop-blur-xl border-t border-slate-800/90 shadow-2xl flex items-center justify-around px-1 py-1.5 text-slate-400 no-print safe-area-bottom">
        <button data-tab="planta" onclick="trocarAba('planta')" class="tab-btn-mobile text-amber-400 border-t-2 border-amber-400 bg-slate-850 flex flex-col items-center justify-center w-full py-1 rounded-lg transition active:scale-95">
            <i class="fa-solid fa-pen-ruler text-sm"></i>
            <span class="text-[9px] font-bold mt-0.5">Planta</span>
        </button>
        <button data-tab="instalacoes" onclick="trocarAba('instalacoes')" class="tab-btn-mobile flex flex-col items-center justify-center w-full py-1 rounded-lg transition active:scale-95">
            <i class="fa-solid fa-bolt-lightning text-sm"></i>
            <span class="text-[9px] font-medium mt-0.5">Elétrica</span>
        </button>
        <button data-tab="visualizacao3d" onclick="trocarAba('visualizacao3d')" class="tab-btn-mobile flex flex-col items-center justify-center w-full py-1 rounded-lg transition active:scale-95">
            <i class="fa-solid fa-cube text-sm"></i>
            <span class="text-[9px] font-medium mt-0.5">3D BIM</span>
        </button>
        <button data-tab="alimentador" onclick="trocarAba('alimentador')" class="tab-btn-mobile flex flex-col items-center justify-center w-full py-1 rounded-lg transition active:scale-95">
            <i class="fa-solid fa-microchip text-sm"></i>
            <span class="text-[9px] font-medium mt-0.5">Quadro</span>
        </button>
        <button data-tab="materiais" onclick="trocarAba('materiais')" class="tab-btn-mobile flex flex-col items-center justify-center w-full py-1 rounded-lg transition active:scale-95">
            <i class="fa-solid fa-boxes-stacked text-sm"></i>
            <span class="text-[9px] font-medium mt-0.5">Materiais</span>
        </button>
        <button data-tab="duvidas" onclick="trocarAba('duvidas')" class="tab-btn-mobile flex flex-col items-center justify-center w-full py-1 rounded-lg transition active:scale-95">
            <i class="fa-solid fa-circle-question text-sm"></i>
            <span class="text-[9px] font-medium mt-0.5">NBR 5410</span>
        </button>
    </nav>

    <!-- MODAL DE INSTRUÇÕES PWA IOS -->
    <div id="modalInstrucoesIOS" class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 flex items-center justify-center hidden p-4">
        <div class="bg-slate-900 border border-slate-700 w-full max-w-sm rounded-2xl p-5 shadow-2xl space-y-4 text-center">
            <div class="w-12 h-12 rounded-2xl bg-amber-500/20 text-amber-400 border border-amber-500/40 flex items-center justify-center text-2xl mx-auto shadow-inner">
                <i class="fa-brands fa-apple"></i>
            </div>
            <h3 class="text-base font-bold text-white">Instalar no iPhone / iPad</h3>
            <p class="text-xs text-slate-300 leading-relaxed text-left">
                No navegador Safari do seu dispositivo Apple, siga estes 2 passos:
            </p>
            <div class="bg-slate-950 p-3.5 rounded-xl border border-slate-800 text-left space-y-2.5 text-xs">
                <div class="flex items-start gap-2.5 text-slate-200">
                    <span class="w-5 h-5 rounded-full bg-slate-800 text-amber-400 flex items-center justify-center font-bold text-[10px] shrink-0 mt-0.5">1</span>
                    <span>Toque no botão <strong>Compartilhar</strong> (<i class="fa-solid fa-arrow-up-from-bracket text-sky-400 mx-1"></i>) localizado na barra inferior do Safari.</span>
                </div>
                <div class="flex items-start gap-2.5 text-slate-200">
                    <span class="w-5 h-5 rounded-full bg-slate-800 text-amber-400 flex items-center justify-center font-bold text-[10px] shrink-0 mt-0.5">2</span>
                    <span>Role para cima e toque em <strong>"Adicionar à Tela de Início"</strong> (<i class="fa-regular fa-square-plus text-emerald-400 mx-1"></i>).</span>
                </div>
            </div>
            <button onclick="document.getElementById('modalInstrucoesIOS').classList.add('hidden')" class="w-full bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold py-2.5 rounded-xl text-xs transition shadow">
                OK, Entendi
            </button>
        </div>
    </div>

<script>
    // =========================================================================
    // PWA & SERVICE WORKER LIFECYCLE HANDLERS
    // =========================================================================
    let deferredPromptPWA = null;

    if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
        // Habilita Zoom Suave com Mouse Wheel nos dois Canvases
        habilitarZoomMouseWheel('cadCanvas');
        habilitarZoomMouseWheel('instalacoesCanvas');

            navigator.serviceWorker.register('./sw.js')
                .then(reg => console.log('[PWA] Service Worker ativo:', reg.scope))
                .catch(err => console.log('[PWA] Erro ao registrar Service Worker:', err));
        });
    }

    window.addEventListener('beforeinstallprompt', (e) => {
        // Previne o infobar automático para que possamos usar nosso botão estilizado
        e.preventDefault();
        deferredPromptPWA = e;
        console.log('[PWA] Evento beforeinstallprompt capturado');
        const btnM = document.getElementById('btnInstalarAppMobile');
        const btnD = document.getElementById('btnInstalarAppDesktop');
        if (btnM) btnM.classList.remove('hidden');
        if (btnD) btnD.classList.remove('hidden');
    });

    window.addEventListener('appinstalled', () => {
        console.log('[PWA] Aplicativo instalado com sucesso!');
        deferredPromptPWA = null;
        const btnM = document.getElementById('btnInstalarAppMobile');
        const btnD = document.getElementById('btnInstalarAppDesktop');
        if (btnM) btnM.classList.add('hidden');
        if (btnD) btnD.classList.add('hidden');
    });

    function dispararInstalacaoPWA() {
        const isIOS = /iPad|iPhone|iPod/.test(navigator.userAgent) && !window.MSStream;
        if (deferredPromptPWA) {
            deferredPromptPWA.prompt();
            deferredPromptPWA.userChoice.then((choiceResult) => {
                if (choiceResult.outcome === 'accepted') {
                    console.log('[PWA] Usuário aceitou a instalação');
                } else {
                    console.log('[PWA] Usuário recusou a instalação');
                }
                deferredPromptPWA = null;
            });
        } else if (isIOS) {
            const m = document.getElementById('modalInstrucoesIOS');
            if (m) m.classList.remove('hidden');
        } else {
            // Em navegadores de computador ou quando já instalado
            const m = document.getElementById('modalInstrucoesIOS');
            if (m) {
                m.classList.remove('hidden');
            } else {
                alert('Para instalar o aplicativo no seu dispositivo: No menu do navegador (três pontos ⋮), selecione "Instalar PRO-ELÉTRICA" ou "Adicionar à tela inicial".');
            }
        }
    }
</script>

    <!-- ===================================================================== -->
    <!-- MODAL DE SELEÇÃO DA CONCESSIONÁRIA / DISTRIBUIDORA LOCAL (NBR 5410 & PRODIST) -->
    <!-- ===================================================================== -->
    <div id="modalConcessionariaLocal" class="hidden fixed inset-0 z-50 bg-slate-950/85 backdrop-blur-md flex items-center justify-center p-3 sm:p-4 overflow-y-auto">
        <div class="bg-slate-900 border-2 border-sky-500/60 rounded-2xl w-full max-w-3xl max-h-[90vh] flex flex-col shadow-2xl overflow-hidden">
            <!-- TOPO DO MODAL -->
            <div class="bg-gradient-to-r from-sky-950 via-slate-900 to-slate-900 p-4 sm:p-5 border-b border-slate-800 flex justify-between items-center">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-sky-500/20 text-sky-400 border border-sky-500/40 flex items-center justify-center text-xl shadow">
                        <i class="fa-solid fa-tower-broadcast"></i>
                    </div>
                    <div>
                        <h3 class="text-base font-black text-white flex items-center gap-2">
                            Empresa Fornecedora do Serviço Local (Concessionária de Energia)
                        </h3>
                        <p class="text-xs text-slate-400">
                            Selecione sua distribuidora para o cálculo do Fator de Demanda e Dimensionamento do Padrão de Entrada (NBR 5410 item 9.5.2)
                        </p>
                    </div>
                </div>
                <button onclick="fecharModalConcessionaria()" class="w-8 h-8 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-400 hover:text-white flex items-center justify-center transition">
                    <i class="fa-solid fa-xmark text-sm"></i>
                </button>
            </div>

            <!-- FILTRO E BUSCA -->
            <div class="p-4 bg-slate-950/90 border-b border-slate-800 flex flex-col sm:flex-row gap-3 items-center justify-between text-xs">
                <div class="relative w-full sm:w-72">
                    <i class="fa-solid fa-magnifying-glass absolute left-3 top-2.5 text-slate-500"></i>
                    <input id="txtBuscaConcessionaria" type="text" placeholder="Buscar distribuidora ou estado (ex: SP, MG, Copel)..." 
                        oninput="filtrarListaConcessionarias()"
                        class="w-full bg-slate-900 border border-slate-700 rounded-xl pl-8 pr-3 py-1.5 text-xs text-white placeholder-slate-500 focus:ring-1 focus:ring-sky-400 outline-none">
                </div>
                <div class="flex items-center gap-2 w-full sm:w-auto justify-end">
                    <label class="text-slate-400 text-[11px] whitespace-nowrap">Filtrar Região/UF:</label>
                    <select id="selFiltroUfConcessionaria" onchange="filtrarListaConcessionarias()" class="bg-slate-900 border border-slate-700 text-sky-300 rounded-xl px-2 py-1.5 text-xs font-bold outline-none">
                        <option value="todos">Todos os Estados (Nacional)</option>
                        <option value="SP">São Paulo (SP)</option>
                        <option value="MG">Minas Gerais (MG)</option>
                        <option value="RJ">Rio de Janeiro (RJ)</option>
                        <option value="PR">Paraná (PR)</option>
                        <option value="SC">Santa Catarina (SC)</option>
                        <option value="RS">Rio Grande do Sul (RS)</option>
                        <option value="BA">Bahia (BA)</option>
                        <option value="GO">Goiás (GO)</option>
                        <option value="outros">Demais Estados / ANEEL</option>
                    </select>
                </div>
            </div>

            <!-- LISTA DE CONCESSIONÁRIAS -->
            <div class="p-4 overflow-y-auto max-h-[50vh] space-y-2.5" id="gridConcessionarias">
                <!-- Preenchido dinamicamente via renderizarListaConcessionarias() -->
            </div>

            <!-- RODAPÉ DO MODAL COM PARÂMETROS ADICIONAIS -->
            <div class="p-4 bg-slate-950 border-t border-slate-800 flex flex-col sm:flex-row justify-between items-center gap-3 text-xs">
                <div class="flex items-center gap-2 text-slate-400 text-[11px]">
                    <i class="fa-solid fa-circle-info text-sky-400"></i>
                    <span>Tensão Secundária Padrão da Concessionária:</span>
                    <span id="lblTensaoNominalConcessionaria" class="text-amber-300 font-mono font-bold">127 / 220V</span>
                </div>
                <div class="flex items-center gap-2 w-full sm:w-auto justify-end">
                    <button onclick="fecharModalConcessionaria()" class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 font-bold transition">
                        Fechar
                    </button>
                    <button onclick="confirmarConcessionariaSelecionada()" class="px-5 py-2 rounded-xl bg-sky-500 hover:bg-sky-400 text-slate-950 font-black flex items-center gap-2 shadow-lg shadow-sky-500/20 transition active:scale-95">
                        <i class="fa-solid fa-check"></i> Aplicar e Recalcular Demanda
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- ===================================================================== -->
    <!-- MODAL DE MEMÓRIA DE CÁLCULO DE DEMANDA DETALHADA (PARCELAS A, B, C, D) -->
    <!-- ===================================================================== -->
    <div id="modalMemoriaDemanda" class="hidden fixed inset-0 z-50 bg-slate-950/85 backdrop-blur-md flex items-center justify-center p-3 sm:p-4 overflow-y-auto">
        <div class="bg-slate-900 border-2 border-amber-500/60 rounded-2xl w-full max-w-4xl max-h-[92vh] flex flex-col shadow-2xl overflow-hidden">
            <!-- TOPO DO MODAL -->
            <div class="bg-gradient-to-r from-amber-950/60 via-slate-900 to-slate-900 p-4 sm:p-5 border-b border-slate-800 flex justify-between items-center">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-amber-500/20 text-amber-400 border border-amber-500/40 flex items-center justify-center text-xl shadow">
                        <i class="fa-solid fa-calculator"></i>
                    </div>
                    <div>
                        <h3 class="text-base font-black text-white flex items-center gap-2">
                            Memória de Cálculo do Fator de Demanda & Padrão de Entrada
                        </h3>
                        <p class="text-xs text-slate-400">
                            Detalhamento analítico das parcelas a, b, c, d conforme a norma da concessionária e NBR 5410
                        </p>
                    </div>
                </div>
                <button onclick="fecharModalMemoriaDemanda()" class="w-8 h-8 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-400 hover:text-white flex items-center justify-center transition">
                    <i class="fa-solid fa-xmark text-sm"></i>
                </button>
            </div>

            <!-- CORPO DO MEMORIAL -->
            <div id="conteudoMemoriaDemanda" class="p-5 overflow-y-auto max-h-[70vh] space-y-5 text-xs text-slate-300">
                <!-- Injetado dinamicamente -->
            </div>

            <!-- RODAPÉ DO MODAL -->
            <div class="p-4 bg-slate-950 border-t border-slate-800 flex justify-between items-center text-xs">
                <span class="text-slate-400 text-[11px]">
                    <i class="fa-solid fa-shield-halved text-emerald-400"></i> Memória em conformidade com as exigências de aprovação técnica da concessionária.
                </span>
                <button onclick="fecharModalMemoriaDemanda()" class="px-5 py-2 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-black transition active:scale-95">
                    Entendido
                </button>
            </div>
        </div>
    </div>


    <!-- ===================================================================== -->
    <!-- MODAL DE CONFIGURAÇÃO DO TERRENO TOTAL (LOTE) VS ÁREA CONSTRUÍDA -->
    <!-- ===================================================================== -->
    <div id="modalConfigTerreno" class="hidden fixed inset-0 z-50 bg-slate-950/85 backdrop-blur-md flex items-center justify-center p-3 sm:p-4 overflow-y-auto">
        <div class="bg-slate-900 border-2 border-emerald-500/60 rounded-2xl w-full max-w-lg shadow-2xl overflow-hidden">
            <!-- TOPO -->
            <div class="bg-gradient-to-r from-emerald-950 via-slate-900 to-slate-900 p-4 border-b border-slate-800 flex justify-between items-center">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-emerald-500/20 text-emerald-400 border border-emerald-500/40 flex items-center justify-center text-xl shadow">
                        <i class="fa-solid fa-border-all"></i>
                    </div>
                    <div>
                        <h3 class="text-base font-black text-white">Configuração do Terreno Total (Lote)</h3>
                        <p class="text-xs text-slate-400">Dimensões do terreno, recuos municipais e cálculo da taxa de ocupação</p>
                    </div>
                </div>
                <button onclick="fecharModalConfigTerreno()" class="w-8 h-8 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-400 hover:text-white flex items-center justify-center transition">
                    <i class="fa-solid fa-xmark text-sm"></i>
                </button>
            </div>

            <!-- CORPO -->
            <div class="p-5 space-y-4 text-xs">
                <!-- PRESETS RÁPIDOS -->
                <div class="space-y-1.5">
                    <label class="text-slate-300 font-bold block text-[11px]">Modelos de Lote Pré-configurados:</label>
                    <div class="grid grid-cols-2 gap-2">
                        <button type="button" onclick="aplicarPresetTerreno(10.0, 20.0, 4.0, 1.5, 3.0)" class="p-2 rounded-xl bg-slate-950 border border-slate-800 hover:border-emerald-500/60 text-left transition">
                            <span class="font-bold text-white block">10m × 20m</span>
                            <span class="text-[10px] text-emerald-400">200 m² (Compacto)</span>
                        </button>
                        <button type="button" onclick="aplicarPresetTerreno(12.0, 25.0, 4.0, 1.5, 3.0)" class="p-2 rounded-xl bg-slate-950 border border-emerald-500/60 text-left transition ring-1 ring-emerald-500/30">
                            <span class="font-bold text-white block">12m × 25m</span>
                            <span class="text-[10px] text-emerald-400 font-bold">300 m² (Padrão BR)</span>
                        </button>
                        <button type="button" onclick="aplicarPresetTerreno(15.0, 30.0, 5.0, 2.0, 4.0)" class="p-2 rounded-xl bg-slate-950 border border-slate-800 hover:border-emerald-500/60 text-left transition">
                            <span class="font-bold text-white block">15m × 30m</span>
                            <span class="text-[10px] text-emerald-400">450 m² (Médio)</span>
                        </button>
                        <button type="button" onclick="aplicarPresetTerreno(20.0, 40.0, 5.0, 3.0, 5.0)" class="p-2 rounded-xl bg-slate-950 border border-slate-800 hover:border-emerald-500/60 text-left transition">
                            <span class="font-bold text-white block">20m × 40m</span>
                            <span class="text-[10px] text-emerald-400">800 m² (Chácara/Amplo)</span>
                        </button>
                    </div>
                </div>

                <!-- INPUTS DE DIMENSÃO -->
                <div class="grid grid-cols-2 gap-3 pt-2 border-t border-slate-800">
                    <div>
                        <label class="block text-slate-400 text-[11px] mb-1">Largura / Testada (Frente m):</label>
                        <input id="numTerrenoLargura" type="number" step="0.5" min="5" max="100" value="12.0" class="w-full bg-slate-950 border border-slate-700 text-white font-mono font-bold p-2 rounded-xl text-xs focus:ring-1 focus:ring-emerald-400 outline-none">
                    </div>
                    <div>
                        <label class="block text-slate-400 text-[11px] mb-1">Comprimento / Profundidade (m):</label>
                        <input id="numTerrenoComprimento" type="number" step="0.5" min="10" max="200" value="25.0" class="w-full bg-slate-950 border border-slate-700 text-white font-mono font-bold p-2 rounded-xl text-xs focus:ring-1 focus:ring-emerald-400 outline-none">
                    </div>
                </div>

                <!-- INPUTS DE RECUOS -->
                <div class="grid grid-cols-3 gap-2">
                    <div>
                        <label class="block text-slate-400 text-[10px] mb-1">Recuo Frontal (m):</label>
                        <input id="numTerrenoRecuoFrontal" type="number" step="0.5" min="0" max="20" value="4.0" class="w-full bg-slate-950 border border-slate-700 text-amber-300 font-mono font-bold p-1.5 rounded-lg text-xs text-center outline-none">
                    </div>
                    <div>
                        <label class="block text-slate-400 text-[10px] mb-1">Recuo Lateral (m):</label>
                        <input id="numTerrenoRecuoLateral" type="number" step="0.5" min="0" max="10" value="1.5" class="w-full bg-slate-950 border border-slate-700 text-amber-300 font-mono font-bold p-1.5 rounded-lg text-xs text-center outline-none">
                    </div>
                    <div>
                        <label class="block text-slate-400 text-[10px] mb-1">Recuo Fundos (m):</label>
                        <input id="numTerrenoRecuoFundos" type="number" step="0.5" min="0" max="20" value="3.0" class="w-full bg-slate-950 border border-slate-700 text-amber-300 font-mono font-bold p-1.5 rounded-lg text-xs text-center outline-none">
                    </div>
                </div>

                <div class="bg-slate-950 p-3 rounded-xl border border-slate-800 space-y-1 text-[11px]">
                    <div class="flex justify-between text-slate-400">
                        <span>Área Calculada do Lote:</span>
                        <strong id="lblPreviewAreaTerreno" class="text-emerald-400 font-mono">300.0 m²</strong>
                    </div>
                    <div class="flex justify-between text-slate-400">
                        <span>Área Edificável Máxima:</span>
                        <strong id="lblPreviewAreaEdificavel" class="text-amber-300 font-mono">162.0 m²</strong>
                    </div>
                </div>
            </div>

            <!-- RODAPÉ -->
            <div class="p-4 bg-slate-950 border-t border-slate-800 flex justify-between items-center text-xs">
                <button type="button" onclick="fecharModalConfigTerreno()" class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 font-bold transition">
                    Cancelar
                </button>
                <button type="button" onclick="salvarConfigTerreno()" class="px-5 py-2 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-black flex items-center gap-2 shadow-lg shadow-emerald-500/20 transition active:scale-95">
                    <i class="fa-solid fa-check"></i> Salvar e Atualizar Terreno
                </button>
            </div>
        </div>
    </div>

    <!-- MODAL DE CONFIGURAÇÃO DE ESPESSURA DE PAREDES (NORMAS TÉCNICAS NBR) -->
    <div id="modalConfigParedes" class="hidden fixed inset-0 z-50 bg-slate-950/85 backdrop-blur-md flex items-center justify-center p-4">
        <div class="bg-slate-900 border-2 border-slate-700 w-full max-w-lg rounded-3xl shadow-2xl overflow-hidden animate-in fade-in zoom-in-95 duration-200">
            <!-- CABEÇALHO -->
            <div class="p-5 bg-slate-950 border-b border-slate-800 flex justify-between items-center">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-2xl bg-sky-500/20 text-sky-400 flex items-center justify-center text-lg border border-sky-500/40">
                        <i class="fa-solid fa-border-all"></i>
                    </div>
                    <div>
                        <h3 class="font-bold text-white text-base">Espessura das Paredes (Normas NBR)</h3>
                        <p class="text-xs text-slate-400">NBR 15575 (Desempenho) • NBR 15270 (Blocos Cerâmicos) • NBR 16868 (Alvenaria)</p>
                    </div>
                </div>
                <button onclick="fecharModalConfigParedes()" class="text-slate-400 hover:text-white p-2 rounded-xl hover:bg-slate-800 transition">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>

            <!-- CORPO -->
            <div class="p-6 space-y-4 text-xs">
                <div>
                    <label class="block font-semibold text-slate-300 uppercase mb-1.5 text-[11px]">Pré-definições Segundo Normas Técnicas Brasileiras:</label>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                        <!-- PRESET 15CM - PADRÃO NBR RECOMENDADO -->
                        <div onclick="selecionarPresetEspessura(0.15)" id="cardEsp_0.15" class="card-espessura border-2 border-sky-500 bg-sky-950/20 p-3 rounded-2xl cursor-pointer hover:border-sky-400 transition space-y-1 relative">
                            <div class="flex justify-between items-center">
                                <span class="font-black text-white text-sm">15 cm (0,15 m)</span>
                                <span class="text-[9px] bg-emerald-500/20 text-emerald-300 font-bold px-1.5 py-0.5 rounded-full border border-emerald-500/40">Recomendado</span>
                            </div>
                            <p class="text-[10px] text-slate-300 font-semibold">Padrão NBR 15575 / NBR 15270</p>
                            <p class="text-[9px] text-slate-400">Alvenaria de vedação convencional com tijolo cerâmico ou bloco com emboço e reboco.</p>
                        </div>

                        <!-- PRESET 14CM -->
                        <div onclick="selecionarPresetEspessura(0.14)" id="cardEsp_0.14" class="card-espessura border border-slate-800 bg-slate-950/60 p-3 rounded-2xl cursor-pointer hover:border-slate-700 transition space-y-1">
                            <span class="font-bold text-white text-sm block">14 cm (0,14 m)</span>
                            <p class="text-[10px] text-slate-300 font-semibold">Bloco com Gesso Liso</p>
                            <p class="text-[9px] text-slate-400">Bloco cerâmico ou de concreto estrutural com acabamento interno de gesso direto.</p>
                        </div>

                        <!-- PRESET 10CM DRYWALL -->
                        <div onclick="selecionarPresetEspessura(0.10)" id="cardEsp_0.10" class="card-espessura border border-slate-800 bg-slate-950/60 p-3 rounded-2xl cursor-pointer hover:border-slate-700 transition space-y-1">
                            <span class="font-bold text-white text-sm block">10 cm (0,10 m)</span>
                            <p class="text-[10px] text-slate-300 font-semibold">Parede Leve / Drywall (NBR 15758)</p>
                            <p class="text-[9px] text-slate-400">Gesso acartonado com estrutura metálica e lã mineral para divisórias internas leves.</p>
                        </div>

                        <!-- PRESET 12CM -->
                        <div onclick="selecionarPresetEspessura(0.12)" id="cardEsp_0.12" class="card-espessura border border-slate-800 bg-slate-950/60 p-3 rounded-2xl cursor-pointer hover:border-slate-700 transition space-y-1">
                            <span class="font-bold text-white text-sm block">12 cm (0,12 m)</span>
                            <p class="text-[10px] text-slate-300 font-semibold">Alvenaria Estreita em Cutelo</p>
                            <p class="text-[9px] text-slate-400">Tijolo cerâmico estreito (espelho) com argamassa fina em divisórias secundárias.</p>
                        </div>

                        <!-- PRESET 20CM EXTERNA -->
                        <div onclick="selecionarPresetEspessura(0.20)" id="cardEsp_0.20" class="card-espessura border border-slate-800 bg-slate-950/60 p-3 rounded-2xl cursor-pointer hover:border-slate-700 transition space-y-1">
                            <span class="font-bold text-white text-sm block">20 cm (0,20 m)</span>
                            <p class="text-[10px] text-slate-300 font-semibold">Parede Externa / Fachada</p>
                            <p class="text-[9px] text-slate-400">Alvenaria perimetral com alta isolação térmica e acústica exigida pela NBR 15575.</p>
                        </div>

                        <!-- PRESET 25CM GEMINADA -->
                        <div onclick="selecionarPresetEspessura(0.25)" id="cardEsp_0.25" class="card-espessura border border-slate-800 bg-slate-950/60 p-3 rounded-2xl cursor-pointer hover:border-slate-700 transition space-y-1">
                            <span class="font-bold text-white text-sm block">25 cm (0,25 m)</span>
                            <p class="text-[10px] text-slate-300 font-semibold">Parede Geminada / Dupla (NBR 16868)</p>
                            <p class="text-[9px] text-slate-400">Parede dupla entre unidades autônomas ou alvenaria estrutural reforçada.</p>
                        </div>
                    </div>
                </div>

                <!-- VALOR MANUAL E APLICAÇÃO -->
                <div class="pt-3 border-t border-slate-800 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 bg-slate-950 p-3.5 rounded-2xl border border-slate-800">
                    <div class="flex items-center gap-3">
                        <label class="text-slate-300 font-semibold text-xs">Espessura Ativa (m):</label>
                        <input id="numEspessuraParedeManual" type="number" step="0.01" min="0.05" max="0.60" value="0.15" onchange="atualizarManualEspessura(this.value)" class="w-24 bg-slate-900 border border-slate-700 text-white font-mono font-bold p-2 rounded-xl text-center text-sm outline-none focus:border-sky-400">
                    </div>
                    <label class="flex items-center gap-2 text-slate-300 cursor-pointer select-none text-[11px]">
                        <input type="checkbox" id="chkAplicarTodosComodos" checked class="rounded text-sky-500 bg-slate-900 border-slate-700">
                        <span>Atualizar cômodos existentes</span>
                    </label>
                </div>
            </div>

            <!-- RODAPÉ -->
            <div class="p-4 bg-slate-950 border-t border-slate-800 flex justify-between items-center text-xs">
                <button type="button" onclick="fecharModalConfigParedes()" class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 font-bold transition">
                    Cancelar
                </button>
                <button type="button" onclick="salvarConfigParedes()" class="px-5 py-2 rounded-xl bg-sky-500 hover:bg-sky-400 text-slate-950 font-black flex items-center gap-2 shadow-lg shadow-sky-500/20 transition active:scale-95">
                    <i class="fa-solid fa-check"></i> Aplicar Espessura Normativa
                </button>
            </div>
        </div>
    </div>

</body>
</html>